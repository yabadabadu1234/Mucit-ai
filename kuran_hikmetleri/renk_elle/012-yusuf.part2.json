{"ayet":58,"gruplar":[{"ar":[1,2],"tr":"Yusuf’un kardeşleri"},{"ar":[0],"tr":"gelip"},{"ar":[3,4],"tr":"onun huzuruna girdiler"},{"ar":[5],"tr":"(Yusuf) onları tanıdı"},{"ar":[6,7,8],"tr":"onlar onu tanımıyorlardı"}]},
{"ayet":59,"gruplar":[{"ar":[0,1,2],"tr":"(Yusuf) onların yüklerini hazırlayınca"},{"ar":[3],"tr":"dedi ki"},{"ar":[5,6,7,8],"tr":"«Sizin bababir kardeşinizi"},{"ar":[4],"tr":"de bana getirin"},{"ar":[10,11],"tr":"Görmüyor musunuz"},{"ar":[12,13,14],"tr":"ben ölçeği tam dolduruyorum"},{"ar":[15,16,17],"tr":"ve ben misafirperverlerin en iyisiyim"}]},
