{"sure":12,"ayetler":[
{"ayet":31,"gruplar":[{"ar":[0,1,2],"tr":"Kadın, onların dedikodusunu duyunca"},{"ar":[3,4],"tr":"onlara dâvetçi gönderdi"},{"ar":[5,6,7],"tr":"onlar için dayanacak yastıklar hazırladı"},{"ar":[8,9,10,11,12],"tr":"Onlardan herbirine bir bıçak verdi"},{"ar":[13,14,15],"tr":"(Kadınlar meyveleri soyarken Yusuf’a): «Çık karşılarına!» dedi"},{"ar":[17,18],"tr":"Kadınlar onu görünce"},{"ar":[19],"tr":"onun büyüklüğünü anladılar"},{"ar":[20,21],"tr":"(Şaşkınlıklarından) ellerini kestiler"},{"ar":[22],"tr":"ve dediler ki"},{"ar":[23,24],"tr":"Hâşâ Rabbimiz!"},{"ar":[25,26,27],"tr":"Bu bir beşer değil..."},{"ar":[28,29,30,31,32],"tr":"Bu ancak üstün bir melektir"}]},
{"ayet":32,"gruplar":[{"ar":[0],"tr":"Kadın dedi ki"},{"ar":[1,2,3,4],"tr":"İşte hakkında beni kınadığınız şahıs budur"},{"ar":[6,7,8,9],"tr":"Ben onun nefsinden murat almak istedim"},{"ar":[10],"tr":"Fakat o, (bundan) şiddetle sakındı"},{"ar":[12,13,14,15,16],"tr":"Andolsun, eğer o kendisine emredeceğimi yapmazsa"},{"ar":[17],"tr":"mutlaka zindana atılacak"},{"ar":[18,19,20],"tr":"ve elbette sürünenlerden olacaktır"}]},
{"ayet":33,"gruplar":[{"ar":[1],"tr":"(Yusuf:) Rabbim"},{"ar":[2,4],"tr":"Bana zindan"},{"ar":[5,6,7],"tr":"bunların benden istediklerinden"},{"ar":[3],"tr":"daha iyidir"},{"ar":[9,10,11,12],"tr":"Eğer onların hilelerini benden çevirmezsen"},{"ar":[13,14],"tr":"onlara meyleder"},{"ar":[15,16,17],"tr":"ve cahillerden olurum"},{"ar":[0],"tr":"dedi"}]},
{"ayet":34,"gruplar":[{"ar":[0,1,2],"tr":"Rabbi onun duasını kabul etti"},{"ar":[3,4,5],"tr":"ve hilelerini ondan uzaklaştırdı"},{"ar":[7,8,9,10],"tr":"Çünkü O çok iyi işiten, pek iyi bilendir"}]},
{"ayet":35,"gruplar":[{"ar":[0],"tr":"Sonunda"},{"ar":[3,4,5,6,7],"tr":"(aziz ve arkadaşları) kesin delilleri görmelerine rağmen"},{"ar":[8,9,10],"tr":"(halkın dedikodusunu kesmek için yine de) onu bir zamana kadar mutlaka zindana atmaları"},{"ar":[1,2],"tr":"kendilerine uygun göründü"}]},
{"ayet":36,"gruplar":[{"ar":[0,1,2,3],"tr":"Onunla birlikte zindana iki delikanlı daha girdi"},{"ar":[5,6],"tr":"Onlardan biri dedi ki"},{"ar":[7,8,9,10],"tr":"Ben (rüyada) şarap sıktığımı gördüm"},{"ar":[12,13],"tr":"Diğeri de"},{"ar":[14,15,16,17,18,19,20,21,22],"tr":"Ben de başımın üstünde kuşların yemekte olduğu bir ekmek taşıdığımı gördüm"},{"ar":[24,25],"tr":"Bunun yorumunu bize haber ver"},{"ar":[27,28,29,30],"tr":"Çünkü biz seni güzel davrananlardan görüyoruz, dedi"}]},
{"ayet":37,"gruplar":[{"ar":[0],"tr":"(Yusuf) dedi ki"},{"ar":[1,2,3,4,8,9,10],"tr":"Size yedirilecek yemek gelmeden önce"},{"ar":[5,6,7],"tr":"onun yorumunu mutlaka size haber vereceğim"},{"ar":[12,13,14,15],"tr":"Bu, Rabbimin bana öğrettiklerindendir"},{"ar":[17],"tr":"Şüphesiz ben"},{"ar":[18,19,20,21,22,23],"tr":"Allah’a inanmayan bir kavmin dininden uzaklaştım"},{"ar":[24,25,26,27],"tr":"Onlar ahireti inkâr edenlerin kendileridir"}]},
{"ayet":38,"gruplar":[{"ar":[2,3,4,5],"tr":"Atalarım İbrahim, İshak ve Ya’kub’un"},{"ar":[0,1],"tr":"dinine uydum"},{"ar":[7,8,9,10,11,12,13,14],"tr":"Allah’a herhangi bir şeyi ortak koşmamız bize yaraşmaz"},{"ar":[16],"tr":"Bu"},{"ar":[17,18,19,20,21,22],"tr":"Allah’ın bize ve insanlara olan lütfundandır"},{"ar":[23,24,25,26,27],"tr":"Fakat insanların çoğu şükretmezler"}]},
{"ayet":39,"gruplar":[{"ar":[0,1],"tr":"Ey zindan arkadaşlarım"},{"ar":[2,3],"tr":"Çeşitli tanrılar mı"},{"ar":[4],"tr":"daha iyi"},{"ar":[5],"tr":"yoksa"},{"ar":[6,7,8],"tr":"gücüne karşı durulamaz olan bir tek Allah mı"}]},
{"ayet":40,"gruplar":[{"ar":[0,1,2,3],"tr":"Allah’ı bırakıp da taptıklarınız"},{"ar":[4,5,6,7,8],"tr":"sizin ve atalarınızın taktığı birtakım isimlerden başka bir şey değildir"},{"ar":[9,10,11,12,13,14],"tr":"Allah onlar hakkında herhangi bir delil indirmemiştir"},{"ar":[16,17,18,19],"tr":"Hüküm sadece Allah’a aittir"},{"ar":[21,22,23,24,25],"tr":"O size kendisinden başkasına ibadet etmemenizi emretmiştir"},{"ar":[27,28,29],"tr":"İşte dosdoğru din budur"},{"ar":[30,31,32,33,34],"tr":"Fakat insanların çoğu bilmezler"}]},
{"ayet":41,"gruplar":[{"ar":[0,1],"tr":"Ey zindan arkadaşlarım"},{"ar":[2,3],"tr":"(Rüyalarınıza gelince), biriniz"},{"ar":[4,5,6],"tr":"(daha önce olduğu gibi) efendisine şarap içirecek"},{"ar":[8,9,10],"tr":"diğeri ise asılacak"},{"ar":[11,12,13,14],"tr":"ve kuşlar onun başından (beynini) yiyecekler"},{"ar":[17,18,19,20],"tr":"Yorumunu sorduğunuz iş"},{"ar":[16],"tr":"(bu şekilde) kesinleşmiştir"}]},
{"ayet":42,"gruplar":[{"ar":[1,2,3,4,5],"tr":"Onlardan, kurtulacağını bildiği kimseye"},{"ar":[0],"tr":"dedi ki"},{"ar":[6,7,8],"tr":"Beni efendinin yanında an"},{"ar":[10],"tr":"Fakat şeytan ona"},{"ar":[9,11,12],"tr":"efendisine anmayı unutturdu"},{"ar":[13,14,15,16,17],"tr":"Dolayısıyla (Yusuf), birkaç sene daha zindanda kaldı"}]},
{"ayet":43,"gruplar":[{"ar":[0,1],"tr":"Kral dedi ki"},{"ar":[2],"tr":"Ben (rüyada)"},{"ar":[7,8,9],"tr":"yedi arık ineğin yediği"},{"ar":[3,4,5,6],"tr":"yedi semiz inek gördüm"},{"ar":[10,11,12],"tr":"Ayrıca, yedi yeşil başak"},{"ar":[13,14],"tr":"ve diğerlerini de kuru gördüm"},{"ar":[16,17],"tr":"Ey ileri gelenler"},{"ar":[21,22,23,24],"tr":"Eğer rüya yorumluyorsanız"},{"ar":[18,19,20],"tr":"benim rüyamı da bana yorumlayınız"}]},
{"ayet":44,"gruplar":[{"ar":[0],"tr":"(Yorumcular) dediler ki"},{"ar":[1,2],"tr":"Bunlar karmakarışık düşlerdir"},{"ar":[4,5,6,7,8],"tr":"Biz böyle düşlerin yorumunu bilenlerden değiliz"}]},
{"ayet":45,"gruplar":[{"ar":[1,2,3],"tr":"(Zindandaki) iki kişiden kurtulmuş olan"},{"ar":[5,6],"tr":"uzun bir zaman sonra"},{"ar":[4],"tr":"(Yusuf’u) hatırlayarak"},{"ar":[0],"tr":"dedi ki"},{"ar":[7,8,9],"tr":"Ben size onun yorumunu haber veririm"},{"ar":[10],"tr":"beni hemen (zindana) gönderin"}]},
{"ayet":46,"gruplar":[{"ar":[0],"tr":"(Yusuf’un yanına gelerek dedi ki:) Ey Yusuf"},{"ar":[1,2],"tr":"ey doğru sözlü kişi"},{"ar":[8,9,10],"tr":"(Rüyada görülen) yedi arık ineğin yediği"},{"ar":[5,6,7],"tr":"yedi semiz inek"},{"ar":[11,12,13],"tr":"ile yedi yeşil başak"},{"ar":[4,14,15],"tr":"ve diğerleri de kuru olan (başaklar) hakkında"},{"ar":[3],"tr":"bize yorum yap"},{"ar":[16,17,18,19],"tr":"Ümit ederim ki, insanlara (isabetli yorumunla) dönerim"},{"ar":[20,21],"tr":"de belki onlar da doğruyu öğrenirler"}]},
{"ayet":47,"gruplar":[{"ar":[0],"tr":"Yusuf dedi ki"},{"ar":[1,2,3,4],"tr":"Yedi sene âdetiniz üzere ekin ekersiniz"},{"ar":[5],"tr":"Sonra da"},{"ar":[10,11,12,13],"tr":"yiyeceklerinizden az bir miktar hariç"},{"ar":[6],"tr":"biçtiklerinizi"},{"ar":[7,8,9],"tr":"başağında (stok edip) bırakınız"}]},
{"ayet":48,"gruplar":[{"ar":[0,2,3,4],"tr":"Sonra bunun ardından"},{"ar":[11,12,13,14],"tr":"saklayacaklarınızdan az bir miktar (tohumluk) hariç"},{"ar":[8,9,10],"tr":"o yıllar için biriktirdiklerinizi"},{"ar":[7],"tr":"yeyip bitirecek"},{"ar":[1,5,6],"tr":"yedi kıtlık yılı gelecektir"}]},
{"ayet":49,"gruplar":[{"ar":[0,2,3,4],"tr":"Sonra bunun ardından da"},{"ar":[1,5],"tr":"bir yıl gelecek ki"},{"ar":[6,7,8],"tr":"o yılda insanlara (Allah tarafından) yardım olunacak"},{"ar":[9,10],"tr":"ve o yılda (meyvesuyu ve yağ) sıkacaklar"}]},
{"ayet":50,"gruplar":[{"ar":[0,1],"tr":"(Adam bu yorumu getirince) kral dedi ki"},{"ar":[2,3],"tr":"«Onu bana getirin!»"},{"ar":[5,6,7],"tr":"Elçi, Yusuf’a geldiği zaman"},{"ar":[8],"tr":"(Yusuf) dedi ki"},{"ar":[9,10,11],"tr":"«Efendine dön"},{"ar":[12,13,14,15,16,17,18],"tr":"de ona: Ellerini kesen o kadınların zoru neydi? diye sor"},{"ar":[20,21,22,23],"tr":"Şüphesiz benim Rabbim onların hilesini çok iyi bilir.»"}]},
{"ayet":51,"gruplar":[{"ar":[0],"tr":"(Kral kadınlara) dedi ki"},{"ar":[3,4,5,6,7],"tr":"Yusuf’un nefsinden murat almak istediğiniz zaman"},{"ar":[1,2],"tr":"durumunuz neydi"},{"ar":[10,11],"tr":"Kadınlar, Hâşâ! Allah için"},{"ar":[12,13,14,15,16],"tr":"biz ondan hiçbir kötülük görmedik"},{"ar":[9],"tr":"dediler"},{"ar":[18,19,20],"tr":"Azizin karısı da dedi ki"},{"ar":[21,22,23],"tr":"«Şimdi gerçek ortaya çıktı"},{"ar":[24,25,26,27],"tr":"Ben onun nefsinden murat almak istemiştim"},{"ar":[28,29,30],"tr":"Şüphesiz ki o doğru söyleyenlerdendir.»"}]},
{"ayet":52,"gruplar":[{"ar":[0],"tr":"(Yusuf dedi ki): Bu"},{"ar":[2,3,4,5],"tr":"azizin yokluğunda ona hainlik etmediğimi"},{"ar":[6,7,8,9,10,11],"tr":"ve Allah’ın hainlerin hilesini başarıya ulaştırmayacağını"},{"ar":[1],"tr":"(herkesin) bilmesi içindir"}]},
{"ayet":53,"gruplar":[{"ar":[1,2,3],"tr":"(Bununla beraber) nefsimi temize çıkarmıyorum"},{"ar":[5,6,7,8],"tr":"Çünkü nefis aşırı şekilde kötülüğü emreder"},{"ar":[9,10,11,12],"tr":"Rabbim acıyıp korumuş başka"},{"ar":[14,15,16,17],"tr":"Şüphesiz Rabbim çok bağışlayan, pek esirgeyendir"}]},
{"ayet":54,"gruplar":[{"ar":[0,1],"tr":"Kral dedi ki"},{"ar":[2,3],"tr":"Onu bana getirin"},{"ar":[4,5],"tr":"onu kendime özel danışman edineyim"},{"ar":[7,8],"tr":"Onunla konuşunca"},{"ar":[9,10,11,12,13,14],"tr":"Bugün sen yanımızda yüksek makam sahibi ve güvenilir birisin, dedi"}]},
{"ayet":55,"gruplar":[{"ar":[1,2,3,4],"tr":"«Beni ülkenin hazinelerine tayin et"},{"ar":[0,6,7,8],"tr":"Çünkü ben (onları) çok iyi korurum ve bu işi bilirim» dedi"}]},
{"ayet":56,"gruplar":[{"ar":[0],"tr":"Ve böylece"},{"ar":[2],"tr":"Yusuf’a"},{"ar":[5,6,7,8],"tr":"orada dilediği gibi hareket etmek üzere"},{"ar":[1,3,4],"tr":"ülke içinde yetki verdik"},{"ar":[10,11,12,13],"tr":"Biz dilediğimiz kimseye rahmetimizi eriştiririz"},{"ar":[15,16,17,18],"tr":"Ve güzel davrananların mükâfatını zayi etmeyiz"}]},
