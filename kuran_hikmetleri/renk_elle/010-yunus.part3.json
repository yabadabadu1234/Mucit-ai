{"sure":10,"ayetler":[
{"ayet":61,"gruplar":[{"ar":[0,1,2,3],"tr":"Ne zaman sen bir işte bulunsan"},{"ar":[4,5,6,7,8],"tr":"ne zaman Kur’an’dan bir şey okusan"},{"ar":[9,10,11,12],"tr":"ve siz ne zaman bir iş yaparsanız"},{"ar":[17,18,19],"tr":"o işe daldığınız zaman"},{"ar":[13,14,15,16],"tr":"biz mutlaka üstünüzde şahidizdir"},{"ar":[25,26,27,28,29,30,31,32],"tr":"Ne yerde ne gökte zerre ağırlığınca bir şey"},{"ar":[21,22,23,24],"tr":"Rabbinden uzak (ve gizli) kalmaz"},{"ar":[33,34,35,36],"tr":"Bundan daha küçüğü"},{"ar":[37,38],"tr":"ve daha büyüğü"},{"ar":[39,40,41,42],"tr":"yoktur ki apaçık kitapta (levh-i mahfuzda) bulunmasın"}]},
{"ayet":62,"gruplar":[{"ar":[0,1],"tr":"Bilesiniz ki"},{"ar":[2,3],"tr":"Allah’ın dostlarına"},{"ar":[4,5,6],"tr":"korku yoktur"},{"ar":[7,8,9],"tr":"onlar üzülmeyecekler de"}]},
{"ayet":63,"gruplar":[{"ar":[0,1],"tr":"Onlar, iman edip de"},{"ar":[2,3],"tr":"takvâya ermiş olanlardır"}]},
{"ayet":64,"gruplar":[{"ar":[2,3,4,5,6],"tr":"Dünya hayatında da ahirette de"},{"ar":[0,1],"tr":"onlara müjde vardır"},{"ar":[8,9,10,11],"tr":"Allah’ın sözlerinde asla değişme yoktur"},{"ar":[13,14,15,16],"tr":"İşte bu, büyük kurtuluşun kendisidir"}]},
{"ayet":65,"gruplar":[{"ar":[2],"tr":"(Resûlüm) Onların (inkârcıların) sözleri"},{"ar":[0,1],"tr":"seni üzmesin"},{"ar":[4,5,6,7],"tr":"Çünkü bütün izzet (ve üstünlük) Allah’ındır"},{"ar":[9,10,11],"tr":"O, işitendir, bilendir"}]},
{"ayet":66,"gruplar":[{"ar":[0],"tr":"İyi bilin ki"},{"ar":[1,2,3,4,5,6,7,8],"tr":"göklerde ve yerde ne varsa yalnız Allah’ındır"},{"ar":[12,13,14,15,16,17],"tr":"(O halde) Allah’tan başka ortaklara tapanlar"},{"ar":[10,11],"tr":"neyin ardına düşüyorlar"},{"ar":[19,20,21,22],"tr":"Doğrusu onlar, zandan başka bir şeyin ardına düşmüyorlar"},{"ar":[23,24,25,26],"tr":"ve onlar sadece yalan söylüyorlar"}]},
{"ayet":67,"gruplar":[{"ar":[0],"tr":"O (Allah)"},{"ar":[4,5,6],"tr":"geceyi içinde dinlenesiniz diye"},{"ar":[1,2,3],"tr":"sizin için yaratan"},{"ar":[7,8],"tr":"(çalışıp kazanmanız için de) gündüzü aydınlık kılandır"},{"ar":[10,11,12],"tr":"Şüphesiz bunda"},{"ar":[13,14,15],"tr":"dinleyen bir toplum için ibretler vardır"}]},
{"ayet":68,"gruplar":[{"ar":[1,2,3],"tr":"(Müşrikler:) «Allah çocuk edindi»"},{"ar":[0],"tr":"dediler"},{"ar":[5],"tr":"Hâşâ! O bundan münezzehtir"},{"ar":[7,8],"tr":"O’nun (çocuğa) ihtiyacı yoktur"},{"ar":[10,11,12,13,14,15,16],"tr":"Göklerde ve yerde ne varsa O’nundur"},{"ar":[18,19,20,21,22],"tr":"Bu hususta yanınızda herhangi bir delil yoktur"},{"ar":[24,25,26,27,28,29],"tr":"Allah hakkında bilmediğiniz bir şeyi mi söylüyorsunuz"}]},
{"ayet":69,"gruplar":[{"ar":[0],"tr":"De ki"},{"ar":[2,3,4,5,6],"tr":"Allah hakkında yalan uyduranlar"},{"ar":[1,7,8],"tr":"asla kurtuluşa eremezler"}]},
{"ayet":70,"gruplar":[{"ar":[0,1,2],"tr":"Dünyada bir miktar geçim (sağlarlar)"},{"ar":[3,4,5],"tr":"sonra dönüşleri bizedir"},{"ar":[6],"tr":"sonra da"},{"ar":[10,11,12],"tr":"inkâr etmekte oldukları şeylerden ötürü"},{"ar":[7,8,9],"tr":"onlara şiddetli azabı tattırırız"}]},
{"ayet":71,"gruplar":[{"ar":[1,2,3,4],"tr":"Onlara Nuh’un haberini oku"},{"ar":[5,6,7],"tr":"Hani o kavmine demişti ki"},{"ar":[8],"tr":"«Ey kavmim"},{"ar":[9],"tr":"Eğer"},{"ar":[13],"tr":"benim (aranızda) durmam"},{"ar":[14,15,16],"tr":"ve Allah’ın âyetlerini hatırlatmam"},{"ar":[10,11,12],"tr":"size ağır geldi ise"},{"ar":[17,18,19],"tr":"ben yalnız Allah’a dayanıp güvenirim"},{"ar":[20,21,22],"tr":"Siz de ortaklarınızla beraber toplanıp yapacağınızı kararlaştırın"},{"ar":[23,24,25,26,27,28],"tr":"Sonra işiniz başınıza dert olmasın"},{"ar":[29,30,31],"tr":"Bundan sonra (vereceğiniz) hükmü, bana uygulayın"},{"ar":[32,33],"tr":"ve bana mühlet de vermeyin.»"}]},
{"ayet":72,"gruplar":[{"ar":[0,1],"tr":"«Eğer yüz çeviriyorsanız"},{"ar":[2,3,4,5],"tr":"zaten ben sizden bir ücret istemedim"},{"ar":[7,8,9,10,11],"tr":"Benim ecrim Allah’tan başkasına ait değildir"},{"ar":[13,14,15,16,17],"tr":"ve bana müslümanlardan olmam emrolundu.»"}]},
{"ayet":73,"gruplar":[{"ar":[0],"tr":"Yine de onu yalanladılar"},{"ar":[1,2,3,4,5],"tr":"biz de hem onu hem de onunla beraber gemide bulunanları kurtardık"},{"ar":[6,7],"tr":"ve onları (yeryüzünde) halifeler kıldık"},{"ar":[8,9,10,11],"tr":"âyetlerimizi yalanlayanları da (denizde) boğduk"},{"ar":[13],"tr":"Bak ki"},{"ar":[14,15,16,17],"tr":"uyarılanların (fakat inanmayanların) sonu nasıl oldu"}]},
{"ayet":74,"gruplar":[{"ar":[0,2,3],"tr":"Sonra onun arkasından"},{"ar":[1,4,5,6],"tr":"birçok peygamberi kendi toplumlarına gönderdik"},{"ar":[7,8],"tr":"Onlara mucizeler getirdiler"},{"ar":[9,10,11,12,13,14,15,16],"tr":"Fakat onlar daha önce yalanladıkları şeye inanacak değillerdi"},{"ar":[20,21,22],"tr":"İşte haddi aşanların kalplerini"},{"ar":[18,19],"tr":"biz böyle mühürleriz"}]},
{"ayet":75,"gruplar":[{"ar":[0,2,3],"tr":"Sonra onların ardından da"},{"ar":[6,7,8],"tr":"Firavun ve toplumuna"},{"ar":[4,5],"tr":"Musa ile Harun’u"},{"ar":[1,9],"tr":"mucizelerimizle gönderdik"},{"ar":[10],"tr":"fakat onlar kibirlendiler"},{"ar":[11,12,13],"tr":"ve günahkâr bir toplum oldular"}]},
{"ayet":76,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Katımızdan onlara hak (mucize) gelince"},{"ar":[6,7,8,9],"tr":"«Bu elbette apaçık bir sihirdir»"},{"ar":[5],"tr":"dediler"}]},
{"ayet":77,"gruplar":[{"ar":[1],"tr":"Musa"},{"ar":[4,5],"tr":"«Size hak geldiğinde"},{"ar":[3,2],"tr":"onun için (hep böyle) mi dersiniz"},{"ar":[7,8],"tr":"Bu bir sihir midir"},{"ar":[9,10,11],"tr":"Halbuki sihirbazlar iflâh olmazlar»"},{"ar":[0],"tr":"dedi"}]},
{"ayet":78,"gruplar":[{"ar":[0],"tr":"Onlar dediler ki"},{"ar":[3,4,5,6],"tr":"Babalarımızı üzerinde bulduğumuz (dinden)"},{"ar":[2],"tr":"bizi döndüresin"},{"ar":[7,8,9,10,11],"tr":"ve yeryüzünde ululuk sizin ikinizin olsun diye"},{"ar":[1],"tr":"mi bize geldin"},{"ar":[12,13,14,15],"tr":"Halbuki biz size inanacak değiliz"}]},
{"ayet":79,"gruplar":[{"ar":[0,1],"tr":"Firavun dedi ki"},{"ar":[3,4,5],"tr":"Bilgili bütün sihirbazları"},{"ar":[2],"tr":"bana getirin"}]},
{"ayet":80,"gruplar":[{"ar":[0,1,2],"tr":"Sihirbazlar gelince"},{"ar":[4,5],"tr":"Musa onlara"},{"ar":[6,7,8,9],"tr":"Atacağınızı atın"},{"ar":[3],"tr":"dedi"}]},
{"ayet":81,"gruplar":[{"ar":[0,1],"tr":"Onlar (iplerini) atınca"},{"ar":[2,3],"tr":"Musa dedi ki"},{"ar":[4,5,6,7],"tr":"«Sizin getirdiğiniz sihirdir"},{"ar":[9,10,11],"tr":"Allah onu boşa çıkaracaktır"},{"ar":[13,14,15,16,17,18],"tr":"Çünkü Allah bozguncuların işini düzeltmez.»"}]},
{"ayet":82,"gruplar":[{"ar":[4,5,6],"tr":"«Suçluların hoşuna gitmese de"},{"ar":[0,1,2,3],"tr":"Allah, sözleriyle gerçeği açığa çıkaracaktır.»"}]},
{"ayet":83,"gruplar":[{"ar":[7,8,9,10,11,12,13],"tr":"Firavun ve kavminin kendilerine işkence etmesinden korkuya düştükleri için"},{"ar":[3,4,5,6],"tr":"kavminden bir gurup gençten başka"},{"ar":[0,1,2],"tr":"kimse Musa’ya iman etmedi"},{"ar":[15,16,17,18,19],"tr":"Çünkü Firavun yeryüzünde ululuk taslayan (bir diktatör)"},{"ar":[20,21,22],"tr":"ve haddi aşanlardan idi"}]},
{"ayet":84,"gruplar":[{"ar":[0,1],"tr":"Musa dedi ki"},{"ar":[2],"tr":"Ey kavmim"},{"ar":[3,4,5,6],"tr":"Eğer Allah’a inandıysanız"},{"ar":[9,10,11],"tr":"ve O’na teslim olduysanız"},{"ar":[7,8],"tr":"sadece O’na güvenip dayanın"}]},
