{
 "sure": 15,
 "ad": "Hicr",
 "ayetler": [
  {
   "ayet": 1,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Elif. Lâm. Râ."
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "Bunlar Kitab’ın ve apaçık bir Kur’an’ın âyetleridir."
    }
   ]
  },
  {
   "ayet": 2,
   "gruplar": [
    {
     "ar": [
      2,
      3
     ],
     "tr": "İnkâr edenler"
    },
    {
     "ar": [
      0
     ],
     "tr": "zaman zaman"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "keşke biz de müslüman olsaydık"
    },
    {
     "ar": [
      1
     ],
     "tr": "diye arzu ederler"
    }
   ]
  },
  {
   "ayet": 3,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Onları bırak"
    },
    {
     "ar": [
      1
     ],
     "tr": "yesinler"
    },
    {
     "ar": [
      2
     ],
     "tr": "eğlensinler"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "ve boş ümit onları oyalayadursun"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "(Kötü sonucu) yakında bilecekler!"
    }
   ]
  },
  {
   "ayet": 4,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Helâk ettiğimiz hiçbir ülke yoktur ki"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "hakkında (bizce) bilinen bir yazgı olmasın."
    }
   ]
  },
  {
   "ayet": 5,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Hiçbir millet, ecelinin önüne geçemez"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ve onu geciktiremez."
    }
   ]
  },
  {
   "ayet": 6,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Dediler ki"
    },
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "«Ey kendisine Kur’an indirilen (Muhammed)!"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "Sen mutlaka bir mecnunsun!»"
    }
   ]
  },
  {
   "ayet": 7,
   "gruplar": [
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "«Eğer doğru söyleyenlerden idiysen"
    },
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "bize melekleri getirmeliydin.»"
    }
   ]
  },
  {
   "ayet": 8,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Biz melekleri ancak hak ile indiririz."
    },
    {
     "ar": [
      5,
      6,
      7,
      8
     ],
     "tr": "O zaman onlara mühlet verilmez."
    }
   ]
  },
  {
   "ayet": 9,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Kur’an’ı kesinlikle biz indirdik"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "elbette onu yine biz koruyacağız."
    }
   ]
  },
  {
   "ayet": 10,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Andolsun"
    },
    {
     "ar": [
      2,
      3,
      5,
      6
     ],
     "tr": "senden önceki milletler arasında da"
    },
    {
     "ar": [
      1
     ],
     "tr": "elçiler gönderdik."
    }
   ]
  },
  {
   "ayet": 11,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Onlara bir peygamber gelmeyedursun"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "hemen onunla alay ederlerdi."
    }
   ]
  },
  {
   "ayet": 12,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "İşte böylece"
    },
    {
     "ar": [
      1
     ],
     "tr": "biz onu, (inkârcılığı)"
    },
    {
     "ar": [
      3,
      4,
      2
     ],
     "tr": "suçluların kalplerine sokarız."
    }
   ]
  },
  {
   "ayet": 13,
   "gruplar": [
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "Öncekilerin başına gelenlerden ders almaları gerekirken"
    },
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "onlar hala buna (Kur’an’a) inanmıyorlar."
    }
   ]
  },
  {
   "ayet": 14,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Onlara gökten bir kapı açsak da"
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "oradan yukarı çıksalar"
    }
   ]
  },
  {
   "ayet": 15,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "yine de"
    },
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "«Gözlerimiz boyandı"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "daha doğrusu bize büyü yapılmıştır.» derler."
    }
   ]
  },
  {
   "ayet": 16,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Andolsun, biz gökte birtakım burçlar yarattık"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ve seyr edenler için onu süsledik."
    }
   ]
  },
  {
   "ayet": 17,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Onları"
    },
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "taşlanmış (kovulmuş) her şeytandan koruduk."
    }
   ]
  },
  {
   "ayet": 18,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Ancak kulak hırsızlığı eden müstesna."
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "Onun da peşine açık bir alev sütunu düşmüştür."
    }
   ]
  },
  {
   "ayet": 19,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Yeri uzatıp yaydık"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "orada sabit dağlar yerleştirdik"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "yine orada miktarı ve ölçüsü belirli olan şeyler bitirdik."
    }
   ]
  },
  {
   "ayet": 20,
   "gruplar": [
    {
     "ar": [
      2,
      1,
      4,
      5,
      6,
      7
     ],
     "tr": "Orada hem sizin için hem de rızıkları size ait olmayanlar için"
    },
    {
     "ar": [
      3,
      0
     ],
     "tr": "(gerekli) geçim vasıtaları yarattık."
    }
   ]
  },
  {
   "ayet": 21,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Her şeyin hazineleri yalnız bizim yanımızdadır."
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "Biz onu ancak belli bir ölçüyle indiririz."
    }
   ]
  },
  {
   "ayet": 22,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Biz, rüzgârları aşılayıcı olarak gönderdik"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "ve gökten bir su indirdik"
    },
    {
     "ar": [
      7
     ],
     "tr": "de onunla su ihtiyacınızı karşıladık."
    },
    {
     "ar": [
      8,
      9,
      10,
      11
     ],
     "tr": "(Biz bunları yapmasaydık) siz onu (yeterli) suyu depolayamazdınız."
    }
   ]
  },
  {
   "ayet": 23,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Şüphesiz biz diriltir"
    },
    {
     "ar": [
      3
     ],
     "tr": "ve biz öldürürüz!"
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "Ve her şeye biz vâris oluruz."
    }
   ]
  },
  {
   "ayet": 24,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Andolsun biz, sizden önce gelip geçenleri de biliriz"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "geri kalanları da biliriz."
    }
   ]
  },
  {
   "ayet": 25,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Şüphesiz Rabbin onları (kıyamette) toplayacaktır."
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "Çünkü O, hakîmdir, alîmdir."
    }
   ]
  },
  {
   "ayet": 26,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Andolsun biz insanı"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "(pişmiş) kuru bir çamurdan"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "şekillenmiş kara balçıktan yarattık."
    }
   ]
  },
  {
   "ayet": 27,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Cinleri de"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "daha önce"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "zehirli ateşten"
    },
    {
     "ar": [
      1
     ],
     "tr": "yaratmıştık."
    }
   ]
  },
  {
   "ayet": 28,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Hani Rabbin meleklere demişti ki"
    },
    {
     "ar": [
      7,
      8
     ],
     "tr": "«Ben kupkuru bir çamurdan"
    },
    {
     "ar": [
      9,
      10,
      11
     ],
     "tr": "şekillenmiş kara balçıktan"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "bir insan yaratacağım.»"
    }
   ]
  },
  {
   "ayet": 29,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«Ona şekil verdiğim"
    },
    {
     "ar": [
      2,
      3,
      4,
      5
     ],
     "tr": "ve ona ruhumdan üflediğim zaman"
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "siz hemen onun için secdeye kapanın!»"
    }
   ]
  },
  {
   "ayet": 30,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "Meleklerin hepsi de"
    },
    {
     "ar": [
      0
     ],
     "tr": "hemen secde ettiler."
    }
   ]
  },
  {
   "ayet": 31,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Fakat İblis hariç!"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "O, secde edenlerle beraber olmaktan kaçındı."
    }
   ]
  },
  {
   "ayet": 32,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Allah:)"
    },
    {
     "ar": [
      1
     ],
     "tr": "Ey İblis!"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "Secde edenlerle beraber olmayışının sebebi nedir? dedi."
    }
   ]
  },
  {
   "ayet": 33,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(İblis:)"
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10,
      5
     ],
     "tr": "Ben kuru bir çamurdan, şekillenmiş kara balçıktan yarattığın"
    },
    {
     "ar": [
      4,
      1,
      2,
      3
     ],
     "tr": "bir insana secde edecek değilim, dedi."
    }
   ]
  },
  {
   "ayet": 34,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Allah şöyle buyurdu"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "Öyle ise oradan çık!"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "Artık kovuldun!"
    }
   ]
  },
  {
   "ayet": 35,
   "gruplar": [
    {
     "ar": [
      0,
      3,
      4,
      5
     ],
     "tr": "Muhakkak ki kıyamet gününe kadar"
    },
    {
     "ar": [
      2,
      1
     ],
     "tr": "lânet senin üzerine olacaktır!"
    }
   ]
  },
  {
   "ayet": 36,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(İblis:)"
    },
    {
     "ar": [
      1
     ],
     "tr": "Rabbim!"
    },
    {
     "ar": [
      2,
      3,
      4,
      5
     ],
     "tr": "Öyle ise, (varlıkların) tekrar dirileceği güne kadar bana mühlet ver, dedi."
    }
   ]
  },
  {
   "ayet": 37,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Allah:"
    },
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "Sen bilinen bir vakte kadar kendilerine mühlet verilenlerdensin, buyurdu."
    }
   ]
  },
  {
   "ayet": 38,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "bilinen bir vakte kadar"
    }
   ]
  },
  {
   "ayet": 39,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(İblis) dedi ki"
    },
    {
     "ar": [
      1
     ],
     "tr": "Rabbim!"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "Beni azdırmana karşılık"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "ben de yeryüzünde onlara (günahları) süsleyeceğim"
    },
    {
     "ar": [
      8,
      9
     ],
     "tr": "ve onların hepsini mutlaka azdıracağım!"
    }
   ]
  },
  {
   "ayet": 40,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Ancak"
    },
    {
     "ar": [
      2,
      1,
      3
     ],
     "tr": "onlardan ihlâslı kulların müstesna."
    }
   ]
  },
  {
   "ayet": 41,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Allah) şöyle buyurdu"
    },
    {
     "ar": [
      2,
      3,
      4,
      1
     ],
     "tr": "«İşte bana varan dosdoğru yol budur.»"
    }
   ]
  },
  {
   "ayet": 42,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«Şüphesiz kullarım"
    },
    {
     "ar": [
      2,
      3,
      4,
      5
     ],
     "tr": "üzerinde senin bir hakimiyetin yoktur."
    },
    {
     "ar": [
      6
     ],
     "tr": "Ancak"
    },
    {
     "ar": [
      9,
      10,
      7,
      8
     ],
     "tr": "azgınlardan sana uyanlar müstesna.»"
    }
   ]
  },
  {
   "ayet": 43,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Muhakkak cehennem"
    },
    {
     "ar": [
      3,
      2
     ],
     "tr": "onların hepsine vâdolunan yerdir."
    }
   ]
  },
  {
   "ayet": 44,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Cehennemin yedi kapısı vardır."
    },
    {
     "ar": [
      5,
      3,
      4,
      6,
      7
     ],
     "tr": "Onlardan her kapı için birer gurup ayrılmıştır."
    }
   ]
  },
  {
   "ayet": 45,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "(Allah’ın azabından korkup rahmetine sığınan) takvâ sahipleri, mutlaka"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "cennetlerde ve pınar başlarında olacaklar."
    }
   ]
  },
  {
   "ayet": 46,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "«Oraya emniyet ve selâmetle girin» (denilir, onlara)."
    }
   ]
  },
  {
   "ayet": 47,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Biz, onların gönüllerindeki kini söküp attık"
    },
    {
     "ar": [
      6
     ],
     "tr": "onlar artık"
    },
    {
     "ar": [
      8,
      7,
      9
     ],
     "tr": "köşkler üzerinde karşı karşıya oturan kardeşler olacaklar."
    }
   ]
  },
  {
   "ayet": 48,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Onlara orada hiçbir yorgunluk gelmeyecek"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "ve onlar, oradan çıkarılmayacaklardır."
    }
   ]
  },
  {
   "ayet": 49,
   "gruplar": [
    {
     "ar": [
      2
     ],
     "tr": "Kullarıma"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "benim, çok bağışlayıcı ve pek esirgeyici olduğumu"
    },
    {
     "ar": [
      1
     ],
     "tr": "haber ver."
    }
   ]
  },
  {
   "ayet": 50,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Benim azabımın elem verici bir azap olduğunu da bildir."
    }
   ]
  },
  {
   "ayet": 51,
   "gruplar": [
    {
     "ar": [
      2,
      3
     ],
     "tr": "Onlara İbrahim’in misafirlerinden (meleklerden) de"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "haber ver."
    }
   ]
  },
  {
   "ayet": 52,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Onun yanına girdikleri zaman"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "«selam» dediler."
    },
    {
     "ar": [
      5
     ],
     "tr": "(İbrahim:)"
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "Biz sizden çekiniyoruz, dedi."
    }
   ]
  },
  {
   "ayet": 53,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Dediler ki"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "Korkma"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "biz sana bilgin bir oğul müjdeliyoruz."
    }
   ]
  },
  {
   "ayet": 54,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(İbrahim:)"
    },
    {
     "ar": [
      3,
      4,
      5,
      2
     ],
     "tr": "Bana ihtiyarlık çökmesine rağmen"
    },
    {
     "ar": [
      1
     ],
     "tr": "beni müjdeliyor musunuz?"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "Beni ne ile müjdeliyorsunuz? dedi."
    }
   ]
  },
  {
   "ayet": 55,
   "gruplar": [
    {
     "ar": [
      1,
      2
     ],
     "tr": "Sana gerçeği müjdeledik"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "sakın ümitsizliğe düşenlerden olma!"
    },
    {
     "ar": [
      0
     ],
     "tr": "dediler."
    }
   ]
  },
  {
   "ayet": 56,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(İbrahim:) dedi ki"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "Rabbinin rahmetinden"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "sapıklardan başka"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "kim ümit keser?"
    }
   ]
  },
  {
   "ayet": 57,
   "gruplar": [
    {
     "ar": [
      3,
      4
     ],
     "tr": "«Ey elçiler!"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "(Başka) ne işiniz var?»"
    },
    {
     "ar": [
      0
     ],
     "tr": "dedi."
    }
   ]
  },
  {
   "ayet": 58,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Dediler ki"
    },
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "«Biz, suçlu bir topluma (onları helâk etmeye) gönderildik.»"
    }
   ]
  },
  {
   "ayet": 59,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "«Ancak Lût ailesi hariç."
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "Onların hepsini kurtaracağız.»"
    }
   ]
  },
  {
   "ayet": 60,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«(Fakat Lût’un) karısı müstesna"
    },
    {
     "ar": [
      2,
      4,
      5,
      6
     ],
     "tr": "biz onun geri kalanlardan olmasını takdir ettik.»"
    }
   ]
  },
  {
   "ayet": 61,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Elçiler Lût âilesine gelince"
    }
   ]
  },
  {
   "ayet": 62,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "«Hakikaten siz tanınmayan kimselersiniz»"
    },
    {
     "ar": [
      0
     ],
     "tr": "dedi"
    }
   ]
  },
  {
   "ayet": 63,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Dediler ki"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "«Bilakis, biz sana"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "onların şüphe etmekte oldukları şeyi (azabı ve helâkı) getirdik."
    }
   ]
  },
  {
   "ayet": 64,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Sana gerçeği getirdik"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "biz, hakikaten doğru söyleyenleriz."
    }
   ]
  },
  {
   "ayet": 65,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      4,
      0,
      1
     ],
     "tr": "Gecenin bir bölümünde aile fertlerini yola çıkar"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "sen de arkalarından yürü."
    },
    {
     "ar": [
      9,
      10,
      7,
      8
     ],
     "tr": "Sizden hiç kimse, sakın dönüp de ardına bakmasın"
    },
    {
     "ar": [
      11,
      12,
      13
     ],
     "tr": "istenen yere gidin.»"
    }
   ]
  },
  {
   "ayet": 66,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Ona (Lût’a) şu hükmümüzü vahyettik"
    },
    {
     "ar": [
      8,
      4,
      5,
      6,
      7
     ],
     "tr": "«Sabaha çıkarlarken mutlaka onların ardı kesilmiş olacaktır.»"
    }
   ]
  },
  {
   "ayet": 67,
   "gruplar": [
    {
     "ar": [
      1,
      2
     ],
     "tr": "Şehir halkı"
    },
    {
     "ar": [
      3
     ],
     "tr": "birbirlerini kutlayarak"
    },
    {
     "ar": [
      0
     ],
     "tr": "(meleklerin yanına) geldiler."
    }
   ]
  },
  {
   "ayet": 68,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Lût) onlara"
    },
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "«Bunlar benim misafirimdir."
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "Sakın beni utandırmayın"
    }
   ]
  },
  {
   "ayet": 69,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Allah’tan korkun"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "beni rezil etmeyin!»"
    }
   ]
  },
  {
   "ayet": 70,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "«Biz seni, elâlemin işine karışmaktan men etmemiş miydik?»"
    },
    {
     "ar": [
      0
     ],
     "tr": "dediler."
    }
   ]
  },
  {
   "ayet": 71,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Lût:)"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "İşte kızlarım!"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "(Düşündüğünüzü) yapacaksanız (onlarla evlenin), dedi."
    }
   ]
  },
  {
   "ayet": 72,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Resûlüm!) Hayatın hakkı için"
    },
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "onlar, sarhoşlukları içinde bocalıyorlardı."
    }
   ]
  },
  {
   "ayet": 73,
   "gruplar": [
    {
     "ar": [
      2
     ],
     "tr": "Güneş doğarken"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "onları o korkunç ses yakaladı."
    }
   ]
  },
  {
   "ayet": 74,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Böylece ülkelerinin üstünü altına getirdik."
    },
    {
     "ar": [
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "Üzerlerine de balçıktan pişirilmiş taşlar yağdırdık."
    }
   ]
  },
  {
   "ayet": 75,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "İşte bunda"
    },
    {
     "ar": [
      4
     ],
     "tr": "ibret alanlar için"
    },
    {
     "ar": [
      3
     ],
     "tr": "işaretler vardır."
    }
   ]
  },
  {
   "ayet": 76,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Onlar"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "hâla gözler önünde duran bir yol üzerindedirler."
    }
   ]
  },
  {
   "ayet": 77,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Hakikaten bunda"
    },
    {
     "ar": [
      4
     ],
     "tr": "iman edenler için"
    },
    {
     "ar": [
      3
     ],
     "tr": "bir ibret vardır."
    }
   ]
  },
  {
   "ayet": 78,
   "gruplar": [
    {
     "ar": [
      2,
      3
     ],
     "tr": "Eyke halkı"
    },
    {
     "ar": [
      0,
      1,
      4
     ],
     "tr": "da gerçekten zalim idiler."
    }
   ]
  },
  {
   "ayet": 79,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Biz onlardan da intikam aldık."
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "İkisi de (Eyke ve Medyen) açık bir yol üzerindedir."
    }
   ]
  },
  {
   "ayet": 80,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Andolsun"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "Hicr halkı da"
    },
    {
     "ar": [
      4,
      1
     ],
     "tr": "peygamberleri yalanlamıştı."
    }
   ]
  },
  {
   "ayet": 81,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Biz onlara mucizelerimizi vermiştik"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "fakat onlardan yüz çevirmişlerdi."
    }
   ]
  },
  {
   "ayet": 82,
   "gruplar": [
    {
     "ar": [
      2,
      3
     ],
     "tr": "Onlar, dağlardan"
    },
    {
     "ar": [
      5
     ],
     "tr": "emniyet içinde kalacakları"
    },
    {
     "ar": [
      4,
      1,
      0
     ],
     "tr": "evler oyarlardı."
    }
   ]
  },
  {
   "ayet": 83,
   "gruplar": [
    {
     "ar": [
      2
     ],
     "tr": "Onları da sabaha çıkarlarken"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "o korkunç ses yakaladı."
    }
   ]
  },
  {
   "ayet": 84,
   "gruplar": [
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "Kazanmakta oldukları şeyler"
    },
    {
     "ar": [
      2,
      0,
      1
     ],
     "tr": "onlardan hiçbir zararı savmadı."
    }
   ]
  },
  {
   "ayet": 85,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "Biz gökleri, yeri ve ikisinin arasındakileri ancak hak ile yarattık."
    },
    {
     "ar": [
      9,
      10,
      11
     ],
     "tr": "O saat (kıyamet), mutlaka gelecektir."
    },
    {
     "ar": [
      13,
      14,
      15
     ],
     "tr": "Şimdilik onlara güzel muamele et."
    }
   ]
  },
  {
   "ayet": 86,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Şüphesiz Rabbin"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "hakkıyla yaratan pek iyi bilendir."
    }
   ]
  },
  {
   "ayet": 87,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Andolsun ki, biz sana"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "tekrarlanan yedi âyeti"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ve yüce Kur’an’ı verdik."
    }
   ]
  },
  {
   "ayet": 88,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
     ],
     "tr": "Sakın onlardan bazı sınıflara verdiğimiz dünya malına göz dikme"
    },
    {
     "ar": [
      9,
      10,
      11
     ],
     "tr": "onlardan dolayı üzülme"
    },
    {
     "ar": [
      12,
      13,
      14
     ],
     "tr": "ve müminlere alçak gönüllü ol."
    }
   ]
  },
  {
   "ayet": 89,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "De ki"
    },
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "Şüphesiz ben apaçık bir uyarıcıyım."
    }
   ]
  },
  {
   "ayet": 90,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Nitekim biz,"
    },
    {
     "ar": [
      3
     ],
     "tr": "komplo kuranlara (azabı) indirmişizdir."
    }
   ]
  },
  {
   "ayet": 91,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Onlar,"
    },
    {
     "ar": [
      2,
      3,
      1
     ],
     "tr": "Kur’an’ı tutarsız parçalar olarak nitelendirenlere gelince,"
    }
   ]
  },
  {
   "ayet": 92,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Rabbin hakkı için, mutlaka onların hepsini"
    }
   ]
  },
  {
   "ayet": 93,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "yaptıklarından dolayı sorguya çekeceğiz."
    }
   ]
  },
  {
   "ayet": 94,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Sana emrolunanı açıkça söyle"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "ve ortak koşanlardan yüz çevir!"
    }
   ]
  },
  {
   "ayet": 95,
   "gruplar": [
    {
     "ar": [
      2
     ],
     "tr": "(Seninle) alay edenlere karşı"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "biz sana yeteriz."
    }
   ]
  },
  {
   "ayet": 96,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Onlar Allah ile beraber başka bir tanrı edinenlerdir."
    },
    {
     "ar": [
      7,
      8
     ],
     "tr": "(Kimin doğru olduğunu) yakında bilecekler!"
    }
   ]
  },
  {
   "ayet": 97,
   "gruplar": [
    {
     "ar": [
      5,
      6
     ],
     "tr": "Onların söyledikleri şeyler yüzünden"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "senin canının sıkıldığını"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "andolsun biliyoruz."
    }
   ]
  },
  {
   "ayet": 98,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Sen şimdi Rabbini hamd ile tesbih et"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "ve secde edenlerden ol!"
    }
   ]
  },
  {
   "ayet": 99,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Ve sana yakîn (ölüm) gelinceye kadar"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "Rabbine ibadet et!"
    }
   ]
  }
 ]
}