{"sure":7,"ayetler":[
 {"ayet":1,"gruplar":[{"ar":[0],"tr":"Elif. Lâm. Mîm. Sâd."}]},
 {"ayet":2,"gruplar":[{"ar":[10,9,12,11,2,1,0],"tr":"(Bu), kendisiyle insanları uyarman, inananlara öğüt vermen için sana indirilen bir kitaptır."},{"ar":[3,4,5,6,7,8],"tr":"Artık bu hususta kalbinde bir şüphe olmasın."}]},
 {"ayet":3,"gruplar":[{"ar":[4,5,3,1,2,0],"tr":"Rabbinizden size indirilene (Kur’an’a) uyun."},{"ar":[6,7,8,9,10],"tr":"O’nu bırakıp da başka dostların peşlerinden gitmeyin."},{"ar":[12,13,14],"tr":"Ne kadar da az öğüt alıyorsunuz!"}]},
 {"ayet":4,"gruplar":[{"ar":[0,1,2,3],"tr":"Nice memleketler var ki biz onları helâk ettik."},{"ar":[4,5,6,7,8,9],"tr":"Azabımız onlara geceleyin yahut gündüz istirahat ederlerken geldi."}]},
 {"ayet":5,"gruplar":[{"ar":[3,4,5],"tr":"Azabımız onlara geldiğinde"},{"ar":[2],"tr":"çağırışları,"},{"ar":[9,10,11],"tr":"«Biz gerçekten zalim kişilermişiz»"},{"ar":[6,7,8],"tr":"demelerinden başka"},{"ar":[0,1],"tr":"bir şey olmadı."}]},
 {"ayet":6,"gruplar":[{"ar":[1,2,3],"tr":"Elbette kendilerine peygamber gönderilen kimseleri de,"},{"ar":[4,5,0],"tr":"gönderilen peygamberleri de mutlaka sorguya çekeceğiz!"}]},
 {"ayet":7,"gruplar":[{"ar":[1,2],"tr":"Ve onlara (olup bitenleri) tam bir bilgi ile"},{"ar":[0],"tr":"mutlaka anlatacağız."},{"ar":[4,5,6],"tr":"Biz, onlardan uzak değiliz."}]},
 {"ayet":8,"gruplar":[{"ar":[0,1,2],"tr":"O gün tartı haktır."},{"ar":[4,5,6],"tr":"Kimin (sevap) tartıları ağır gelirse,"},{"ar":[7,8,9],"tr":"işte onlar kurtuluşa erenlerdir."}]},
 {"ayet":9,"gruplar":[{"ar":[0,1,2],"tr":"Kimin de tartıları hafif gelirse,"},{"ar":[3],"tr":"işte onlar,"},{"ar":[9,10,7,8],"tr":"âyetlerimize karşı haksızlık ettiklerinden dolayı"},{"ar":[6,4,5],"tr":"kendilerini ziyana sokanlardır."}]},
 {"ayet":10,"gruplar":[{"ar":[0,1,2,3],"tr":"Doğrusu biz sizi yeryüzüne yerleştirdik"},{"ar":[4,5,6,7],"tr":"ve orada size geçim vasıtaları verdik."},{"ar":[9,10,11],"tr":"Ne kadar da az şükrediyorsunuz!"}]},
 {"ayet":11,"gruplar":[{"ar":[0,1],"tr":"Andolsun sizi yarattık,"},{"ar":[2,3],"tr":"sonra size şekil verdik,"},{"ar":[4,5,6,7,8],"tr":"sonra da meleklere, Âdem’e secde edin! diye emrettik."},{"ar":[9,10,11],"tr":"İblis’in dışındakiler secde ettiler."},{"ar":[12,13,14,15],"tr":"O secde edenlerden olmadı."}]},
 {"ayet":12,"gruplar":[{"ar":[0],"tr":"Allah buyurdu:"},{"ar":[1,2,3,4,5,6],"tr":"Ben sana emretmişken seni secde etmekten alıkoyan nedir?"},{"ar":[9,10,11],"tr":"Ben ondan daha üstünüm."},{"ar":[12,13,14],"tr":"Çünkü beni ateşten yarattın,"},{"ar":[15,16,17,8],"tr":"onu çamurdan yarattın, dedi."}]},
 {"ayet":13,"gruplar":[{"ar":[0],"tr":"Allah:"},{"ar":[1,2],"tr":"Öyle ise, «İn oradan!»"},{"ar":[3,4,5,6,7,8],"tr":"Orada büyüklük taslamak senin haddin değildir."},{"ar":[9],"tr":"Çık!"},{"ar":[10,11,12],"tr":"çünkü sen aşağılıklardansın!"}]},
 {"ayet":14,"gruplar":[{"ar":[1,2,3,4,0],"tr":"İblis: Bana, (insanların) tekrar dirilecekleri güne kadar mühlet ver, dedi."}]},
 {"ayet":15,"gruplar":[{"ar":[0,1,2,3],"tr":"Allah: Haydi, sen mühlet verilenlerdensin, buyurdu."}]},
 {"ayet":16,"gruplar":[{"ar":[0],"tr":"İblis dedi ki:"},{"ar":[1,2],"tr":"Öyle ise beni azdırmana karşılık, and içerim ki,"},{"ar":[3,4,5,6],"tr":"ben de onları saptırmak için senin doğru yolunun üstüne oturacağım."}]},
 {"ayet":17,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Sonra elbette onlara önlerinden,"},{"ar":[5,6],"tr":"arkalarından,"},{"ar":[7,8],"tr":"sağlarından,"},{"ar":[9,10],"tr":"sollarından sokulacağım"},{"ar":[12,13,14,15],"tr":"ve sen, onların çoklarını şükredenlerden bulmayacaksın!» dedi."}]},
 {"ayet":18,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah buyurdu: Haydi, yerilmiş ve kovulmuş olarak oradan çık!"},{"ar":[6,7,8],"tr":"Andolsun ki, onlardan kim sana uyarsa,"},{"ar":[9,10,11,12],"tr":"sizin hepinizi cehenneme dolduracağım!"}]},
 {"ayet":19,"gruplar":[{"ar":[0],"tr":"(Allah buyurdu ki): Ey Âdem!"},{"ar":[2,3,4,1],"tr":"Sen ve eşin cennette yerleşip"},{"ar":[5,6,7,8],"tr":"dilediğiniz yerden yeyin."},{"ar":[9,10,11,12],"tr":"Ancak şu ağaca yaklaşmayın!"},{"ar":[13,14,15],"tr":"Sonra zalimlerden olursunuz."}]},
 {"ayet":20,"gruplar":[{"ar":[2],"tr":"Derken şeytan,"},{"ar":[5,6,7,8,9],"tr":"birbirine kapalı ayıp yerlerini"},{"ar":[3,4],"tr":"kendilerine göstermek için"},{"ar":[0,1],"tr":"onlara vesvese verdi"},{"ar":[10,13,15,16],"tr":"ve: Rabbiniz size bu ağacı"},{"ar":[17,18,19,20],"tr":"sırf melek olursunuz"},{"ar":[21,22,23,24],"tr":"veya ebedî kalanlardan olursunuz diye"},{"ar":[11,12,14],"tr":"yasakladı, dedi."}]},
 {"ayet":21,"gruplar":[{"ar":[1,2,3,4],"tr":"Ve onlara: Ben gerçekten size öğüt verenlerdenim,"},{"ar":[0],"tr":"diye yemin etti."}]},
 {"ayet":22,"gruplar":[{"ar":[0,1],"tr":"Böylece onları hile ile aldattı."},{"ar":[3,4,5],"tr":"Ağacın meyvesini tattıklarında"},{"ar":[6,7,8],"tr":"ayıp yerleri kendilerine göründü."},{"ar":[9,10,11,12,13,14],"tr":"Ve cennet yapraklarından üzerlerini örtmeye başladılar."},{"ar":[17],"tr":"Rableri onlara:"},{"ar":[18,19,20,21,22],"tr":"Ben size o ağacı yasaklamadım mı"},{"ar":[23,24,25,26,27,28,29,16],"tr":"ve şeytan size apaçık bir düşmandır, demedim mi? diye nidâ etti."}]},
 {"ayet":23,"gruplar":[{"ar":[0],"tr":"(Âdem ile eşi) dediler ki:"},{"ar":[1],"tr":"Ey Rabbimiz!"},{"ar":[2,3],"tr":"Biz kendimize zulmettik."},{"ar":[4,5,6,7,8],"tr":"Eğer bizi bağışlamaz ve bize acımazsan"},{"ar":[9,10,11],"tr":"mutlaka ziyan edenlerden oluruz."}]},
 {"ayet":24,"gruplar":[{"ar":[2,3,4,1],"tr":"Allah: Birbirinize düşman olarak inin!"},{"ar":[6,7,8,9,10,11,12],"tr":"Sizin için yeryüzünde bir süreye kadar yerleşme ve faydalanma vardır,"},{"ar":[0],"tr":"buyurdu."}]},
 {"ayet":25,"gruplar":[{"ar":[1,2],"tr":"Orada yaşayacaksınız,"},{"ar":[3,4],"tr":"orada öleceksiniz"},{"ar":[5,6,0],"tr":"ve oradan (diriltilip) çıkarılacaksınız» dedi."}]},
 {"ayet":26,"gruplar":[{"ar":[0,1],"tr":"Ey Âdem oğulları!"},{"ar":[4,5,6,7],"tr":"Size ayıp yerlerinizi örtecek giysi,"},{"ar":[8,2,3],"tr":"süslenecek elbise yarattık."},{"ar":[10,11],"tr":"Takvâ elbisesi..."},{"ar":[12,13],"tr":"İşte o daha hayırlıdır."},{"ar":[15,16,17,18],"tr":"Bunlar Allah’ın âyetlerindendir."},{"ar":[19,20],"tr":"Belki düşünüp öğüt alırlar (diye onları indirdi)."}]},
 {"ayet":27,"gruplar":[{"ar":[0,1],"tr":"Ey Âdem oğulları!"},{"ar":[4,7],"tr":"Şeytan, ana-babanızı,"},{"ar":[14,13],"tr":"ayıp yerlerini kendilerine göstermek için"},{"ar":[10,11,12],"tr":"elbiselerini soyarak"},{"ar":[5,6,8,9],"tr":"cennetten çıkardığı gibi"},{"ar":[2,3],"tr":"sizi de aldatmasın."},{"ar":[16,18,19],"tr":"Çünkü o ve yandaşları,"},{"ar":[20,21,22,23],"tr":"sizin onları göremeyeceğiniz yerden"},{"ar":[17],"tr":"sizi görürler."},{"ar":[25,26,27,28,29,30,31],"tr":"Şüphesiz biz şeytanları, inanmayanların dostları kıldık."}]},
 {"ayet":28,"gruplar":[{"ar":[0,1,2],"tr":"Onlar bir kötülük yaptıkları zaman:"},{"ar":[4,5,6],"tr":"«Babalarımızı bu yolda bulduk."},{"ar":[7,8,9,3],"tr":"Allah da bize bunu emretti» derler."},{"ar":[11],"tr":"De ki:"},{"ar":[12,13,14,15,16],"tr":"Allah kötülüğü emretmez."},{"ar":[18,19,20,21,22,23],"tr":"Allah’a karşı bilmediğiniz şeyleri mi söylüyorsunuz?"}]},
 {"ayet":29,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2,3],"tr":"Rabbim adaleti emretti."},{"ar":[5,6,7,8,9],"tr":"Her secde ettiğinizde yüzlerinizi O’na çevirin"},{"ar":[10,11,12,13],"tr":"ve dini yalnız Allah’a has kılarak O’na yalvarın."},{"ar":[15,16,17],"tr":"İlkin sizi yarattığı gibi (yine O’na) döneceksiniz."}]},
 {"ayet":30,"gruplar":[{"ar":[0,1],"tr":"O, bir gurubu doğru yola iletti,"},{"ar":[2,3,4,5],"tr":"bir guruba da sapıklık müstehak oldu."},{"ar":[7,8,9,10,11,12,13],"tr":"Çünkü onlar Allah’ı bırakıp şeytanları kendilerine dost edindiler."},{"ar":[14,15,16],"tr":"Böyle iken kendilerinin doğru yolda olduklarını sanıyorlar."}]}
]}
