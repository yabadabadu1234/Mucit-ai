{"sure":9,"ayetler":[
{"ayet":26,"gruplar":[{"ar":[0],"tr":"Sonra"},{"ar":[2,4,5,6,7],"tr":"Allah, Resûl’ü ile müminler üzerine"},{"ar":[1,3],"tr":"sekînetini (sükûnet ve huzur duygusu) indirdi"},{"ar":[8,9,10,11],"tr":"sizin görmediğiniz ordular (melekler) indirdi"},{"ar":[12,13,14],"tr":"de kâfirlere azap etti"},{"ar":[16,17,18],"tr":"İşte bu, o kâfirlerin cezasıdır"}]},
{"ayet":27,"gruplar":[{"ar":[0],"tr":"Sonra"},{"ar":[2,3,4,5],"tr":"Allah, bunun ardından"},{"ar":[1,6,7,8],"tr":"yine dilediğinin tevbesini kabul eder"},{"ar":[10,11,12],"tr":"Zira Allah bağışlayan, esirgeyendir"}]},
{"ayet":28,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4,5],"tr":"Müşrikler ancak bir pisliktir"},{"ar":[6,10,11,12],"tr":"Onun için bu yıllarından sonra"},{"ar":[7,8,9],"tr":"Mescid-i Haram’a yaklaşmasınlar"},{"ar":[14,15,16],"tr":"Eğer yoksulluktan korkarsanız"},{"ar":[19,22,23],"tr":"(biliniz ki) Allah dilerse"},{"ar":[17,18,20,21],"tr":"sizi kendi lütfundan zengin edecektir"},{"ar":[25,26,27,28],"tr":"Şüphesiz Allah iyi bilendir, hikmet sahibidir"}]},
{"ayet":29,"gruplar":[{"ar":[18,19,20,21],"tr":"Kendilerine Kitap verilenlerden"},{"ar":[2,3,4,5,6,7],"tr":"Allah’a ve ahiret gününe inanmayan"},{"ar":[8,9,10,11,12,13],"tr":"Allah ve Resûlünün haram kıldığını haram saymayan"},{"ar":[14,15,16,17],"tr":"ve hak dini kendine din edinmeyen"},{"ar":[1],"tr":"kimselerle"},{"ar":[27,28],"tr":"küçülerek"},{"ar":[22,23,24,25,26],"tr":"elleriyle cizye verinceye kadar"},{"ar":[0],"tr":"savaşın"}]},
{"ayet":30,"gruplar":[{"ar":[1],"tr":"Yahudiler"},{"ar":[2,3,4],"tr":"Uzeyr Allah’ın oğludur"},{"ar":[0],"tr":"dediler"},{"ar":[6],"tr":"Hıristiyanlar da"},{"ar":[7,8,9],"tr":"Mesîh (İsa) Allah’ın oğludur"},{"ar":[5],"tr":"dediler"},{"ar":[11],"tr":"Bu"},{"ar":[12,13],"tr":"onların ağızlarıyla geveledikleri sözlerdir"},{"ar":[15,16,17,18,19,20],"tr":"(Sözlerini) daha önce kâfir olmuş kimselerin sözlerine benzetiyorlar"},{"ar":[22,23],"tr":"Allah onları kahretsin"},{"ar":[25,26],"tr":"Nasıl da (haktan bâtıla) döndürülüyorlar"}]},
{"ayet":31,"gruplar":[{"ar":[4,5,6],"tr":"(Yahudiler) Allah’ı bırakıp"},{"ar":[1],"tr":"bilginlerini (hahamlarını)"},{"ar":[2],"tr":"(hıristiyanlar) da rahiplerini"},{"ar":[7,8,9],"tr":"ve Meryem oğlu Mesîh’i (İsa’yı)"},{"ar":[0,3],"tr":"rabler edindiler"},{"ar":[10,11,12,13,14,15],"tr":"Halbuki onlara ancak tek ilâha kulluk etmeleri emrolundu"},{"ar":[17,18,19,20],"tr":"O’ndan başka tanrı yoktur"},{"ar":[22,23,24],"tr":"O, bunların ortak koştukları şeylerden uzaktır"}]},
{"ayet":32,"gruplar":[{"ar":[3,4],"tr":"Allah’ın nûrunu"},{"ar":[5],"tr":"ağızlarıyla (üfleyip)"},{"ar":[0,1,2],"tr":"söndürmek istiyorlar"},{"ar":[12,13,14],"tr":"Halbuki kâfirler hoşlanmasalar da"},{"ar":[7,9,10,11],"tr":"Allah nûrunu tamamlamaktan"},{"ar":[6,8],"tr":"asla vazgeçmez"}]},
{"ayet":33,"gruplar":[{"ar":[0],"tr":"O (Allah)"},{"ar":[11,12,13],"tr":"müşrikler hoşlanmasalar da"},{"ar":[7,8,9,10],"tr":"(kendi) dinini bütün dinlere üstün kılmak için"},{"ar":[3],"tr":"Resûlünü"},{"ar":[4,5,6],"tr":"hidayet ve Hak Din ile"},{"ar":[1,2],"tr":"gönderendir"}]},
{"ayet":34,"gruplar":[{"ar":[1,2,3],"tr":"Ey iman edenler"},{"ar":[4,5,6,7,8],"tr":"(Biliniz ki), hahamlardan ve râhiplerden birçoğu"},{"ar":[9,10,11,12],"tr":"insanların mallarını haksız yollardan yerler"},{"ar":[13,14,15,16],"tr":"ve (insanları) Allah yolundan engellerler"},{"ar":[19,20,21],"tr":"Altın ve gümüşü yığıp da"},{"ar":[18,22,23,24,25,26],"tr":"onları Allah yolunda harcamayanlar yok mu"},{"ar":[27,28,29],"tr":"işte onlara elem verici bir azabı müjdele"}]},
{"ayet":35,"gruplar":[{"ar":[1,2,3,4,5],"tr":"(Bu paralar) cehennem ateşinde kızdırılıp"},{"ar":[6,7,8,9,10,0],"tr":"bunlarla onların alınları, yanları ve sırtları dağlanacağı gün"},{"ar":[12,13,14,15],"tr":"(onlara denilir ki): «İşte bu kendiniz için biriktirdiğiniz servettir"},{"ar":[16,17,18,19],"tr":"Artık yığmakta olduğunuz şeylerin (azabını) tadın!»"}]},
{"ayet":36,"gruplar":[{"ar":[11,12,13,14],"tr":"Gökleri ve yeri yarattığı günde"},{"ar":[8,9,10],"tr":"Allah’ın yazısına göre"},{"ar":[3,4],"tr":"Allah katında"},{"ar":[0,1,2,5,6,7],"tr":"ayların sayısı on iki"},{"ar":[15,16,17],"tr":"bunlardan dördü haram aylarıdır"},{"ar":[19,20,21],"tr":"İşte bu doğru hesaptır"},{"ar":[23,24,25,26],"tr":"O aylar içinde (Allah’ın koyduğu yasağı çiğneyerek) kendinize zulmetmeyin"},{"ar":[31,32,33],"tr":"ve müşrikler nasıl sizinle topyekün savaşıyorlarsa"},{"ar":[28,29,30],"tr":"siz de onlara karşı topyekün savaşın"},{"ar":[35,36],"tr":"ve bilin ki"},{"ar":[37,38,39],"tr":"Allah (kötülükten) sakınanlarla beraberdir"}]},
{"ayet":37,"gruplar":[{"ar":[0,1],"tr":"(Haram ayları) ertelemek, sadece"},{"ar":[2,3,4],"tr":"kâfirlikte ileri gitmektir"},{"ar":[6,7,8,9],"tr":"Çünkü onunla, kâfir olanlar saptırılır"},{"ar":[14,15,16,17,18],"tr":"Allah’ın haram kıldığının sayısını bozmak"},{"ar":[19,20,21,22],"tr":"ve O’nun haram kıldığını helâl kılmak için"},{"ar":[10,11],"tr":"(haram ayını) bir yıl helâl sayarlar"},{"ar":[12,13],"tr":"bir yıl da haram sayarlar"},{"ar":[24,25,26,27],"tr":"(Böylece) onların kötü işleri kendilerine güzel gösterilmiştir"},{"ar":[29,30,31,32,33],"tr":"Allah kâfirler topluluğunu hidayete erdirmez"}]},
{"ayet":38,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4],"tr":"Size ne oldu ki"},{"ar":[5,6,7,8,9,10,11],"tr":"«Allah yolunda savaşa çıkın!» denildiği zaman"},{"ar":[12,13,14],"tr":"yere çakılıp kalıyorsunuz"},{"ar":[16,17,18,19,20],"tr":"Dünya hayatını ahirete tercih mi ediyorsunuz"},{"ar":[22,23,24,25,26,27,28,29],"tr":"Fakat dünya hayatının faydası ahiretin yanında pek azdır"}]},
{"ayet":39,"gruplar":[{"ar":[0,1],"tr":"Eğer (gerektiğinde savaşa) çıkmazsanız"},{"ar":[2,3,4],"tr":"(Allah) sizi pek elem verici bir azap ile cezalandırır"},{"ar":[5,6,7],"tr":"ve yerinize sizden başka bir kavim getirir"},{"ar":[8,9,10],"tr":"siz (savaşa çıkmamakla) O’na hiçbir zarar veremezsiniz"},{"ar":[12,13,14,15,16],"tr":"Allah her şeye kadirdir"}]},
{"ayet":40,"gruplar":[{"ar":[0,1],"tr":"Eğer siz ona (Resûlullah’a) yardım etmezseniz (bu önemli değil)"},{"ar":[2,3,4],"tr":"ona Allah yardım etmiştir"},{"ar":[5,6,7,8],"tr":"Hani, kâfirler onu"},{"ar":[9,10],"tr":"iki kişiden biri olarak (Ebu Bekir ile birlikte Mekke’den) çıkarmışlardı"},{"ar":[11,12,13,14],"tr":"hani onlar mağaradaydı"},{"ar":[15,17],"tr":"o, arkadaşına"},{"ar":[18,19,20,21,22],"tr":"Üzülme, çünkü Allah bizimle beraberdir"},{"ar":[16],"tr":"diyordu"},{"ar":[24,25,26,27],"tr":"Bunun üzerine Allah ona (sükûnet sağlayan) emniyetini indirdi"},{"ar":[28,29,30,31],"tr":"onu sizin görmediğiniz bir ordu ile destekledi"},{"ar":[32,33,34,35,36],"tr":"ve kâfir olanların sözünü alçalttı"},{"ar":[38,39,40,41],"tr":"Allah’ın sözü ise zaten yücedir"},{"ar":[43,44,45],"tr":"Çünkü Allah üstündür, hikmet sahibidir"}]},
{"ayet":41,"gruplar":[{"ar":[0,1,2],"tr":"(Ey müminler!) Gerek hafif, gerek ağır olarak savaşa çıkın"},{"ar":[3,4,5,6,7,8],"tr":"mallarınızla ve canlarınızla Allah yolunda cihad edin"},{"ar":[13,14,15],"tr":"Eğer bilirseniz"},{"ar":[10,11,12],"tr":"bu sizin için daha hayırlıdır"}]},
{"ayet":42,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Eğer yakın bir dünya malı ve kolay bir yolculuk olsaydı"},{"ar":[6],"tr":"(o münafıklar) mutlaka sana uyup peşinden gelirlerdi"},{"ar":[7,8,9,10],"tr":"Fakat meşakkatli yol onlara uzak geldi"},{"ar":[14,15,16,17],"tr":"Gerçi onlar, «Gücümüz yetseydi mutlaka sizinle beraber çıkardık»"},{"ar":[18,19],"tr":"diye kendilerini helâk edercesine"},{"ar":[12,13],"tr":"Allah’a yemin edecekler"},{"ar":[20,21,22,23],"tr":"Halbuki Allah onların mutlaka yalancı olduklarını biliyor"}]},
{"ayet":43,"gruplar":[{"ar":[0,1,2],"tr":"Allah seni affetti"},{"ar":[6,7,8,9,10],"tr":"Fakat doğru söyleyenler sana iyice belli olup"},{"ar":[11,12],"tr":"sen yalancıları bilinceye kadar"},{"ar":[3,4,5],"tr":"onlara niçin izin verdin"}]},
{"ayet":44,"gruplar":[{"ar":[2,3,4,5,6],"tr":"Allah’a ve ahiret gününe iman edenler"},{"ar":[7,8,9,10],"tr":"mallarıyla canlarıyla savaşmaktan"},{"ar":[0,1],"tr":"(geri kalmak için) senden izin istemezler"},{"ar":[12,13,14],"tr":"Allah takvâ sahiplerini pek iyi bilir"}]},
{"ayet":45,"gruplar":[{"ar":[0],"tr":"Ancak"},{"ar":[3,4,5,6,7],"tr":"Allah’a ve ahiret gününe inanmayan"},{"ar":[8,9],"tr":"kalpleri şüpheye düşüp"},{"ar":[2,10,11,12,13],"tr":"kuşkuları içinde bocalayanlar"},{"ar":[1],"tr":"senden izin isterler"}]},
{"ayet":46,"gruplar":[{"ar":[1,2,3],"tr":"Eğer onlar (savaşa) çıkmak isteselerdi"},{"ar":[4,5,6],"tr":"elbette bunun için bir hazırlık yaparlardı"},{"ar":[7,8,9,10],"tr":"Fakat Allah onların davranışlarını çirkin gördü"},{"ar":[11],"tr":"ve onları geri koydu"},{"ar":[12,13,14,15],"tr":"onlara «Oturanlarla (kadın ve çocuklarla) beraber oturun!» denildi"}]},
{"ayet":47,"gruplar":[{"ar":[0,1,2],"tr":"Eğer içinizde (onlar da savaşa) çıksalardı"},{"ar":[3,4,5,6],"tr":"size bozgunculuktan başka bir katkıları olmazdı"},{"ar":[7,8,9,10],"tr":"ve mutlaka fitne çıkarmak isteyerek aranızda koşarlardı"},{"ar":[11,12,13],"tr":"İçinizde, onlara iyice kulak verecekler de vardır"},{"ar":[15,16,17],"tr":"Allah zalimleri gayet iyi bilir"}]},
{"ayet":48,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Andolsun onlar önceden de fitne çıkarmak istemişler"},{"ar":[5,6,7],"tr":"ve sana nice işler çevirmişlerdi"},{"ar":[8,9,10],"tr":"Nihayet hak geldi"},{"ar":[14,15],"tr":"ve onlar istemedikleri halde"},{"ar":[11,12,13],"tr":"Allah’ın emri yerini buldu"}]},
{"ayet":49,"gruplar":[{"ar":[0,1],"tr":"Onlardan öylesi de var ki"},{"ar":[3,4],"tr":"«Bana izin ver"},{"ar":[2,5,6],"tr":"beni fitneye düşürme» der"},{"ar":[8,9,10,11],"tr":"Bilesiniz ki onlar zaten fitneye düşmüşlerdir"},{"ar":[13,14,15,16],"tr":"Cehennem, kâfirleri mutlaka kuşatacaktır"}]},
{"ayet":50,"gruplar":[{"ar":[0,1,2],"tr":"Eğer sana bir iyilik erişirse"},{"ar":[3],"tr":"bu onları üzer"},{"ar":[5,6,7],"tr":"Ve eğer başına bir musibet gelirse"},{"ar":[9,10,11,12,13],"tr":"«İyi ki biz daha önce tedbirimizi almışız»"},{"ar":[8],"tr":"derler"},{"ar":[14,15,16],"tr":"ve böbürlenerek dönüp giderler"}]},
{"ayet":51,"gruplar":[{"ar":[0],"tr":"De ki"},{"ar":[1,2,3,4,5,6,7],"tr":"Allah’ın bizim için yazdığından başkası bize asla erişmez"},{"ar":[8,9],"tr":"O bizim mevlâmızdır"},{"ar":[11,12,13,14],"tr":"Onun için müminler yalnız Allah’a dayanıp güvensinler"}]},
{"ayet":52,"gruplar":[{"ar":[0],"tr":"De ki"},{"ar":[1,2,3,4,5,6],"tr":"Siz bizim için ancak iki iyilikten birini beklemektesiniz"},{"ar":[8],"tr":"Biz de"},{"ar":[10,11,12,13,14,15,16,17,18],"tr":"Allah’ın, ya kendi katından veya bizim elimizle size bir azap vermesini"},{"ar":[9],"tr":"bekliyoruz"},{"ar":[20],"tr":"Haydi bekleyin"},{"ar":[21,22,23],"tr":"şüphesiz biz de sizinle beraber beklemekteyiz"}]},
{"ayet":53,"gruplar":[{"ar":[0],"tr":"De ki"},{"ar":[1,2],"tr":"İster gönüllü verin"},{"ar":[3,4],"tr":"ister gönülsüz"},{"ar":[5,6,7],"tr":"sizden (sadaka) asla kabul olunmayacaktır"},{"ar":[9,10,11,12],"tr":"Çünkü siz yoldan çıkan bir topluluk oldunuz"}]},
{"ayet":54,"gruplar":[{"ar":[1,2,3,4,5],"tr":"Onların harcamalarının kabul edilmesini engelleyen"},{"ar":[7,8,9,10],"tr":"onların Allah ve Resûlünü inkâr etmeleri"},{"ar":[11,12,13,14,15,16],"tr":"namaza ancak üşenerek gelmeleri"},{"ar":[0,6,17,18,19,20,21],"tr":"ve istemeyerek harcamalarından başka bir şey değildir"}]},
{"ayet":55,"gruplar":[{"ar":[2,3,4],"tr":"(Ey Muhammed!) Onların malları ve çocukları"},{"ar":[0,1],"tr":"seni imrendirmesin"},{"ar":[6,8,10],"tr":"Çünkü Allah bunlarla, ancak"},{"ar":[9,11,12,13],"tr":"dünya hayatında onların azaplarını çoğaltmayı"},{"ar":[14,15,16,17],"tr":"ve onların kâfir olarak canlarının çıkmasını"},{"ar":[7],"tr":"istiyor"}]}
]}
