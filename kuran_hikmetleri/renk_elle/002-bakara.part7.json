{"ayetler": [
 {"ayet":181,"gruplar":[{"ar":[0,2,3,4,1],"tr":"Her kim bunu işittikten ve kabullendikten sonra vasiyeti değiştirirse,"},{"ar":[5,6,7,8,9],"tr":"günahı onu değiştirenleredir"},{"ar":[11,12],"tr":"Şüphesiz Allah"},{"ar":[13],"tr":"(her şeyi) işitir"},{"ar":[14],"tr":"ve (her şeyi) bilir"}]},
 {"ayet":182,"gruplar":[{"ar":[0],"tr":"Her kim,"},{"ar":[2,3,4,5,6],"tr":"vasiyet edenin haksızlığa yahut günaha meyletmesinden"},{"ar":[1],"tr":"endişe eder de"},{"ar":[7,8],"tr":"(alâkalıların) aralarını bulursa"},{"ar":[9,10,11],"tr":"kendisine günah yoktur"},{"ar":[13,14,15,16],"tr":"Şüphesiz Allah çok bağışlayan hem de esirgeyendir"}]},
 {"ayet":183,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[5],"tr":"Oruç"},{"ar":[8,9,10,11,6,7],"tr":"sizden önce gelip geçmiş ümmetlere farz kılındığı gibi"},{"ar":[3,4],"tr":"size de farz kılındı"},{"ar":[12,13],"tr":"Umulur ki korunursunuz"}]},
 {"ayet":184,"gruplar":[{"ar":[0,1],"tr":"Sayılı günlerde olmak üzere (oruç size farz kılındı)"},{"ar":[3,4,5,6,7,8,9],"tr":"Sizden her kim hasta yahut yolcu olursa"},{"ar":[10,11,12,13],"tr":"(tutamadığı günler kadar) diğer günlerde kaza eder"},{"ar":[15,16,17],"tr":"(İhtiyarlık veya şifa umudu kalmamış hastalık gibi devamlı mazereti olup da) oruç tutmaya güçleri yetmeyenlere"},{"ar":[18,19,20],"tr":"bir fakiri doyuracak fidye gerekir"},{"ar":[22,23,24],"tr":"Bununla beraber kim gönüllü olarak hayır yaparsa,"},{"ar":[25,26,27],"tr":"bu kendisi için daha iyidir"},{"ar":[34,35,36],"tr":"Eğer bilirseniz"},{"ar":[29,30,31,32],"tr":"(güçlüğüne rağmen) oruç tutmanız sizin için daha hayırlıdır"}]},
 {"ayet":185,"gruplar":[{"ar":[0,1],"tr":"Ramazan ayı,"},{"ar":[6,7],"tr":"insanlara yol gösterici,"},{"ar":[8,9,10,11],"tr":"doğrunun ve doğruyu eğriden ayırmanın açık delilleri olarak"},{"ar":[5,3,2,4],"tr":"Kur’an’ın indirildiği aydır"},{"ar":[13,14,15,16],"tr":"Öyle ise sizden ramazan ayını idrak edenler"},{"ar":[17],"tr":"onda oruç tutsun"},{"ar":[19,20,21,22,23,24],"tr":"Kim o anda hasta veya yolcu olursa"},{"ar":[25,26,27,28],"tr":"(tutamadığı günler sayısınca) başka günlerde kaza etsin"},{"ar":[30,31,32,33],"tr":"Allah sizin için kolaylık ister,"},{"ar":[34,35,36,37],"tr":"zorluk istemez"},{"ar":[38,39],"tr":"Bütün bunlar, sayıyı tamamlamanız"},{"ar":[42,43,44],"tr":"ve size doğru yolu göstermesine karşılık,"},{"ar":[40,41],"tr":"Allah’ı tazim etmeniz,"},{"ar":[45,46],"tr":"şükretmeniz içindir"}]},
 {"ayet":186,"gruplar":[{"ar":[2,1,3,0],"tr":"Kullarım sana, beni sorduğunda (söyle onlara):"},{"ar":[4,5],"tr":"Ben çok yakınım"},{"ar":[10,11],"tr":"Bana dua ettiği vakit"},{"ar":[8,9,7],"tr":"dua edenin dileğine karşılık veririm"},{"ar":[13,14],"tr":"O halde (kullarım da) benim davetime uysunlar"},{"ar":[15,16],"tr":"ve bana inansınlar"},{"ar":[17,18],"tr":"ki doğru yolu bulalar"}]},
 {"ayet":187,"gruplar":[{"ar":[2,3,6,5,4,1,0],"tr":"Oruç gecesinde kadınlarınıza yaklaşmak size helâl kılındı"},{"ar":[8,9,10],"tr":"Onlar sizin için birer elbise,"},{"ar":[11,12,13],"tr":"siz de onlar için birer elbisesiniz"},{"ar":[15,16,17,18,19,20],"tr":"Allah sizin kendinize kötülük ettiğinizi bildi"},{"ar":[21,22,23,24],"tr":"ve tevbenizi kabul edip sizi bağışladı"},{"ar":[26,27],"tr":"Artık (ramazan gecelerinde) onlara yaklaşın"},{"ar":[28,29,30,31,32],"tr":"ve Allah’ın sizin için takdir ettiklerini isteyin"},{"ar":[39,40,41,42,43,44,45,36,37,38,34,35],"tr":"Sabahın beyaz ipliği (aydınlığı), siyah ipliğinden (karanlığından) ayırt edilinceye kadar yeyin, için"},{"ar":[47,48,49,50,51],"tr":"sonra akşama kadar orucu tamamlayın"},{"ar":[53,54,55,56,57,58],"tr":"Mescitlerde ibadete çekilmiş olduğunuz zamanlarda kadınlarla birleşmeyin"},{"ar":[60,61,62],"tr":"Bunlar Allah’ın koyduğu sınırlardır"},{"ar":[63,64],"tr":"Sakın bu sınırlara yaklaşmayın"},{"ar":[66,67,68,69,70],"tr":"İşte böylece Allah âyetlerini insanlara açıklar"},{"ar":[71,72],"tr":"Umulur ki korunurlar"}]},
 {"ayet":188,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Mallarınızı aranızda haksız sebeplerle yemeyin"},{"ar":[15,16],"tr":"Kendiniz bilip dururken,"},{"ar":[10,11,12,13,14,9],"tr":"insanların mallarından bir kısmını haram yollardan yemeniz için"},{"ar":[5,6,7,8],"tr":"o malları hakimlere (idarecilere veya mahkeme hakimlerine) vermeyin"}]},
 {"ayet":189,"gruplar":[{"ar":[3,2,1],"tr":"Sana, hilâl şeklinde yeni doğan ayları sorarlar"},{"ar":[5],"tr":"De ki:"},{"ar":[6,7,8,9],"tr":"Onlar, insanlar ve özellikle hac için vakit ölçüleridir"},{"ar":[11,12,13,14,15,16,17],"tr":"İyi davranış, asla evlere arkalarından gelip girmeniz değildir"},{"ar":[18,19,20,21],"tr":"Lâkin iyi davranış, korunan (ve ölçülü giden) kimsenin davranışıdır"},{"ar":[23,24,25,26],"tr":"Evlere kapılarından girin,"},{"ar":[28,29],"tr":"Allah’tan korkun,"},{"ar":[30,31],"tr":"umulur ki kurtuluşa erersiniz"}]},
 {"ayet":190,"gruplar":[{"ar":[4,5],"tr":"Size karşı savaş açanlara,"},{"ar":[1,2,3,0],"tr":"siz de Allah yolunda savaş açın"},{"ar":[6,7],"tr":"Sakın aşırı gitmeyin,"},{"ar":[9,10,11,12,13],"tr":"çünkü Allah aşırıları sevmez"}]},
 {"ayet":191,"gruplar":[{"ar":[1,2,0],"tr":"Onları (size karşı savaşanları) yakaladığınız yerde öldürün"},{"ar":[4,5,6],"tr":"Sizi çıkardıkları yerden"},{"ar":[3],"tr":"siz de onları çıkarın"},{"ar":[8,9,10,11],"tr":"Fitne, adam öldürmekten daha kötüdür"},{"ar":[15,16,17,18,19,20],"tr":"Mescid-i Haram’da onlar sizinle savaşmadıkça,"},{"ar":[13,14],"tr":"siz de onlarla savaşmayın"},{"ar":[22,23],"tr":"Eğer onlar size karşı savaş açarlarsa"},{"ar":[24],"tr":"siz de onları öldürün"},{"ar":[26,27,28],"tr":"İşte kâfirlerin cezası böyledir"}]},
 {"ayet":192,"gruplar":[{"ar":[0,1],"tr":"Eğer onlar (savaştan) vazgeçerlerse,"},{"ar":[2,3,4,5],"tr":"(şunu iyi bilin ki) Allah gafûr ve rahîmdir"}]},
 {"ayet":193,"gruplar":[{"ar":[2,3,4],"tr":"Fitne tamamen yok edilinceye"},{"ar":[5,6,7],"tr":"ve din (kulluk) de yalnız Allah için oluncaya kadar"},{"ar":[0,1],"tr":"onlarla savaşın"},{"ar":[9,10],"tr":"Şayet vazgeçerlerse"},{"ar":[13,14,15],"tr":"zalimlerden başkasına"},{"ar":[11,12],"tr":"düşmanlık ve saldırı yoktur"}]},
 {"ayet":194,"gruplar":[{"ar":[0,1,2,3],"tr":"Haram ay haram aya"},{"ar":[5],"tr":"karşılıktır"},{"ar":[4],"tr":"Hürmetler (dokunulmazlıklar) karşılıklıdır"},{"ar":[7,8,9],"tr":"Kim size saldırırsa"},{"ar":[10,11,12,13,14,15],"tr":"siz de ona misilleme olacak kadar saldırın"},{"ar":[17,18],"tr":"Allah’tan korkun"},{"ar":[19,20,21,22,23],"tr":"ve bilin ki Allah müttakîlerle beraberdir"}]},
 {"ayet":195,"gruplar":[{"ar":[1,2,3,0],"tr":"Allah yolunda harcayın"},{"ar":[4,5,6,7,8],"tr":"Kendi ellerinizle kendinizi tehlikeye atmayın"},{"ar":[10],"tr":"Yaptığınızı güzel yapın"},{"ar":[12,13,14,15],"tr":"Allah güzel yapanları sever"}]},
 {"ayet":196,"gruplar":[{"ar":[1,2,3,0],"tr":"Haccı ve umreyi Allah için tam yapın"},{"ar":[5,6],"tr":"Eğer (bunlardan) alıkonursanız"},{"ar":[7,8,9,10],"tr":"kolayınıza gelen kurbanı gönderin"},{"ar":[15,16,17,18],"tr":"Kurban, yerine varıncaya kadar"},{"ar":[12,13,14],"tr":"başlarınızı tıraş etmeyin"},{"ar":[20,21,22,23],"tr":"Sizden her kim hasta olursa"},{"ar":[24,25,26,27,28],"tr":"yahut başından bir rahatsızlığı varsa,"},{"ar":[30,31,32,33,34,35,29],"tr":"oruç veya sadaka veya kurban olmak üzere fidye gerekir"},{"ar":[37,38],"tr":"(Hac yolculuğu için) emin olduğunuz vakit"},{"ar":[39,40,41,42,43],"tr":"kim hac günlerine kadar umre ile faydalanmak isterse,"},{"ar":[44,45,46,47],"tr":"kolayına gelen bir kurban kesmek gerekir"},{"ar":[49,50,51],"tr":"Kurban kesmeyen kimse"},{"ar":[53,54,55,56],"tr":"hac günlerinde üç,"},{"ar":[57,58,59],"tr":"memleketine döndüğü zaman yedi"},{"ar":[52],"tr":"olmak üzere oruç tutar ki,"},{"ar":[61,62,63],"tr":"hepsi tam on gündür"},{"ar":[65,66,67,68,69,70,71,72],"tr":"Bu söylenenler, ailesi Mescid-i Haram civarında oturmayanlar içindir"},{"ar":[74,75],"tr":"Allah’tan korkun"},{"ar":[76,77,78,79,80],"tr":"Biliniz ki Allah’ın vereceği ceza ağırdır"}]},
 {"ayet":197,"gruplar":[{"ar":[0,1,2],"tr":"Hac, bilinen aylardadır"},{"ar":[4,5,6,7],"tr":"Kim o aylarda hacca niyet ederse (ihramını giyerse),"},{"ar":[14,15,8,9],"tr":"hac esnasında kadına yaklaşmak,"},{"ar":[10,11],"tr":"günah sayılan davranışlara yönelmek,"},{"ar":[12,13],"tr":"kavga etmek yoktur"},{"ar":[17,18,19,20,21,22],"tr":"Ne hayır işlerseniz Allah onu bilir"},{"ar":[24],"tr":"(Ey müminler! Ahiret için) azık edinin"},{"ar":[25,26,27,28],"tr":"Bilin ki azığın en hayırlısı takvâdır"},{"ar":[31,32],"tr":"Ey akıl sahipleri!"},{"ar":[30],"tr":"Benden (emirlerime muhalefetten) sakının"}]},
 {"ayet":198,"gruplar":[{"ar":[6,7,5,4],"tr":"(Hac mevsiminde ticaret yaparak) Rabbinizden gelecek bir lütfu (kazancı) aramanızda"},{"ar":[0,1,2],"tr":"size herhangi bir günah yoktur"},{"ar":[9,10,11,12],"tr":"Arafat’tan ayrılıp akın ettiğinizde"},{"ar":[15,16,17,13,14],"tr":"Meş’ar-i Haram’da Allah’ı zikredin"},{"ar":[19,20,21],"tr":"ve O’nu size gösterdiği şekilde anın"},{"ar":[22,23,24,25,26,27],"tr":"Şüphesiz siz daha önce yanlış gidenlerden idiniz"}]},
 {"ayet":199,"gruplar":[{"ar":[0],"tr":"Sonra"},{"ar":[5,4,3,2],"tr":"insanların (sel gibi) aktığı yerden"},{"ar":[1],"tr":"siz de akın"},{"ar":[6,7],"tr":"Allah’tan mağfiret isteyin"},{"ar":[9,10,11,12],"tr":"Çünkü Allah affedici ve esirgeyicidir"}]},
 {"ayet":200,"gruplar":[{"ar":[0,1,2],"tr":"Hac ibadetlerinizi bitirince,"},{"ar":[5,6],"tr":"babalarınızı andığınız gibi,"},{"ar":[7,8,9],"tr":"hatta ondan daha kuvvetli bir şekilde"},{"ar":[3,4],"tr":"Allah’ı anın"},{"ar":[11,12,13],"tr":"İnsanlardan öyleleri var ki:"},{"ar":[15],"tr":"Ey Rabbimiz!"},{"ar":[16,17,18],"tr":"Bize dünyada ver,"},{"ar":[14],"tr":"derler"},{"ar":[19,20,21,22,23,24],"tr":"Böyle kimselerin ahiretten hiç nasibi yoktur"}]},
 {"ayet":201,"gruplar":[{"ar":[0,1],"tr":"Onlardan bir kısmı da:"},{"ar":[3],"tr":"Ey Rabbimiz!"},{"ar":[4,5,6,7],"tr":"Bize dünyada da iyilik ver,"},{"ar":[8,9,10],"tr":"ahirette de iyilik ver"},{"ar":[11,12,13],"tr":"Bizi cehennem azabından koru!"},{"ar":[2],"tr":"derler"}]},
 {"ayet":202,"gruplar":[{"ar":[0,1],"tr":"İşte onlar için,"},{"ar":[3,4,2],"tr":"kazandıklarından büyük bir nasip vardır"},{"ar":[6,7,8],"tr":"(Şüphesiz) Allah’ın hesabı çok süratlidir"}]},
 {"ayet":203,"gruplar":[{"ar":[3,4,5,1,2],"tr":"Sayılı günlerde (eyyam-ı teşrikte telbiye ve tekbir getirerek) Allah’ı anın"},{"ar":[7,8,9,10],"tr":"Kim iki gün içinde acele edip (Mina’dan Mekke’ye) dönmek isterse,"},{"ar":[11,12,13],"tr":"ona günah yoktur"},{"ar":[14,15],"tr":"Kim geri kalırsa"},{"ar":[16,17,18],"tr":"ona da günah yoktur"},{"ar":[20,21],"tr":"Bunlar günahtan sakınanlar içindir"},{"ar":[23,24],"tr":"Allah’tan korkun"},{"ar":[25,26,27,28],"tr":"ve bilin ki hepiniz O’nun huzurunda toplanacaksınız"}]},
 {"ayet":204,"gruplar":[{"ar":[0,1,2],"tr":"İnsanlardan öyleleri vardır ki,"},{"ar":[5,6,7,4],"tr":"dünya hayatı hakkında söyledikleri"},{"ar":[3],"tr":"senin hoşuna gider"},{"ar":[8,9,10,11,12,13],"tr":"Hatta böylesi kalbinde olana (samimi olduğuna) Allah’ı şahit tutar"},{"ar":[14,15,16],"tr":"Halbuki o, hasımların en yamanıdır"}]},
 {"ayet":205,"gruplar":[{"ar":[0,1],"tr":"O, dönüp gitti mi (yahut bir iş başına geçti mi)"},{"ar":[3,4,5,6],"tr":"yeryüzünde ortalığı fesada vermek,"},{"ar":[7,8,9],"tr":"ekinleri tahrip edip nesilleri bozmak için"},{"ar":[2],"tr":"çalışır"},{"ar":[11,12,13,14],"tr":"Allah bozgunculuğu sevmez"}]},
 {"ayet":206,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Böylesine «Allah’tan kork!» denilince"},{"ar":[5,6,7],"tr":"benlik ve gurur kendisini günaha sevkeder"},{"ar":[9,10],"tr":"(Ceza ve azap olarak) ona cehennem yeter"},{"ar":[12,13],"tr":"O ne kötü yerdir!"}]},
 {"ayet":207,"gruplar":[{"ar":[0,1,2],"tr":"İnsanlardan öyleleri de var ki,"},{"ar":[5,6,7],"tr":"Allah’ın rızasını almak için"},{"ar":[3,4],"tr":"kendini feda eder"},{"ar":[9,10,11],"tr":"Allah da kullarına şefkatlidir"}]},
 {"ayet":208,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[6,3,4,5],"tr":"Hep birden barışa girin"},{"ar":[7,8,9,10],"tr":"Sakın şeytanın peşinden gitmeyin"},{"ar":[12,13,14,15],"tr":"Çünkü o, apaçık düşmanınızdır"}]},
 {"ayet":209,"gruplar":[{"ar":[5,6,2,3,4],"tr":"Size apaçık deliller geldikten sonra,"},{"ar":[0,1],"tr":"yine de kayarsanız,"},{"ar":[7,8,9,10,11],"tr":"şunu iyi bilin ki Allah azîzdir, hakîmdir"}]},
 {"ayet":210,"gruplar":[{"ar":[0,2,3],"tr":"Onlar, ille de"},{"ar":[6,7,8,9],"tr":"buluttan gölgeler içinde"},{"ar":[5,10],"tr":"Allah’ın ve meleklerinin"},{"ar":[4],"tr":"gelmesini"},{"ar":[1],"tr":"mi beklerler?"},{"ar":[11,12],"tr":"Halbuki iş bitirilmiştir. (Allah nizamı artık değişmez.)"},{"ar":[14,15,16,17],"tr":"Bütün işler yalnızca Allah’a döndürülür"}]}
