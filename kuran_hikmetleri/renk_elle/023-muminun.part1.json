{"sure": 23, "ayetler": [{"ayet": 1, "gruplar": [{"ar": [2], "tr": "Gerçekten müminler"}, {"ar": [0, 1], "tr": "kurtuluşa ermiştir;"}]}, {"ayet": 2, "gruplar": [{"ar": [0, 1], "tr": "Onlar ki,"}, {"ar": [2, 3, 4], "tr": "namazlarında huşû içindedirler;"}]}, {"ayet": 3, "gruplar": [{"ar": [0, 1], "tr": "Onlar ki,"}, {"ar": [2, 3, 4], "tr": "boş ve yararsız şeylerden yüz çevirirler;"}]}, {"ayet": 4, "gruplar": [{"ar": [0, 1], "tr": "Onlar ki,"}, {"ar": [2, 3], "tr": "zekâtı verirler;"}]}, {"ayet": 5, "gruplar": [{"ar": [0, 1], "tr": "Ve onlar ki,"}, {"ar": [2, 3], "tr": "iffetlerini korurlar;"}]}, {"ayet": 6, "gruplar": [{"ar": [0, 1, 2], "tr": "Ancak eşleri"}, {"ar": [3, 4, 5, 6], "tr": "ve ellerinin sahip olduğu (câriyeleri) hariç."}, {"ar": [7, 8, 9], "tr": "(Bunlarla ilişkilerden dolayı) kınanmış değillerdir."}]}, {"ayet": 7, "gruplar": [{"ar": [0, 1], "tr": "Şu halde, kim"}, {"ar": [2, 3], "tr": "bunun ötesine gitmek isterse,"}, {"ar": [4, 5, 6], "tr": "işte bunlar, haddi aşan kimselerdir."}]}, {"ayet": 8, "gruplar": [{"ar": [0, 1], "tr": "Yine onlar (o müminler) ki,"}, {"ar": [2, 3, 4], "tr": "emanetlerine ve ahidlerine riayet ederler;"}]}, {"ayet": 9, "gruplar": [{"ar": [0, 1], "tr": "Ve onlar ki,"}, {"ar": [2, 3, 4], "tr": "namazlarına devam ederler."}]}, {"ayet": 10, "gruplar": [{"ar": [0, 1, 2], "tr": "İşte, asıl bunlar vâris olacaklardır;"}]}, {"ayet": 11, "gruplar": [{"ar": [1, 2], "tr": "(Evet) Firdevs’e vâris olan"}, {"ar": [0], "tr": "bu kimseler,"}, {"ar": [3, 4, 5], "tr": "orada ebedî kalıcıdırlar."}]}, {"ayet": 12, "gruplar": [{"ar": [0, 1, 2], "tr": "Andolsun biz insanı,"}, {"ar": [5, 6, 3, 4], "tr": "çamurdan (süzülüp çıkarılmış) bir özden yarattık."}]}, {"ayet": 13, "gruplar": [{"ar": [0, 1, 2], "tr": "Sonra onu"}, {"ar": [3, 4, 5], "tr": "sağlam bir karargâhta nutfe haline getirdik."}]}, {"ayet": 14, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Sonra nutfeyi alaka (aşılanmış yumurta) yaptık."}, {"ar": [4, 5, 6], "tr": "Peşinden, alakayı, bir parçacık et haline soktuk;"}, {"ar": [7, 8, 9], "tr": "bu bir parçacık eti kemiklere (iskelete) çevirdik;"}, {"ar": [10, 11, 12], "tr": "bu kemikleri etle kapladık."}, {"ar": [13, 14, 15, 16], "tr": "Sonra onu başka bir yaratışla insan haline getirdik."}, {"ar": [20, 21, 19, 18], "tr": "Yapıp-yaratanların en güzeli olan Allah pek yücedir."}]}, {"ayet": 15, "gruplar": [{"ar": [0, 1], "tr": "Sonra, muhakkak ki siz,"}, {"ar": [2, 3, 4], "tr": "bunun ardından elbet öleceksiniz."}]}, {"ayet": 16, "gruplar": [{"ar": [0, 1], "tr": "Sonra da şüphesiz, sizler"}, {"ar": [2, 3, 4], "tr": "kıyamet gününde tekrar diriltileceksiniz."}]}, {"ayet": 17, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Andolsun biz, sizin üstünüzde yedi yol yarattık."}, {"ar": [5, 6, 7, 8, 9], "tr": "Biz yaratmaktan habersiz değiliz."}]}, {"ayet": 18, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Gökten uygun bir ölçüde yağmur indirip"}, {"ar": [5, 6, 7], "tr": "onu arzda durdurduk."}, {"ar": [9, 10, 11, 12, 13], "tr": "Bizim onu gidermeye de elbet gücümüz yeter."}]}, {"ayet": 19, "gruplar": [{"ar": [0, 1, 2], "tr": "Böylece onun (yağmurun) sayesinde sizin yararınıza"}, {"ar": [3, 4, 5, 6], "tr": "hurma bahçeleri ve üzüm bağları meydana getirdik."}, {"ar": [7, 8, 9, 10], "tr": "Bunlarda sizin için birçok meyveler vardır"}, {"ar": [11, 12], "tr": "ve siz onlardan yersiniz."}]}, {"ayet": 20, "gruplar": [{"ar": [2, 3, 4, 5, 0, 1], "tr": "Tûr-i Sînâ’da da yetişen bir ağaç daha meydana getirdik"}, {"ar": [6, 7, 8], "tr": "ki, bu ağaç hem yağ hem de yiyenlerin ekmeğine katık edecekleri (zeytin) verir."}]}, {"ayet": 21, "gruplar": [{"ar": [3, 1, 2, 0, 4], "tr": "Hayvanlarda sizin için elbette ibretler vardır."}, {"ar": [7, 8, 9, 6], "tr": "Onların karınlarındakinden (sütlerinden) size içiririz."}, {"ar": [10, 11, 12, 13], "tr": "Onlarda sizin için birçok faydalar daha vardır;"}, {"ar": [14, 15], "tr": "etlerinden de yersiniz."}]}, {"ayet": 22, "gruplar": [{"ar": [0, 1, 2], "tr": "Onların üzerinde ve gemilerde"}, {"ar": [3], "tr": "taşınırsınız."}]}, {"ayet": 23, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Andolsun ki, Nuh’u kavmine gönderdik"}, {"ar": [5], "tr": "ve o:"}, {"ar": [6, 7, 8], "tr": "Ey kavmim! Allah’a kulluk edin."}, {"ar": [9, 10, 11, 12, 13], "tr": "Sizin için O’ndan başka bir tanrı yoktur."}, {"ar": [15, 16], "tr": "Hâla sakınmaz mısınız? dedi."}]}, {"ayet": 24, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Bunun üzerine, kavminin inkarcı ileri gelenleri şöyle dediler:"}, {"ar": [6, 7, 8, 9, 10], "tr": "«Bu, sadece sizin gibi bir beşerdir."}, {"ar": [11, 12, 13, 14], "tr": "Size üstün ve hâkim olmak istiyor."}, {"ar": [15, 16, 17, 18, 19], "tr": "Eğer Allah (peygamber göndermek) isteseydi, muhakkak ki melekler gönderirdi."}, {"ar": [20, 21, 22, 23, 24, 25], "tr": "Biz geçmişteki atalarımızdan böyle bir şey duymadık.»"}]}, {"ayet": 25, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "«Bu, yalnızca kendisinde delilik bulunan bir kimsedir."}, {"ar": [6, 7, 8, 9], "tr": "Öyle ise, bir süreye kadar ona katlanıp bekleyin bakalım.»"}]}, {"ayet": 26, "gruplar": [{"ar": [0, 1], "tr": "(Nuh), Rabbim! dedi,"}, {"ar": [2, 3, 4], "tr": "beni yalanlamalarına karşı bana yardım et!"}]}, {"ayet": 27, "gruplar": [{"ar": [0, 1, 2], "tr": "Bunun üzerine ona şöyle vahyettik:"}, {"ar": [5, 6, 3, 4], "tr": "Gözlerimizin önünde (muhafazamız altında) ve bildirdiğimiz şekilde gemiyi yap."}, {"ar": [7, 8, 9, 10, 11], "tr": "Bizim emrimiz gelip de sular coşup yükselmeye başlayınca"}, {"ar": [13, 14, 15, 16, 17, 18], "tr": "her cinsten birer çift ile,"}, {"ar": [20, 21, 22, 23, 24, 25, 19], "tr": "daha önce kendisi aleyhinde hüküm verilmiş olanların dışındaki aileni gemiye al."}, {"ar": [27, 28, 29, 30, 31], "tr": "Zulmetmiş olanlar konusunda bana hiç yalvarma!"}, {"ar": [33, 34], "tr": "Zira onlar kesinlikle boğulacaklardır."}]}, {"ayet": 28, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Sen, yanındakilerle birlikte gemiye yerleştiğinde:"}, {"ar": [8, 9, 10, 11, 12, 13, 14], "tr": "«Bizi zalimler topluluğundan kurtaran Allah’a hamdolsun»"}, {"ar": [7], "tr": "de."}]}, {"ayet": 29, "gruplar": [{"ar": [0, 1], "tr": "Ve de ki: Rabbim!"}, {"ar": [2, 3, 4], "tr": "Beni bereketli bir yere indir."}, {"ar": [5, 6, 7], "tr": "Sen, iskân edenlerin en hayırlısısın."}]}, {"ayet": 30, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Şüphesiz bunda (Nuh ve kavminin başından geçenlerde) birtakım ibretler vardır."}, {"ar": [4, 5, 6], "tr": "Hakikaten biz (kullarımızı böyle) deneriz."}]}, {"ayet": 31, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Sonra onların ardından"}, {"ar": [4, 5], "tr": "bir başka nesil meydana getirdik."}]}, {"ayet": 32, "gruplar": [{"ar": [3, 1], "tr": "Onlar arasından kendilerine:"}, {"ar": [5, 6], "tr": "«Allah’a kulluk edin."}, {"ar": [7, 8, 9, 10, 11], "tr": "Sizin O’ndan başka bir tanrınız yoktur."}, {"ar": [13, 14], "tr": "Hâla Allah’tan korkmaz mısınız?»"}, {"ar": [0, 2], "tr": "(mesajını ileten) bir peygamber gönderdik."}]}, {"ayet": 33, "gruplar": [{"ar": [2, 3, 1, 0], "tr": "Onun kavminden,"}, {"ar": [4, 5, 6, 7, 8], "tr": "kâfir olup ahirete ulaşmayı inkâr eden"}, {"ar": [9, 10, 11, 12], "tr": "ve dünya hayatında kendilerine refah verdiğimiz varlıklı kişiler:"}, {"ar": [13, 14, 15, 16, 17], "tr": "«Bu, dediler, sadece sizin gibi bir insandır;"}, {"ar": [18, 19, 20, 21], "tr": "sizin yediğinizden yer,"}, {"ar": [22, 23, 24], "tr": "sizin içtiğinizden içer.»"}]}, {"ayet": 34, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "«Gerçekten, sizin gibi bir beşere itaat ederseniz,"}, {"ar": [4, 5, 6], "tr": "herhalde ziyan edersiniz.»"}]}, {"ayet": 35, "gruplar": [{"ar": [0, 1], "tr": "«Size,"}, {"ar": [2, 3, 4, 5, 6], "tr": "öldüğünüz, toprak ve kemik yığını haline geldiğinizde,"}, {"ar": [7, 8], "tr": "mutlak surette sizin (kabirden) çıkarılacağınızı mı vâdediyor?»"}]}, {"ayet": 36, "gruplar": [{"ar": [3, 4], "tr": "«Bu size vaâdedilen"}, {"ar": [1, 2], "tr": "(öldükten sonra yeniden dirilmek, gerçek olmaktan) çok uzak!»"}]}, {"ayet": 37, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "«Hayat, şu dünya hayatımızdan ibarettir."}, {"ar": [5, 6], "tr": "(Kimimiz) ölürüz, (kimimiz) yaşarız;"}, {"ar": [7, 8, 9], "tr": "bir daha diriltilecek de değiliz.»"}]}, {"ayet": 38, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6, 7], "tr": "«O, Allah hakkında yalnızca yalan uyduran bir adamdır;"}, {"ar": [8, 9, 10, 11], "tr": "biz ona inanmıyoruz.»"}]}, {"ayet": 39, "gruplar": [{"ar": [0], "tr": "O peygamber:"}, {"ar": [1], "tr": "Rabbim! dedi,"}, {"ar": [2, 3, 4], "tr": "beni yalanlamalarına karşılık bana yardımcı ol!"}]}, {"ayet": 40, "gruplar": [{"ar": [0], "tr": "Allah şöyle buyurdu:"}, {"ar": [1, 2, 3, 4], "tr": "Pek yakında onlar mutlaka pişman olacaklar!"}]}, {"ayet": 41, "gruplar": [{"ar": [2, 0, 1], "tr": "Nitekim, vukuu kaçınılmaz olan korkunç bir ses yakalayıverdi onları!"}, {"ar": [3, 4], "tr": "Kendilerini hemen sel süprüntüsüne çevirdik."}, {"ar": [6, 7, 8], "tr": "Zalimler topluluğunun canı cehenneme!"}]}, {"ayet": 42, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Sonra onların ardından"}, {"ar": [4, 5], "tr": "başka nesiller getirdik."}]}, {"ayet": 43, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Hiçbir ümmet, ecelini ne öne alabilir,"}, {"ar": [5, 6], "tr": "ne de erteleyebilir."}]}, {"ayet": 44, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Sonra biz peyderpey peygamberlerimizi gönderdik."}, {"ar": [5, 6, 7, 8, 9], "tr": "Herhangi bir ümmete peygamberlerinin geldiği her defasında,"}, {"ar": [10], "tr": "onlar bu peygamberi yalanladılar;"}, {"ar": [12, 13, 14], "tr": "biz de onları birbiri ardından yok ettik"}, {"ar": [15, 16], "tr": "ve onları ibret hikâyelerine dönüştürdük."}, {"ar": [18, 19, 20, 21], "tr": "Artık iman etmeyen kavmin canı cehenneme!"}]}, {"ayet": 45, "gruplar": [{"ar": [0], "tr": "Sonra"}, {"ar": [5], "tr": "âyetlerimizle"}, {"ar": [6, 7], "tr": "ve apaçık bir fermanla"}, {"ar": [2, 3, 4], "tr": "Musa ve kardeşi Harun’u"}, {"ar": [1], "tr": "Firavun’a ve ileri gelenlerine gönderdik."}]}, {"ayet": 46, "gruplar": [{"ar": [0, 1, 2], "tr": "Firavun’a ve ileri gelenlerine"}, {"ar": [3], "tr": "Onlar ise kibire kapıldılar"}, {"ar": [4, 5, 6], "tr": "ve ululuk taslayan bir kavim oldular."}]}, {"ayet": 47, "gruplar": [{"ar": [0], "tr": "Bu yüzden dediler ki:"}, {"ar": [4, 5, 6], "tr": "Kavimleri bize kölelik ederken,"}, {"ar": [1, 2, 3], "tr": "bizim gibi olan bu iki adama inanır mıyız?"}]}, {"ayet": 48, "gruplar": [{"ar": [0], "tr": "Böylece onları yalanladılar"}, {"ar": [1, 2, 3], "tr": "ve bu sebeple helâk edilenlerden oldular."}]}, {"ayet": 49, "gruplar": [{"ar": [0, 1, 2], "tr": "Andolsun biz Musa’ya,"}, {"ar": [4, 5], "tr": "belki onlar yola gelirler diye,"}, {"ar": [3], "tr": "Kitab’ı verdik."}]}, {"ayet": 50, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Meryem oğlunu ve annesini de (kudretimize) bir alâmet kıldık;"}, {"ar": [5, 6, 7, 8, 9, 10], "tr": "onları, yerleşmeye elverişli, suyu bulunan bir tepeye yerleştirdik."}]}, {"ayet": 51, "gruplar": [{"ar": [0, 1], "tr": "«Ey Peygamberler!"}, {"ar": [2, 3, 4], "tr": "Temiz olan şeylerden yeyin;"}, {"ar": [5, 6], "tr": "güzel işler yapın."}, {"ar": [8, 9, 10, 11], "tr": "Ben sizin yaptıklarınızı hakkıyle bilmekteyim.»"}]}, {"ayet": 52, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Şüphesiz bu (insanlar) bir tek ümmet olarak sizin ümmetinizdir;"}, {"ar": [5, 6], "tr": "ben de sizin Rabbinizim."}, {"ar": [7], "tr": "Öyle ise benden sakının» (denildi)."}]}, {"ayet": 53, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Ne var ki insanlar kendi aralarındaki işlerini parça parça böldüler."}, {"ar": [5, 6, 7, 8, 9], "tr": "Her gurup kendilerinde bulunan (fikir ve davranış) ile sevinip böbürlenmektedirler."}]}, {"ayet": 54, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Şimdi sen onları bir zamana kadar gaflet ve sapıklıkları ile başbaşa bırak!"}]}, {"ayet": 55, "gruplar": [{"ar": [0, 1], "tr": "Sanıyorlar mı ki,"}, {"ar": [2, 3, 4, 5, 6], "tr": "onlara verdiğimiz servet ve oğullar ile"}]}, {"ayet": 56, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "kendilerine faydalar sağlamak için can atıyoruz?"}, {"ar": [5], "tr": "Hayır,"}, {"ar": [6, 7], "tr": "onlar işin farkına varamıyorlar."}]}, {"ayet": 57, "gruplar": [{"ar": [0, 1, 2], "tr": "Rablerine olan saygıdan dolayı"}, {"ar": [3, 4, 5, 6], "tr": "kötülükten sakınanlar;"}]}, {"ayet": 58, "gruplar": [{"ar": [0, 1], "tr": "Rablerinin âyetlerine"}, {"ar": [2, 3, 4], "tr": "inananlar;"}]}, {"ayet": 59, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Rablerine ortak tanımayanlar;"}]}, {"ayet": 60, "gruplar": [{"ar": [6, 7, 8, 9], "tr": "Ve Rablerine dönecekleri için"}, {"ar": [0, 1, 2, 3], "tr": "yapmakta oldukları işleri"}, {"ar": [4, 5], "tr": "kalpleri çarparak yapanlar;"}]}]}