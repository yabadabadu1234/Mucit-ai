     "tr": "İçinde kendinize ait eşyanın bulunduğu oturulmayan evlere girmenizde herhangi bir sakınca yoktur."
    },
    {
     "ar": [
      12,
      13,
      14,
      15,
      16,
      17
     ],
     "tr": "Allah, sizin açığa vurduklarınızı da, gizlediklerinizi de bilir."
    }
   ]
  },
  {
   "ayet": 30,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "(Resûlüm!) Mümin erkeklere,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "gözlerini (harama) dikmemelerini,"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ırzlarını da korumalarını söyle."
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "Çünkü bu, kendileri için daha temiz bir davranıştır."
    },
    {
     "ar": [
      12,
      13,
      14,
      15,
      16
     ],
     "tr": "Şüphesiz Allah, onların yapmakta olduklarından haberdardır."
    }
   ]
  },
  {
   "ayet": 31,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Mümin kadınlara da söyle:"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Gözlerini (harama bakmaktan) korusunlar;"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "namus ve iffetlerini esirgesinler."
    },
    {
     "ar": [
      10,
      11,
      12,
      13
     ],
     "tr": "Görünen kısımları müstesna olmak üzere,"
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "zinetlerini teşhir etmesinler."
    },
    {
     "ar": [
      15,
      16,
      17,
      18
     ],
     "tr": "Baş örtülerini, yakalarının üzerine (kadar) örtsünler."
    },
    {
     "ar": [
      24
     ],
     "tr": "Kocaları,"
    },
    {
     "ar": [
      26
     ],
     "tr": "babaları,"
    },
    {
     "ar": [
      28,
      29
     ],
     "tr": "kocalarının babaları,"
    },
    {
     "ar": [
      31
     ],
     "tr": "kendi oğulları,"
    },
    {
     "ar": [
      33,
      34
     ],
     "tr": "kocalarının oğulları,"
    },
    {
     "ar": [
      36
     ],
     "tr": "erkek kardeşleri,"
    },
    {
     "ar": [
      38,
      39
     ],
     "tr": "erkek kardeşlerinin oğulları,"
    },
    {
     "ar": [
      41,
      42
     ],
     "tr": "kız kardeşlerinin oğulları,"
    },
    {
     "ar": [
      44
     ],
     "tr": "kendi kadınları (mümin kadınlar),"
    },
    {
     "ar": [
      46,
      47,
      48
     ],
     "tr": "ellerinin altında bulunanlar (köleleri),"
    },
    {
     "ar": [
      49,
      50,
      51,
      52,
      53,
      54,
      55
     ],
     "tr": "erkeklerden, ailenin kadınına şehvet duymayan hizmetçi vb. tâbi kimseler,"
    },
    {
     "ar": [
      56,
      57,
      58,
      59,
      60,
      61,
      62,
      63
     ],
     "tr": "yahut henüz kadınların gizli kadınlık hususiyetlerinin farkında olmayan çocuklardan"
    },
    {
     "ar": [
      20,
      21,
      22,
      23
     ],
     "tr": "başkasına zinetlerini göstermesinler."
    },
    {
     "ar": [
      65,
      66,
      67,
      68,
      69,
      70,
      71,
      72
     ],
     "tr": "Gizlemekte oldukları zinetleri anlaşılsın diye ayaklarını yere vurmasınlar"
    },
    {
     "ar": [
      74,
      75,
      76,
      77,
      78,
      79
     ],
     "tr": "Ey müminler! Hep birden Allah’a tevbe ediniz"
    },
    {
     "ar": [
      80,
      81
     ],
     "tr": "ki kurtuluşa eresiniz."
    }
   ]
  },
  {
   "ayet": 32,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Aranızdaki bekârları,"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "kölelerinizden ve cariyelerinizden elverişli olanları evlendirin."
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "Eğer bunlar fakir iseler,"
    },
    {
     "ar": [
      11,
      12,
      13,
      14
     ],
     "tr": "Allah kendi lütfu ile onları zenginleştirir."
    },
    {
     "ar": [
      16,
      17,
      18
     ],
     "tr": "Allah, (lütfu) geniş olan ve (her şeyi) bilendir."
    }
   ]
  },
  {
   "ayet": 33,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      4,
      1
     ],
     "tr": "Evlenme imkânını bulamayanlar ise,"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "Allah, lütfu ile kendilerini varlıklı kılıncaya kadar"
    },
    {
     "ar": [
      0
     ],
     "tr": "iffetlerini korusunlar."
    },
    {
     "ar": [
      14,
      15,
      16,
      11,
      12,
      13
     ],
     "tr": "Ellerinizin altında bulunanlardan (köleler ve câriyelerden) mükâtebe yapmak isteyenlerle,"
    },
    {
     "ar": [
      18,
      19,
      20,
      21
     ],
     "tr": "eğer kendilerinde bir hayır (kabiliyet ve güvenilirlik) görüyorsanız,"
    },
    {
     "ar": [
      17
     ],
     "tr": "hemen mükâtebe yapın."
    },
    {
     "ar": [
      23,
      24,
      25,
      26,
      27,
      28
     ],
     "tr": "Allah’ın size vermiş olduğu malından siz de onlara verin."
    },
    {
     "ar": [
      30,
      31,
      32,
      33,
      34
     ],
     "tr": "Dünya hayatının geçici menfaatlerini elde edeceksiniz diye,"
    },
    {
     "ar": [
      35,
      36,
      37
     ],
     "tr": "namuslu kalmak isteyen câriyelerinizi fuhşa zorlamayın."
    },
    {
     "ar": [
      43,
      44,
      45,
      46,
      47,
      48,
      49
     ],
     "tr": "Kim onları zor altında bırakırsa, bilinmelidir ki zorlanmalarından sonra Allah"
    },
    {
     "ar": [
      50,
      51
     ],
     "tr": "(onlar için) çok bağışlayıcı ve merhametlidir."
    }
   ]
  },
  {
   "ayet": 34,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Andolsun ki biz size (gerekeni) açık açık bildiren âyetler,"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "sizden önce yaşayıp gitmiş olanlardan örnekler"
    },
    {
     "ar": [
      11,
      12
     ],
     "tr": "ve takvâya ulaşmış kimseler için öğütler indirdik."
    }
   ]
  },
  {
   "ayet": 35,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "Allah, göklerin ve yerin nûrudur."
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "O’nun nûrunun temsili,"
    },
    {
     "ar": [
      9,
      10,
      8
     ],
     "tr": "içinde lamba bulunan bir kandillik gibidir."
    },
    {
     "ar": [
      12,
      13,
      14
     ],
     "tr": "O lamba kristal bir fanus içindedir;"
    },
    {
     "ar": [
      16,
      17,
      18,
      19
     ],
     "tr": "o fanus da sanki inciye benzer bir yıldız gibidir ki,"
    },
    {
     "ar": [
      25,
      26,
      27,
      28
     ],
     "tr": "doğuya da, batıya da nisbet edilemeyen"
    },
    {
     "ar": [
      22,
      23,
      24,
      21,
      20
     ],
     "tr": "mübarek bir ağaçtan, yani zeytinden (çıkan yağdan) tutuşturulur."
    },
    {
     "ar": [
      30,
      29,
      31,
      32,
      33,
      34,
      35
     ],
     "tr": "Onun yağı, neredeyse, kendisine ateş değmese dahi ışık verir."
    },
    {
     "ar": [
      37,
      38,
      39
     ],
     "tr": "(Bu,) nûr üstüne nûrdur."
    },
    {
     "ar": [
      41,
      42,
      43,
      44,
      45
     ],
     "tr": "Allah dilediği kimseyi nûruna eriştirir."
    },
    {
     "ar": [
      47,
      48,
      49,
      50
     ],
     "tr": "Allah insanlara (işte böyle) temsiller getirir."
    },
    {
     "ar": [
      52,
      53,
      54,
      55
     ],
     "tr": "Allah her şeyi bilir."
    }
   ]
  },
  {
   "ayet": 36,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "(Bu kandil) birtakım evlerdedir ki,"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6,
      7,
      8
     ],
     "tr": "Allah (o evlerin) yücelmesine ve içlerinde isminin anılmasına izin vermiştir."
    },
    {
     "ar": [
      11,
      12,
      13,
      9,
      10
     ],
     "tr": "Orada sabah akşam O’nu (öyle kimseler) tesbih eder ki;"
    }
   ]
  },
  {
   "ayet": 37,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Onlar,"
    },
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "ne ticaret ne de alış-verişin kendilerini"
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10,
      11,
      12
     ],
     "tr": "Allah’ı anmaktan, namaz kılmaktan ve zekât vermekten alıkoyamadığı insanlardır."
    },
    {
     "ar": [
      14,
      15,
      16,
      17,
      18,
      19
     ],
     "tr": "Onlar, kalplerin ve gözlerin allak bullak olduğu bir günden korkarlar."
    }
   ]
  },
  {
   "ayet": 38,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Çünkü (o günde) Allah, onları yaptıklarının en güzeli ile mükâfatlandıracak"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "ve lütfundan onlara fazlasıyla verecektir."
    },
    {
     "ar": [
      9,
      10,
      11,
      12,
      13,
      14
     ],
     "tr": "Allah, dilediğini hesapsız rızıklandırır."
    }
   ]
  },
  {
   "ayet": 39,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "İnkâr edenlere gelince, onların amelleri,"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "ıssız çöllerdeki serap gibidir ki"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "susayan onu su zanneder;"
    },
    {
     "ar": [
      8,
      9,
      10,
      11,
      12,
      13
     ],
     "tr": "nihayet ona vardığında orada herhangi bir şey bulamamış,"
    },
    {
     "ar": [
      14,
      15,
      16
     ],
     "tr": "üstelik yanıbaşında da (inanmadığı, kendisinden sakınmadığı) Allah’ı bulmuştur;"
    },
    {
     "ar": [
      17,
      18
     ],
     "tr": "Allah ise, onun hesabını tastamam görmüştür."
    },
    {
     "ar": [
      20,
      21,
      22
     ],
     "tr": "Allah hesabı çok çabuk görür."
    }
   ]
  },
  {
   "ayet": 40,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Yahut (o kâfirlerin duygu, düşünce ve davranışları) engin bir denizdeki yoğun karanlıklar gibidir;"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "(öyle bir deniz) ki, onu dalga üstüne dalga kaplıyor;"
    },
    {
     "ar": [
      12
     ],
     "tr": "üstünde de bulut..."
    },
    {
     "ar": [
      14,
      15,
      16,
      17
     ],
     "tr": "Birbiri üstüne karanlıklar..."
    },
    {
     "ar": [
      18,
      19,
      20,
      21,
      22,
      23
     ],
     "tr": "İnsan, elini çıkarıp uzatsa, neredeyse onu dahi göremez."
    },
    {
     "ar": [
      25,
      26,
      27,
      28,
      29,
      30
     ],
     "tr": "Bir kimseye Allah nûr vermemişse,"
    },
    {
     "ar": [
      31,
      32,
      33,
      34
     ],
     "tr": "artık o kimsenin aydınlıktan nasibi yoktur."
    }
   ]
  },
  {
   "ayet": 41,
   "gruplar": [
    {
     "ar": [
      6,
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "Göklerde ve yerde bulunanlarla dizi dizi kuşların"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "Allah’ı tesbih ettiklerini"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "görmez misin?"
    },
    {
     "ar": [
      13,
      14,
      15,
      16,
      17
     ],
     "tr": "Her biri kendi duasını ve tesbihini (öğrenmiş) bilmiştir."
    },
    {
     "ar": [
      19,
      20,
      21,
      22
     ],
     "tr": "Allah, onların yapmakta olduklarını hakkıyle bilir."
    }
   ]
  },
  {
   "ayet": 42,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Göklerin ve yerin mülkü Allah’ındır;"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "dönüş de ancak O’nadır."
    }
   ]
  },
  {
   "ayet": 43,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Görmez misin ki Allah"
    },
    {
     "ar": [
      5,
      4
     ],
     "tr": "bir takım bulutları (çıkarıp) sürüyor;"
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "sonra onları bir araya getirip üstüste yığıyor."
    },
    {
     "ar": [
      12,
      13,
      14,
      15,
      16
     ],
     "tr": "İşte görüyorsun ki bunlar arasından yağmur çıkıyor."
    },
    {
     "ar": [
      17,
      18,
      19,
      20,
      21,
      22,
      23,
      24
     ],
     "tr": "O, gökten, oradaki dağlardan (dağlar büyüklüğünde bulutlardan) dolu indirir."
    },
    {
     "ar": [
      25,
      26,
      27,
      28
     ],
     "tr": "Artık onu dilediğine isabet ettirir;"
    },
    {
     "ar": [
      29,
      30,
      31,
      32
     ],
     "tr": "dilediğinden de onu uzak tutar;"
    },
    {
     "ar": [
      34,
      35,
      36,
      37,
      38
     ],
     "tr": "(bu bulutların) şimşeğinin parıltısı neredeyse gözleri alır!"
    }
   ]
  },
  {
   "ayet": 44,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Allah, gece ile gündüzü birbirine çeviriyor."
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "Şüphesiz bunda basiret sahipleri için mutlak bir ibret vardır."
    }
   ]
  },
  {
   "ayet": 45,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Allah, her canlıyı sudan yarattı."
    },
    {
     "ar": [
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "İşte bunlardan kimi karnı üstünde sürünür,"
    },
    {
     "ar": [
      12,
      13,
      14,
      15,
      16
     ],
     "tr": "kimi iki ayağı üstünde yürür,"
    },
    {
     "ar": [
      17,
      18,
      19,
      20,
      21
     ],
     "tr": "kimi dört ayağı üstünde yürür..."
    },
    {
     "ar": [
      23,
      24,
      25,
      26
     ],
     "tr": "Allah dilediğini yaratır;"
    },
    {
     "ar": [
      28,
      29,
      30,
      31,
      32,
      33
     ],
     "tr": "şüphesiz Allah her şeye kadirdir."
    }
   ]
  },
  {
   "ayet": 46,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Andolsun biz (bilmediklerinizi size) açık seçik bildiren âyetler indirdik."
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "Allah, dilediğini doğru yola iletir."
    }
   ]
  },
  {
   "ayet": 47,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "(Bazı insanlar:) «Allah’a ve Peygamber’e inandık ve itaat ettik» diyorlar;"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "ondan sonra da içlerinden bir gurup yüz çeviriyor."
    },
    {
     "ar": [
      13,
      14,
      15
     ],
     "tr": "Bunlar inanmış değillerdir."
    }
   ]
  },
  {
   "ayet": 48,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "Onlar, aralarında hüküm vermesi için Allah’a ve Peygamber’e çağırıldıklarında,"
    },
    {
     "ar": [
      7,
      8,
      9,
      10
     ],
     "tr": "bakarsın ki içlerinden bir kısmı yüz çevirip dönerler."
    }
   ]
  },
  {
   "ayet": 49,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Ama, eğer (Allah ve Resûlünün hükmettiği) hak kendi lehlerine ise,"
    },
    {
     "ar": [
      4,
      5,
      6
