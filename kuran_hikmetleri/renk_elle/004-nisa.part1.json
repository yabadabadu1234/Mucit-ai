{"sure":4,"ayetler":[
 {"ayet":1,"gruplar":[{"ar":[0,1],"tr":"Ey insanlar!"},{"ar":[4,5,6,7,8],"tr":"Sizi bir tek nefisten yaratan"},{"ar":[9,10,11],"tr":"ve ondan da eşini yaratan"},{"ar":[12,13,14,15,16],"tr":"ve ikisinden birçok erkekler ve kadınlar üretip yayan"},{"ar":[3,2],"tr":"Rabbinizden sakının."},{"ar":[20,22,21,19],"tr":"Adını kullanarak birbirinizden dilekte bulunduğunuz Allah’tan"},{"ar":[23],"tr":"ve akrabalık haklarına riayetsizlikten de"},{"ar":[18],"tr":"sakının."},{"ar":[25,26,27,28,29],"tr":"Şüphesiz Allah sizin üzerinizde gözetleyicidir."}]},
 {"ayet":2,"gruplar":[{"ar":[1,2,0],"tr":"Yetimlere mallarını verin,"},{"ar":[4,5,6,7],"tr":"temizi pis olanla değişmeyin,"},{"ar":[9,10,11,12,13],"tr":"onların mallarını kendi mallarınıza katarak (kendi malınızmış gibi) yemeyin;"},{"ar":[15,16,17,18],"tr":"çünkü bu, büyük bir günahtır."}]},
 {"ayet":3,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Eğer (kendileriyle evlendiğiniz takdirde) yetimlerin haklarına riayet edememekten korkarsanız"},{"ar":[7,8,9,10,11],"tr":"beğendiğiniz (veya size helâl olan) kadınlardan"},{"ar":[12,13,14,6],"tr":"ikişer, üçer, dörder alın."},{"ar":[16,17,18,19],"tr":"Haksızlık yapmaktan korkarsanız"},{"ar":[20],"tr":"bir tane alın;"},{"ar":[21,22,23,24],"tr":"yahut da sahip olduğunuz (cariyeler) ile yetinin."},{"ar":[26,27,28,29],"tr":"Bu, adaletten ayrılmamanız için en uygun olanıdır."}]},
 {"ayet":4,"gruplar":[{"ar":[0,1,2,3],"tr":"Kadınlara mehirlerini gönül rızası ile (cömertçe) verin;"},{"ar":[5,11],"tr":"eğer gönül hoşluğu ile"},{"ar":[10,9,8,7,6],"tr":"o mehrin bir kısmını size bağışlarlarsa"},{"ar":[12,13,14],"tr":"onu da afiyetle yeyin."}]},
 {"ayet":5,"gruplar":[{"ar":[6,7,8,5,4,3],"tr":"Allah’ın geçiminize dayanak kıldığı mallarınızı"},{"ar":[2,0,1],"tr":"aklı ermezlere (reşit olmayanlara) vermeyin;"},{"ar":[10,9],"tr":"o mallarla onları besleyin,"},{"ar":[11],"tr":"giydirin"},{"ar":[12,13,14,15],"tr":"ve onlara güzel söz söyleyin."}]},
 {"ayet":6,"gruplar":[{"ar":[2,3,4,5,1,0],"tr":"Evlilik çağına gelinceye kadar yetimleri (gözetip) deneyin,"},{"ar":[6,8,9,7],"tr":"eğer onlarda akılca bir olgunlaşma görürseniz"},{"ar":[10,12,11],"tr":"hemen mallarını kendilerine verin."},{"ar":[14,15,16,17,18,19],"tr":"Büyüyecekler (de geri alacaklar) diye o malları israf ile ve tez elden yemeyin."},{"ar":[21,22,23,24],"tr":"Zengin olan (veli) iffetli olmaya çalışsın,"},{"ar":[26,27,28,29,30],"tr":"yoksul olan da (ihtiyaç ve emeğine) uygun olarak yesin."},{"ar":[32,33,34,35],"tr":"Mallarını kendilerine verdiğiniz zaman"},{"ar":[36,37],"tr":"yanlarında şahit bulundurun."},{"ar":[39,40,41],"tr":"Hesap sorucu olarak da Allah yeter."}]},
 {"ayet":7,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Ana-babanın ve yakınların bıraktıklarından erkeklere bir pay vardır;"},{"ar":[6,7,8,9,10,11],"tr":"ana-babanın ve yakınların bıraktıklarından kadınlara da bir pay vardır."},{"ar":[12,13,14,15,16],"tr":"Gerek azından, gerek çoğundan"},{"ar":[18,19],"tr":"belli bir hisse ayrılmıştır."}]},
 {"ayet":8,"gruplar":[{"ar":[3,4,5,6],"tr":"(Mirastan payı olmayan) yakınlar, yetimler ve yoksullar"},{"ar":[0,1,2],"tr":"miras taksiminde hazır bulunursa"},{"ar":[8,7],"tr":"bundan, onları da rızıklandırın"},{"ar":[9,10,11,12],"tr":"ve onlara güzel söz söyleyin."}]},
 {"ayet":9,"gruplar":[{"ar":[4,5,7,6,3,2],"tr":"Geriye eli ermez, gücü yetmez çocuklar bıraktıkları takdirde"},{"ar":[8,9,1],"tr":"(halleri ne olur) diye korkacak olanlar"},{"ar":[0],"tr":"(yetimlere haksızlık etmekten) korkup titresinler;"},{"ar":[10,11],"tr":"Allah’tan sakınsınlar"},{"ar":[12,13,14],"tr":"ve doğru söz söylesinler."}]},
 {"ayet":10,"gruplar":[{"ar":[5,4,3,2,1],"tr":"Haksızlıkla yetimlerin mallarını yiyenler"},{"ar":[0,6,7,8,9,10],"tr":"şüphesiz karınlarına ancak ateş tıkınmış olurlar;"},{"ar":[12,13],"tr":"zaten onlar alevlenmiş ateşe gireceklerdir."}]},
 {"ayet":11,"gruplar":[{"ar":[1,2,3],"tr":"Allah size, çocuklarınız hakkında,"},{"ar":[5,6,7,8],"tr":"erkeğe, kadının payının iki misli"},{"ar":[0],"tr":"(miras vermenizi) emreder."},{"ar":[10,11,12,13,14],"tr":"(Çocuklar) ikiden fazla kadın iseler,"},{"ar":[15,16,17,18],"tr":"ölünün bıraktığının üçte ikisi onlarındır."},{"ar":[20,21,22],"tr":"Eğer yalnız bir kadınsa"},{"ar":[23,24],"tr":"yarısı onundur."},{"ar":[33,34,35,36],"tr":"Ölenin çocuğu varsa,"},{"ar":[26,27,28,29,30,31,32],"tr":"ana-babasından her birinin mirastan altıda bir hissesi vardır."},{"ar":[38,39,40,41,42,43,44],"tr":"Eğer çocuğu yok da ana-babası ona vâris olmuş ise,"},{"ar":[45,46],"tr":"anasına üçte bir (düşer)."},{"ar":[48,49,50,51],"tr":"Eğer ölenin kardeşleri varsa,"},{"ar":[52,53],"tr":"anasına altıda bir (düşer."},{"ar":[55,56,57,58,59,60,61],"tr":"Bütün bu paylar ölenin) yapacağı vasiyetten ve borçtan sonradır."},{"ar":[63,64],"tr":"Babalarınız ve oğullarınızdan"},{"ar":[65,66,67,68,69,70],"tr":"hangisinin size, fayda bakımından daha yakın olduğunu bilemezsiniz."},{"ar":[72,73,74],"tr":"Bunlar Allah tarafından konmuş farzlardır (paylardır)."},{"ar":[76,77,78,79,80],"tr":"Şüphesiz Allah ilim ve hikmet sahibidir."}]},
 {"ayet":12,"gruplar":[{"ar":[21,22,23,24,25,26,27],"tr":"Yapacakları vasiyetten ve borçtan sonra"},{"ar":[5,6,7,8,9,10],"tr":"eşlerinizin, eğer çocukları yoksa,"},{"ar":[1,2,3,4],"tr":"bıraktıklarının yarısı sizindir."},{"ar":[12,13,14,15,16,17,18,19],"tr":"Çocukları varsa bıraktıklarının dörtte biri sizindir."},{"ar":[33,34,35,36,37],"tr":"Çocuğunuz yoksa, sizin de,"},{"ar":[48,49,50,51,52,53,54],"tr":"yapacağınız vasiyetten ve borçtan sonra,"},{"ar":[29,30,31,32],"tr":"bıraktığınızın dörtte biri onlarındır (zevcelerinizindir)."},{"ar":[39,40,41,42,43,44,45,46],"tr":"Çocuğunuz varsa, bıraktığınızın sekizde biri onlarındır."},{"ar":[56,57,58,61,62,59,60],"tr":"Eğer bir erkek veya kadının, anababası ve çocukları bulunmadığı halde (kelâle şeklinde) malı mirasçılara kalırsa"},{"ar":[63,64,65,66],"tr":"ve bir erkek yahut bir kızkardeşi varsa,"},{"ar":[67,68,69,70],"tr":"her birine altıda bir düşer."},{"ar":[72,73,74,75,76,77,78,79,80],"tr":"Bundan fazla iseler üçte bire ortaktırlar."},{"ar":[82,83,84,85,86,87,88],"tr":"(Bu taksim) yapılacak vasiyetten ve borçtan sonra,"},{"ar":[89,90],"tr":"kimse zarara uğramaksızın (yapılacak)tır."},{"ar":[92,93,94],"tr":"Bunlar Allah’tan size vasiyettir."},{"ar":[96,97,98],"tr":"Allah her şeyi hakkıyle bilendir, halîmdir."}]},
 {"ayet":13,"gruplar":[{"ar":[0,1,2],"tr":"Bunlar, Allah’ın (koyduğu) sınırlardır."},{"ar":[4,5,6,7],"tr":"Kim Allah’a ve Peygamberine itaat ederse"},{"ar":[8,9,10,11,12,13],"tr":"Allah onu, zemininden ırmaklar akan cennetlere koyacaktır;"},{"ar":[14,15],"tr":"orada devamlı kalıcıdırlar;"},{"ar":[17,18,19],"tr":"işte büyük kurtuluş budur."}]},
 {"ayet":14,"gruplar":[{"ar":[0,1,2,3],"tr":"Kim Allah’a ve Peygamberine karşı isyan eder"},{"ar":[4,5],"tr":"ve sınırlarını aşarsa"},{"ar":[6,7,8,9],"tr":"Allah onu, devamlı kalacağı bir ateşe sokar"},{"ar":[10,11,12],"tr":"ve onun için alçaltıcı bir azap vardır."}]},
 {"ayet":15,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Kadınlarınızdan fuhuş yapanlara"},{"ar":[5,6,7,8],"tr":"karşı aranızdan dört şahit getirin."},{"ar":[10,11],"tr":"Eğer şahitlik ederlerse,"},{"ar":[15,16,17],"tr":"o kadınları ölüm alıp götürünceye"},{"ar":[18,19,20,21,22],"tr":"yahut Allah onlara bir yol açıncaya kadar"},{"ar":[13,14,12],"tr":"evlerde hapsedin."}]},
 {"ayet":16,"gruplar":[{"ar":[0,1,2],"tr":"İçinizden fuhuş yapan her iki tarafa"},{"ar":[3],"tr":"ceza verin;"},{"ar":[5,6,7],"tr":"eğer tevbe eder, uslanırlarsa"},{"ar":[8,9],"tr":"artık onlara ceza verip eziyet etmekten vazgeçin;"},{"ar":[11,12,13,14,15],"tr":"çünkü Allah tevbeleri çok kabul eden ve çok esirgeyendir."}]},
 {"ayet":17,"gruplar":[{"ar":[0,1,2,3],"tr":"Allah’ın kabul edeceği tevbe, ancak"},{"ar":[4,5,6,7,8,9,10,11],"tr":"bilmeden kötülük edip de sonra tez elden tevbe edenlerin tevbesidir;"},{"ar":[12,13,14,15],"tr":"işte Allah bunların tevbesini kabul eder;"},{"ar":[17,18,19,20],"tr":"Allah her şeyi bilendir, hikmet sahibidir."}]},
 {"ayet":18,"gruplar":[{"ar":[0,3,4],"tr":"Yoksa kötülükleri yapıp yapıp da"},{"ar":[5,6,7,8,9],"tr":"içlerinden birine ölüm gelip çatınca"},{"ar":[10,11,12,13],"tr":"Ben şimdi tevbe ettim» diyenler"},{"ar":[14,15,16,17,18],"tr":"ile kâfir olarak ölenler için"},{"ar":[1,2],"tr":"(kabul edilecek) tevbe yoktur."},{"ar":[20,21,22,23,24],"tr":"Onlar için acı bir azap hazırlamışızdır."}]},
 {"ayet":19,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[3,4,5,6,7,8,9],"tr":"Kadınlara zorla vâris olmanız size helâl değildir."},{"ar":[17,18,19,20,21],"tr":"Apaçık bir edepsizlik yapmadıkça,"},{"ar":[13,14,15,16],"tr":"onlara verdiğinizin bir kısmını ele geçirmeniz için de"},{"ar":[11,12],"tr":"kadınları sıkıştırmayın."},{"ar":[23,24],"tr":"Onlarla iyi geçinin."},{"ar":[26,27],"tr":"Eğer onlardan hoşlanmazsanız"},{"ar":[28,29,30,31,32,33,34,35,36],"tr":"(biliniz ki) Allah’ın hakkınızda çok hayırlı kılacağı bir şeyden de hoşlanmamış olabilirsiniz."}]},
 {"ayet":20,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Eğer bir eşi bırakıp da yerine başka bir eş almak isterseniz,"},{"ar":[6,7,8],"tr":"onlardan birine yüklerle mehir vermiş olsanız dahi"},{"ar":[9,10,11,12],"tr":"ondan hiçbir şeyi geri almayın."},{"ar":[14,15,16,17],"tr":"Siz iftira ederek ve apaçık günah işleyerek onu geri alır mısınız?"}]}
]}
