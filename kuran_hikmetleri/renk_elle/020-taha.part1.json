{"sure": 20, "ayetler": [{"ayet": 1, "gruplar": [{"ar": [0], "tr": "Tâ. Hâ."}]}, {"ayet": 2, "gruplar": [{"ar": [3, 2], "tr": "Kur’an’ı sana,"}, {"ar": [0, 4], "tr": "güçlük çekesin diye değil,"}, {"ar": [1], "tr": "indirdik."}]}, {"ayet": 3, "gruplar": [{"ar": [0], "tr": "ancak"}, {"ar": [3], "tr": "Allah’tan korkanlara"}, {"ar": [1], "tr": "bir öğüt olsun diye"}]}, {"ayet": 4, "gruplar": [{"ar": [3, 4, 5, 2], "tr": "yeri ve yüce gökleri yaratan Allah"}, {"ar": [1], "tr": "tarafından"}, {"ar": [0], "tr": "peyderpey indirilmiştir."}]}, {"ayet": 5, "gruplar": [{"ar": [0], "tr": "Rahmân,"}, {"ar": [1, 2, 3], "tr": "Arş’a istivâ etmiştir."}]}, {"ayet": 6, "gruplar": [{"ar": [1, 2, 3, 4, 5, 6, 7, 8], "tr": "Göklerde, yerde ve ikisi arasında bulunan şeyler"}, {"ar": [9, 10, 11], "tr": "ile toprağın altında olanlar"}, {"ar": [0], "tr": "hep O’nundur."}]}, {"ayet": 7, "gruplar": [{"ar": [0, 1, 2], "tr": "Eğer sen, sözü açıktan söylersen,"}, {"ar": [3, 4], "tr": "bilesin ki O,"}, {"ar": [5], "tr": "gizliyi de,"}, {"ar": [6], "tr": "gizlinin gizlisini de bilir."}]}, {"ayet": 8, "gruplar": [{"ar": [0], "tr": "Allah,"}, {"ar": [1, 2, 3, 4], "tr": "kendisinden başka ilâh olmayandır."}, {"ar": [7, 8, 6], "tr": "En güzel isimler O’na mahsustur."}]}, {"ayet": 9, "gruplar": [{"ar": [3, 2], "tr": "(Resûlüm!) Musa (olayının) haberi"}, {"ar": [0, 1], "tr": "sana ulaştı mı?"}]}, {"ayet": 10, "gruplar": [{"ar": [0, 1, 2], "tr": "Hani o, bir ateş görmüş"}, {"ar": [3, 4, 5], "tr": "ve ailesine: Bekleyin!"}, {"ar": [6, 7, 8], "tr": "Eminim ki bir ateş gördüm."}, {"ar": [9, 10, 11, 12], "tr": "Belki ondan size bir meş’ale getiririm"}, {"ar": [13, 14, 15, 16, 17], "tr": "veya ateşin yanında bir rehber bulurum, demişti."}]}, {"ayet": 11, "gruplar": [{"ar": [0, 1], "tr": "Oraya vardığında"}, {"ar": [2, 3], "tr": "kendisine (tarafımızdan): Ey Musa! diye seslenildi:"}]}, {"ayet": 12, "gruplar": [{"ar": [0, 1, 2], "tr": "Muhakkak ki ben, evet ben senin Rabbinim!"}, {"ar": [3, 4], "tr": "Hemen pabuçlarını çıkar!"}, {"ar": [6, 7, 8, 9], "tr": "Çünkü sen kutsal vâdi Tuvâ’dasın!"}]}, {"ayet": 13, "gruplar": [{"ar": [0, 1], "tr": "Ben seni seçtim."}, {"ar": [2, 3, 4], "tr": "Şimdi vahyedilene kulak ver."}]}, {"ayet": 14, "gruplar": [{"ar": [0, 1, 2], "tr": "Muhakkak ki ben, yalnızca ben Allah’ım."}, {"ar": [3, 4, 5, 6], "tr": "Benden başka ilâh yoktur."}, {"ar": [7], "tr": "Bana kulluk et;"}, {"ar": [10, 8, 9], "tr": "beni anmak için namaz kıl."}]}, {"ayet": 15, "gruplar": [{"ar": [0, 1, 2], "tr": "Kıyamet günü mutlaka gelecektir."}, {"ar": [6, 7, 8, 9, 5], "tr": "Herkes peşine koştuğu şeyin karşılığını bulsun diye"}, {"ar": [3, 4], "tr": "neredeyse onu (kendimden) gizleyeceğim."}]}, {"ayet": 16, "gruplar": [{"ar": [3, 4, 5, 6], "tr": "Ona inanmayan"}, {"ar": [7, 8], "tr": "ve nefsinin arzularına uyan kimseler"}, {"ar": [0, 1, 2], "tr": "sakın seni ondan (kıyamete inanmaktan) alıkoymasın;"}, {"ar": [9], "tr": "sonra mahvolursun!"}]}, {"ayet": 17, "gruplar": [{"ar": [1], "tr": "Şu"}, {"ar": [2], "tr": "sağ elindeki"}, {"ar": [0], "tr": "nedir,"}, {"ar": [3], "tr": "ey Musa?"}]}, {"ayet": 18, "gruplar": [{"ar": [0, 1, 2], "tr": "O, benim asamdır, dedi,"}, {"ar": [3, 4], "tr": "ona dayanırım,"}, {"ar": [5, 6, 7, 8], "tr": "onunla davarlarıma yaprak silkelerim;"}, {"ar": [9, 10, 11, 12], "tr": "benim ona başkaca ihtiyaçlarım da vardır."}]}, {"ayet": 19, "gruplar": [{"ar": [0], "tr": "Allah:"}, {"ar": [1, 2], "tr": "Yere at onu, ey Musa! dedi."}]}, {"ayet": 20, "gruplar": [{"ar": [0], "tr": "Onu hemen yere attı."}, {"ar": [1, 2], "tr": "Bir de ne görsün,"}, {"ar": [3, 4], "tr": "hızla sürünen bir yılan değil mi!"}]}, {"ayet": 21, "gruplar": [{"ar": [0], "tr": "Allah buyurdu:"}, {"ar": [1], "tr": "Al onu!"}, {"ar": [2, 3], "tr": "Korkma!"}, {"ar": [5, 6, 7], "tr": "Biz onu şimdi ilk haline sokacağız."}]}, {"ayet": 22, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Bir de elini koltuğunun altına sok"}, {"ar": [9, 10], "tr": "ki, bir başka mucize olmak üzere"}, {"ar": [4, 5, 6, 7, 8], "tr": "o, kusursuz ve lekesiz beyazlıkta çıksın."}]}, {"ayet": 23, "gruplar": [{"ar": [0], "tr": "Ta ki, sana,"}, {"ar": [1, 2, 3], "tr": "(böylece) en büyük âyetlerimizden bazılarını gösterelim."}]}, {"ayet": 24, "gruplar": [{"ar": [2, 0, 1], "tr": "Firavun’a git."}, {"ar": [3, 4], "tr": "Çünkü o iyice azdı."}]}, {"ayet": 25, "gruplar": [{"ar": [0, 1], "tr": "Musa: Rabbim! dedi,"}, {"ar": [2, 3, 4], "tr": "yüreğime genişlik ver."}]}, {"ayet": 26, "gruplar": [{"ar": [2, 0, 1], "tr": "İşimi bana kolaylaştır."}]}, {"ayet": 27, "gruplar": [{"ar": [2, 3], "tr": "Dilimden"}, {"ar": [1], "tr": "(şu) bağı"}, {"ar": [0], "tr": "çöz."}]}, {"ayet": 28, "gruplar": [{"ar": [1, 0], "tr": "Ki sözümü anlasınlar."}]}, {"ayet": 29, "gruplar": [{"ar": [0, 1], "tr": "Bana"}, {"ar": [3, 4], "tr": "ailemden"}, {"ar": [2], "tr": "bir de vezir (yardımcı) ver,"}]}, {"ayet": 30, "gruplar": [{"ar": [1, 0], "tr": "Kardeşim Harun’u."}]}, {"ayet": 31, "gruplar": [{"ar": [1], "tr": "Onun sayesinde"}, {"ar": [2, 0], "tr": "arkamı kuvvetlendir."}]}, {"ayet": 32, "gruplar": [{"ar": [0], "tr": "Ve onu"}, {"ar": [1, 2], "tr": "işime ortak kıl."}]}, {"ayet": 33, "gruplar": [{"ar": [0, 1, 2], "tr": "Böylece seni bol bol tesbih edelim."}]}, {"ayet": 34, "gruplar": [{"ar": [0, 1], "tr": "Ve çok çok analım seni."}]}, {"ayet": 35, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Şüphesiz sen bizi görmektesin."}]}, {"ayet": 36, "gruplar": [{"ar": [0], "tr": "Allah:"}, {"ar": [4], "tr": "Ey Musa! dedi,"}, {"ar": [1, 2, 3], "tr": "istediğin sana verildi."}]}, {"ayet": 37, "gruplar": [{"ar": [0, 1, 2], "tr": "Andolsun biz sana"}, {"ar": [3, 4], "tr": "bir defa daha lütufta bulunmuştuk."}]}, {"ayet": 38, "gruplar": [{"ar": [0], "tr": "Bir zaman,"}, {"ar": [4, 5], "tr": "vahyedilecek şeyi"}, {"ar": [2, 3], "tr": "annene (şöyle)"}, {"ar": [1], "tr": "vahyetmiştik:"}]}, {"ayet": 39, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Musa’yı sandığa koy;"}, {"ar": [4, 5, 6], "tr": "sonra onu denize (Nil’e) bırak;"}, {"ar": [7, 8, 9], "tr": "deniz onu kıyıya atsın da,"}, {"ar": [10, 11, 12, 13, 14], "tr": "benim düşmanım ve onun düşmanı olan biri onu alsın."}, {"ar": [16, 17, 18, 19], "tr": "(Ey Musa! Sevilmen) ve"}, {"ar": [20, 21, 22], "tr": "benim nezaretimde yetiştirilmen için sana kendimden sevgi verdim."}]}, {"ayet": 40, "gruplar": [{"ar": [0, 1, 2], "tr": "Hani, kız kardeşin gidip"}, {"ar": [3, 4, 5, 6, 7, 8], "tr": "«Ona bakacak birini size bulayım mı?» diyordu."}, {"ar": [10, 11, 12], "tr": "Böylece seni,"}, {"ar": [13, 14, 15, 16, 17], "tr": "gözü gönlü mutluluk dolsun ve üzülmesin diye annene geri verdik."}, {"ar": [19, 20], "tr": "Ve sen, birini öldürdün de"}, {"ar": [21, 22, 23], "tr": "seni endişeden kurtardık."}, {"ar": [24, 25], "tr": "Seni iyiden iyiye denemeden geçirdik."}, {"ar": [27, 28, 29, 30, 31], "tr": "Bunun için yıllarca Medyen halkı arasında kaldın."}, {"ar": [32, 33, 34, 35, 36], "tr": "Sonra takdire göre (bu makama) geldin ey Musa!"}]}, {"ayet": 41, "gruplar": [{"ar": [0, 1], "tr": "Seni, kendim için elçi seçtim."}]}, {"ayet": 42, "gruplar": [{"ar": [1, 2, 0], "tr": "Sen ve kardeşin birlikte"}, {"ar": [3], "tr": "âyetlerimi götürün."}, {"ar": [4, 5, 6, 7], "tr": "Beni anmayı ihmal etmeyin."}]}, {"ayet": 43, "gruplar": [{"ar": [2, 0, 1], "tr": "Firavun’a gidin."}, {"ar": [3, 4], "tr": "Çünkü o, iyiden iyiye azdı."}]}, {"ayet": 44, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Ona yumuşak söz söyleyin."}, {"ar": [4, 5, 6, 7], "tr": "Belki o, aklını başına alır veya korkar."}]}, {"ayet": 45, "gruplar": [{"ar": [0, 1], "tr": "Dediler ki: Rabbimiz!"}, {"ar": [2, 3, 4, 5, 6], "tr": "Doğrusu biz, onun bize aşırı derecede kötü davranmasından"}, {"ar": [7, 8, 9], "tr": "yahut iyice azmasından endişe ediyoruz."}]}, {"ayet": 46, "gruplar": [{"ar": [0], "tr": "Buyurdu ki:"}, {"ar": [1, 2], "tr": "Korkmayın,"}, {"ar": [4, 5], "tr": "çünkü ben sizinle beraberim;"}, {"ar": [6, 7], "tr": "işitir ve görürüm."}]}, {"ayet": 47, "gruplar": [{"ar": [0, 1], "tr": "Haydi, ona gidin de deyin ki:"}, {"ar": [2, 3, 4], "tr": "Biz, senin Rabbinin elçileriyiz."}, {"ar": [5, 6, 7, 8], "tr": "İsrailoğullarını hemen bizimle birlikte gönder;"}, {"ar": [9, 10], "tr": "onlara eziyet etme!"}, {"ar": [12, 13, 14, 15, 16], "tr": "Biz, senin Rabbinden bir âyet getirdik."}, {"ar": [18, 19, 20, 21, 22], "tr": "Kurtuluş, hidayete uyanlarındır."}]}, {"ayet": 48, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Hakikaten bize vahyolundu ki:"}, {"ar": [7, 8, 9], "tr": "(Peygamberleri) yalanlayan ve yüz çevirenlere"}, {"ar": [5, 6], "tr": "azap edilecektir."}]}, {"ayet": 49, "gruplar": [{"ar": [0], "tr": "Firavun:"}, {"ar": [1, 2, 3], "tr": "Rabbiniz de kimmiş, ey Musa? dedi."}]}, {"ayet": 50, "gruplar": [{"ar": [0], "tr": "O da:"}, {"ar": [1, 2], "tr": "Bizim Rabbimiz,"}, {"ar": [4, 5, 6, 3], "tr": "her şeye hılkatini (varlık ve özelliğini) veren,"}, {"ar": [7, 8], "tr": "sonra da doğru yolu gösterendir, dedi."}]}, {"ayet": 51, "gruplar": [{"ar": [0], "tr": "Firavun:"}, {"ar": [1], "tr": "Öyle ise,"}, {"ar": [4, 3], "tr": "önceki milletlerin"}, {"ar": [2], "tr": "hali ne olacak? dedi."}]}, {"ayet": 52, "gruplar": [{"ar": [0], "tr": "Musa:"}, {"ar": [1], "tr": "Onlar hakkındaki bilgi,"}, {"ar": [2, 3, 4, 5], "tr": "Rabbimin yanında bir kitapta bulunur."}, {"ar": [9, 7, 8, 10, 11], "tr": "Rabbim, ne yanılır ne de unutur, dedi."}]}, {"ayet": 53, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "O, yeri size beşik yapan"}, {"ar": [5, 6, 7, 8], "tr": "ve onda size yollar açan,"}, {"ar": [9, 10, 11, 12], "tr": "gökten de su indirendir."}, {"ar": [13, 14], "tr": "Onunla biz"}, {"ar": [16, 17, 18, 15], "tr": "çeşitli bitkilerden çiftler çıkardık."}]}, {"ayet": 54, "gruplar": [{"ar": [0], "tr": "Yeyiniz;"}, {"ar": [1, 2], "tr": "hayvanlarınızı otlatınız."}, {"ar": [4, 5, 6], "tr": "Şüphesiz bunda"}, {"ar": [8, 9], "tr": "akıl sahipleri için"}, {"ar": [7], "tr": "(Allah’ın kudretine) işaretler vardır."}]}, {"ayet": 55, "gruplar": [{"ar": [1, 2], "tr": "Sizi ondan (topraktan) yarattık;"}, {"ar": [3, 4], "tr": "yine sizi oraya döndüreceğiz"}, {"ar": [5, 6, 7, 8], "tr": "ve bir kez daha sizi ondan çıkaracağız."}]}, {"ayet": 56, "gruplar": [{"ar": [0, 1], "tr": "Andolsun biz ona (Firavun’a)"}, {"ar": [3, 2], "tr": "bütün (bu) delillerimizi gösterdik;"}, {"ar": [4, 5], "tr": "yine de yalanladı ve diretti."}]}, {"ayet": 57, "gruplar": [{"ar": [0], "tr": "Dedi ki:"}, {"ar": [2, 5, 3, 4], "tr": "Bizi, yaptığın büyü ile yurdumuzdan çıkarasın diye"}, {"ar": [1, 6], "tr": "mi geldin, ey Musa?"}]}, {"ayet": 58, "gruplar": [{"ar": [0, 1, 2], "tr": "Öyle ise, muhakkak surette biz de sana, aynen onun gibi bir büyü getireceğiz."}, {"ar": [3, 4, 5, 6], "tr": "Şimdi sen, seninle bizim aramızda,"}, {"ar": [7, 8, 9, 10, 11, 12, 13], "tr": "ne senin, ne de bizim muhalefet etmeyeceğimiz uygun bir yerde buluşma zamanı ayarla."}]}, {"ayet": 59, "gruplar": [{"ar": [0], "tr": "Musa:"}, {"ar": [1, 2, 3], "tr": "Buluşma zamanınız, bayram günü,"}, {"ar": [7], "tr": "kuşluk vaktinde"}, {"ar": [4, 5, 6], "tr": "insanların toplanma zamanı olsun, dedi."}]}, {"ayet": 60, "gruplar": [{"ar": [0, 1], "tr": "Bunun üzerine Firavun dönüp gitti."}, {"ar": [2, 3], "tr": "Hilesini (sihirbazlarını) topladı;"}, {"ar": [4, 5], "tr": "sonra geri geldi."}]}]}