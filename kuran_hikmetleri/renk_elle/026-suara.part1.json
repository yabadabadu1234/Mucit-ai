{"sure": 26, "ayetler": [{"ayet": 1, "gruplar": [{"ar": [0], "tr": "Tâ. Sîn. Mîm."}]}, {"ayet": 2, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Bunlar, apaçık Kitab’ın âyetleridir."}]}, {"ayet": 3, "gruplar": [{"ar": [3, 4, 5], "tr": "(Resûlüm!) Onlar iman etmiyorlar diye"}, {"ar": [0, 1, 2], "tr": "neredeyse kendine kıyacaksın!"}]}, {"ayet": 4, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Biz dilesek, onların üzerine gökten bir mucize indiririz de,"}, {"ar": [7, 8, 9, 10], "tr": "ona boyunları eğilip kalır."}]}, {"ayet": 5, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Kendilerine, o çok esirgeyici Allah’tan hiçbir yeni öğüt gelmez ki,"}, {"ar": [7, 8, 9, 10], "tr": "ondan yüz çevirmesinler."}]}, {"ayet": 6, "gruplar": [{"ar": [0, 1], "tr": "Üstelik (ona) «yalandır» derler;"}, {"ar": [4, 5, 6, 7], "tr": "fakat alay edip durdukları şeylerin"}, {"ar": [2, 3], "tr": "haberleri yakında onlara gelecektir."}]}, {"ayet": 7, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Yeryüzüne bir bakmazlar mı!"}, {"ar": [4, 5, 6, 7, 8, 9, 10], "tr": "Orada her güzel çiftten nice bitkiler yetiştirdik."}]}, {"ayet": 8, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Şüphesiz bunlarda (Allah’ın kudretine) bir nişâne vardır;"}, {"ar": [5, 6, 7, 8], "tr": "ama çoğu iman etmezler."}]}, {"ayet": 9, "gruplar": [{"ar": [0, 1], "tr": "Şüphe yok ki Rabbin,"}, {"ar": [2, 3, 4], "tr": "mutlak galip ve engin merhamet sahibidir."}]}, {"ayet": 10, "gruplar": [{"ar": [0], "tr": "Hani"}, {"ar": [2, 3], "tr": "Rabbin Musa’ya:"}, {"ar": [6, 7], "tr": "O zalimler güruhuna,"}, {"ar": [5], "tr": "git."}, {"ar": [1, 4], "tr": "diye seslenmişti."}]}, {"ayet": 11, "gruplar": [{"ar": [0, 1], "tr": "Firavun’un kavmine"}, {"ar": [3, 4], "tr": "Hâla (başlarına gelecekten) sakınmayacaklar mı onlar?"}]}, {"ayet": 12, "gruplar": [{"ar": [0, 1], "tr": "Musa şöyle dedi: Rabbim!"}, {"ar": [2, 3, 4, 5], "tr": "Doğrusu, beni yalancılıkla suçlamalarından korkuyorum."}]}, {"ayet": 13, "gruplar": [{"ar": [0, 1], "tr": "(Bu durumda) içim daralır,"}, {"ar": [2, 3, 4], "tr": "dilim dönmez;"}, {"ar": [5, 6, 7], "tr": "onun için Harun’a da elçilik ver."}]}, {"ayet": 14, "gruplar": [{"ar": [0, 1, 2], "tr": "Onların bana isnad ettikleri bir suç da var."}, {"ar": [3, 4, 5], "tr": "Bundan ötürü beni öldürmelerinden korkuyorum."}]}, {"ayet": 15, "gruplar": [{"ar": [0], "tr": "Allah buyurdu:"}, {"ar": [1], "tr": "Hayır (seni asla öldüremezler)!"}, {"ar": [3, 4], "tr": "İkiniz mucizelerimizle gidin."}, {"ar": [6, 7, 8], "tr": "Şüphesiz ki, biz sizinle beraberiz, (her şeyi) işitmekteyiz."}]}, {"ayet": 16, "gruplar": [{"ar": [0, 1, 2], "tr": "Haydi Firavun’a gidip deyin ki:"}, {"ar": [3, 4, 5, 6], "tr": "Gerçekten biz, âlemlerin Rabbi’nin elçisiyiz;"}]}, {"ayet": 17, "gruplar": [{"ar": [3, 4, 1, 2], "tr": "İsrailoğullarını bizimle beraber gönder."}]}, {"ayet": 18, "gruplar": [{"ar": [0], "tr": "(Kendisine Allah’ın emri tebliğ edilince Firavun) dedi ki:"}, {"ar": [1, 2, 3, 4], "tr": "Biz seni çocukken himayemize alıp büyütmedik mi?"}, {"ar": [5, 6, 7, 8, 9], "tr": "Hayatının birçok yıllarını aramızda geçirmedin mi?"}]}, {"ayet": 19, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Sonunda o yaptığın (kötü) işi de yaptın."}, {"ar": [4, 5, 6], "tr": "Sen nankörün birisin!"}]}, {"ayet": 20, "gruplar": [{"ar": [0], "tr": "Musa:"}, {"ar": [3, 1, 2], "tr": "Ben, dedi, o işi o anda"}, {"ar": [4, 5], "tr": "sonunun ne olacağını bilmeyerek yaptım."}]}, {"ayet": 21, "gruplar": [{"ar": [2, 3, 0, 1], "tr": "Sizden korkunca da hemen aranızdan kaçtım."}, {"ar": [4, 5, 6, 7], "tr": "Sonra Rabbim bana hikmet bahşetti"}, {"ar": [8, 9, 10], "tr": "ve beni peygamberlerden kıldı."}]}, {"ayet": 22, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "O nimet diye başıma kaktığın ise,"}, {"ar": [4, 5, 6, 7], "tr": "(aslında) İsrailoğullarını kendine kul köle etmendir."}]}, {"ayet": 23, "gruplar": [{"ar": [0, 1], "tr": "Firavun şöyle dedi:"}, {"ar": [2, 3, 4], "tr": "Âlemlerin Rabbi dediğin de nedir?"}]}, {"ayet": 24, "gruplar": [{"ar": [0], "tr": "Musa cevap verdi:"}, {"ar": [7, 8, 9], "tr": "Eğer işin gerçeğini düşünüp anlayan kişiler olsanız,"}, {"ar": [1, 2, 3, 4, 5], "tr": "(itiraf edersiniz ki) O, göklerin, yerin ve ikisi arasında bulunan her şeyin Rabbidir."}]}, {"ayet": 25, "gruplar": [{"ar": [0, 1, 2], "tr": "(Firavun) etrafında bulunanlara:"}, {"ar": [3, 4], "tr": "İşitiyor musunuz? dedi."}]}, {"ayet": 26, "gruplar": [{"ar": [0], "tr": "Musa dedi ki:"}, {"ar": [1, 2, 3, 4], "tr": "O, sizin de Rabbiniz, daha önceki atalarınızın da Rabbidir."}]}, {"ayet": 27, "gruplar": [{"ar": [0], "tr": "Firavun:"}, {"ar": [2, 3, 4, 5], "tr": "Size gönderilen bu elçiniz"}, {"ar": [1, 6], "tr": "mutlaka delidir, dedi."}]}, {"ayet": 28, "gruplar": [{"ar": [0], "tr": "Musa devamla şunu söyledi:"}, {"ar": [7, 8, 9], "tr": "Şayet aklınızı kullansanız"}, {"ar": [1, 2, 3, 4, 5], "tr": "(anlarsınız ki), O, doğunun, batının ve ikisinin arasında bulunanların Rabbidir."}]}, {"ayet": 29, "gruplar": [{"ar": [0], "tr": "Firavun:"}, {"ar": [1, 2, 3, 4], "tr": "Benden başkasını tanrı edinirsen,"}, {"ar": [5, 6, 7], "tr": "andolsun ki seni zindanlıklardan ederim! dedi."}]}, {"ayet": 30, "gruplar": [{"ar": [0], "tr": "Musa:"}, {"ar": [1, 2, 3, 4], "tr": "Sana apaçık bir şey getirmiş olsam da mı? dedi."}]}, {"ayet": 31, "gruplar": [{"ar": [0], "tr": "Firavun:"}, {"ar": [3, 4, 5, 6], "tr": "Doğru söyleyenlerden isen,"}, {"ar": [1, 2], "tr": "haydi getir onu! diye karşılık verdi."}]}, {"ayet": 32, "gruplar": [{"ar": [0, 1], "tr": "Bunun üzerine Musa asâsını atıverdi;"}, {"ar": [2, 3, 4, 5], "tr": "bir de ne görsünler, asâ apaçık koca bir yılan (oluvermiş)!"}]}, {"ayet": 33, "gruplar": [{"ar": [0, 1], "tr": "Elini de (koynundan) çıkardı;"}, {"ar": [2, 3, 4, 5], "tr": "o da seyredenlere bembeyaz görünen (nur saçan bir şey oluvermiş)!"}]}, {"ayet": 34, "gruplar": [{"ar": [0, 1, 2], "tr": "Firavun, çevresindeki ileri gelenlere:"}, {"ar": [3, 4, 5, 6], "tr": "Bu, dedi, doğrusu çok bilgili bir sihirbaz!"}]}, {"ayet": 35, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Sizi sihiriyle yurdunuzdan çıkarmak istiyor."}, {"ar": [6, 7], "tr": "Şimdi ne buyurursunuz?"}]}, {"ayet": 36, "gruplar": [{"ar": [0], "tr": "Dediler ki:"}, {"ar": [1, 2], "tr": "Onu ve kardeşini eğle"}, {"ar": [3, 4, 5, 6], "tr": "ve şehirlere toplayıcı görevliler gönder;"}]}, {"ayet": 37, "gruplar": [{"ar": [1, 2, 3], "tr": "Ne kadar bilgisi derin sihirbaz varsa"}, {"ar": [0], "tr": "sana getirsinler."}]}, {"ayet": 38, "gruplar": [{"ar": [1, 2, 3, 4, 0], "tr": "Böylece sihirbazlar belli bir günün tayin edilen vaktinde biraraya getirildi."}]}, {"ayet": 39, "gruplar": [{"ar": [0, 1], "tr": "Halka:"}, {"ar": [2, 3, 4], "tr": "Siz de toplanıyor musunuz (haydi hemen toplanın), denildi."}]}, {"ayet": 40, "gruplar": [{"ar": [3, 4, 5, 6], "tr": "(Firavun’un adamları:) Eğer üstün gelirlerse,"}, {"ar": [0, 1, 2], "tr": "herhalde sihirbazlara uyarız, dediler."}]}, {"ayet": 41, "gruplar": [{"ar": [0, 1, 2], "tr": "Sihirbazlar geldiklerinde"}, {"ar": [3, 4], "tr": "Firavun’a:"}, {"ar": [8, 9, 10, 11], "tr": "Şayet biz üstün gelirsek,"}, {"ar": [5, 6, 7], "tr": "muhakkak bize bir ücret vardır değil mi? dediler."}]}, {"ayet": 42, "gruplar": [{"ar": [0, 1], "tr": "Firavun cevap verdi: Evet,"}, {"ar": [2, 3], "tr": "o takdirde hiç şüphe etmeyin,"}, {"ar": [4, 5], "tr": "gözde kimselerden de olacaksınız."}]}, {"ayet": 43, "gruplar": [{"ar": [2, 1], "tr": "Musa onlara:"}, {"ar": [3, 4, 5, 6], "tr": "Ne atacaksanız atın! dedi."}]}, {"ayet": 44, "gruplar": [{"ar": [0, 1, 2], "tr": "Bunun üzerine iplerini ve değneklerini attılar"}, {"ar": [3], "tr": "ve:"}, {"ar": [4, 5], "tr": "Firavun’un kudreti hakkı için"}, {"ar": [6, 7, 8], "tr": "elbette bizler galip geleceğiz, dediler."}]}, {"ayet": 45, "gruplar": [{"ar": [0, 1, 2], "tr": "Sonra Musa asâsını attı;"}, {"ar": [3, 4, 5, 6, 7], "tr": "bir de ne görsünler, onların uydurduklarını yutuveriyor!"}]}, {"ayet": 46, "gruplar": [{"ar": [2, 0, 1], "tr": "(Bunu görünce) sihirbazlar derhal secdeye kapandılar."}]}, {"ayet": 47, "gruplar": [{"ar": [2, 3], "tr": "«Âlemlerin Rabbine,"}, {"ar": [1], "tr": "iman ettik»"}, {"ar": [0], "tr": "dediler."}]}, {"ayet": 48, "gruplar": [{"ar": [1, 2, 0], "tr": "Musa ve Harun’un Rabbine"}]}, {"ayet": 49, "gruplar": [{"ar": [0], "tr": "Firavun, (kızgınlık içinde) dedi ki:"}, {"ar": [1, 2, 3, 4, 5, 6], "tr": "Ben size izin vermeden ona iman ettiniz ha!"}, {"ar": [8, 9, 10, 11, 12], "tr": "Demek ki size sihiri öğreten büyüğünüzmüş o!"}, {"ar": [13, 14], "tr": "Ama şimdi (size yapacağımı görecek ve) bileceksiniz:"}, {"ar": [16, 17, 18, 19, 20], "tr": "Andolsun, ellerinizi ve ayaklarınızı çaprazlama kestireceğim,"}, {"ar": [21, 22], "tr": "hepinizi astıracağım!"}]}, {"ayet": 50, "gruplar": [{"ar": [0, 1, 2], "tr": "«Zararı yok, dediler,"}, {"ar": [4, 5, 6, 7], "tr": "(nasıl olsa) biz şüphesiz Rabbimize döneceğiz.»"}]}, {"ayet": 51, "gruplar": [{"ar": [7, 8, 9, 10], "tr": "«Biz, ilk iman edenler olduğumuz için"}, {"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Rabbimizin hatalarımızı bağışlayacağını umarız.»"}]}, {"ayet": 52, "gruplar": [{"ar": [2, 3], "tr": "Musa’ya:"}, {"ar": [4, 5, 6], "tr": "Kullarımı geceleyin yola çıkar;"}, {"ar": [7, 8], "tr": "çünkü takip edileceksiniz,"}, {"ar": [1], "tr": "diye vahyettik."}]}, {"ayet": 53, "gruplar": [{"ar": [0, 1], "tr": "Firavun da"}, {"ar": [2, 3, 4], "tr": "şehirlere (asker) toplayıcılar gönderdi:"}]}, {"ayet": 54, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "«Esasen bunlar, sayıları az, bölük pörçük bir cemaattır.»"}]}, {"ayet": 55, "gruplar": [{"ar": [0, 1, 2], "tr": "«(Böyle iken) kesinkes bizi öfkelendirmişlerdir.»"}]}, {"ayet": 56, "gruplar": [{"ar": [0, 1, 2], "tr": "«Biz ise, elbette uyanık (ve yekvücut) bir cemaatız.» (diyor ve dedirtiyordu)."}]}, {"ayet": 57, "gruplar": [{"ar": [0], "tr": "Ama (sonunda) biz onları (Firavun ve kavmini),"}, {"ar": [1, 2], "tr": "bahçelerden,"}, {"ar": [3], "tr": "pınarlardan,"}]}, {"ayet": 58, "gruplar": [{"ar": [0], "tr": "hazinelerden"}, {"ar": [1, 2], "tr": "ve değerli bir yerden"}]}, {"ayet": 59, "gruplar": [{"ar": [0], "tr": "Böylece,"}, {"ar": [1, 2, 3], "tr": "bunlara İsrailoğullarını mirasçı yaptık."}]}, {"ayet": 60, "gruplar": [{"ar": [0], "tr": "Derken (Firavun ve adamları)"}, {"ar": [1], "tr": "gün doğumunda onların ardına düştüler."}]}, {"ayet": 61, "gruplar": [{"ar": [0, 1, 2], "tr": "İki topluluk birbirini görünce,"}, {"ar": [4, 5, 3], "tr": "Musa’nın adamları:"}, {"ar": [6, 7], "tr": "İşte yakalandık! dediler."}]}, {"ayet": 62, "gruplar": [{"ar": [0, 1], "tr": "Musa: Asla! dedi,"}, {"ar": [3, 4, 5, 6], "tr": "Rabbim şüphesiz benimledir, bana yol gösterecektir."}]}, {"ayet": 63, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Bunun üzerine Musa’ya:"}, {"ar": [4, 5, 6], "tr": "Asân ile denize vur! diye vahyettik."}, {"ar": [8], "tr": "(Vurunca deniz) derhal yarıldı (on iki yol açıldı),"}, {"ar": [9, 10, 11, 12, 13], "tr": "her bölük koca bir dağ gibi oldu."}]}, {"ayet": 64, "gruplar": [{"ar": [2, 1, 0], "tr": "Ötekilerini de oraya yaklaştırdık."}]}, {"ayet": 65, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Musa ve beraberinde bulunanların hepsini kurtardık."}]}, {"ayet": 66, "gruplar": [{"ar": [0], "tr": "Sonra"}, {"ar": [2, 1], "tr": "ötekilerini suda boğduk."}]}, {"ayet": 67, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Şüphesiz bunda bir ibret vardır;"}, {"ar": [5, 6, 7, 8], "tr": "ama çokları iman etmiş değillerdir."}]}, {"ayet": 68, "gruplar": [{"ar": [0, 1], "tr": "Şüphesiz Rabbin,"}, {"ar": [2, 3, 4], "tr": "işte O, mutlak galip ve engin merhamet sahibidir."}]}, {"ayet": 69, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "(Resûlüm!) Onlara İbrahim’in haberini de naklet."}]}, {"ayet": 70, "gruplar": [{"ar": [0, 1], "tr": "Hani o,"}, {"ar": [2, 3], "tr": "babasına ve kavmine:"}, {"ar": [4, 5], "tr": "Neye tapıyorsunuz? demişti."}]}]}