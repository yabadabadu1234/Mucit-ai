   ]
  },
  {
   "ayet": 5,
   "gruplar": [
    {
     "ar": [
      1,
      2
     ],
     "tr": "şaşıyorsan"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "asıl şaşılacak şey onların"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "«Biz toprak olduğumuz zaman"
    },
    {
     "ar": [
      8,
