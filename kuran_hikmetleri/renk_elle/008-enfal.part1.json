{"sure":8,"ayetler":[
{"ayet":1,"gruplar":[{"ar":[0,1,2],"tr":"Sana savaş ganimetlerini soruyorlar"},{"ar":[4],"tr":"De ki"},{"ar":[5],"tr":"Ganimetler"},{"ar":[6,7],"tr":"Allah ve Peygamber’e aittir"},{"ar":[18,19,20],"tr":"O halde siz (gerçek) müminler iseniz"},{"ar":[9,10],"tr":"Allah’tan korkun"},{"ar":[11,12,13],"tr":"aranızı düzeltin"},{"ar":[15,16,17],"tr":"Allah ve Resûlüne itaat edin"}]},
{"ayet":2,"gruplar":[{"ar":[0,1],"tr":"Müminler ancak"},{"ar":[3,4,5,6,7],"tr":"Allah anıldığı zaman yürekleri titreyen"},{"ar":[8,9,10,11],"tr":"kendilerine Allah’ın âyetleri okunduğunda"},{"ar":[12,13],"tr":"imanlarını artıran"},{"ar":[14,15,16],"tr":"ve yalnız Rablerine dayanıp güvenen"},{"ar":[2],"tr":"kimselerdir"}]},
{"ayet":3,"gruplar":[{"ar":[0,1,2],"tr":"Onlar namazlarını dosdoğru kılan"},{"ar":[3,4,5],"tr":"ve kendilerine rızık olarak verdiğimizden (Allah yolunda) harcayan kimselerdir"}]},
{"ayet":4,"gruplar":[{"ar":[0,1,2,3],"tr":"İşte onlar gerçek müminlerdir"},{"ar":[5],"tr":"Onlar için"},{"ar":[7,8],"tr":"Rableri katında"},{"ar":[6],"tr":"nice dereceler"},{"ar":[9],"tr":"bağışlanma"},{"ar":[10,11],"tr":"ve tükenmez bir rızık vardır"}]},
{"ayet":5,"gruplar":[{"ar":[6,7,8,9,10],"tr":"(Onların bu hali,) müminlerden bir gurup kesinlikle istemediği halde"},{"ar":[2,3,4],"tr":"Rabbinin seni evinden"},{"ar":[0,1,5],"tr":"hak uğruna çıkardığı (zamanki halleri) gibidir"}]},
{"ayet":6,"gruplar":[{"ar":[2,3,4,5],"tr":"Hak ortaya çıktıktan sonra"},{"ar":[6],"tr":"sanki"},{"ar":[10,11],"tr":"gözleri göre göre"},{"ar":[7,8,9],"tr":"ölüme sürükleniyorlarmış gibi"},{"ar":[0,1],"tr":"(cihad hususunda) seninle tartışıyorlardı"}]},
{"ayet":7,"gruplar":[{"ar":[0],"tr":"Hatırlayın ki"},{"ar":[1,2,3,4,5,6],"tr":"Allah size, iki taifeden (kervan veya Kureyş ordusundan) birinin sizin olduğunu vadediyordu"},{"ar":[7,8,9,10,11,12,13],"tr":"siz de kuvvetsiz olanın (kervanın) sizin olmasını istiyordunuz"},{"ar":[15],"tr":"Oysa Allah"},{"ar":[16,17,18,19],"tr":"sözleriyle hakkı gerçekleştirmek"},{"ar":[20,21,22],"tr":"ve (Kureyş ordusunu yok ederek) kâfirlerin ardını kesmek"},{"ar":[14],"tr":"istiyordu"}]},
{"ayet":8,"gruplar":[{"ar":[4,5,6],"tr":"(Bunlar,) günahkârlar istemese de"},{"ar":[0,1],"tr":"hakkı gerçekleştirmek"},{"ar":[2,3],"tr":"ve bâtılı ortadan kaldırmak içindi"}]},
{"ayet":9,"gruplar":[{"ar":[0,1,2],"tr":"Hatırlayın ki, siz Rabbinizden yardım istiyordunuz"},{"ar":[5,6,7,8,9,10],"tr":"O da, ben peşpeşe gelen bin melek ile size yardım edeceğim"},{"ar":[3,4],"tr":"diyerek duanızı kabul buyurdu"}]},
{"ayet":10,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah bunu (meleklerle yardımı) sadece müjde olsun"},{"ar":[5,6,7],"tr":"ve onunla kalbiniz yatışsın diye yapmıştı"},{"ar":[9,10,11,12,13,14],"tr":"Zaten yardım yalnız Allah tarafındandır"},{"ar":[16,17],"tr":"Çünkü Allah"},{"ar":[18],"tr":"mutlak galiptir"},{"ar":[19],"tr":"yegâne hüküm ve hikmet sahibidir"}]},
{"ayet":11,"gruplar":[{"ar":[0],"tr":"O zaman"},{"ar":[3,4],"tr":"katından bir güven olmak üzere"},{"ar":[1,2],"tr":"sizi hafif bir uykuya daldırıyordu"},{"ar":[10,11],"tr":"sizi temizlemek"},{"ar":[12,13,14,15],"tr":"şeytanın pisliğini (verdiği vesveseyi) sizden gidermek"},{"ar":[16,17,18],"tr":"kalplerinizi birbirine bağlamak"},{"ar":[19,20,21],"tr":"ve savaşta sebat ettirmek"},{"ar":[5,6,7,8,9],"tr":"için üzerinize gökten bir su (yağmur) indiriyordu"}]},
{"ayet":12,"gruplar":[{"ar":[0,2,3,4],"tr":"Hani Rabbin meleklere"},{"ar":[5,6],"tr":"«Muhakkak ben sizinle beraberim"},{"ar":[7,8,9],"tr":"haydi iman edenlere destek olun"},{"ar":[11,12,13,14,15,16],"tr":"Ben kâfirlerin yüreğine korku salacağım"},{"ar":[17,18,19],"tr":"vurun boyunlarına"},{"ar":[20,21,22,23],"tr":"Vurun onların bütün parmaklarına"},{"ar":[1],"tr":"diye vahyediyordu"}]},
{"ayet":13,"gruplar":[{"ar":[0],"tr":"Bu söylenenler"},{"ar":[1,2,3,4],"tr":"onların Allah’a ve Resûlüne karşı gelmelerinden ötürüdür"},{"ar":[6,7,8,9],"tr":"Kim Allah ve Resûlüne karşı gelirse"},{"ar":[10,11],"tr":"bilsin ki Allah"},{"ar":[12,13],"tr":"azabı şiddetli olandır"}]},
{"ayet":14,"gruplar":[{"ar":[0],"tr":"İşte bu yenilgi size Allah’ın azabı"},{"ar":[1],"tr":"Şimdilik onu tadın"},{"ar":[2,3,4,5],"tr":"Kâfirlere bir de cehennem ateşinin azabı vardır"}]},
{"ayet":15,"gruplar":[{"ar":[0,1,2],"tr":"Ey müminler"},{"ar":[3,4,5,6,7],"tr":"Toplu halde kâfirlerle karşılaştığınız zaman"},{"ar":[8,9,10],"tr":"onlara arkanızı dönmeyin. (Korkup kaçmayın)"}]},
{"ayet":16,"gruplar":[{"ar":[5,6],"tr":"Tekrar savaşmak için bir tarafa çekilme"},{"ar":[7,8,9,10,4],"tr":"veya diğer bölüğe ulaşıp mevzi tutma durumu dışında"},{"ar":[0,1,2,3],"tr":"kim öyle bir günde onlara arka çevirirse"},{"ar":[11,12,13,14,15],"tr":"muhakkak ki o, Allah’ın gazabını hak etmiş olarak döner"},{"ar":[16,17],"tr":"Onun yeri de cehennemdir"},{"ar":[19,20],"tr":"Orası, varılacak ne kötü yerdir"}]},
{"ayet":17,"gruplar":[{"ar":[0,1],"tr":"(Savaşta) onları siz öldürmediniz"},{"ar":[2,3,4],"tr":"fakat Allah öldürdü onları"},{"ar":[6,7,8,9],"tr":"attığın zaman da sen atmadın"},{"ar":[10,11,12],"tr":"fakat Allah attı (onu)"},{"ar":[14,15,16,17,18],"tr":"Ve bunu, müminleri güzel bir imtihanla denemek için (yaptı)"},{"ar":[20,21,22,23],"tr":"Şüphesiz Allah işitendir, bilendir"}]},
{"ayet":18,"gruplar":[{"ar":[0],"tr":"Bu böyledir"},{"ar":[1,2],"tr":"Şüphesiz Allah"},{"ar":[3,4,5],"tr":"kâfirlerin tuzağını bozar"}]},
{"ayet":19,"gruplar":[{"ar":[0,1],"tr":"(Ey kâfirler!) Eğer siz fetih istiyorsanız"},{"ar":[2,3,4],"tr":"işte size fetih geldi! (Yenelim derken yenildiniz.)"},{"ar":[6,7],"tr":"Ve eğer (inkardan) vazgeçerseniz"},{"ar":[8,9,10],"tr":"bu sizin için daha iyidir"},{"ar":[12,13],"tr":"Yine (Peygamber’e düşmanlığa) dönerseniz"},{"ar":[14],"tr":"biz de (ona) yardıma döneriz"},{"ar":[18,20,21],"tr":"Topluluğunuz çok bile olsa"},{"ar":[15,16,17,19],"tr":"sizden hiçbir şeyi savamaz"},{"ar":[22,23,24,25],"tr":"Çünkü Allah müminlerle beraberdir"}]},
{"ayet":20,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4,5],"tr":"Allah’a ve Resûlüne itaat edin"},{"ar":[9,10],"tr":"işittiğiniz halde"},{"ar":[6,7,8],"tr":"O’ndan yüz çevirmeyin"}]},
{"ayet":21,"gruplar":[{"ar":[5,6,7],"tr":"İşitmedikleri halde"},{"ar":[2,3,4],"tr":"işittik diyenler gibi"},{"ar":[0,1],"tr":"olmayın"}]},
{"ayet":22,"gruplar":[{"ar":[1,4,5],"tr":"Şüphesiz Allah katında"},{"ar":[2,3],"tr":"canlıların en kötüsü"},{"ar":[6,7,8,9,10],"tr":"düşünmeyen sağırlar ve dilsizlerdir"}]},
{"ayet":23,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah onlarda bir hayır görseydi"},{"ar":[5],"tr":"elbette onlara işittirirdi"},{"ar":[7,8],"tr":"Fakat işittirseydi bile"},{"ar":[9,10,11],"tr":"yine onlar yüz çevirerek dönerlerdi"}]},
{"ayet":24,"gruplar":[{"ar":[0,1,2],"tr":"Ey inananlar"},{"ar":[6,7,8,9],"tr":"Hayat verecek şeylere sizi çağırdığı zaman"},{"ar":[3,4,5],"tr":"Allah ve Resûlüne uyun"},{"ar":[11,12],"tr":"Ve bilin ki"},{"ar":[13,14,15,16,17],"tr":"Allah kişi ile onun kalbi arasına girer"},{"ar":[18,19,20],"tr":"ve siz mutlaka onun huzurunda toplanacaksınız"}]},
{"ayet":25,"gruplar":[{"ar":[0,1],"tr":"Bir de öyle bir fitneden sakının"},{"ar":[2,3,4,5,6,7],"tr":"ki o, içinizden sadece zulmedenlere erişmekle kalmaz (umuma sirayet ve hepsini perişan eder)"},{"ar":[9,10,11,12,13],"tr":"Biliniz ki, Allah’ın azabı şiddetlidir"}]}
]}
