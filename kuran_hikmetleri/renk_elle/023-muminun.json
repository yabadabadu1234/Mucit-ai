{
 "sure": 23,
 "ad": "Muminun",
 "ayetler": [
  {
   "ayet": 1,
   "gruplar": [
    {
     "ar": [
      2
     ],
     "tr": "Gerçekten müminler"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "kurtuluşa ermiştir;"
    }
   ]
  },
  {
   "ayet": 2,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Onlar ki,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "namazlarında huşû içindedirler;"
    }
   ]
  },
  {
   "ayet": 3,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Onlar ki,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "boş ve yararsız şeylerden yüz çevirirler;"
    }
   ]
  },
  {
   "ayet": 4,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Onlar ki,"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "zekâtı verirler;"
    }
   ]
  },
  {
   "ayet": 5,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Ve onlar ki,"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "iffetlerini korurlar;"
    }
   ]
  },
  {
   "ayet": 6,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Ancak eşleri"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "ve ellerinin sahip olduğu (câriyeleri) hariç."
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "(Bunlarla ilişkilerden dolayı) kınanmış değillerdir."
    }
   ]
  },
  {
   "ayet": 7,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Şu halde, kim"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "bunun ötesine gitmek isterse,"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "işte bunlar, haddi aşan kimselerdir."
    }
   ]
  },
  {
   "ayet": 8,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Yine onlar (o müminler) ki,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "emanetlerine ve ahidlerine riayet ederler;"
    }
   ]
  },
  {
   "ayet": 9,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Ve onlar ki,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "namazlarına devam ederler."
    }
   ]
  },
  {
   "ayet": 10,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "İşte, asıl bunlar vâris olacaklardır;"
    }
   ]
  },
  {
   "ayet": 11,
   "gruplar": [
    {
     "ar": [
      1,
      2
     ],
     "tr": "(Evet) Firdevs’e vâris olan"
    },
    {
     "ar": [
      0
     ],
     "tr": "bu kimseler,"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "orada ebedî kalıcıdırlar."
    }
   ]
  },
  {
   "ayet": 12,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Andolsun biz insanı,"
    },
    {
     "ar": [
      5,
      6,
      3,
      4
     ],
     "tr": "çamurdan (süzülüp çıkarılmış) bir özden yarattık."
    }
   ]
  },
  {
   "ayet": 13,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Sonra onu"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "sağlam bir karargâhta nutfe haline getirdik."
    }
   ]
  },
  {
   "ayet": 14,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sonra nutfeyi alaka (aşılanmış yumurta) yaptık."
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "Peşinden, alakayı, bir parçacık et haline soktuk;"
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "bu bir parçacık eti kemiklere (iskelete) çevirdik;"
    },
    {
     "ar": [
      10,
      11,
      12
     ],
     "tr": "bu kemikleri etle kapladık."
    },
    {
     "ar": [
      13,
      14,
      15,
      16
     ],
     "tr": "Sonra onu başka bir yaratışla insan haline getirdik."
    },
    {
     "ar": [
      20,
      21,
      19,
      18
     ],
     "tr": "Yapıp-yaratanların en güzeli olan Allah pek yücedir."
    }
   ]
  },
  {
   "ayet": 15,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Sonra, muhakkak ki siz,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "bunun ardından elbet öleceksiniz."
    }
   ]
  },
  {
   "ayet": 16,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Sonra da şüphesiz, sizler"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "kıyamet gününde tekrar diriltileceksiniz."
    }
   ]
  },
  {
   "ayet": 17,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Andolsun biz, sizin üstünüzde yedi yol yarattık."
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "Biz yaratmaktan habersiz değiliz."
    }
   ]
  },
  {
   "ayet": 18,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Gökten uygun bir ölçüde yağmur indirip"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "onu arzda durdurduk."
    },
    {
     "ar": [
      9,
      10,
      11,
      12,
      13
     ],
     "tr": "Bizim onu gidermeye de elbet gücümüz yeter."
    }
   ]
  },
  {
   "ayet": 19,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Böylece onun (yağmurun) sayesinde sizin yararınıza"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "hurma bahçeleri ve üzüm bağları meydana getirdik."
    },
    {
     "ar": [
      7,
      8,
      9,
      10
     ],
     "tr": "Bunlarda sizin için birçok meyveler vardır"
    },
    {
     "ar": [
      11,
      12
     ],
     "tr": "ve siz onlardan yersiniz."
    }
   ]
  },
  {
   "ayet": 20,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      4,
      5,
      0,
      1
     ],
     "tr": "Tûr-i Sînâ’da da yetişen bir ağaç daha meydana getirdik"
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "ki, bu ağaç hem yağ hem de yiyenlerin ekmeğine katık edecekleri (zeytin) verir."
    }
   ]
  },
  {
   "ayet": 21,
   "gruplar": [
    {
     "ar": [
      3,
      1,
      2,
      0,
      4
     ],
     "tr": "Hayvanlarda sizin için elbette ibretler vardır."
    },
    {
     "ar": [
      7,
      8,
      9,
      6
     ],
     "tr": "Onların karınlarındakinden (sütlerinden) size içiririz."
    },
    {
     "ar": [
      10,
      11,
      12,
      13
     ],
     "tr": "Onlarda sizin için birçok faydalar daha vardır;"
    },
    {
     "ar": [
      14,
      15
     ],
     "tr": "etlerinden de yersiniz."
    }
   ]
  },
  {
   "ayet": 22,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Onların üzerinde ve gemilerde"
    },
    {
     "ar": [
      3
     ],
     "tr": "taşınırsınız."
    }
   ]
  },
  {
   "ayet": 23,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Andolsun ki, Nuh’u kavmine gönderdik"
    },
    {
     "ar": [
      5
     ],
     "tr": "ve o:"
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "Ey kavmim! Allah’a kulluk edin."
    },
    {
     "ar": [
      9,
      10,
      11,
      12,
      13
     ],
     "tr": "Sizin için O’ndan başka bir tanrı yoktur."
    },
    {
     "ar": [
      15,
      16
     ],
     "tr": "Hâla sakınmaz mısınız? dedi."
    }
   ]
  },
  {
   "ayet": 24,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Bunun üzerine, kavminin inkarcı ileri gelenleri şöyle dediler:"
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "«Bu, sadece sizin gibi bir beşerdir."
    },
    {
     "ar": [
      11,
      12,
      13,
      14
     ],
     "tr": "Size üstün ve hâkim olmak istiyor."
    },
    {
     "ar": [
      15,
      16,
      17,
      18,
      19
     ],
     "tr": "Eğer Allah (peygamber göndermek) isteseydi, muhakkak ki melekler gönderirdi."
    },
    {
     "ar": [
      20,
      21,
      22,
      23,
      24,
      25
     ],
     "tr": "Biz geçmişteki atalarımızdan böyle bir şey duymadık.»"
    }
   ]
  },
  {
   "ayet": 25,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "«Bu, yalnızca kendisinde delilik bulunan bir kimsedir."
    },
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "Öyle ise, bir süreye kadar ona katlanıp bekleyin bakalım.»"
    }
   ]
  },
  {
   "ayet": 26,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "(Nuh), Rabbim! dedi,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "beni yalanlamalarına karşı bana yardım et!"
    }
   ]
  },
  {
   "ayet": 27,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Bunun üzerine ona şöyle vahyettik:"
    },
    {
     "ar": [
      5,
      6,
      3,
      4
     ],
     "tr": "Gözlerimizin önünde (muhafazamız altında) ve bildirdiğimiz şekilde gemiyi yap."
    },
    {
     "ar": [
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "Bizim emrimiz gelip de sular coşup yükselmeye başlayınca"
    },
    {
     "ar": [
      13,
      14,
      15,
      16,
      17,
      18
     ],
     "tr": "her cinsten birer çift ile,"
    },
    {
     "ar": [
      20,
      21,
      22,
      23,
      24,
      25,
      19
     ],
     "tr": "daha önce kendisi aleyhinde hüküm verilmiş olanların dışındaki aileni gemiye al."
    },
    {
     "ar": [
      27,
      28,
      29,
      30,
      31
     ],
     "tr": "Zulmetmiş olanlar konusunda bana hiç yalvarma!"
    },
    {
     "ar": [
      33,
      34
     ],
     "tr": "Zira onlar kesinlikle boğulacaklardır."
    }
   ]
  },
  {
   "ayet": 28,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "Sen, yanındakilerle birlikte gemiye yerleştiğinde:"
    },
    {
     "ar": [
      8,
      9,
      10,
      11,
      12,
      13,
      14
     ],
     "tr": "«Bizi zalimler topluluğundan kurtaran Allah’a hamdolsun»"
    },
    {
     "ar": [
      7
     ],
     "tr": "de."
    }
   ]
  },
  {
   "ayet": 29,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Ve de ki: Rabbim!"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Beni bereketli bir yere indir."
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "Sen, iskân edenlerin en hayırlısısın."
    }
   ]
  },
  {
   "ayet": 30,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Şüphesiz bunda (Nuh ve kavminin başından geçenlerde) birtakım ibretler vardır."
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "Hakikaten biz (kullarımızı böyle) deneriz."
    }
   ]
  },
  {
   "ayet": 31,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sonra onların ardından"
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "bir başka nesil meydana getirdik."
    }
   ]
  },
  {
   "ayet": 32,
   "gruplar": [
    {
     "ar": [
      3,
      1
     ],
     "tr": "Onlar arasından kendilerine:"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "«Allah’a kulluk edin."
    },
    {
     "ar": [
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "Sizin O’ndan başka bir tanrınız yoktur."
    },
    {
     "ar": [
      13,
      14
     ],
     "tr": "Hâla Allah’tan korkmaz mısınız?»"
    },
    {
     "ar": [
      0,
      2
     ],
     "tr": "(mesajını ileten) bir peygamber gönderdik."
    }
   ]
  },
  {
   "ayet": 33,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      1,
      0
     ],
     "tr": "Onun kavminden,"
    },
    {
     "ar": [
      4,
      5,
      6,
      7,
      8
     ],
     "tr": "kâfir olup ahirete ulaşmayı inkâr eden"
    },
    {
     "ar": [
      9,
      10,
      11,
      12
     ],
     "tr": "ve dünya hayatında kendilerine refah verdiğimiz varlıklı kişiler:"
    },
    {
     "ar": [
      13,
      14,
      15,
      16,
      17
     ],
     "tr": "«Bu, dediler, sadece sizin gibi bir insandır;"
    },
    {
     "ar": [
      18,
      19,
      20,
      21
     ],
     "tr": "sizin yediğinizden yer,"
    },
    {
     "ar": [
      22,
      23,
      24
     ],
     "tr": "sizin içtiğinizden içer.»"
    }
   ]
  },
  {
   "ayet": 34,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "«Gerçekten, sizin gibi bir beşere itaat ederseniz,"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "herhalde ziyan edersiniz.»"
    }
   ]
  },
  {
   "ayet": 35,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«Size,"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "öldüğünüz, toprak ve kemik yığını haline geldiğinizde,"
    },
    {
     "ar": [
      7,
      8
     ],
     "tr": "mutlak surette sizin (kabirden) çıkarılacağınızı mı vâdediyor?»"
    }
   ]
  },
  {
   "ayet": 36,
   "gruplar": [
    {
     "ar": [
      3,
      4
     ],
     "tr": "«Bu size vaâdedilen"
    },
    {
     "ar": [
      1,
      2
     ],
     "tr": "(öldükten sonra yeniden dirilmek, gerçek olmaktan) çok uzak!»"
    }
   ]
  },
  {
   "ayet": 37,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "«Hayat, şu dünya hayatımızdan ibarettir."
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "(Kimimiz) ölürüz, (kimimiz) yaşarız;"
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "bir daha diriltilecek de değiliz.»"
    }
   ]
  },
  {
   "ayet": 38,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "«O, Allah hakkında yalnızca yalan uyduran bir adamdır;"
    },
    {
     "ar": [
      8,
      9,
      10,
      11
     ],
     "tr": "biz ona inanmıyoruz.»"
    }
   ]
  },
  {
   "ayet": 39,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "O peygamber:"
    },
    {
     "ar": [
      1
     ],
     "tr": "Rabbim! dedi,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "beni yalanlamalarına karşılık bana yardımcı ol!"
    }
   ]
  },
  {
   "ayet": 40,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Allah şöyle buyurdu:"
    },
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "Pek yakında onlar mutlaka pişman olacaklar!"
    }
   ]
  },
  {
   "ayet": 41,
   "gruplar": [
    {
     "ar": [
      2,
      0,
      1
     ],
     "tr": "Nitekim, vukuu kaçınılmaz olan korkunç bir ses yakalayıverdi onları!"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "Kendilerini hemen sel süprüntüsüne çevirdik."
    },
    {
     "ar": [
      6,
      7,
      8
     ],
     "tr": "Zalimler topluluğunun canı cehenneme!"
    }
   ]
  },
  {
   "ayet": 42,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sonra onların ardından"
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "başka nesiller getirdik."
    }
   ]
  },
  {
   "ayet": 43,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Hiçbir ümmet, ecelini ne öne alabilir,"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ne de erteleyebilir."
    }
   ]
  },
  {
   "ayet": 44,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sonra biz peyderpey peygamberlerimizi gönderdik."
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "Herhangi bir ümmete peygamberlerinin geldiği her defasında,"
    },
    {
     "ar": [
      10
     ],
     "tr": "onlar bu peygamberi yalanladılar;"
    },
    {
     "ar": [
      12,
      13,
      14
     ],
     "tr": "biz de onları birbiri ardından yok ettik"
    },
    {
     "ar": [
      15,
      16
     ],
     "tr": "ve onları ibret hikâyelerine dönüştürdük."
    },
    {
     "ar": [
      18,
      19,
      20,
      21
     ],
     "tr": "Artık iman etmeyen kavmin canı cehenneme!"
    }
   ]
  },
  {
   "ayet": 45,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Sonra"
    },
    {
     "ar": [
      5
     ],
     "tr": "âyetlerimizle"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "ve apaçık bir fermanla"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Musa ve kardeşi Harun’u"
    },
    {
     "ar": [
      1
     ],
     "tr": "Firavun’a ve ileri gelenlerine gönderdik."
    }
   ]
  },
  {
   "ayet": 46,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Firavun’a ve ileri gelenlerine"
    },
    {
     "ar": [
      3
     ],
     "tr": "Onlar ise kibire kapıldılar"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "ve ululuk taslayan bir kavim oldular."
    }
   ]
  },
  {
   "ayet": 47,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Bu yüzden dediler ki:"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "Kavimleri bize kölelik ederken,"
    },
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "bizim gibi olan bu iki adama inanır mıyız?"
    }
   ]
  },
  {
   "ayet": 48,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Böylece onları yalanladılar"
    },
    {
     "ar": [
      1,
      2,
      3
     ],
     "tr": "ve bu sebeple helâk edilenlerden oldular."
    }
   ]
  },
  {
   "ayet": 49,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Andolsun biz Musa’ya,"
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "belki onlar yola gelirler diye,"
    },
    {
     "ar": [
      3
     ],
     "tr": "Kitab’ı verdik."
    }
   ]
  },
  {
   "ayet": 50,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Meryem oğlunu ve annesini de (kudretimize) bir alâmet kıldık;"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "onları, yerleşmeye elverişli, suyu bulunan bir tepeye yerleştirdik."
    }
   ]
  },
  {
   "ayet": 51,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«Ey Peygamberler!"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Temiz olan şeylerden yeyin;"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "güzel işler yapın."
    },
    {
     "ar": [
      8,
      9,
      10,
      11
     ],
     "tr": "Ben sizin yaptıklarınızı hakkıyle bilmekteyim.»"
    }
   ]
  },
  {
   "ayet": 52,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Şüphesiz bu (insanlar) bir tek ümmet olarak sizin ümmetinizdir;"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "ben de sizin Rabbinizim."
    },
    {
     "ar": [
      7
     ],
     "tr": "Öyle ise benden sakının» (denildi)."
    }
   ]
  },
  {
   "ayet": 53,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Ne var ki insanlar kendi aralarındaki işlerini parça parça böldüler."
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "Her gurup kendilerinde bulunan (fikir ve davranış) ile sevinip böbürlenmektedirler."
    }
   ]
  },
  {
   "ayet": 54,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Şimdi sen onları bir zamana kadar gaflet ve sapıklıkları ile başbaşa bırak!"
    }
   ]
  },
  {
   "ayet": 55,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Sanıyorlar mı ki,"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "onlara verdiğimiz servet ve oğullar ile"
    }
   ]
  },
  {
   "ayet": 56,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "kendilerine faydalar sağlamak için can atıyoruz?"
    },
    {
     "ar": [
      5
     ],
     "tr": "Hayır,"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "onlar işin farkına varamıyorlar."
    }
   ]
  },
  {
   "ayet": 57,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Rablerine olan saygıdan dolayı"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "kötülükten sakınanlar;"
    }
   ]
  },
  {
   "ayet": 58,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Rablerinin âyetlerine"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "inananlar;"
    }
   ]
  },
  {
   "ayet": 59,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Rablerine ortak tanımayanlar;"
    }
   ]
  },
  {
   "ayet": 60,
   "gruplar": [
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "Ve Rablerine dönecekleri için"
    },
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "yapmakta oldukları işleri"
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "kalpleri çarparak yapanlar;"
    }
   ]
  },
  {
   "ayet": 61,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "İşte onlar, iyiliklere koşuşurlar"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "ve iyilik için yarışırlar."
    }
   ]
  },
  {
   "ayet": 62,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Biz hiç kimseyi gücünün yettiğinden başkası ile yükümlü kılmayız."
    },
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "Nezdimizde hakkı söyleyen bir kitap vardır"
    },
    {
     "ar": [
      11,
      12,
      13
     ],
     "tr": "ve onlar haksızlığa uğratılmazlar."
    }
   ]
  },
  {
   "ayet": 63,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Hayır, onların (o inkârcıların) kalpleri bu hususta cehâlet içindedir."
    },
    {
     "ar": [
      6,
      7,
      8,
      9,
      10
     ],
     "tr": "Ayrıca onların bundan (bu şirk ve inkârcılıklarından) öte birtakım (kötü) işleri vardır ki,"
    },
    {
     "ar": [
      11,
      12,
      13
     ],
     "tr": "onlar bu işleri yapar dururlar."
    }
   ]
  },
  {
   "ayet": 64,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "En nihayet,"
    },
    {
     "ar": [
      3,
      2,
      4
     ],
     "tr": "refah ve bolluk içinde olanlarını sıkıntıya (veya azaba) uğrattığımızda,"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "bakarsın ki onlar feryadı basarlar."
    }
   ]
  },
  {
   "ayet": 65,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Boşuna sızlanmayın bugün!"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "Zira bizden yardım göremeyeceksiniz!"
    }
   ]
  },
  {
   "ayet": 66,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Çünkü âyetlerim size okunurdu da,"
    },
    {
     "ar": [
      5,
      6,
      7,
      8
     ],
     "tr": "siz, buna karşı kibirlenerek arkanızı döner,"
    }
   ]
  },
  {
   "ayet": 67,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "kibirlenerek"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "geceleyin (Kâbe’nin etrafında toplanarak) hezeyanlar savururdunuz."
    }
   ]
  },
  {
   "ayet": 68,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Onlar bu sözü (Kur’an’ı) hiç düşünmediler mi?"
    },
    {
     "ar": [
      3,
      4,
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "Yoksa kendilerine, daha önce geçmişteki atalarına gelmeyen bir şey mi geldi?"
    }
   ]
  },
  {
   "ayet": 69,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Yoksa Peygamberlerini henüz tanımadılar da"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "bu yüzden mi onu inkâr ediyorlar?"
    }
   ]
  },
  {
   "ayet": 70,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Yoksa onda bir cinnet olduğunu mu söylüyorlar?"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "Hayır; o, kendilerine hakkı getirmiştir."
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "Onların çoğu ise haktan hoşlanmamaktadırlar."
    }
   ]
  },
  {
   "ayet": 71,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Eğer hak, onların kötü arzu ve isteklerine uysaydı,"
    },
    {
     "ar": [
      4,
      5,
      6,
      7,
      8
     ],
     "tr": "mutlaka gökler ve yer ile bunlarda bulunanlar bozulur giderdi."
    },
    {
     "ar": [
      10,
      11,
      12
     ],
     "tr": "Hayır, biz onlara şan ve şereflerini getirdik;"
    },
    {
     "ar": [
      13,
      14,
      15,
      16
     ],
     "tr": "fakat onlar kendi şereflerine sırt çevirdiler."
    }
   ]
  },
  {
   "ayet": 72,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "(Resûlüm!) Yoksa sen onlardan bir karşılık mı istiyorsun?"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "Rabbinin karşılığı daha hayırlıdır."
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "O, rızık verenlerin en hayırlısıdır."
    }
   ]
  },
  {
   "ayet": 73,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Gerçek şu ki sen onları"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "doğru bir yola çağırıyorsun."
    }
   ]
  },
  {
   "ayet": 74,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Ahirete inanmayanlar ise,"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "ısrarla yoldan çıkmaktadırlar."
    }
   ]
  },
  {
   "ayet": 75,
   "gruplar": [
    {
     "ar": [
      1,
      2
     ],
     "tr": "Eğer onlara acıyıp da"
    },
    {
     "ar": [
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "içinde bulundukları sıkıntıyı giderseydik,"
    },
    {
     "ar": [
      11,
      8,
      9,
      10
     ],
     "tr": "iyice körleşerek azgınlıklarında direnirlerdi."
    }
   ]
  },
  {
   "ayet": 76,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Andolsun, biz onları sıkıntıya düşürdük de"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "yine Rablerine boyun eğmediler,"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "tazarru ve niyazda da bulunmuyorlar."
    }
   ]
  },
  {
   "ayet": 77,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "En nihayet"
    },
    {
     "ar": [
      3,
      4,
      5,
      6,
      7,
      2
     ],
     "tr": "üzerlerine, azabı çok şiddetli bir kapı açtığımız zaman,"
    },
    {
     "ar": [
      8,
      9,
      10,
      11
     ],
     "tr": "bir de bakarsın ki onlar orada şaşkın ve ümitsiz kalmışlardır!"
    }
   ]
  },
  {
   "ayet": 78,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "O,"
    },
    {
     "ar": [
      3,
      4,
      5,
      6,
      2
     ],
     "tr": "sizin için kulakları, gözleri ve gönülleri yaratandır."
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "Ne de az şükrediyorsunuz!"
    }
   ]
  },
  {
   "ayet": 79,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Ve O,"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "sizi yeryüzünde yaratıp türetendir."
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "Sırf O’nun huzurunda toplanacaksınız."
    }
   ]
  },
  {
   "ayet": 80,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Ve O, yaşatan ve öldürendir;"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "gecenin ve gündüzün değişmesi O’nun eseridir."
    },
    {
     "ar": [
      9,
      10
     ],
     "tr": "Hâla aklınızı kullanmaz mısınız!"
    }
   ]
  },
  {
   "ayet": 81,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Buna rağmen"
    },
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "onlar, öncekilerin dedikleri gibi dediler."
    }
   ]
  },
  {
   "ayet": 82,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Dediler ki:"
    },
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Sahi biz, ölüp de bir toprak ve kemik yığını haline gelmişken,"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "mutlaka yeniden diriltileceğiz öyle mi?"
    }
   ]
  },
  {
   "ayet": 83,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Hakikaten,"
    },
    {
     "ar": [
      2
     ],
     "tr": "gerek bize, gerekse"
    },
    {
     "ar": [
      5,
      6,
      3
     ],
     "tr": "daha önce atalarımıza"
    },
    {
     "ar": [
      4,
      1
     ],
     "tr": "böyle bir vaadde bulunuldu;"
    },
    {
     "ar": [
      7,
      8,
      9,
      10,
      11
     ],
     "tr": "(fakat) bu geçmiştekilerin masallarından başka bir şey değildir!"
    }
   ]
  },
  {
   "ayet": 84,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Resûlüm!) de ki:"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "Eğer biliyorsanız (söyleyin bakalım),"
    },
    {
     "ar": [
      2,
      3,
      4,
      1
     ],
     "tr": "bu dünya ve onda bulunanlar kime aittir?"
    }
   ]
  },
  {
   "ayet": 85,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«Allah’a aittir» diyecekler."
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "Öyle ise siz hiç düşünüp taşınmaz mısınız!"
    },
    {
     "ar": [
      3
     ],
     "tr": "de."
    }
   ]
  },
  {
   "ayet": 86,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      4,
      5,
      6,
      7
     ],
     "tr": "Yedi kat göklerin Rabbi, azametli Arş’ın Rabbi"
    },
    {
     "ar": [
      1
     ],
     "tr": "kimdir?"
    },
    {
     "ar": [
      0
     ],
     "tr": "diye sor."
    }
   ]
  },
  {
   "ayet": 87,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«(Bunlar da) Allah’ındır» diyecekler."
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "Şu halde siz Allah’tan korkmaz mısınız!"
    },
    {
     "ar": [
      3
     ],
     "tr": "de."
    }
   ]
  },
  {
   "ayet": 88,
   "gruplar": [
    {
     "ar": [
      11,
      12,
      13
     ],
     "tr": "Eğer biliyorsanız (söyleyin),"
    },
    {
     "ar": [
      2,
      3,
      4,
      5
     ],
     "tr": "her şeyin melekûtu (mülkiyeti ve yönetimi) kendisinin elinde olan,"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "kendisi her şeyi koruyup kollayan,"
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "fakat kendisi korunmayan (buna muhtaç olmayan)"
    },
    {
     "ar": [
      1
     ],
     "tr": "kimdir?"
    },
    {
     "ar": [
      0
     ],
     "tr": "diye sor."
    }
   ]
  },
  {
   "ayet": 89,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "«(Bunların hepsi) Allah’ındır» diyecekler."
    },
    {
     "ar": [
      4,
      5
     ],
     "tr": "Öyle ise nasıl olup da büyüye kapılıyorsunuz?"
    },
    {
     "ar": [
      3
     ],
     "tr": "de."
    }
   ]
  },
  {
   "ayet": 90,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Doğrusu biz onlara gerçeği getirdik;"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "onlar ise hakikaten yalancılardır."
    }
   ]
  },
  {
   "ayet": 91,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Allah evlât edinmemiştir;"
    },
    {
     "ar": [
      5,
      6,
      7,
      8,
      9
     ],
     "tr": "O’nunla beraber hiçbir tanrı da yoktur."
    },
    {
     "ar": [
      11
     ],
     "tr": "Aksi takdirde"
    },
    {
     "ar": [
      12,
      13,
      14,
      15,
      16
     ],
     "tr": "her tanrı kendi yarattığını sevk ve idare eder"
    },
    {
     "ar": [
      17,
      18,
      19,
      20
     ],
     "tr": "ve mutlaka onlardan biri diğerine galebe çalardı."
    },
    {
     "ar": [
      22,
      23,
      24,
      25
     ],
     "tr": "Allah, onların (müşriklerin) yakıştırdıkları şeylerden münezzehtir."
    }
   ]
  },
  {
   "ayet": 92,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Allah, gaybı da şehâdeti de bilendir."
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "O, müşriklerin ortak koştukları şeylerden çok yüce ve münezzehtir."
    }
   ]
  },
  {
   "ayet": 93,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Resûlüm!) De ki:"
    },
    {
     "ar": [
      1
     ],
     "tr": "«Rabbim!"
    },
    {
     "ar": [
      2,
      3,
      4,
      5
     ],
     "tr": "Eğer onlara yöneltilen tehdidi (dünyevî sıkıntıyı ve uhrevî azabı) mutlaka bana göstereceksen;"
    }
   ]
  },
  {
   "ayet": 94,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "bu durumda beni zalimler topluluğunun içinde bulundurma"
    },
    {
     "ar": [
      0
     ],
     "tr": "Rabbim!»"
    }
   ]
  },
  {
   "ayet": 95,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "Biz, onlara yönelttiğimiz tehdidi sana göstermeye elbette ki kadiriz."
    }
   ]
  },
  {
   "ayet": 96,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Sen, kötülüğü en güzel bir tutumla sav."
    },
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "Biz onların yakıştırmakta oldukları şeyi çok iyi bilmekteyiz."
    }
   ]
  },
  {
   "ayet": 97,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Ve de ki: Rabbim!"
    },
    {
     "ar": [
      5,
      6,
      2,
      3
     ],
     "tr": "Şeytanların kışkırtmalarından sana sığınırım!"
    }
   ]
  },
  {
   "ayet": 98,
   "gruplar": [
    {
     "ar": [
      3,
      4
     ],
     "tr": "Onların yanımda bulunmalarından da"
    },
    {
     "ar": [
      0,
      1
     ],
     "tr": "sana sığınırım,"
    },
    {
     "ar": [
      2
     ],
     "tr": "Rabbim!"
    }
   ]
  },
  {
   "ayet": 99,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Nihayet onlardan (müşriklerden) birine ölüm gelip çattığında:"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "«Rabbim! der, beni geri gönder;»"
    }
   ]
  },
  {
   "ayet": 100,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "«Ta ki boşa geçirdiğim dünyada iyi iş (ve hareketler) yapayım.»"
    },
    {
     "ar": [
      6
     ],
     "tr": "Hayır!"
    },
    {
     "ar": [
      8,
      9,
      10,
      11
     ],
     "tr": "Bu onun ağzından çıkan (boş) bir laftan ibarettir."
    },
    {
     "ar": [
      13,
      14,
      15,
      16,
      17,
      18
     ],
     "tr": "Onların gerisinde ise, yeniden dirilecekleri güne kadar (süren) bir berzah vardır."
    }
   ]
  },
  {
   "ayet": 101,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sûra üflendiği zaman"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "artık aralarında akrabalık bağları kalmamıştır;"
    },
    {
     "ar": [
      8,
      9
     ],
     "tr": "birbirlerini de arayıp sormazlar."
    }
   ]
  },
  {
   "ayet": 102,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Artık kimlerin (sevap) tartıları ağır basarsa,"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "işte asıl bunlar kurtuluşa erenlerdir."
    }
   ]
  },
  {
   "ayet": 103,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Kimlerin de tartıları hafif gelirse,"
    },
    {
     "ar": [
      3,
      4,
      5,
      6
     ],
     "tr": "artık bunlar da kendilerine yazık etmişlerdir;"
    },
    {
     "ar": [
      7,
      8,
      9
     ],
     "tr": "(çünkü onlar) ebedî cehennemdedirler."
    }
   ]
  },
  {
   "ayet": 104,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Ateş yüzlerini yakar;"
    },
    {
     "ar": [
      3,
      4,
      5
     ],
     "tr": "orada suratları çirkin ve gülünç bir halde bulunurlar."
    }
   ]
  },
  {
   "ayet": 105,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Size âyetlerim okunurdu da,"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "siz onları yalanlardınız değil mi?"
    }
   ]
  },
  {
   "ayet": 106,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "Derler ki: Rabbimiz!"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "Azgınlığımız bizi altetti;"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "biz, bir sapıklar topluluğu idik."
    }
   ]
  },
  {
   "ayet": 107,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Rabbimiz! Bizi buradan çıkar."
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "Eğer bir daha (ettiklerimize) dönersek,"
    },
    {
     "ar": [
      5,
      6
     ],
     "tr": "artık belli ki biz zalim insanlarız."
    }
   ]
  },
  {
   "ayet": 108,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Buyurur ki: Alçaldıkça alçalın orada!"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "Bana karşı konuşmayın artık!"
    }
   ]
  },
  {
   "ayet": 109,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4
     ],
     "tr": "Zira kullarımdan bir zümre:"
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "Rabbimiz! Biz iman ettik;"
    },
    {
     "ar": [
      8,
      9,
      10
     ],
     "tr": "öyle ise bizi affet; bize acı!"
    },
    {
     "ar": [
      11,
      12,
      13,
      5
     ],
     "tr": "Sen, merhametlilerin en iyisisin, demişlerdi."
    }
   ]
  },
  {
   "ayet": 110,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "İşte siz onları alaya aldınız;"
    },
    {
     "ar": [
      2,
      3,
      4
     ],
     "tr": "sonunda onlar (ile alay etmeniz) size beni yâdetmeyi unutturdu,"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "siz onlara gülüyordunuz."
    }
   ]
  },
  {
   "ayet": 111,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2
     ],
     "tr": "Bugün ben onlara,"
    },
    {
     "ar": [
      3,
      4
     ],
     "tr": "sabrettiklerinin karşılığını verdim;"
    },
    {
     "ar": [
      5,
      6,
      7
     ],
     "tr": "onlar, hakikaten muratlarına erenlerdir."
    }
   ]
  },
  {
   "ayet": 112,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "(Allah inkârcılara)"
    },
    {
     "ar": [
      2,
      3,
      4,
      5,
      6
     ],
     "tr": "«Yeryüzünde kaç yıl kaldınız?»"
    },
    {
     "ar": [
      1
     ],
     "tr": "diye sorar."
    }
   ]
  },
  {
   "ayet": 113,
   "gruplar": [
    {
     "ar": [
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "«Bir gün veya günün bir kısmı kadar kaldık."
    },
    {
     "ar": [
      6,
      7
     ],
     "tr": "İşte sayanlara sor»"
    },
    {
     "ar": [
      0
     ],
     "tr": "derler."
    }
   ]
  },
  {
   "ayet": 114,
   "gruplar": [
    {
     "ar": [
      0
     ],
     "tr": "Buyurur:"
    },
    {
     "ar": [
      1,
      2,
      3,
      4
     ],
     "tr": "Sadece az bir süre kaldınız;"
    },
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "keşke siz (bunu) bilmiş olsaydınız!"
    }
   ]
  },
  {
   "ayet": 115,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3
     ],
     "tr": "Sizi sadece boş yere yarattığımızı"
    },
    {
     "ar": [
      4,
      5,
      6,
      7
     ],
     "tr": "ve sizin hakikaten huzurumuza geri getirilmeyeceğinizi mi sandınız?"
    }
   ]
  },
  {
   "ayet": 116,
   "gruplar": [
    {
     "ar": [
      2,
      3,
      0,
      1
     ],
     "tr": "Mutlak hakim ve hak olan Allah, çok yücedir."
    },
    {
     "ar": [
      5,
      6,
      7,
      8
     ],
     "tr": "O’ndan başka tanrı yoktur,"
    },
    {
     "ar": [
      9,
      10,
      11
     ],
     "tr": "O, yüce Arş’ın sahibidir."
    }
   ]
  },
  {
   "ayet": 117,
   "gruplar": [
    {
     "ar": [
      0,
      1,
      2,
      3,
      4,
      5
     ],
     "tr": "Her kim Allah ile birlikte diğer bir tanrıya taparsa,"
    },
    {
     "ar": [
      6,
      7,
      8,
      9
     ],
     "tr": "-ki bu hususla ilgili hiçbir delili yoktur-"
    },
    {
     "ar": [
      10,
      11,
      12,
      13
     ],
     "tr": "o kimsenin hesabı ancak Rabbinin nezdindedir."
    },
    {
     "ar": [
      15,
      16,
      17,
      18
     ],
     "tr": "Şurası muhakkak ki kâfirler iflah olmaz."
    }
   ]
  },
  {
   "ayet": 118,
   "gruplar": [
    {
     "ar": [
      0,
      1
     ],
     "tr": "(Resûlüm!) De ki:"
    },
    {
     "ar": [
      2,
      3
     ],
     "tr": "Bağışla ve merhamet et Rabbim!"
    },
    {
     "ar": [
      4,
      5,
      6
     ],
     "tr": "Sen merhametlilerin en iyisisin."
    }
   ]
  }
 ]
}