{"ayetler": [
 {"ayet":31,"gruplar":[{"ar":[1],"tr":"Allah Âdem’e"},{"ar":[2,3],"tr":"bütün isimleri"},{"ar":[0],"tr":"öğretti"},{"ar":[4],"tr":"Sonra"},{"ar":[5,6,7],"tr":"onları önce meleklere arzedip"},{"ar":[12,13,14],"tr":"Eğer siz sözünüzde sadık iseniz"},{"ar":[10,11],"tr":"şunların isimlerini"},{"ar":[9],"tr":"bana bildirin"},{"ar":[8],"tr":"dedi"}]},
 {"ayet":32,"gruplar":[{"ar":[0],"tr":"Melekler: Yâ Rab!"},{"ar":[1],"tr":"Seni noksan sıfatlardan tenzih ederiz"},{"ar":[5,6,7,4],"tr":"senin bize öğrettiklerinden başka"},{"ar":[2,3],"tr":"bizim bilgimiz yoktur"},{"ar":[9,10,11,12],"tr":"Şüphesiz alîm ve hakîm olan ancak sensin, dediler"}]},
 {"ayet":33,"gruplar":[{"ar":[1],"tr":"Ey Âdem!"},{"ar":[2,3,0],"tr":"Eşyanın isimlerini meleklere anlat, dedi"},{"ar":[5,6,7],"tr":"Âdem onların isimlerini onlara anlatınca"},{"ar":[12,11],"tr":"Ben size"},{"ar":[13,14,15,16],"tr":"muhakkak semâvat ve arzda görülmeyenleri (oralardaki sırları) bilirim"},{"ar":[17,18,19,20,21,22],"tr":"Bundan da öte, gizli ve açık yapmakta olduklarınızı da bilirim"},{"ar":[8,9,10],"tr":"dememiş miydim? dedi"}]},
 {"ayet":34,"gruplar":[{"ar":[0,1,2],"tr":"Hani biz meleklere (ve cinlere):"},{"ar":[4,3],"tr":"Âdem’e secde edin, demiştik"},{"ar":[6,7,5],"tr":"İblis hariç hepsi secde ettiler"},{"ar":[8],"tr":"O yüz çevirdi"},{"ar":[9],"tr":"ve büyüklük tasladı"},{"ar":[10,11,12],"tr":"böylece kâfirlerden oldu"}]},
 {"ayet":35,"gruplar":[{"ar":[0],"tr":"Biz:"},{"ar":[1],"tr":"Ey Âdem!"},{"ar":[3,4],"tr":"Sen ve eşin (Havva)"},{"ar":[5,2],"tr":"beraberce cennete yerleşin"},{"ar":[8],"tr":"orada kolaylıkla"},{"ar":[9,10],"tr":"istediğiniz zaman her yerde"},{"ar":[7,6],"tr":"cennet nimetlerinden yeyin"},{"ar":[11,12,13,14],"tr":"sadece şu ağaca yaklaşmayın"},{"ar":[15,16,17],"tr":"Eğer bu ağaçtan yerseniz her ikiniz de kendine kötülük eden zalimlerden olursunuz, dedik"}]},
 {"ayet":36,"gruplar":[{"ar":[1,0],"tr":"Şeytan onların ayaklarını kaydırıp haddi tecavüz ettirdi"},{"ar":[3],"tr":"ve"},{"ar":[4,5,6],"tr":"içinde bulundukları (cennetten)"},{"ar":[3],"tr":"onları çıkardı"},{"ar":[8],"tr":"Bunun üzerine:"},{"ar":[10,11,12],"tr":"Bir kısmınız diğerine düşman olarak"},{"ar":[9],"tr":"ininiz"},{"ar":[14,15,16],"tr":"sizin için yeryüzünde"},{"ar":[17],"tr":"barınak"},{"ar":[18,19,20],"tr":"ve belli bir zamana dek yaşamak vardır, dedik"}]},
 {"ayet":37,"gruplar":[{"ar":[1],"tr":"Âdem,"},{"ar":[2,3,4],"tr":"Rabbinden bir takım ilhamlar"},{"ar":[0],"tr":"aldı"},{"ar":[5,6],"tr":"derhal tevbe etti"},{"ar":[8,9,10,11],"tr":"Çünkü Allah tevbeleri kabul eden ve merhameti bol olandır"}]},
 {"ayet":38,"gruplar":[{"ar":[0],"tr":"Dedik ki:"},{"ar":[1,2,3],"tr":"Hepiniz cennetten inin!"},{"ar":[5,6,7,8],"tr":"Eğer benden size bir hidayet gelir de"},{"ar":[9,10,11],"tr":"her kim hidayetime tâbi olursa"},{"ar":[12,13,14],"tr":"onlar için herhangi bir korku yoktur"},{"ar":[15,16,17],"tr":"ve onlar üzüntü çekmezler"}]},
 {"ayet":39,"gruplar":[{"ar":[0,1],"tr":"İnkâr edip"},{"ar":[2,3],"tr":"âyetlerimizi yalanlayanlara gelince"},{"ar":[4,5,6],"tr":"onlar cehennemliktir"},{"ar":[8,9,10],"tr":"onlar orada ebedî kalırlar"}]},
 {"ayet":40,"gruplar":[{"ar":[0,1],"tr":"Ey İsrailoğulları!"},{"ar":[3,4,5,6,2],"tr":"Size verdiğim nimetlerimi hatırlayın"},{"ar":[8,7],"tr":"bana verdiğiniz sözü yerine getirin"},{"ar":[9,10],"tr":"ki, ben de size vâdettiklerimi vereyim"},{"ar":[11,12],"tr":"Yalnızca benden korkun"}]},
 {"ayet":41,"gruplar":[{"ar":[4,5],"tr":"Elinizdekini (Tevrat’ın aslını)"},{"ar":[3],"tr":"tasdik edici olarak"},{"ar":[1,2],"tr":"indirdiğime (Kur’an’a)"},{"ar":[0],"tr":"iman edin"},{"ar":[6,7,8,9,10],"tr":"Sakın onu inkâr edenlerin ilki olmayın"},{"ar":[12,13,14,15,16],"tr":"Âyetlerimi az bir karşılık ile satmayın"},{"ar":[17,18],"tr":"yalnız benden (benim azabımdan) korkun"}]},
 {"ayet":42,"gruplar":[{"ar":[6,7],"tr":"Bilerek"},{"ar":[2,3,0,1],"tr":"hakkı bâtıl ile karıştırmayın"},{"ar":[4,5],"tr":"hakkı gizlemeyin"}]},
 {"ayet":43,"gruplar":[{"ar":[0,1],"tr":"Namazı tam kılın"},{"ar":[2,3],"tr":"zekâtı hakkıyla verin"},{"ar":[4,5,6],"tr":"rükû edenlerle beraber rükû edin"}]},
 {"ayet":44,"gruplar":[{"ar":[6,7,8],"tr":"Sizler Kitab’ı (Tevrat’ı) okuduğunuz (gerçekleri bildiğiniz) halde"},{"ar":[2,3,1],"tr":"insanlara iyiliği emredip"},{"ar":[4,5],"tr":"kendinizi unutuyor musunuz"},{"ar":[10,11],"tr":"Aklınızı kullanmıyor musunuz"}]},
 {"ayet":45,"gruplar":[{"ar":[1,2],"tr":"Sabır ve namaz ile"},{"ar":[0],"tr":"Allah’tan yardım isteyin"},{"ar":[4],"tr":"Şüphesiz o (sabır ve namaz),"},{"ar":[6,7,8],"tr":"Allah’a saygıdan kalbi ürperenler dışında"},{"ar":[5],"tr":"herkese zor ve ağır gelen bir görevdir"}]},
 {"ayet":46,"gruplar":[{"ar":[0],"tr":"Onlar,"},{"ar":[2,3,4],"tr":"kesinlikle Rablerine kavuşacaklarını"},{"ar":[5,6,7],"tr":"ve O’na döneceklerini"},{"ar":[1],"tr":"düşünen ve bunu kabullenen kimselerdir"}]},
 {"ayet":47,"gruplar":[{"ar":[0,1],"tr":"Ey İsrailoğulları!"},{"ar":[3,4,5,6],"tr":"Size verdiğim nimetimi"},{"ar":[7,8,9,10],"tr":"ve sizi (bir zamanlar) cümle âleme üstün kıldığımı"},{"ar":[2],"tr":"hatırlayın"}]},
 {"ayet":48,"gruplar":[{"ar":[0,1],"tr":"Öyle bir günden korkun ki"},{"ar":[2,3,4,5,6,7],"tr":"o günde hiç kimse başkası için herhangi bir ödemede bulunamaz"},{"ar":[8,9,10,11],"tr":"hiç kimseden (Allah izin vermedikçe) şefaat kabul olunmaz"},{"ar":[12,13,14,15],"tr":"fidye alınmaz"},{"ar":[16,17,18],"tr":"onlara asla yardım da yapılmaz"}]},
 {"ayet":49,"gruplar":[{"ar":[0],"tr":"Hatırlayın ki,"},{"ar":[1,2,3,4],"tr":"sizi, Firavun taraftarlarından kurtardık"},{"ar":[5,6,7],"tr":"Çünkü onlar size azabın en kötüsünü reva görüyorlar"},{"ar":[8,9],"tr":"yeni doğan erkek çocuklarınızı kesiyorlar"},{"ar":[10,11],"tr":"(fenalık için) kızlarınızı hayatta bırakıyorlardı"},{"ar":[13,14,15],"tr":"Aslında o size reva görülenlerde"},{"ar":[16,17,18],"tr":"Rabbinizden büyük bir imtihan vardı"}]},
 {"ayet":50,"gruplar":[{"ar":[0],"tr":"Bir zamanlar"},{"ar":[1,2,3],"tr":"biz sizin için denizi yardık"},{"ar":[4],"tr":"sizi kurtardık"},{"ar":[6,7],"tr":"Firavun’un taraftarlarını da"},{"ar":[8,9],"tr":"siz bakıp dururken"},{"ar":[5],"tr":"denizde boğduk"}]},
 {"ayet":51,"gruplar":[{"ar":[2,3,4,1],"tr":"Musa’ya kırk gece (vahyetmek üzere) söz vermiştik"},{"ar":[5],"tr":"Sonra"},{"ar":[10,11],"tr":"haksızlık ederek"},{"ar":[7,6,8,9],"tr":"buzağıyı (tanrı) edindiniz"}]},
 {"ayet":52,"gruplar":[{"ar":[5,3,4],"tr":"O davranışlarınızdan sonra"},{"ar":[6,7],"tr":"(akıllanıp) şükredersiniz diye"},{"ar":[0,1,2],"tr":"sizi affettik"}]},
 {"ayet":53,"gruplar":[{"ar":[5,6],"tr":"Doğru yolu bulasınız diye"},{"ar":[2],"tr":"Musa’ya"},{"ar":[3],"tr":"Kitab’ı"},{"ar":[4],"tr":"ve hak ile bâtılı ayıran hükümleri"},{"ar":[1],"tr":"verdik"}]},
 {"ayet":54,"gruplar":[{"ar":[0,1,2,3],"tr":"Musa kavmine demişti ki"},{"ar":[4],"tr":"Ey kavmim!"},{"ar":[5,6,7,8,9],"tr":"Şüphesiz siz, buzağıyı (tanrı) edinmekle kendinize kötülük ettiniz"},{"ar":[10,11,12],"tr":"Onun için Yaradanınıza tevbe edin"},{"ar":[13,14],"tr":"de nefislerinizi (kötü duygularınızı) öldürün"},{"ar":[15,16,17,18,19],"tr":"Öyle yapmanız Yaratıcınızın katında sizin için daha iyidir"},{"ar":[20,21],"tr":"Böylece Allah tevbenizi kabul etmiş olur"},{"ar":[23,24,25,26],"tr":"Çünkü acıyıp tevbeleri kabul eden ancak O’dur"}]},
 {"ayet":55,"gruplar":[{"ar":[0],"tr":"Bir zamanlar:"},{"ar":[2],"tr":"Ey Musa!"},{"ar":[7,8,9,6],"tr":"Biz Allah’ı açıkça görmedikçe"},{"ar":[3,4,5],"tr":"asla sana inanmayız"},{"ar":[1],"tr":"demiştiniz de"},{"ar":[12,13],"tr":"bakıp durur olduğunuz halde"},{"ar":[10,11],"tr":"hemen sizi yıldırım çarpmıştı"}]},
 {"ayet":56,"gruplar":[{"ar":[0],"tr":"Sonra"},{"ar":[2,3,4],"tr":"ölümünüzün ardından"},{"ar":[1],"tr":"sizi dirilttik"},{"ar":[5,6],"tr":"ki şükredesiniz"}]},
 {"ayet":57,"gruplar":[{"ar":[0,1,2],"tr":"Ve sizi bulutla gölgeledik"},{"ar":[3,4,5,6],"tr":"size kudret helvası ve bıldırcın gönderdik"},{"ar":[8,9,10,11,12],"tr":"«Verdiğimiz güzel nimetlerden yeyiniz»"},{"ar":[14,15],"tr":"Hakikatta onlar bize değil"},{"ar":[16,17,18,19],"tr":"sadece kendilerine kötülük ediyorlardı"}]},
 {"ayet":58,"gruplar":[{"ar":[3,4,2],"tr":"Bu kasabaya girin"},{"ar":[6,7,8,9,5],"tr":"orada bulunanlardan dilediğiniz şekilde bol bol yeyin"},{"ar":[11,12,10],"tr":"kapısından eğilerek girin"},{"ar":[13,14],"tr":"(girerken) «Hıtta!» (Yâ Rabbi bizi affet) deyin"},{"ar":[15,16,17],"tr":"ki, sizin hatalarınızı bağışlayalım"},{"ar":[19,20],"tr":"zira biz, iyi davrananlara (karşılığını) fazlasıyla vereceğiz"},{"ar":[1],"tr":"demiştik"}]},
 {"ayet":59,"gruplar":[{"ar":[1,2],"tr":"Fakat zalimler"},{"ar":[5,6,7],"tr":"kendilerine söylenenleri"},{"ar":[3,4],"tr":"başka sözlerle"},{"ar":[0],"tr":"değiştirdiler"},{"ar":[15,16,17],"tr":"Bunun üzerine biz, yapmakta oldukları kötülükler sebebiyle"},{"ar":[10,11,9],"tr":"zalimlerin üzerine"},{"ar":[13,14],"tr":"gökten"},{"ar":[12],"tr":"acı bir azap"},{"ar":[8],"tr":"indirdik"}]},
 {"ayet":60,"gruplar":[{"ar":[2,3,4],"tr":"Musa (çölde) kavmi için su istemişti"},{"ar":[5],"tr":"de biz ona:"},{"ar":[6,7,8],"tr":"Değneğinle taşa vur!"},{"ar":[10,11,12,13,14],"tr":"Derhal (taştan) oniki kaynak fışkırdı"},{"ar":[16,17,18,19,20],"tr":"Her bölük, içeceği kaynağı bildi"},{"ar":[22,23,24,25,26],"tr":"Allah’ın rızkından yeyin, için"},{"ar":[27,28,29,30,31],"tr":"sakın yeryüzünde bozgunculuk etmeyin"}]}
]}
