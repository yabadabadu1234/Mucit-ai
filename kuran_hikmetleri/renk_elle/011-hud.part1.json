{"sure":11,"ayetler":[
{"ayet":1,"gruplar":[{"ar":[0],"tr":"Elif. Lâm. Râ."},{"ar":[7,8,9,10],"tr":"(Bu sana indirilen), hikmet sahibi (ve) her şeyden haberdar olan (Allah) tarafından"},{"ar":[3,4],"tr":"âyetleri sağlamlaştırılmış"},{"ar":[5,6],"tr":"sonra da açıklanmış"},{"ar":[2],"tr":"bir kitaptır"}]},
{"ayet":2,"gruplar":[{"ar":[0,1,2,3],"tr":"(De ki: Bu Kitap) «Allah’tan başkasına ibadet etmemeniz için (indirildi)"},{"ar":[5],"tr":"Şüphesiz ki ben"},{"ar":[6,7],"tr":"onun tarafından size (gönderilmiş)"},{"ar":[8,9],"tr":"bir uyarıcı ve müjdeleyiciyim"}]},
{"ayet":3,"gruplar":[{"ar":[0,1,2],"tr":"Ve Rabbinizden mağfiret dilemeniz"},{"ar":[3,4,5],"tr":"sonra da ona tevbe etmeniz için (indirildi. Eğer bu emrolunanları yaparsanız)"},{"ar":[6,7,8,9,10,11],"tr":"Allah sizi, tayin edilmiş bir süreye kadar güzel bir şekilde yaşatır"},{"ar":[12,13,14,15,16],"tr":"fazlasını yapan herkese de iyiliğinin karşılığını verir"},{"ar":[18,19],"tr":"Eğer yüz çevirirseniz"},{"ar":[20,21,22,23,24,25],"tr":"ben sizin başınıza gelecek büyük bir günün azabından korkarım.»"}]},
{"ayet":4,"gruplar":[{"ar":[0,1,2],"tr":"Dönüşünüz yalnız Allah’adır"},{"ar":[4,5,6,7,8],"tr":"O, her şeye kadirdir"}]},
{"ayet":5,"gruplar":[{"ar":[0,1],"tr":"Bilesiniz ki, onlar"},{"ar":[4,5],"tr":"Peygamber’den, (düşmanlıklarını) gizlemeleri için"},{"ar":[2,3],"tr":"göğüslerini çevirirler (gönüllerinden geçeni gizlerler)"},{"ar":[7],"tr":"İyi bilin ki"},{"ar":[8,9,10],"tr":"onlar elbiselerine büründükleri zaman dahi"},{"ar":[12,13],"tr":"Allah onların gizlediklerini de"},{"ar":[11,14,15],"tr":"açığa çıkardıklarını da bilir"},{"ar":[17,18,19,20],"tr":"Çünkü O, kalplerin özünü bilendir"}]},
{"ayet":6,"gruplar":[{"ar":[1,2,3,4,5],"tr":"Yeryüzünde yürüyen her canlının"},{"ar":[9],"tr":"rızkı"},{"ar":[6,7,8],"tr":"yalnızca Allah’ın üzerinedir"},{"ar":[11],"tr":"Allah o canlının durduğu yeri"},{"ar":[12,10],"tr":"ve sonunda bırakılacağı mekanı bilir"},{"ar":[14],"tr":"(Bunların) hepsi"},{"ar":[15,16,17],"tr":"açık bir kitapta (levh-i mahfuz’da) dır"}]},
{"ayet":7,"gruplar":[{"ar":[0],"tr":"O"},{"ar":[13,14,15],"tr":"hanginizin amelinin daha güzel olacağı hususunda"},{"ar":[12],"tr":"sizi imtihan etmek için"},{"ar":[8,9,10,11],"tr":"Arş’ı su üzerinde iken"},{"ar":[1,2,3,4,5,6,7],"tr":"gökleri ve yeri altı günde yaratandır"},{"ar":[17],"tr":"Yemin ederim ki, (Resûlüm!)"},{"ar":[18,19,20,21,22,23],"tr":"«Ölümden sonra muhakkak diriltileceksiniz» desen"},{"ar":[25,26],"tr":"kâfir olanlar derhal"},{"ar":[24,27,28,29,30,31],"tr":"«Bu, açık bir büyüden başka bir şey değildir» derler"}]},
{"ayet":8,"gruplar":[{"ar":[0,1,2,3],"tr":"Andolsun, eğer biz onlardan azabı"},{"ar":[4,5,6],"tr":"sayılı bir süreye kadar ertelesek"},{"ar":[7,8,9],"tr":"mutlaka «Onun gelmesini engelleyen nedir?» derler"},{"ar":[11],"tr":"Bilesiniz ki"},{"ar":[12,13],"tr":"kendilerine azap geldiği gün"},{"ar":[14,15,16],"tr":"bir daha onlardan uzaklaştırılacak değildir"},{"ar":[19,20,21,22],"tr":"Ve alay etmekte oldukları şey"},{"ar":[17,18],"tr":"onları çepeçevre kuşatacaktır"}]},
{"ayet":9,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Eğer insana tarafımızdan bir rahmet (nimet) tattırır"},{"ar":[5,6,7],"tr":"da sonra bunu ondan çekip alırsak"},{"ar":[8,9,10],"tr":"tamamen ümitsiz ve nankör olur"}]},
{"ayet":10,"gruplar":[{"ar":[0,3,4,5],"tr":"Eğer kendisine dokunan bir zarardan sonra"},{"ar":[1,2],"tr":"ona bir nimet tattırırsak"},{"ar":[6,7,8,9],"tr":"elbette «Kötülükler benden gitti» der"},{"ar":[11,12,13],"tr":"Çünkü o (bunu derken) şımarıktır, kibirlidir"}]},
{"ayet":11,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Ancak (musibetlere) sabredip güzel iş yapanlar böyle değildir"},{"ar":[5,6,7],"tr":"İşte onlar için bir bağış"},{"ar":[8,9],"tr":"ve bir büyük mükâfat vardır"}]},
{"ayet":12,"gruplar":[{"ar":[0],"tr":"Belki de sen"},{"ar":[11,12,13,14],"tr":"(müşriklerin:) «Ona (gökten) bir hazine indirilseydi"},{"ar":[15,16,17,18],"tr":"veya onunla beraber bir melek gelseydi!»"},{"ar":[9,10],"tr":"demelerinden ötürü"},{"ar":[2,3,4,5],"tr":"sana vahyolunan âyetlerin bir kısmını (duyurmayı)"},{"ar":[1],"tr":"terk edeceksin"},{"ar":[6,7,8],"tr":"ve bu yüzden ruhun daralacaktır"},{"ar":[20,21,22],"tr":"(İyi bil ki) sen ancak bir uyarıcısın"},{"ar":[24,25,26,27,28],"tr":"Allah ise her şeye vekîldir"}]},
{"ayet":13,"gruplar":[{"ar":[0,2],"tr":"Yoksa, «Onu (Kur’an’ı) kendisi uydurdu» mu"},{"ar":[1],"tr":"diyorlar"},{"ar":[4],"tr":"De ki"},{"ar":[16,17,18],"tr":"Eğer doğru iseniz"},{"ar":[13,14,15],"tr":"Allah’tan başka"},{"ar":[10,11,12],"tr":"çağırabildiklerinizi (yardıma) çağırın da"},{"ar":[5,6,7,8,9],"tr":"siz de onun gibi uydurulmuş on sûre getirin"}]},
{"ayet":14,"gruplar":[{"ar":[0,1,2],"tr":"Eğer (onlar) size cevap veremiyorlarsa"},{"ar":[3],"tr":"bilin ki"},{"ar":[4,5,6,7],"tr":"o ancak Allah’ın ilmiyle indirilmiştir"},{"ar":[8,9,10,11,12],"tr":"ve O’ndan başka tanrı yoktur"},{"ar":[14,15,16],"tr":"Artık siz müslüman oluyor musunuz"}]},
{"ayet":15,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Kim, (yalnız) dünya hayatını ve zinetini istemekte ise"},{"ar":[6,7,8,9],"tr":"işlerinin karşılığını orada onlara tam olarak veririz"},{"ar":[10,11,12,13],"tr":"ve orada onlar hiçbir zarara uğratılmazlar"}]},
{"ayet":16,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"İşte onlar, ahirette kendileri için ateşten başka hiçbir şeyleri olmayan kimselerdir"},{"ar":[9,10,11,12],"tr":"(dünyada) yaptıkları da boşa gitmiştir"},{"ar":[13,14,15,16],"tr":"yapmakta oldukları şeyler (zaten) bâtıldır"}]},
{"ayet":17,"gruplar":[{"ar":[2,3,4,5],"tr":"Rabbin tarafından (gelmiş) açık bir delile dayanan"},{"ar":[6,7,8],"tr":"ve kendisini Rabbinden bir şahidin izlediği"},{"ar":[9,10],"tr":"ayrıca kendisinden önce"},{"ar":[13,14],"tr":"bir önder ve bir rahmet olarak"},{"ar":[0,1,11,12],"tr":"Musa’nın Kitab’ı (elinde) bulunan kimse (inkârcılar gibi) midir"},{"ar":[16,17,18],"tr":"Çünkü bunlar ona (Kur’an’a) inanırlar"},{"ar":[20,21,22,23,24],"tr":"Zümrelerden hangisi onu inkâr ederse"},{"ar":[25,26],"tr":"işte cehennem ateşi onun varacağı yerdir"},{"ar":[28,29,30,31,32],"tr":"bundan şüphen olmasın"},{"ar":[34,35,36,37],"tr":"zira bu, senin Rabbin tarafından bildirilmiş gerçektir"},{"ar":[38,39,40,41,42],"tr":"fakat insanların çoğu inanmazlar"}]},
{"ayet":18,"gruplar":[{"ar":[0,2,3,4,5,6],"tr":"Kim Allah’a karşı yalan uydurandan"},{"ar":[1],"tr":"daha zalim olabilir"},{"ar":[8,9,10,11],"tr":"Onlar (kıyamet gününde) Rablerine arz edilecekler"},{"ar":[13],"tr":"şahitler de"},{"ar":[14,15,16,17,18],"tr":"İşte bunlar Rablerine karşı yalan söyleyenlerdir"},{"ar":[12],"tr":"diyecekler"},{"ar":[20],"tr":"Bilin ki"},{"ar":[21,22,23,24],"tr":"Allah’ın lâneti zalimlerin üzerinedir"}]},
{"ayet":19,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Onlar, (insanları) Allah’ın yolundan alıkoyan"},{"ar":[5,6],"tr":"ve onu eğri göstermek isteyenlerdir"},{"ar":[7,8,9,10],"tr":"Ahireti inkâr edenler de onlardır"}]},
{"ayet":20,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Onlar yeryüzünde (Allah’ı) âciz bırakacak değillerdir"},{"ar":[6,7,8,9,10,11,12,13],"tr":"onların Allah’tan başka (yardım isteyecekleri) dostları da yoktur"},{"ar":[15,16,17],"tr":"Onların azabı kat kat olacaktır"},{"ar":[19,20,21,22,23,24,25],"tr":"Çünkü onlar (gerçekleri) ne görebiliyorlar ne de kulak veriyorlardı"}]},
{"ayet":21,"gruplar":[{"ar":[0,1,2,3],"tr":"İşte onlar kendilerini ziyana uğrattılar"},{"ar":[6,7,8],"tr":"Uydurmakta oldukları şeyler de"},{"ar":[4,5],"tr":"kendilerinden kaybolup gitti"}]},
{"ayet":22,"gruplar":[{"ar":[0,1,2],"tr":"Şüphesiz onlar"},{"ar":[3,4],"tr":"ahirette"},{"ar":[5,6],"tr":"en çok ziyana uğrayanlardır"}]},
{"ayet":23,"gruplar":[{"ar":[0,1,2,3,4],"tr":"İnanıp da güzel işler yapan"},{"ar":[5,6,7],"tr":"ve Rablerine gönülden boyun eğenlere gelince"},{"ar":[8,9,10],"tr":"işte onlar cennet ehlidir"},{"ar":[12,13,14],"tr":"Onlar orada ebedî kalırlar"}]},
{"ayet":24,"gruplar":[{"ar":[1,2],"tr":"Bu iki zümrenin (müminlerle kâfirlerin) durumu"},{"ar":[3,4],"tr":"kör ve sağır"},{"ar":[5,6],"tr":"ile gören ve işiten kimseler gibidir"},{"ar":[8,9,10],"tr":"Bunların hali hiç eşit olur mu"},{"ar":[12,13],"tr":"Hâla ibret almıyor musunuz"}]},
{"ayet":25,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Andolsun, biz Nuh’u kavmine elçi gönderdik"},{"ar":[5,6,7,8],"tr":"Onlara: «Ben (dedi), sizin için apaçık bir uyarıcıyım"}]},
{"ayet":26,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah’tan başkasına tapmayın"},{"ar":[6,7,8,9,10,11],"tr":"Ben, size (gelecek) elem verici bir günün azabından korkuyorum.»"}]},
{"ayet":27,"gruplar":[{"ar":[1,2,3,4,5],"tr":"Kavminden ileri gelen kâfirler"},{"ar":[0],"tr":"dediler ki"},{"ar":[6,7,8,9,10],"tr":"«Biz seni sadece bizim gibi bir insan olarak görüyoruz"},{"ar":[11,12,13,14,15,16,17,18,19],"tr":"Bizden, basit görüşle hareket eden alt tabakamızdan başkasının sana uyduğunu görmüyoruz"},{"ar":[20,21,22,23,24,25],"tr":"Ve sizin bize karşı bir üstünlüğünüzü de görmüyoruz"},{"ar":[26,27,28],"tr":"Bilakis sizin yalancılar olduğunuzu düşünüyoruz.»"}]},
{"ayet":28,"gruplar":[{"ar":[0],"tr":"(Nuh) dedi ki"},{"ar":[1],"tr":"Ey kavmim"},{"ar":[3,4,5,6,7,8],"tr":"Eğer ben Rabbim tarafından (bildirilen) açık bir delil üzerinde isem"},{"ar":[9,10,11,12],"tr":"ve O bana kendi katından bir rahmet vermiş de"},{"ar":[13,14],"tr":"bu size gizli tutulmuşsa"},{"ar":[2],"tr":"buna ne dersiniz"},{"ar":[16,17,18],"tr":"Siz onu istemediğiniz halde"},{"ar":[15],"tr":"biz sizi ona zorlayacak mıyız"}]},
{"ayet":29,"gruplar":[{"ar":[0],"tr":"Ey kavmim"},{"ar":[1,2,3,4],"tr":"Allah’ın emirlerini bildirmeye karşılık sizden herhangi bir mal istemiyorum"},{"ar":[6,7,8,9,10],"tr":"Benim mükâfatım ancak Allah’a aittir"},{"ar":[12,13,14,15,16],"tr":"Ben iman edenleri kovacak değilim"},{"ar":[18,19,20],"tr":"çünkü onlar Rablerine kavuşacaklardır"},{"ar":[21,22,23,24],"tr":"Fakat ben sizi, bilgisizce davranan bir topluluk olarak görüyorum"}]},
{"ayet":30,"gruplar":[{"ar":[0],"tr":"Ey kavmim"},{"ar":[5,6],"tr":"Ben onları kovarsam"},{"ar":[1,2,3,4],"tr":"beni Allah’tan (onun azabından) kim korur"},{"ar":[8,9],"tr":"Düşünmüyor musunuz"}]}
]}
