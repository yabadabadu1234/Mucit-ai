{"sure":4,"ayetler":[
 {"ayet":21,"gruplar":[{"ar":[2,3,4,5,6],"tr":"Vaktiyle siz birbirinizle haşir-neşir olduğunuz"},{"ar":[7,8,9,10],"tr":"ve onlar sizden sağlam bir teminat almış olduğu halde"},{"ar":[0,1],"tr":"onu nasıl geri alırsınız!"}]},
 {"ayet":22,"gruplar":[{"ar":[7,8,9,10],"tr":"Geçmişte olanlar bir yana,"},{"ar":[0,1,2,3,4,5,6],"tr":"babalarınızın evlendiği kadınlarla evlenmeyin;"},{"ar":[12,13,14],"tr":"çünkü bu bir hayasızlıktır,"},{"ar":[15],"tr":"iğrenç bir şeydir"},{"ar":[16,17],"tr":"ve kötü bir yoldur."}]},
 {"ayet":23,"gruplar":[{"ar":[2],"tr":"Analarınız,"},{"ar":[3],"tr":"kızlarınız,"},{"ar":[4],"tr":"kızkardeşleriniz,"},{"ar":[5],"tr":"halalarınız,"},{"ar":[6],"tr":"teyzeleriniz,"},{"ar":[7,8],"tr":"kardeş kızları,"},{"ar":[9,10],"tr":"kızkardeş kızları,"},{"ar":[11,12,13],"tr":"sizi emziren analarınız,"},{"ar":[14,15,16],"tr":"süt bacılarınız,"},{"ar":[17,18],"tr":"eşlerinizin anaları,"},{"ar":[25,26,27,23,24,20,21,22,19],"tr":"kendileriyle birleştiğiniz eşlerinizden olup evlerinizde bulunan üvey kızlarınız"},{"ar":[0,1],"tr":"size haram kılındı."},{"ar":[28,29,30,31,32],"tr":"Eğer onlarla (nikâhlanıp da) henüz birleşmemişseniz"},{"ar":[33,34,35],"tr":"kızlarını almanızda size bir mahzur yoktur."},{"ar":[36,37,38,39,40],"tr":"Kendi sulbünüzden olan oğullarınızın eşleri"},{"ar":[41,42,43,44],"tr":"ve iki kız kardeşi birden almak da size haram kılındı;"},{"ar":[45,46,47,48],"tr":"ancak geçen geçmiştir."},{"ar":[50,51,52,53,54],"tr":"Allah çok bağışlayıcı ve esirgeyicidir."}]},
 {"ayet":24,"gruplar":[{"ar":[4,5,6,7],"tr":"(Harp esiri olarak) sahip olduğunuz cariyeler müstesna,"},{"ar":[1,2,3],"tr":"evli kadınlar da"},{"ar":[11],"tr":"size haram kılındı."},{"ar":[9,10],"tr":"Allah’ın size emri budur."},{"ar":[15,16,17],"tr":"Bunlardan başkasını,"},{"ar":[21,22,23],"tr":"namuslu olmak ve zina etmemek üzere"},{"ar":[20,18,19],"tr":"mallarınızla (mehirlerini vererek) istemeniz"},{"ar":[13,14],"tr":"size helâl kılındı."},{"ar":[25,26,27,28],"tr":"Onlardan faydalanmanıza karşılık"},{"ar":[29,30,31],"tr":"kararlaştırılmış olan mehirlerini verin."},{"ar":[39,40,41],"tr":"Mehir kesiminden sonra (bir miktar indirim için)"},{"ar":[37,38,36],"tr":"karşılıklı anlaşmanızda"},{"ar":[33,34,35],"tr":"size günah yoktur."},{"ar":[43,44,45,46,47],"tr":"Şüphesiz Allah ilim ve hikmet sahibidir."}]},
 {"ayet":25,"gruplar":[{"ar":[0,1,2,3,4,5,6,7,8],"tr":"İçinizden, imanlı hür kadınlarla evlenmeye gücü yetmeyen kimse,"},{"ar":[9,10,11,12,13,14,15],"tr":"ellerinizin altında bulunan imanlı genç kızlarınız (sayılan) cariyelerinizden alsın."},{"ar":[17,18,19],"tr":"Allah sizin imanınızı daha iyi bilmektedir."},{"ar":[21,22,23],"tr":"Hep aynı köktensiniz (insanlık bakımından aranızda fark yoktur)."},{"ar":[31,32,33,34,35,36],"tr":"Öyle ise iffetli yaşamaları, zina etmemeleri ve gizli dost da tutmamaları şartı"},{"ar":[26,27,25],"tr":"ve sahiplerinin izni ile onları (cariyeleri) nikâhlayıp alın,"},{"ar":[28,29,30],"tr":"mehirlerini de normal miktarda verin."},{"ar":[38,39,40,41,42],"tr":"Evlendikten sonra bir fuhuş yaparlarsa"},{"ar":[43,44,45,46,47,48,49],"tr":"onlara, hür kadınların cezasının yarısı (uygulanır)."},{"ar":[51,52,53,54,55],"tr":"Bu (cariye ile evlenme izni), içinizden günaha düşmekten korkanlar içindir."},{"ar":[57,58,59,60],"tr":"Sabretmeniz ise sizin için daha hayırlıdır."},{"ar":[62,63,64],"tr":"Allah çok bağışlayıcı ve esirgeyicidir."}]},
 {"ayet":26,"gruplar":[{"ar":[1,3,2],"tr":"Allah size (bilmediklerinizi) açıklamak"},{"ar":[4,5,6,7,8],"tr":"ve sizi, sizden önceki (iyi) lerin yollarına iletmek"},{"ar":[9,10],"tr":"ve sizin günahlarınızı bağışlamak"},{"ar":[0],"tr":"istiyor."},{"ar":[12,13,14],"tr":"Allah hakkıyle bilicidir, yegâne hikmet sahibidir."}]},
 {"ayet":27,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah sizin tevbenizi kabul etmek ister;"},{"ar":[6,7,8],"tr":"şehvetlerine uyanlar (kötü arzuların esiri olanlar)"},{"ar":[5,9,10,11,12],"tr":"ise büsbütün yoldan çıkmanızı isterler."}]},
 {"ayet":28,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Allah sizden (yükünüzü) hafifletmek ister;"},{"ar":[6,7,8],"tr":"çünkü insan zayıf yaratılmıştır."}]},
 {"ayet":29,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[8,9,10,11,12,13,14],"tr":"Karşılıklı rızaya dayanan ticaret olması hali müstesna,"},{"ar":[3,4,5,6,7],"tr":"mallarınızı, bâtıl (haksız ve haram yollar) ile aranızda (alıp vererek) yemeyin."},{"ar":[16,17,18],"tr":"Ve kendinizi öldürmeyin."},{"ar":[20,21,22,23,24],"tr":"Şüphesiz Allah, sizi esirgeyecektir."}]},
 {"ayet":30,"gruplar":[{"ar":[0,3,4,2,1],"tr":"Kim düşmanlık ve haksızlık ile bunu (haram yemeyi veya öldürmeyi) yaparsa"},{"ar":[5,6,7],"tr":"(bilsin ki) onu ateşe koyacağız;"},{"ar":[9,10,11,12,13],"tr":"bu ise Allah’a çok kolaydır."}]},
 {"ayet":31,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Eğer yasaklandığınız büyük günahlardan kaçınırsanız,"},{"ar":[6,7,8],"tr":"sizin küçük günahlarınızı örteriz"},{"ar":[9,10,11],"tr":"ve sizi şerefli bir yere sokarız."}]},
 {"ayet":32,"gruplar":[{"ar":[4,6,7,8,3,5,2,0,1],"tr":"Allah’ın sizi, birbirinizden üstün kıldığı şeyleri (başkasında olup da sizde olmayanı) hasretle arzu etmeyin."},{"ar":[10,11,12,13],"tr":"Erkeklerin de kazandıklarından nasipleri var,"},{"ar":[15,16,17,18],"tr":"kadınların da kazandıklarından nasipleri var."},{"ar":[20,21,22,23],"tr":"Allah’tan lütfunu isteyin;"},{"ar":[25,26,27,28,29,30],"tr":"şüphesiz Allah her şeyi bilmektedir."}]},
 {"ayet":33,"gruplar":[{"ar":[0],"tr":"(Erkek ve kadından) her biri için,"},{"ar":[3,4,5,6,2,1],"tr":"ana, baba ve akrabanın bıraktığından (hisselerini alacak olan) vârisler kıldık."},{"ar":[8,9,10],"tr":"Yeminlerinizin bağladığı kimselere de"},{"ar":[11,12],"tr":"paylarını verin."},{"ar":[14,15,16,17,18,19,20],"tr":"Çünkü Allah her şeyi görmektedir."}]},
 {"ayet":34,"gruplar":[{"ar":[4,5,6,7,8,9],"tr":"Allah’ın insanlardan bir kısmını diğerlerine üstün kılması sebebiyle"},{"ar":[10,11,12,13],"tr":"ve mallarından harcama yaptıkları için"},{"ar":[0,1,2,3],"tr":"erkekler kadınların yöneticisi ve koruyucusudur."},{"ar":[15,16],"tr":"Onun için sâliha kadınlar itaatkârdır."},{"ar":[19,20,21,17,18],"tr":"Allah’ın kendilerini korumasına karşılık gizliyi (kimse görmese de namuslarını) koruyucudurlar."},{"ar":[23,24,25],"tr":"Baş kaldırmasından endişe ettiğiniz kadınlara"},{"ar":[26],"tr":"öğüt verin,"},{"ar":[27,28,29],"tr":"onları yataklarda yalnız bırakın"},{"ar":[30],"tr":"ve (bunlarla yola gelmezlerse) dövün."},{"ar":[32,33],"tr":"Eğer size itaat ederlerse"},{"ar":[34,35,36,37],"tr":"artık onların aleyhine başka bir yol aramayın;"},{"ar":[39,40,41,42,43],"tr":"çünkü Allah yücedir, büyüktür."}]},
 {"ayet":35,"gruplar":[{"ar":[0,1,2,3],"tr":"Eğer karı-kocanın aralarının açılmasından korkarsanız,"},{"ar":[6,7,5],"tr":"erkeğin ailesinden bir hakem"},{"ar":[8,9,10],"tr":"ve kadının ailesinden bir hakem"},{"ar":[4],"tr":"gönderin."},{"ar":[11,12,13],"tr":"Bunlar barıştırmak isterlerse"},{"ar":[14,15,16],"tr":"Allah aralarını bulur;"},{"ar":[18,19,20,21,22],"tr":"şüphesiz Allah her şeyi bilen, her şeyden haberdar olandır."}]},
 {"ayet":36,"gruplar":[{"ar":[1,2],"tr":"Allah’a ibadet edin"},{"ar":[3,4,5,6],"tr":"ve O’na hiçbir şeyi ortak koşmayın."},{"ar":[8],"tr":"Ana-babaya,"},{"ar":[10,11],"tr":"akrabaya,"},{"ar":[12],"tr":"yetimlere,"},{"ar":[13],"tr":"yoksullara,"},{"ar":[14,15,16],"tr":"yakın komşuya,"},{"ar":[17,18],"tr":"uzak komşuya,"},{"ar":[19,20],"tr":"yakın arkadaşa,"},{"ar":[21,22],"tr":"yolcuya,"},{"ar":[23,24,25],"tr":"ellerinizin altında bulunanlara (köle, cariye, hizmetçi ve benzerlerine)"},{"ar":[9],"tr":"iyi davranın;"},{"ar":[27,28,29,30,31,32,33,34],"tr":"Allah kendini beğenen ve daima böbürlenip duran kimseyi sevmez."}]},
 {"ayet":37,"gruplar":[{"ar":[0,1],"tr":"Bunlar cimrilik eden"},{"ar":[2,3,4],"tr":"ve insanlara da cimriliği tavsiye eden,"},{"ar":[5,6,7,8,9,10],"tr":"Allah’ın kendilerine lütfundan verdiğini gizleyen kimselerdir."},{"ar":[12,13,14,15],"tr":"Biz, kâfirler için alçaltıcı bir azap hazırladık."}]},
 {"ayet":38,"gruplar":[{"ar":[5,6,7,8,9,10],"tr":"Allah’a ve ahiret gününe inanmadıkları halde"},{"ar":[0,1,2,3,4],"tr":"mallarını, insanlara gösteriş için sarfedenler de (ahirette azaba dûçâr olurlar)."},{"ar":[12,13,14,15,16],"tr":"Şeytan bir kimseye arkadaş olursa,"},{"ar":[17,18],"tr":"ne kötü bir arkadaştır o!"}]},
 {"ayet":39,"gruplar":[{"ar":[2,3,4,5,6],"tr":"Allah’a ve ahiret gününe iman edip de"},{"ar":[7,8,9,10],"tr":"Allah’ın kendilerine verdiğinden (O’nun yolunda) harcasalardı"},{"ar":[0,1],"tr":"ne olurdu sanki!"},{"ar":[12,13,14,15],"tr":"Allah onların durumunu hakkıyle bilmektedir."}]},
 {"ayet":40,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Şüphe yok ki Allah zerre kadar haksızlık etmez. (Kulun yaptığı iş, eğer bir kötülük ise, onun cezasını adaletle verir.)"},{"ar":[7,8,9],"tr":"İyilik olursa"},{"ar":[10],"tr":"onu katlar (kat kat arttırır),"},{"ar":[11,12,13,14,15],"tr":"kendinden de büyük mükâfat verir."}]},
 {"ayet":41,"gruplar":[{"ar":[2,3,4,5,6],"tr":"Her bir ümmetten bir şahit getirdiğimiz"},{"ar":[7,8,9,10,11,1],"tr":"ve seni de onlara şahit olarak gösterdiğimiz zaman"},{"ar":[0],"tr":"halleri nice olacak!"}]},
 {"ayet":42,"gruplar":[{"ar":[2,3,4,5],"tr":"Küfür yoluna sapıp peygamberi dinlemeyenler"},{"ar":[0],"tr":"o gün"},{"ar":[1,6,7,8,9],"tr":"yerin dibine batırılmayı temenni ederler"},{"ar":[10,11,12,13],"tr":"ve Allah’tan hiçbir haberi gizleyemezler."}]},
 {"ayet":43,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[6,7],"tr":"Siz sarhoş iken"},{"ar":[8,9,10,11],"tr":"-ne söylediğinizi bilinceye kadar-"},{"ar":[12,13],"tr":"cünüp iken de"},{"ar":[14,15,16],"tr":"-yolcu olan müstesna-"},{"ar":[17,18],"tr":"gusül edinceye kadar"},{"ar":[3,4,5],"tr":"namaza yaklaşmayın."},{"ar":[20,21,22,23,24,25],"tr":"Eğer hasta olur veya bir yolculuk üzerinde bulunursanız,"},{"ar":[26,27,28,29,30,31],"tr":"yahut sizden biriniz ayak yolundan gelirse,"},{"ar":[32,33,34,35,36,37],"tr":"yahut kadınlara dokunup da (bu durumlarda) su bulamamışsanız"},{"ar":[38,39,40],"tr":"o zaman temiz bir toprakla teyemmüm edin:"},{"ar":[41,42,43],"tr":"Yüzlerinize ve ellerinize sürün."},{"ar":[45,46,47,48,49],"tr":"Şüphesiz Allah çok affedici ve bağışlayıcıdır."}]},
 {"ayet":44,"gruplar":[{"ar":[3,4,5,6,7,0,1,2],"tr":"Kendilerine Kitap’tan nasip verilenlere baksana!"},{"ar":[8,9],"tr":"Sapıklığı satın alıyorlar"},{"ar":[10,11,12,13],"tr":"ve sizin de yoldan çıkmanızı istiyorlar!"}]},
 {"ayet":45,"gruplar":[{"ar":[0,1,2],"tr":"Allah düşmanlarınızı sizden daha iyi bilir."},{"ar":[4,5,6],"tr":"Gerçek bir dost olarak Allah yeter,"},{"ar":[7,8,9],"tr":"bir yardımcı olarak da Allah kâfidir."}]}
]}
