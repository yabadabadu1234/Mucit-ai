{"sure":3,"ayetler":[
 {"ayet":36,"gruplar":[{"ar":[0,1],"tr":"Onu doğurunca,"},{"ar":[7,8,9,10],"tr":"Allah, ne doğurduğunu bilip dururken:"},{"ar":[3],"tr":"Rabbim!"},{"ar":[4,5,6],"tr":"Ben onu kız doğurdum"},{"ar":[11,12,13],"tr":"Oysa erkek, kız gibi değildir"},{"ar":[15,16,17],"tr":"Ona Meryem adını verdim"},{"ar":[22,23,24],"tr":"Kovulmuş şeytana karşı"},{"ar":[18,19,20,21],"tr":"onu ve soyunu senin korumanı diliyorum"},{"ar":[2],"tr":"dedi"}]},
 {"ayet":37,"gruplar":[{"ar":[1],"tr":"Rabbi"},{"ar":[0,2,3],"tr":"Meryem’e hüsnü kabul gösterdi;"},{"ar":[4,5,6],"tr":"onu güzel bir bitki gibi yetiştirdi"},{"ar":[8,7],"tr":"Zekeriyya’yı da onun bakımı ile görevlendirdi"},{"ar":[13,12,16],"tr":"Zekeriyya, onun yanına,"},{"ar":[10,11,14],"tr":"mâbede her girişinde"},{"ar":[15,17],"tr":"orada bir rızık bulur"},{"ar":[20,21,22,23],"tr":"«Ey Meryem, bu sana nereden geliyor?»"},{"ar":[19],"tr":"der;"},{"ar":[25],"tr":"o da:"},{"ar":[26,27,28,29],"tr":"Bu, Allah tarafındandır"},{"ar":[31,32,33,34,35,36,37],"tr":"Allah, dilediğine sayısız rızık verir, derdi"}]},
 {"ayet":38,"gruplar":[{"ar":[0,2],"tr":"Orada Zekeriyya,"},{"ar":[3,1],"tr":"Rabbine dua etti:"},{"ar":[6],"tr":"Rabbim!"},{"ar":[8,9,10],"tr":"Bana tarafından"},{"ar":[12,11,7],"tr":"hayırlı bir nesil bağışla"},{"ar":[14,15,16],"tr":"Şüphesiz sen duayı hakkıyla işitensin,"},{"ar":[5],"tr":"dedi"}]},
 {"ayet":39,"gruplar":[{"ar":[3,4,5,6,2],"tr":"Zekeriyya mâbedde durmuş namaz kılarken"},{"ar":[1,0],"tr":"melekler ona şöyle nida ettiler:"},{"ar":[8],"tr":"Allah sana,"},{"ar":[12,13,14],"tr":"kendisi tarafından gelen bir Kelime’yi"},{"ar":[11],"tr":"tasdik edici,"},{"ar":[15],"tr":"efendi,"},{"ar":[16],"tr":"iffetli"},{"ar":[19,18,17],"tr":"ve sâlihlerden bir peygamber olarak"},{"ar":[10,9],"tr":"Yahya’yı müjdeler"}]},
 {"ayet":40,"gruplar":[{"ar":[0],"tr":"Zekeriyya:"},{"ar":[1],"tr":"Rabbim! dedi,"},{"ar":[6,7,8],"tr":"bana ihtiyarlık gelip çattığına,"},{"ar":[9,10],"tr":"üstelik karım da kısır olduğuna göre"},{"ar":[2,3,4,5],"tr":"benim nasıl oğlum olabilir?"},{"ar":[12],"tr":"Allah şöyle buyurdu:"},{"ar":[13],"tr":"İşte böyledir;"},{"ar":[14,15,16,17],"tr":"Allah dilediğini yapar"}]},
 {"ayet":41,"gruplar":[{"ar":[0,1],"tr":"Zekeriyya: Rabbim!"},{"ar":[3,4,2],"tr":"(Oğlum olacağına dair) bana bir alâmet göster, dedi"},{"ar":[6],"tr":"Allah buyurdu ki:"},{"ar":[7],"tr":"Senin için alâmet,"},{"ar":[10],"tr":"insanlara,"},{"ar":[11,12],"tr":"üç gün,"},{"ar":[13,14],"tr":"işaretten başka"},{"ar":[8,9],"tr":"söz söylememendir"},{"ar":[16,17,18],"tr":"Ayrıca Rabbini çok an,"},{"ar":[19,20,21],"tr":"sabah akşam tesbih et"}]},
 {"ayet":42,"gruplar":[{"ar":[0,2,1],"tr":"Hani melekler demişlerdi:"},{"ar":[3],"tr":"Ey Meryem!"},{"ar":[4,5,6],"tr":"Allah seni seçti;"},{"ar":[7],"tr":"seni tertemiz yarattı"},{"ar":[8,9,10,11],"tr":"ve seni bütün dünya kadınlarına tercih etti"}]},
 {"ayet":43,"gruplar":[{"ar":[0],"tr":"Ey Meryem!"},{"ar":[2,1],"tr":"Rabbine ibadet et;"},{"ar":[3],"tr":"secdeye kapan,"},{"ar":[5,6,4],"tr":"(O’nun huzurunda) eğilenlerle beraber sen de eğil"}]},
 {"ayet":44,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) Bunlar,"},{"ar":[4,5],"tr":"bizim sana vahiy yoluyla bildirmekte olduğumuz"},{"ar":[1,2,3],"tr":"gayb haberlerindendir"},{"ar":[13,14,15],"tr":"İçlerinden hangisi Meryem’i himayesine alacak diye"},{"ar":[10,11,12],"tr":"kur’a çekmek üzere kalemlerini atarlarken"},{"ar":[7,8,9],"tr":"sen onların yanında değildin;"},{"ar":[19,20],"tr":"onlar (bu yüzden) çekişirken de"},{"ar":[16,17,18],"tr":"yanlarında değildin"}]},
 {"ayet":45,"gruplar":[{"ar":[0,1,2],"tr":"Melekler demişlerdi ki:"},{"ar":[3],"tr":"Ey Meryem!"},{"ar":[5,6,7,8],"tr":"Allah sana kendisinden bir Kelime’yi müjdeliyor"},{"ar":[9,12,13,11],"tr":"Adı Meryem oğlu İsa’dır"},{"ar":[10],"tr":"Mesîh’tir;"},{"ar":[15,16,17,14],"tr":"dünyada da, ahirette de itibarlı"},{"ar":[18,19],"tr":"ve Allah’ın kendisine yakın kıldıklarındandır"}]},
 {"ayet":46,"gruplar":[{"ar":[5,6],"tr":"O, sâlihlerden olarak"},{"ar":[2,3],"tr":"beşikte iken"},{"ar":[4],"tr":"ve yetişkinlik halinde"},{"ar":[1,0],"tr":"insanlara (peygamber sözleri ile) konuşacak"}]},
 {"ayet":47,"gruplar":[{"ar":[0,1],"tr":"Meryem: Rabbim! dedi,"},{"ar":[6,7,8],"tr":"bana bir erkek eli değmediği halde"},{"ar":[2,3,4,5],"tr":"nasıl çocuğum olur?"},{"ar":[10],"tr":"Allah şöyle buyurdu:"},{"ar":[11],"tr":"İşte böyledir,"},{"ar":[12,13,14,15],"tr":"Allah dilediğini yaratır"},{"ar":[17,18,19],"tr":"Bir işe hükmedince"},{"ar":[22,20,21,23],"tr":"ona sadece «Ol!» der;"},{"ar":[24],"tr":"o da oluverir"}]},
 {"ayet":48,"gruplar":[{"ar":[0],"tr":"(Melekler, Meryem’e hitaben İsa hakkında sözlerine devam ettiler:) Allah ona"},{"ar":[1],"tr":"yazmayı,"},{"ar":[2],"tr":"hikmeti,"},{"ar":[3],"tr":"Tevrat’ı,"},{"ar":[4],"tr":"İncil’i öğretecek"}]},
 {"ayet":49,"gruplar":[{"ar":[0,1,2,3],"tr":"O, İsrailoğullarına bir elçi olacak (ve onlara şöyle diyecek:)"},{"ar":[4,5,6,7,8,9],"tr":"Size Rabbinizden bir mucize getirdim:"},{"ar":[11,12,13,14,15,16,17],"tr":"Size çamurdan bir kuş sureti yapar,"},{"ar":[18,19],"tr":"ona üflerim"},{"ar":[20,21,22,23],"tr":"ve Allah’ın izni ile o kuş oluverir"},{"ar":[25,26,27,28,29,30,31],"tr":"Yine Allah’ın izni ile körü ve alacalıyı iyileştirir, ölüleri diriltirim"},{"ar":[33,34,35,36,37,38,39],"tr":"Ayrıca evlerinizde ne yeyip ne biriktirdiğinizi size haber veririm"},{"ar":[46,47,48],"tr":"Eğer inanan kimseler iseniz,"},{"ar":[41,42,43,44,45],"tr":"bunda sizin için bir ibret vardır"}]},
 {"ayet":50,"gruplar":[{"ar":[2,3,4,5,1],"tr":"Benden önce gelen Tevrat’ı"},{"ar":[0],"tr":"doğrulayıcı olarak"},{"ar":[8,9,10,11,6,7],"tr":"ve size haram kılınan bazı şeyleri de helâl kılmam için gönderildim"},{"ar":[13,14,15,16],"tr":"Size Rabbinizden bir mucize getirdim"},{"ar":[17,18],"tr":"O halde Allah’tan korkun,"},{"ar":[19],"tr":"bana da itaat edin"}]},
 {"ayet":51,"gruplar":[{"ar":[1,2,3],"tr":"Allah, benim de Rabbim, sizin de Rabbinizdir"},{"ar":[4],"tr":"Öyle ise O’na kulluk edin"},{"ar":[6,7,8],"tr":"İşte bu doğru yoldur"}]},
 {"ayet":52,"gruplar":[{"ar":[1,4,3,5,2],"tr":"İsa, onlardaki inkârcılığı sezince:"},{"ar":[9,10,8,7],"tr":"Allah yolunda bana yardımcı olacaklar kimlerdir?"},{"ar":[6],"tr":"dedi"},{"ar":[13],"tr":"Havârîler:"},{"ar":[14,15,16],"tr":"Biz, Allah yolunun yardımcılarıyız;"},{"ar":[17,18],"tr":"Allah’a inandık,"},{"ar":[19,20,21],"tr":"şahit ol ki bizler müslümanlarız,"},{"ar":[12],"tr":"cevabını verdiler"}]},
 {"ayet":53,"gruplar":[{"ar":[0],"tr":"(Havârîler:) Rabbimiz!"},{"ar":[2,3,1],"tr":"İndirdiğine inandık"},{"ar":[4,5],"tr":"ve Peygamber’e uyduk"},{"ar":[6,7,8],"tr":"Şimdi bizi (birliğini ve peygamberlerini tasdik eden) şahitlerden yaz, dediler"}]},
 {"ayet":54,"gruplar":[{"ar":[0],"tr":"(Yahudiler) tuzak kurdular;"},{"ar":[1,2],"tr":"Allah da onların tuzaklarını bozdu"},{"ar":[4,5,6],"tr":"Allah, tuzak kuranların hayırlısıdır"}]},
 {"ayet":55,"gruplar":[{"ar":[0,1,2],"tr":"Allah buyurmuştu ki:"},{"ar":[3],"tr":"Ey İsa!"},{"ar":[5],"tr":"Seni vefat ettireceğim,"},{"ar":[6,7],"tr":"seni nezdime yükselteceğim,"},{"ar":[8,9,10,11],"tr":"seni inkâr edenlerden arındıracağım"},{"ar":[12,13,14],"tr":"ve sana uyanları"},{"ar":[18,19,20],"tr":"kıyamete kadar"},{"ar":[15,16,17],"tr":"kâfirlerden üstün kılacağım"},{"ar":[22,23,24],"tr":"Sonra dönüşünüz bana olacak"},{"ar":[27,28,29,30],"tr":"İşte o zaman ayrılığa düştüğünüz şeyler hakkında"},{"ar":[26],"tr":"aranızda"},{"ar":[25],"tr":"ben hükmedeceğim"}]},
 {"ayet":56,"gruplar":[{"ar":[0,1,2],"tr":"İnkâr edenler var ya,"},{"ar":[6,7,8],"tr":"onları dünya ve ahirette"},{"ar":[3,4,5],"tr":"şiddetli bir azaba çarptıracağım;"},{"ar":[9,10,11,12],"tr":"onların hiç yardımcıları da olmayacak"}]},
 {"ayet":57,"gruplar":[{"ar":[0,1,2,3,4],"tr":"İman edip iyi davranışlarda bulunanlara gelince,"},{"ar":[5,6],"tr":"Allah onların mükâfatlarını eksiksiz verecektir"},{"ar":[8,9,10,11],"tr":"Allah zalimleri sevmez"}]},
 {"ayet":58,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) Bu söylenenleri"},{"ar":[2],"tr":"biz sana"},{"ar":[3,4,5,6],"tr":"âyetlerden ve hikmet dolu Kur’an’dan"},{"ar":[1],"tr":"okuyoruz"}]},
 {"ayet":59,"gruplar":[{"ar":[3,4,1,2],"tr":"Allah nezdinde İsa’nın durumu,"},{"ar":[5,6],"tr":"Âdem’in durumu gibidir"},{"ar":[8,9,10],"tr":"Allah onu topraktan yarattı"},{"ar":[11,12,13,14,15],"tr":"Sonra ona «Ol!» dedi ve oluverdi"}]},
 {"ayet":60,"gruplar":[{"ar":[0,1,2],"tr":"Gerçek, Rabbinden gelendir"},{"ar":[3,4,5,6],"tr":"Öyle ise şüphecilerden olma"}]},
 {"ayet":61,"gruplar":[{"ar":[6,3,4,5,7,8],"tr":"Sana bu ilim geldikten sonra"},{"ar":[0,1,2],"tr":"seninle bu konuda çekişenlere"},{"ar":[9],"tr":"de ki:"},{"ar":[10],"tr":"Geliniz,"},{"ar":[16,17],"tr":"sizler ve bizler de dahil olmak üzere,"},{"ar":[12,13],"tr":"siz kendi çocuklarınızı biz de kendi çocuklarımızı,"},{"ar":[14,15],"tr":"siz kendi kadınlarınızı, biz de kendi kadınlarımızı"},{"ar":[11],"tr":"çağıralım,"},{"ar":[18,19],"tr":"sonra da dua edelim de"},{"ar":[22,21,23,24,20],"tr":"Allah’tan yalancılar üzerine lânet dileyelim"}]},
 {"ayet":62,"gruplar":[{"ar":[0,1],"tr":"Şüphesiz bu (İsa hakkında söylenenler),"},{"ar":[2,3,4],"tr":"doğru haberlerdir"},{"ar":[6,7,8,9,10],"tr":"Allah’tan başka ilâh yoktur"},{"ar":[12,13],"tr":"Muhakkak ki Allah,"},{"ar":[14],"tr":"evet O,"},{"ar":[15,16],"tr":"mutlak güç ve hikmet sahibidir"}]},
 {"ayet":63,"gruplar":[{"ar":[0,1],"tr":"Eğer yine yüz çevirirlerse,"},{"ar":[2,3],"tr":"şüphesiz Allah,"},{"ar":[5,4],"tr":"bozguncuları hakkıyla bilendir"}]},
 {"ayet":64,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) de ki:"},{"ar":[1,2],"tr":"Ey ehl-i kitap!"},{"ar":[7,8,6,5,3,4],"tr":"Sizinle bizim aramızda müşterek olan bir söze geliniz:"},{"ar":[9,10,11,12],"tr":"Allah’tan başkasına tapmayalım;"},{"ar":[13,14,15,16],"tr":"O’na hiçbir şeyi eş tutmayalım"},{"ar":[17,18,19,20,21,22,23,24],"tr":"ve Allah’ı bırakıp da kimimiz kimimizi ilâhlaştırmasın"},{"ar":[26,27],"tr":"Eğer onlar yine yüz çevirirlerse,"},{"ar":[29,30,31],"tr":"işte o zaman: Şahit olun ki biz müslümanlarız!"},{"ar":[28],"tr":"deyiniz"}]},
 {"ayet":65,"gruplar":[{"ar":[0,1],"tr":"Ey ehl-i kitap!"},{"ar":[2,3,4,5],"tr":"İbrahim hakkında niçin çekişirsiniz?"},{"ar":[6,8,9,10,11,12,7],"tr":"Halbuki Tevrat ve İncil, kesinlikle ondan sonra indirildi"},{"ar":[14,15],"tr":"Siz hiç düşünmez misiniz?"}]},
 {"ayet":66,"gruplar":[{"ar":[0,1],"tr":"İşte siz böyle kimselersiniz!"},{"ar":[3,4,5,6,2],"tr":"Hadi hakkında bilgi sahibi olduğunuz konuda tartıştınız;"},{"ar":[7,8,9,10,11,12,13],"tr":"fakat bilgi sahibi olmadığınız konuda niçin tartışıyorsunuz!"},{"ar":[15,16],"tr":"Oysa ki Allah, her şeyi bilir,"},{"ar":[17,18,19],"tr":"siz ise bilmezsiniz"}]},
 {"ayet":67,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"İbrahim, ne yahudi, ne de hıristiyan idi;"},{"ar":[6,7,8,9],"tr":"fakat o, Allah’ı bir tanıyan dosdoğru bir müslüman idi;"},{"ar":[10,11,12,13],"tr":"müşriklerden de değildi"}]},
 {"ayet":68,"gruplar":[{"ar":[1,2,3],"tr":"İnsanların İbrahim’e en yakın olanı,"},{"ar":[4,5],"tr":"ona uyanlar,"},{"ar":[6,7],"tr":"şu Peygamber (Muhammed)"},{"ar":[8,9],"tr":"ve (ona) iman edenlerdir"},{"ar":[11,12,13],"tr":"Allah müminlerin dostudur"}]},
 {"ayet":69,"gruplar":[{"ar":[3,4,1,2,0],"tr":"Ehl-i kitaptan bir kısmı istediler ki,"},{"ar":[5,6],"tr":"ne yapıp edip sizi saptırabilsinler"},{"ar":[7,8,9,10],"tr":"Oysa onlar sadece kendilerini saptırırlar da"},{"ar":[11,12],"tr":"farkına bile varmazlar"}]},
 {"ayet":70,"gruplar":[{"ar":[0,1],"tr":"Ey ehl-i kitap!"},{"ar":[6,7],"tr":"(Gerçeği) görüp bildiğiniz halde"},{"ar":[2,3,4,5],"tr":"niçin Allah’ın âyetlerini inkâr edersiniz?"}]}
]}
