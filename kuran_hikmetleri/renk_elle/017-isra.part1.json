{"sure": 17, "ayetler": [{"ayet": 1, "gruplar": [{"ar": [4], "tr": "Bir gece,"}, {"ar": [14, 15, 16], "tr": "kendisine âyetlerimizden bir kısmını gösterelim diye"}, {"ar": [3], "tr": "(Muhammed) kulunu"}, {"ar": [5, 6, 7], "tr": "Mescid-i Harâm’dan,"}, {"ar": [11, 12, 13], "tr": "çevresini mübarek kıldığımız"}, {"ar": [8, 9, 10], "tr": "Mescid-i Aksâ’ya"}, {"ar": [2, 1], "tr": "götüren Allah"}, {"ar": [0], "tr": "noksan sıfatlardan münezzehtir;"}, {"ar": [18, 19, 20, 21], "tr": "O, gerçekten işitendir, görendir."}]}, {"ayet": 2, "gruplar": [{"ar": [0, 1, 2], "tr": "Biz, Musa’ya Kitab’ı verdik"}, {"ar": [5, 6], "tr": "ve İsrailoğullarına:"}, {"ar": [7, 8, 9, 10, 11], "tr": "«Benden başkasını dayanılıp güvenilen bir rab edinmeyin» diyerek"}, {"ar": [3, 4], "tr": "bu Kitab’ı bir hidayet rehberi kıldık."}]}, {"ayet": 3, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "(Ey) Nuh ile birlikte (gemide) taşıdığımız kimselerin nesli!"}, {"ar": [6, 7], "tr": "Şunu bilin ki Nuh,"}, {"ar": [9, 8], "tr": "çok şükreden bir kul idi."}]}, {"ayet": 4, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Biz, Kitap’ta İsrailoğullarına:"}, {"ar": [6, 7, 8, 9], "tr": "Sizler, yeryüzünde iki defa fesat çıkaracaksınız"}, {"ar": [10, 11, 12], "tr": "ve azgınlık derecesinde bir kibre kapılacaksınız, diye bildirdik."}]}, {"ayet": 5, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Bunlardan ilkinin zamanı gelince,"}, {"ar": [4, 5, 6, 7, 8, 9, 10], "tr": "üzerinize güçlü kuvvetli kullarımızı gönderdik."}, {"ar": [11, 12, 13], "tr": "Bunlar, evlerin arasında dolaşarak (sizi) aradılar."}, {"ar": [15, 16, 17], "tr": "Bu, yerine getirilmiş bir vaad idi."}]}, {"ayet": 6, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Sonra onlara karşı size tekrar (galibiyet ve zafer) verdik;"}, {"ar": [5, 6, 7], "tr": "servet ve oğullarla gücünüzü arttırdık;"}, {"ar": [8, 9, 10], "tr": "sayınızı daha da çoğalttık."}]}, {"ayet": 7, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Eğer iyilik ederseniz kendinize etmiş,"}, {"ar": [5, 6, 7], "tr": "kötülük ederseniz yine kendinize etmiş olursunuz."}, {"ar": [9, 10, 11, 12], "tr": "Artık diğer cezalandırma zamanı gelince,"}, {"ar": [13, 14], "tr": "yüzünüzü kara etsinler,"}, {"ar": [15, 16, 17, 18, 19, 20], "tr": "daha önce girdikleri gibi yine Mescid’e (Süleyman Mâbedi’ne) girsinler"}, {"ar": [21, 22, 23, 24], "tr": "ve ellerine geçirdikleri her şeyi büsbütün tahrip etsinler"}]}, {"ayet": 8, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Belki Rabbiniz size merhamet eder;"}, {"ar": [5, 6], "tr": "fakat siz eğer yine (fesatçılığa) dönerseniz,"}, {"ar": [7], "tr": "biz de sizi yine cezalandırırız."}, {"ar": [9, 10, 11, 12], "tr": "Biz cehennemi kâfirler için bir hapishane yaptık."}]}, {"ayet": 9, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Şüphesiz ki bu Kur’an en doğru yola iletir;"}, {"ar": [9, 10, 11, 7, 8], "tr": "iyi davranışlarda bulunan müminlere,"}, {"ar": [12, 13, 14, 15], "tr": "kendileri için büyük bir mükâfat olduğunu müjdeler."}]}, {"ayet": 10, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Ahirete inanmayanlara gelince,"}, {"ar": [5, 6, 7, 8], "tr": "onlar için de elemli bir azap hazırlamışızdır."}]}, {"ayet": 11, "gruplar": [{"ar": [0, 1, 4], "tr": "İnsan hayrı istediği kadar"}, {"ar": [2, 3], "tr": "şerri de ister."}, {"ar": [6, 7, 8], "tr": "İnsan pek acelecidir!"}]}, {"ayet": 12, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Biz, geceyi ve gündüzü birer âyet (delil) olarak yarattık."}, {"ar": [12, 13, 14, 15], "tr": "Nitekim, Rabbinizin nimetlerini araştırmanız,"}, {"ar": [16, 17, 18, 19], "tr": "ayrıca, yılların sayısını ve hesabı bilmeniz için"}, {"ar": [5, 6, 7], "tr": "gecenin karanlığını silip"}, {"ar": [8, 9, 10, 11], "tr": "(yerine, eşyayı) aydınlatan gündüzün aydınlığını getirdik."}, {"ar": [21, 22, 23, 24], "tr": "İşte biz, her şeyi açık açık anlattık."}]}, {"ayet": 13, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Her insanın amelini (veya kaderini) boynuna bağladık."}, {"ar": [8, 9, 10], "tr": "İnsan için kıyamet gününde,"}, {"ar": [13], "tr": "açılmış olarak"}, {"ar": [12], "tr": "önüne konacak"}, {"ar": [11, 7], "tr": "bir kitap çıkarırız."}]}, {"ayet": 14, "gruplar": [{"ar": [0, 1], "tr": "Kitabını oku!"}, {"ar": [4, 5, 6, 2, 3], "tr": "Bugün sana hesap sorucu olarak kendi nefsin yeter."}]}, {"ayet": 15, "gruplar": [{"ar": [0, 1], "tr": "Kim hidayet yolunu seçerse,"}, {"ar": [2, 3, 4], "tr": "bunu ancak kendi iyiliği için seçmiş olur;"}, {"ar": [6, 7], "tr": "kim de doğruluktan saparsa,"}, {"ar": [8, 9, 10], "tr": "kendi zararına sapmış olur."}, {"ar": [12, 13, 14, 15, 16], "tr": "Hiçbir günahkâr, başkasının günah yükünü üstlenmez."}, {"ar": [18, 19, 20, 21, 22, 23], "tr": "Biz, bir peygamber göndermedikçe (kimseye) azap edecek değiliz."}]}, {"ayet": 16, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Bir ülkeyi helâk etmek istediğimizde,"}, {"ar": [5, 6], "tr": "o ülkenin zenginlik sebebiyle şımarmış elebaşılarına (iyilikleri) emrederiz;"}, {"ar": [7, 8], "tr": "buna rağmen onlar orada kötülük işlerler."}, {"ar": [9, 10, 11], "tr": "Böylece o ülke, helâke müstahak olur;"}, {"ar": [12, 13], "tr": "biz de orayı darmadağın ederiz."}]}, {"ayet": 17, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Nuh’tan sonraki nesillerden nicelerini helâk ettik."}, {"ar": [10, 11, 12, 13], "tr": "Kullarının günahlarını bilen ve gören olarak"}, {"ar": [8, 9], "tr": "Rabbin yeterlidir."}]}, {"ayet": 18, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Her kim bu çarçabuk geçen dünyayı dilerse"}, {"ar": [9, 10, 5, 6, 7, 8], "tr": "ona, yani dilediğimiz kimseye dilediğimiz kadarını"}, {"ar": [4], "tr": "dünyada hemen verir,"}, {"ar": [11, 12, 13], "tr": "sonra da onu,"}, {"ar": [16, 17], "tr": "kınanmış ve kovulmuş olarak"}, {"ar": [14, 15], "tr": "gireceği cehenneme sokarız."}]}, {"ayet": 19, "gruplar": [{"ar": [0, 1, 2], "tr": "Kim de ahireti diler"}, {"ar": [6, 7], "tr": "ve bir mümin olarak"}, {"ar": [3, 4, 5], "tr": "ona yaraşır bir çaba ile çalışırsa,"}, {"ar": [8, 9, 10, 11], "tr": "işte bunların çalışmaları makbuldür."}]}, {"ayet": 20, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Hepsine, onlara da bunlara da (dünyayı isteyenlere de ahireti isteyenlere de)"}, {"ar": [4, 5, 6], "tr": "Rabbinin ihsanından (istediklerini) veririz."}, {"ar": [8, 9, 10, 11, 12], "tr": "Rabbinin ihsanı kısıtlanmış değildir."}]}, {"ayet": 21, "gruplar": [{"ar": [0, 1], "tr": "Baksana, biz"}, {"ar": [2, 3, 4, 5], "tr": "insanların kimini kiminden nasıl üstün kılmışızdır!"}, {"ar": [7, 8, 9, 10, 11], "tr": "Elbette ki ahiret, derece ve üstünlük farkları bakımından daha büyüktür."}]}, {"ayet": 22, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Allah ile birlikte bir ilâh daha tanıma!"}, {"ar": [6, 7, 8], "tr": "Sonra kınanmış ve kendi başına terkedilmiş olarak kalırsın."}]}, {"ayet": 23, "gruplar": [{"ar": [1, 2], "tr": "Rabbin,"}, {"ar": [3, 4, 5, 6], "tr": "sadece kendisine kulluk etmenizi,"}, {"ar": [7, 8], "tr": "ana babanıza da iyi davranmanızı kesin bir şekilde emretti."}, {"ar": [10, 11, 12, 13, 14, 15, 16], "tr": "Onlardan biri veya her ikisi senin yanında yaşlanırsa,"}, {"ar": [17, 18, 19, 20], "tr": "kendilerine «of!» bile deme;"}, {"ar": [21, 22], "tr": "onları azarlama;"}, {"ar": [23, 24, 25, 26], "tr": "ikisine de güzel söz söyle."}]}, {"ayet": 24, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Onları esirgeyerek alçakgönüllülükle üzerlerine kanat ger"}, {"ar": [6], "tr": "ve:"}, {"ar": [7, 8, 9, 10, 11], "tr": "«Rabbim! Küçüklüğümde onlar beni nasıl yetiştirmişlerse, şimdi de sen onlara (öyle) rahmet et!» diyerek dua et."}]}, {"ayet": 25, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Rabbiniz sizin kalplerinizdekini çok iyi bilir."}, {"ar": [6, 7, 8], "tr": "Eğer siz iyi olursanız,"}, {"ar": [9, 10, 11, 12], "tr": "şunu bilin ki Allah, kötülükten yüz çevirerek tevbeye yönelenleri son derece bağışlayıcıdır."}]}, {"ayet": 26, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Bir de akrabaya,"}, {"ar": [4], "tr": "yoksula,"}, {"ar": [5, 6], "tr": "yolcuya hakkını ver."}, {"ar": [7, 8, 9], "tr": "Gereksiz yere de saçıp savurma."}]}, {"ayet": 27, "gruplar": [{"ar": [0, 1, 2], "tr": "Zira böylesine saçıp savuranlar"}, {"ar": [3, 4], "tr": "şeytanların dostlarıdırlar."}, {"ar": [6, 7, 8, 9], "tr": "Şeytan ise Rabbine karşı çok nankördür."}]}, {"ayet": 28, "gruplar": [{"ar": [0], "tr": "Eğer"}, {"ar": [3, 4, 5, 6, 7], "tr": "Rabbinden umduğun (beklemek durumunda olduğun) bir rahmet için"}, {"ar": [1, 2], "tr": "onların yüzlerine bakamıyorsan,"}, {"ar": [8, 9, 10, 11], "tr": "hiç olmazsa kendilerine gönül alıcı bir söz söyle."}]}, {"ayet": 29, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Eli sıkı olma;"}, {"ar": [6, 7, 8, 9], "tr": "büsbütün eli açık da olma."}, {"ar": [10, 11], "tr": "Sonra kınanır,"}, {"ar": [12], "tr": "(kaybettiklerinin) hasretini çeker durursun."}]}, {"ayet": 30, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Rabbin rızkı dilediğine bol verir, dilediğine daraltır."}, {"ar": [8, 9, 10, 11, 12], "tr": "Şüphesiz ki O, kullarından haberdardır, (onları) çok iyi görür."}]}, {"ayet": 31, "gruplar": [{"ar": [3, 4, 0, 1, 2], "tr": "Geçim endişesi ile çocuklarınızın canına kıymayın."}, {"ar": [6, 7, 8], "tr": "Biz, onların da sizin de rızkınızı veririz."}, {"ar": [10, 11, 12, 13, 14], "tr": "Onları öldürmek gerçekten büyük bir suçtur."}]}, {"ayet": 32, "gruplar": [{"ar": [0, 1, 2], "tr": "Zinaya yaklaşmayın."}, {"ar": [4, 5, 6], "tr": "Zira o, bir hayâsızlıktır"}, {"ar": [7, 8], "tr": "ve çok kötü bir yoldur."}]}, {"ayet": 33, "gruplar": [{"ar": [6, 7], "tr": "Haklı bir sebep olmadıkça"}, {"ar": [3, 4, 5, 2], "tr": "Allah’ın muhterem kıldığı cana"}, {"ar": [0, 1], "tr": "kıymayın."}, {"ar": [9, 10, 11], "tr": "Bir kimse zulmen öldürülürse,"}, {"ar": [12, 13, 14, 15], "tr": "onun velîsine (hakkını alması için) yetki verdik."}, {"ar": [16, 17, 18, 19], "tr": "Ancak bu velî de kısasta ileri gitmesin."}, {"ar": [21, 22, 23], "tr": "Zaten (kendisine bu yetki verilmekle) o, alacağını almıştır."}]}, {"ayet": 34, "gruplar": [{"ar": [2, 3], "tr": "Yetimin malına,"}, {"ar": [8, 9, 10], "tr": "rüşdüne erinceye kadar,"}, {"ar": [4, 5, 6, 7], "tr": "ancak en güzel bir niyetle"}, {"ar": [0, 1], "tr": "yaklaşın."}, {"ar": [12, 13], "tr": "Verdiğiniz sözü de yerine getirin."}, {"ar": [15, 16, 17, 18], "tr": "Çünkü verilen söz, sorumluluğu gerektirir."}]}, {"ayet": 35, "gruplar": [{"ar": [2, 3, 0, 1], "tr": "Ölçtüğünüz zaman tastamam ölçün"}, {"ar": [4, 5, 6], "tr": "ve doğru terazi ile tartın."}, {"ar": [8, 9, 10, 11], "tr": "Bu, hem daha iyidir hem de neticesi bakımından daha güzeldir."}]}, {"ayet": 36, "gruplar": [{"ar": [2, 3, 4, 5, 6, 0, 1], "tr": "Hakkında bilgin bulunmayan şeyin ardına düşme."}, {"ar": [8, 9, 10, 11], "tr": "Çünkü kulak, göz ve gönül,"}, {"ar": [12, 13, 14, 15, 16], "tr": "bunların hepsi ondan sorumludur."}]}, {"ayet": 37, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Yeryüzünde böbürlenerek dolaşma."}, {"ar": [6, 7, 8, 9], "tr": "Çünkü sen (ağırlık ve azametinle) ne yeri yarabilir"}, {"ar": [10, 11, 12, 13], "tr": "ne de dağlarla ululuk yarışına girebilirsin."}]}, {"ayet": 38, "gruplar": [{"ar": [0, 1], "tr": "Bütün bu sayılanların"}, {"ar": [3], "tr": "kötü olanları,"}, {"ar": [4, 5, 2, 6], "tr": "Rabbinin nezdinde sevimsizdir."}]}, {"ayet": 39, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "İşte bunlar, Rabbinin sana vahyettiği hikmetlerdir."}, {"ar": [8, 9, 10, 11, 12, 13], "tr": "Allah ile birlikte başka ilâh edinme;"}, {"ar": [17, 18], "tr": "sonra kınanmış ve (Allah’ın rahmetinden) uzaklaştırılmış olarak"}, {"ar": [14, 15, 16], "tr": "cehenneme atılırsın."}]}, {"ayet": 40, "gruplar": [{"ar": [0, 1, 2], "tr": "(Ey müşrikler!) Rabbiniz, erkek çocukları sizin için ayırdı da,"}, {"ar": [3, 4, 5, 6], "tr": "kendisi meleklerden kız çocuklar mı edindi!"}, {"ar": [8, 9, 10, 11], "tr": "Gerçekten siz, (vebali) çok büyük bir söz söylüyorsunuz."}]}]}