{"sure":3,"ayetler":[
 {"ayet":71,"gruplar":[{"ar":[0,1],"tr":"Ey ehl-i kitap!"},{"ar":[2,3,4,5],"tr":"Neden doğruyu eğriye karıştırıyor"},{"ar":[8,9],"tr":"ve bile bile"},{"ar":[6,7],"tr":"gerçeği gizliyorsunuz?"}]},
 {"ayet":72,"gruplar":[{"ar":[3,4,2,1,0],"tr":"Ehl-i kitaptan bir gurup şöyle dedi:"},{"ar":[9,10,8,7,6],"tr":"«Müminlere indirilmiş olana"},{"ar":[11,12,5],"tr":"sabahleyin (görünüşte) inanıp"},{"ar":[13,14],"tr":"akşamleyin inkâr edin"},{"ar":[15,16],"tr":"Belki onlar (böylece dinlerinden) dönerler"}]},
 {"ayet":73,"gruplar":[{"ar":[5,4,3,2,0,1],"tr":"Sizin dininize uyanlardan başka hiçbir kimseye inanmayın.»"},{"ar":[6],"tr":"(Resûlüm!) De ki:"},{"ar":[7,8,9,10],"tr":"Doğru yol ancak Allah’ın yoludur"},{"ar":[11,12,13,14,15,16],"tr":"Yine (onlar, kendi aralarında şöyle dediler:) «Size verilenin benzerinin başka herhangi bir kimseye verildiğine,"},{"ar":[17,18,19,20],"tr":"yahut Rabbinizin huzurunda onların size karşı deliller getireceklerine de (inanmayın).»"},{"ar":[22],"tr":"De ki:"},{"ar":[23,24,25,26],"tr":"Lütuf ve ihsan Allah’ın elindedir"},{"ar":[27,28,29],"tr":"Onu dilediğine verir"},{"ar":[31,32,33],"tr":"Allah’ın rahmeti geniştir ve O her şeyi hakkıyla bilir"}]},
 {"ayet":74,"gruplar":[{"ar":[1,2,3,0],"tr":"Rahmetini dilediğine ayırır"},{"ar":[5,6,7,8],"tr":"Allah üstün lütuf sahibidir"}]},
 {"ayet":75,"gruplar":[{"ar":[2,3,1,4],"tr":"Ehl-i kitaptan öylesi vardır ki,"},{"ar":[7,5,6],"tr":"ona yüklerle mal emanet bıraksan,"},{"ar":[8,9],"tr":"onu sana noksansız iade eder"},{"ar":[10,11],"tr":"Fakat onlardan öylesi de vardır ki,"},{"ar":[14,12,13],"tr":"ona bir dinar emanet bıraksan,"},{"ar":[18,19,20,21,22],"tr":"tepesine dikilip durmazsan"},{"ar":[15,16,17],"tr":"onu sana iade etmez"},{"ar":[24,25],"tr":"Bu da onların,"},{"ar":[26,27,28,29,30,31],"tr":"«Ümmîlere karşı yaptıklarımızdan dolayı bize vebal yoktur» demelerindendir"},{"ar":[32,33,34,35,36,37],"tr":"Allah adına bile bile yalan söylüyorlar"}]},
 {"ayet":76,"gruplar":[{"ar":[0],"tr":"Hayır! (Gerçek onların dediği değil.)"},{"ar":[1,2,3,4],"tr":"Her kim sözünü yerine getirir ve kötülükten sakınırsa,"},{"ar":[5,6,7,8],"tr":"bilsin ki Allah sakınanları sever"}]},
 {"ayet":77,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"Allah’a karşı verdikleri sözü ve yeminlerini az bir bedelle değiştirenlere gelince,"},{"ar":[8,9,10,11,12,13],"tr":"işte bunların ahirette bir payı yoktur"},{"ar":[20,21,16,14,15],"tr":"Kıyamet günü Allah onlarla konuşmayacak,"},{"ar":[17,18,19],"tr":"onlara bakmayacak"},{"ar":[22,23],"tr":"ve onları temize çıkarmayacaktır"},{"ar":[24,25,26],"tr":"Onlar için acı bir azap vardır"}]},
 {"ayet":78,"gruplar":[{"ar":[0,1,2],"tr":"Ehl-i kitaptan bir gurup,"},{"ar":[6,7,8],"tr":"okuduklarını kitaptan sanasınız diye"},{"ar":[5,3,4],"tr":"kitabı okurken dillerini eğip bükerler"},{"ar":[9,10,11,12],"tr":"Halbuki okudukları Kitap’tan değildir"},{"ar":[18,19,20,21,22],"tr":"Söyledikleri Allah katından olmadığı halde:"},{"ar":[14,15,16,17],"tr":"Bu Allah katındandır,"},{"ar":[13],"tr":"derler"},{"ar":[27,28,23,24,25,26],"tr":"Onlar bile bile Allah’a iftira ediyorlar"}]},
 {"ayet":79,"gruplar":[{"ar":[0,1,2],"tr":"Hiçbir insanın,"},{"ar":[5,4,6,7,8],"tr":"Allah’ın kendisine Kitap, hikmet ve peygamberlik vermesinden"},{"ar":[9,11],"tr":"sonra (kalkıp) insanlara:"},{"ar":[15,16,17,12,13,14],"tr":"Allah’ı bırakıp bana kul olun!"},{"ar":[10,3],"tr":"demesi mümkün değildir"},{"ar":[18],"tr":"Bilakis (şöyle demesi gerekir):"},{"ar":[21,22,23,24,25,26,27],"tr":"Okutmakta ve öğretmekte olduğunuz Kitap uyarınca"},{"ar":[19,20],"tr":"Rabbe hâlis kullar olunuz"}]},
 {"ayet":80,"gruplar":[{"ar":[0,1],"tr":"Ve size:"},{"ar":[4,5,6,3],"tr":"Melekleri ve peygamberleri ilâhlar edinin,"},{"ar":[2],"tr":"diye de emretmez"},{"ar":[12,13,10,11],"tr":"Siz müslüman olduktan sonra"},{"ar":[8,9],"tr":"hiç size kâfirliği emreder mi?"}]},
 {"ayet":81,"gruplar":[{"ar":[0,2,4],"tr":"Hani Allah, peygamberlerden:"},{"ar":[5,6,7,8,9,10],"tr":"«Ben size Kitap ve hikmet verdikten sonra"},{"ar":[14,15,13,12,11],"tr":"nezdinizdekileri tasdik eden bir peygamber geldiğinde"},{"ar":[16,17,18],"tr":"ona mutlaka inanıp yardım edeceksiniz»"},{"ar":[3,1],"tr":"diye söz almış,"},{"ar":[21,22,23,24,25],"tr":"«Kabul ettiniz ve bu ahdimi yüklendiniz mi?»"},{"ar":[20],"tr":"dediğinde,"},{"ar":[28,27],"tr":"«Kabul ettik» cevabını vermişler,"},{"ar":[30],"tr":"bunun üzerine Allah:"},{"ar":[31],"tr":"O halde şahit olun;"},{"ar":[32,33,34,35],"tr":"ben de sizinle birlikte şahitlik edenlerdenim, buyurmuştu"}]},
 {"ayet":82,"gruplar":[{"ar":[2,3],"tr":"Artık bundan sonra"},{"ar":[0,1],"tr":"her kim dönerse"},{"ar":[4,5,6],"tr":"işte onlar yoldan çıkmışların ta kendileridir"}]},
 {"ayet":83,"gruplar":[{"ar":[6,7,8,9],"tr":"Göklerde ve yerdekiler,"},{"ar":[10,11],"tr":"ister istemez"},{"ar":[4,5],"tr":"O’na teslim olduğu halde"},{"ar":[0,1,2,3],"tr":"onlar (ehl-i kitap), Allah’ın dininden başkasını mı arıyorlar?"},{"ar":[12,13],"tr":"Halbuki O’na döndürüleceklerdir"}]},
 {"ayet":84,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[2],"tr":"Biz, Allah’a,"},{"ar":[3,4,5],"tr":"bize indirilene,"},{"ar":[6,7,8,9,10,11,12,13],"tr":"İbrahim, İsmail, İshak, Ya’kub ve Ya’kub oğullarına indirilenlere,"},{"ar":[14,15,16,17,18,19,20],"tr":"Musa, İsa ve (diğer) peygamberlere Rableri tarafından verilenlere"},{"ar":[1],"tr":"iman ettik"},{"ar":[21,22,23,24,25],"tr":"Onları birbirinden ayırdetmeyiz"},{"ar":[26,27,28],"tr":"Biz ancak O’na teslim oluruz"}]},
 {"ayet":85,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Kim, İslâm’dan başka bir din ararsa,"},{"ar":[5,6,7],"tr":"bilsin ki kendisinden (böyle bir din) asla kabul edilmeyecek"},{"ar":[8,9,10,11,12],"tr":"ve o, ahirette ziyan edenlerden olacaktır"}]},
 {"ayet":86,"gruplar":[{"ar":[5,6],"tr":"İman etmelerinden,"},{"ar":[7,8,9,10],"tr":"Resûl’ün hak olduğuna şehadet getirmelerinden"},{"ar":[11,12],"tr":"ve kendilerine apaçık deliller gelmesinden sonra"},{"ar":[4,3],"tr":"inkârcılığa sapan bir kavme"},{"ar":[0,1,2],"tr":"Allah nasıl hidayet nasip eder?"},{"ar":[14,15,16,17,18],"tr":"Allah zalimler topluluğunu doğru yola iletmez"}]},
 {"ayet":87,"gruplar":[{"ar":[0,1],"tr":"İşte onların cezası,"},{"ar":[5,6,7,8,4,2,3],"tr":"Allah’ın, meleklerin ve bütün insanlığın lânetine uğramalarıdır"}]},
 {"ayet":88,"gruplar":[{"ar":[0,1],"tr":"Bu lânete ebedî gömülüp gidecekler"},{"ar":[2,3,4,5],"tr":"Onların azapları hafifletilmez;"},{"ar":[6,7,8],"tr":"yüzlerine de bakılmaz"}]},
 {"ayet":89,"gruplar":[{"ar":[0,1,2,3,4,5,6],"tr":"Ancak, bundan sonra tevbe edip yola gelenler başka"},{"ar":[7,8,9,10],"tr":"Çünkü Allah çok bağışlayıcı ve merhametlidir"}]},
 {"ayet":90,"gruplar":[{"ar":[3,4],"tr":"İnandıktan sonra"},{"ar":[1,2,0],"tr":"kâfirliğe sapıp"},{"ar":[5,6,7],"tr":"sonra inkârcılıkta daha da ileri gidenlerin"},{"ar":[10,8,9],"tr":"tevbeleri asla kabul edilmeyecektir"},{"ar":[11,12,13],"tr":"Ve işte onlar, sapıkların ta kendisidirler"}]},
 {"ayet":91,"gruplar":[{"ar":[0],"tr":"Gerçekten,"},{"ar":[1,2,3,4,5],"tr":"inkâr edip kâfir olarak ölenler var ya,"},{"ar":[8,9],"tr":"onların hiçbirinden"},{"ar":[13,14,15,10,11,12],"tr":"-fidye olarak dünya dolusu altın verecek olsa dahi-"},{"ar":[6,7],"tr":"kabul edilmeyecektir"},{"ar":[17,18,19,20],"tr":"Onlar için acı bir azap vardır;"},{"ar":[21,22,23,24],"tr":"hiç yardımcıları da yoktur"}]},
 {"ayet":92,"gruplar":[{"ar":[5,6],"tr":"Sevdiğiniz şeylerden"},{"ar":[3,4],"tr":"(Allah yolunda) harcamadıkça"},{"ar":[0,1,2],"tr":"«iyi»ye eremezsiniz"},{"ar":[8,9,10,11],"tr":"Her ne harcarsanız,"},{"ar":[12,13,14,15],"tr":"Allah onu hakkıyla bilir"}]},
 {"ayet":93,"gruplar":[{"ar":[14,15,16,17],"tr":"Tevrat’ın indirilmesinden önce,"},{"ar":[7,8,9,10,11,12,13],"tr":"İsrail’in (Ya’kub’un) kendisine haram kıldıkları dışında,"},{"ar":[1,2],"tr":"yiyeceğin her türlüsü"},{"ar":[5,6,3,4],"tr":"İsrailoğullarına helâl idi"},{"ar":[19],"tr":"De ki:"},{"ar":[23,24,25],"tr":"Eğer doğru sözlü iseniz,"},{"ar":[20,21,22],"tr":"o zaman Tevrat’ı getirip onu okuyun"}]},
 {"ayet":94,"gruplar":[{"ar":[5,6,7],"tr":"Artık bundan sonra"},{"ar":[0,1,2,3,4],"tr":"her kim Allah’a karşı yalan uydurursa,"},{"ar":[8,9,10],"tr":"işte bunlar, zalimlerin ta kendisidirler"}]},
 {"ayet":95,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2],"tr":"Allah doğruyu söylemiştir"},{"ar":[4,7],"tr":"Öyle ise, hakka yönelmiş olarak"},{"ar":[5,6],"tr":"İbrahim’in dinine uyunuz"},{"ar":[8,9,10,11],"tr":"O, müşriklerden değildi"}]},
 {"ayet":96,"gruplar":[{"ar":[0],"tr":"Şüphesiz,"},{"ar":[7,8,9],"tr":"âlemlere bereket ve hidayet kaynağı olarak"},{"ar":[4,3],"tr":"insanlar için kurulan"},{"ar":[1,2],"tr":"ilk ev (mâbet),"},{"ar":[5,6],"tr":"Mekke’deki (Kâbe)dir"}]},
 {"ayet":97,"gruplar":[{"ar":[0],"tr":"Orada"},{"ar":[1,2],"tr":"apaçık nişâneler,"},{"ar":[3,4],"tr":"(ayrıca) İbrahim’in makamı vardır"},{"ar":[6,7,8,9],"tr":"Oraya giren emniyette olur"},{"ar":[16,17,18,19,14,15],"tr":"Yoluna gücü yetenlerin o evi haccetmesi,"},{"ar":[11,12,13],"tr":"Allah’ın insanlar üzerinde bir hakkıdır"},{"ar":[21,22],"tr":"Kim inkâr ederse"},{"ar":[23,24,25,26,27],"tr":"bilmelidir ki, Allah bütün âlemlerden müstağnîdir"}]},
 {"ayet":98,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2],"tr":"Ey ehl-i kitap!"},{"ar":[7,8,9,10,11],"tr":"Allah yaptıklarınızı görüp dururken"},{"ar":[3,4,5,6],"tr":"niçin Allah’ın âyetlerini inkâr edersiniz?"}]},
 {"ayet":99,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2],"tr":"Ey ehl-i kitap!"},{"ar":[12,13],"tr":"(Gerçeği) görüp bildiğiniz halde"},{"ar":[3,10,11],"tr":"niçin Allah’ın yolunu eğri göstermeye yeltenerek"},{"ar":[8,9,4,5,6,7],"tr":"müminleri Allah yolundan çevirmeye kalkışıyorsunuz?"},{"ar":[15,16,17,18,19],"tr":"Allah yaptıklarınızdan habersiz değildir"}]},
 {"ayet":100,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[7,8,9,6,5],"tr":"Kendilerine kitap verilenlerden bir guruba"},{"ar":[3,4],"tr":"uyarsanız"},{"ar":[11,12],"tr":"imanınızdan sonra"},{"ar":[10,13],"tr":"sizi yeniden inkârcılığa sevkederler"}]},
 {"ayet":101,"gruplar":[{"ar":[4,6,5,3],"tr":"Size Allah’ın âyetleri okunurken,"},{"ar":[2,7,8],"tr":"üstelik Allah Resûlü de aranızda iken"},{"ar":[0,1],"tr":"nasıl inkâra saparsınız?"},{"ar":[10,11,12],"tr":"Her kim Allah’a bağlanırsa"},{"ar":[13,14,15,16,17],"tr":"kesinlikle doğru yola iletilmiştir"}]},
 {"ayet":102,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[4,5,6,3],"tr":"Allah’tan, O’na yaraşır şekilde korkun"},{"ar":[7,8,9,10,11],"tr":"ve ancak müslümanlar olarak can verin"}]},
 {"ayet":103,"gruplar":[{"ar":[3,1,2,0],"tr":"Hep birlikte Allah’ın ipine (İslâm’a) sımsıkı yapışın;"},{"ar":[4,5],"tr":"parçalanmayın"},{"ar":[8,9,10,7],"tr":"Allah’ın size olan nimetini hatırlayın:"},{"ar":[11,12,13],"tr":"Hani siz birbirinize düşman kişiler idiniz de"},{"ar":[14,15,16],"tr":"O, gönüllerinizi birleştirmişti"},{"ar":[17,18,19],"tr":"ve O’nun nimeti sayesinde kardeş kimseler olmuştunuz"},{"ar":[20,21,22,23,24,25],"tr":"Yine siz bir ateş çukurunun tam kenarında iken"},{"ar":[27,26],"tr":"oradan da sizi O kurtarmıştı"},{"ar":[29,31,32,33,30],"tr":"İşte Allah size âyetlerini böyle açıklar"},{"ar":[34,35],"tr":"ki doğru yolu bulasınız"}]},
 {"ayet":104,"gruplar":[{"ar":[1],"tr":"Sizden,"},{"ar":[3,4,5],"tr":"hayra çağıran,"},{"ar":[6,7],"tr":"iyiliği emredip"},{"ar":[8,9,10],"tr":"kötülüğü meneden"},{"ar":[2,0],"tr":"bir topluluk bulunsun"},{"ar":[12,13,14],"tr":"İşte onlar kurtuluşa erenlerdir"}]},
 {"ayet":105,"gruplar":[{"ar":[5,6,7,8,9],"tr":"Kendilerine apaçık deliller geldikten sonra"},{"ar":[2,3,4,0,1],"tr":"parçalanıp ayrılığa düşenler gibi olmayın"},{"ar":[11,12,13,14],"tr":"İşte bunlar için büyük bir azap vardır"}]}
]}
