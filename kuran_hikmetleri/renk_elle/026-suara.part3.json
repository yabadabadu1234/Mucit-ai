{"sure": 26, "ayetler": [{"ayet": 111, "gruplar": [{"ar": [1], "tr": "Onlar şöyle cevap verdiler:"}, {"ar": [3], "tr": "Sana"}, {"ar": [5], "tr": "düşük seviyeli kimseler"}, {"ar": [4], "tr": "tâbi olup dururken,"}, {"ar": [2], "tr": "biz sana iman eder miyiz hiç!"}]}, {"ayet": 112, "gruplar": [{"ar": [0], "tr": "Nuh dedi ki:"}, {"ar": [4, 5], "tr": "Onların yaptıkları"}, {"ar": [3], "tr": "hakkında"}, {"ar": [1, 2], "tr": "bilgim yoktur."}]}, {"ayet": 113, "gruplar": [{"ar": [1], "tr": "Onların hesabı"}, {"ar": [0, 2], "tr": "ancak"}, {"ar": [3, 4], "tr": "Rabbime aittir."}, {"ar": [6, 7], "tr": "Bir düşünseniz!"}]}, {"ayet": 114, "gruplar": [{"ar": [1], "tr": "Ben"}, {"ar": [3], "tr": "iman eden kimseleri"}, {"ar": [0, 2], "tr": "kovacak değilim."}]}, {"ayet": 115, "gruplar": [{"ar": [1], "tr": "Ben"}, {"ar": [0, 2], "tr": "ancak"}, {"ar": [4], "tr": "apaçık bir"}, {"ar": [3], "tr": "uyarıcıyım."}]}, {"ayet": 116, "gruplar": [{"ar": [0], "tr": "Dediler ki:"}, {"ar": [4], "tr": "Ey Nuh!"}, {"ar": [2, 3], "tr": "(Bu davadan) vazgeçmezsen,"}, {"ar": [1], "tr": "iyi bil ki,"}, {"ar": [6, 7], "tr": "taşlanmışlardan"}, {"ar": [5], "tr": "olacaksın!"}]}, {"ayet": 117, "gruplar": [{"ar": [1], "tr": "Rabbim!"}, {"ar": [0], "tr": "dedi,"}, {"ar": [2, 3], "tr": "kavmim"}, {"ar": [4], "tr": "beni yalancılıkla suçladı."}]}, {"ayet": 118, "gruplar": [{"ar": [1, 2], "tr": "benimle onların arasında"}, {"ar": [0, 3], "tr": "sen hükmünü ver."}, {"ar": [4, 5, 6, 7, 8], "tr": "Beni ve beraberimdeki müminleri kurtar."}]}, {"ayet": 119, "gruplar": [{"ar": [0], "tr": "Bunun üzerine biz"}, {"ar": [1, 2], "tr": "onu ve beraberindekileri,"}, {"ar": [5], "tr": "o dolu"}, {"ar": [4], "tr": "geminin"}, {"ar": [3], "tr": "içinde (taşıyarak) kurtardık."}]}, {"ayet": 120, "gruplar": [{"ar": [0], "tr": "Sonra da"}, {"ar": [3], "tr": "geri kalanları"}, {"ar": [1, 2], "tr": "suda boğduk."}]}, {"ayet": 121, "gruplar": [{"ar": [0, 1, 2], "tr": "Doğrusu bunda"}, {"ar": [3], "tr": "büyük bir ders vardır;"}, {"ar": [5, 6], "tr": "ama"}, {"ar": [7], "tr": "çokları"}, {"ar": [8], "tr": "iman etmezler."}]}, {"ayet": 122, "gruplar": [{"ar": [0], "tr": "Şüphesiz"}, {"ar": [1], "tr": "Rabbin,"}, {"ar": [2], "tr": "işte O,"}, {"ar": [3], "tr": "mutlak galip"}, {"ar": [4], "tr": "ve engin merhamet sahibidir."}]}, {"ayet": 123, "gruplar": [{"ar": [1], "tr": "Âd (kavmi)"}, {"ar": [2], "tr": "peygamberleri"}, {"ar": [0], "tr": "yalancılıkla suçladı."}]}, {"ayet": 124, "gruplar": [{"ar": [3, 4], "tr": "Kardeşleri Hûd"}, {"ar": [2], "tr": "onlara"}, {"ar": [0, 1], "tr": "şöyle demişti:"}, {"ar": [5, 6], "tr": "(Allah’a karşı gelmekten) sakınmaz mısınız?"}]}, {"ayet": 125, "gruplar": [{"ar": [0], "tr": "Bilin ki, ben"}, {"ar": [1], "tr": "size"}, {"ar": [2, 3], "tr": "gönderilmiş güvenilir bir elçiyim."}]}, {"ayet": 126, "gruplar": [{"ar": [0, 1], "tr": "Artık Allah’a karşı gelmekten sakının"}, {"ar": [2], "tr": "ve bana itaat edin."}]}, {"ayet": 127, "gruplar": [{"ar": [0, 1, 2], "tr": "Buna karşı"}, {"ar": [3, 4], "tr": "sizden hiçbir ücret istemiyorum."}, {"ar": [7, 8, 9], "tr": "Benim ecrimi verecek olan, ancak"}, {"ar": [10, 11], "tr": "âlemlerin Rabbidir."}]}, {"ayet": 128, "gruplar": [{"ar": [1, 2], "tr": "Siz her yüksek yere"}, {"ar": [3], "tr": "bir alâmet"}, {"ar": [0], "tr": "dikerek"}, {"ar": [4], "tr": "eğleniyor musunuz?"}]}, {"ayet": 129, "gruplar": [{"ar": [2, 3], "tr": "Temelli kalacağınızı umarak"}, {"ar": [1], "tr": "sağlam yapılar"}, {"ar": [0], "tr": "mı ediniyorsunuz?"}]}, {"ayet": 130, "gruplar": [{"ar": [0, 1], "tr": "Yakaladığınız zaman,"}, {"ar": [3], "tr": "zorbalar gibi"}, {"ar": [2], "tr": "mi yakalıyorsunuz?"}]}, {"ayet": 131, "gruplar": [{"ar": [0, 1], "tr": "Artık Allah’tan korkun"}, {"ar": [2], "tr": "ve bana itaat edin."}]}, {"ayet": 132, "gruplar": [{"ar": [3, 4], "tr": "Bildiğiniz şeyleri"}, {"ar": [1, 2], "tr": "size veren,"}, {"ar": [0], "tr": "(Allah’a karşı gelmek)ten sakının."}]}, {"ayet": 133, "gruplar": [{"ar": [1], "tr": "davarlar,"}, {"ar": [2], "tr": "oğullar,"}, {"ar": [0], "tr": "ihsan eden"}]}, {"ayet": 134, "gruplar": [{"ar": [0], "tr": "bağlar,"}, {"ar": [1], "tr": "pınarlar"}]}, {"ayet": 135, "gruplar": [{"ar": [0], "tr": "Doğrusu"}, {"ar": [2], "tr": "sizin hakkınızda"}, {"ar": [5], "tr": "muazzam"}, {"ar": [4], "tr": "bir günün"}, {"ar": [3], "tr": "azabından"}, {"ar": [1], "tr": "endişe ediyorum."}]}, {"ayet": 136, "gruplar": [{"ar": [0], "tr": "şöyle dediler:"}, {"ar": [3], "tr": "Sen öğüt versen de,"}, {"ar": [4, 5, 6, 7, 8], "tr": "vermesen de"}, {"ar": [2, 1], "tr": "bizce birdir."}]}, {"ayet": 137, "gruplar": [{"ar": [1], "tr": "Bu,"}, {"ar": [4], "tr": "öncekilerin"}, {"ar": [3], "tr": "geleneğinden"}, {"ar": [0, 2], "tr": "başka bir şey değildir."}]}, {"ayet": 138, "gruplar": [{"ar": [1], "tr": "Biz"}, {"ar": [2], "tr": "azaba uğratılacak"}, {"ar": [0], "tr": "da değiliz."}]}, {"ayet": 139, "gruplar": [{"ar": [0], "tr": "Böylece onu yalancılıkla suçladılar;"}, {"ar": [1], "tr": "biz de kendilerini helâk ettik."}, {"ar": [3, 4, 5], "tr": "Doğrusu bunda"}, {"ar": [6], "tr": "büyük bir ibret vardır;"}, {"ar": [8, 9], "tr": "ama"}, {"ar": [10], "tr": "çokları"}, {"ar": [11], "tr": "iman etmezler."}]}, {"ayet": 140, "gruplar": [{"ar": [0], "tr": "Şüphesiz"}, {"ar": [1], "tr": "Rabbin,"}, {"ar": [2], "tr": "işte O,"}, {"ar": [3], "tr": "mutlak galip"}, {"ar": [4], "tr": "ve engin merhamet sahibidir."}]}, {"ayet": 141, "gruplar": [{"ar": [1], "tr": "Semûd (kavmi)"}, {"ar": [2], "tr": "peygamberleri"}, {"ar": [0], "tr": "yalancılıkla suçladı."}]}, {"ayet": 142, "gruplar": [{"ar": [3, 4], "tr": "Kardeşleri Sâlih"}, {"ar": [2], "tr": "onlara"}, {"ar": [0, 1], "tr": "şöyle demişti:"}, {"ar": [5, 6], "tr": "(Allah’a karşı gelmekten) sakınmaz mısınız?"}]}, {"ayet": 143, "gruplar": [{"ar": [0], "tr": "Bilin ki, ben"}, {"ar": [1], "tr": "size"}, {"ar": [2, 3], "tr": "gönderilmiş güvenilir bir elçiyim."}]}, {"ayet": 144, "gruplar": [{"ar": [0, 1], "tr": "Artık Allah’a karşı gelmekten sakının"}, {"ar": [2], "tr": "ve bana itaat edin."}]}, {"ayet": 145, "gruplar": [{"ar": [0, 1, 2], "tr": "Buna karşı"}, {"ar": [3, 4], "tr": "sizden hiçbir ücret istemiyorum."}, {"ar": [7, 8, 9], "tr": "Benim ecrimi verecek olan, ancak"}, {"ar": [10, 11], "tr": "âlemlerin Rabbidir."}]}, {"ayet": 146, "gruplar": [{"ar": [1, 2, 3], "tr": "burada,"}, {"ar": [4], "tr": "güven içinde"}, {"ar": [0], "tr": "bırakılacak mısınız (sanırsınız)?"}]}, {"ayet": 147, "gruplar": [{"ar": [1], "tr": "bahçelerin,"}, {"ar": [2], "tr": "pınarların"}, {"ar": [0], "tr": "içinde;"}]}, {"ayet": 148, "gruplar": [{"ar": [0], "tr": "ekinlerin,"}, {"ar": [2, 3], "tr": "salkımları sarkmış"}, {"ar": [1], "tr": "hurmalıkların arasında"}]}, {"ayet": 149, "gruplar": [{"ar": [1, 2], "tr": "dağlardan"}, {"ar": [4], "tr": "ustaca"}, {"ar": [3], "tr": "evler"}, {"ar": [0], "tr": "yontuyorsunuz (oyup yapıyorsunuz)."}]}, {"ayet": 150, "gruplar": [{"ar": [0, 1], "tr": "Artık Allah’tan korkun"}, {"ar": [2], "tr": "ve bana itaat edin."}]}, {"ayet": 151, "gruplar": [{"ar": [3], "tr": "aşırı gidenlerin"}, {"ar": [2], "tr": "emrine"}, {"ar": [0, 1], "tr": "uymayın."}]}, {"ayet": 152, "gruplar": [{"ar": [2, 3], "tr": "Yeryüzünde"}, {"ar": [1], "tr": "bozgunculuk yapıp"}, {"ar": [0, 4, 5], "tr": "dirlik düzenlik vermeyen"}]}, {"ayet": 153, "gruplar": [{"ar": [0], "tr": "Dediler ki:"}, {"ar": [2], "tr": "Sen,"}, {"ar": [1], "tr": "olsa olsa"}, {"ar": [3, 4], "tr": "iyice büyülenmiş birisin!"}]}, {"ayet": 154, "gruplar": [{"ar": [1, 0, 2], "tr": "Sen de ancak"}, {"ar": [4], "tr": "bizim gibi"}, {"ar": [3], "tr": "bir insansın."}, {"ar": [7], "tr": "Eğer"}, {"ar": [10, 9], "tr": "doğru söyleyenlerden"}, {"ar": [8], "tr": "isen,"}, {"ar": [5, 6], "tr": "haydi bize bir mucize getir."}]}, {"ayet": 155, "gruplar": [{"ar": [1, 2], "tr": "İşte (mucize) bu dişi devedir;"}, {"ar": [3, 4], "tr": "onun bir su içme hakkı vardır,"}, {"ar": [7, 8], "tr": "belli bir günün"}, {"ar": [6], "tr": "içme hakkı da"}, {"ar": [5], "tr": "sizindir,"}, {"ar": [0], "tr": "dedi."}]}, {"ayet": 156, "gruplar": [{"ar": [0, 1, 2], "tr": "Ona bir kötülükle ilişmeyin,"}, {"ar": [6], "tr": "yoksa sizi muazzam"}, {"ar": [5], "tr": "bir günün"}, {"ar": [4], "tr": "azabı"}, {"ar": [3], "tr": "yakalayıverir."}]}, {"ayet": 157, "gruplar": [{"ar": [0], "tr": "Buna rağmen onlar deveyi kestiler;"}, {"ar": [1], "tr": "ama"}, {"ar": [2], "tr": "pişman da oldular."}]}, {"ayet": 158, "gruplar": [{"ar": [0, 1], "tr": "Bunun üzerine onları azap yakaladı."}, {"ar": [3, 4, 5], "tr": "Doğrusu bunda,"}, {"ar": [6], "tr": "büyük bir ders vardır;"}, {"ar": [8, 9], "tr": "ama"}, {"ar": [10], "tr": "çokları"}, {"ar": [11], "tr": "iman etmezler."}]}, {"ayet": 159, "gruplar": [{"ar": [0], "tr": "Şüphesiz"}, {"ar": [1], "tr": "Rabbin,"}, {"ar": [2], "tr": "işte O,"}, {"ar": [3], "tr": "mutlak galip"}, {"ar": [4], "tr": "ve engin merhamet sahibidir."}]}, {"ayet": 160, "gruplar": [{"ar": [1, 2], "tr": "Lût kavmi"}, {"ar": [3], "tr": "peygamberleri"}, {"ar": [0], "tr": "yalancılıkla suçladı."}]}]}