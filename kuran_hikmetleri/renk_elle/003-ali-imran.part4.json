{"sure":3,"ayetler":[
 {"ayet":106,"gruplar":[{"ar":[1,2],"tr":"Nice yüzlerin ağardığı,"},{"ar":[3,4],"tr":"nice yüzlerin de karardığı"},{"ar":[0],"tr":"günü (düşünün.)"},{"ar":[6,7,8,9],"tr":"İmdi, yüzleri kararanlara:"},{"ar":[10,11,12],"tr":"İnanmanızdan sonra kâfir mi oldunuz?"},{"ar":[15,16,17],"tr":"Öyle ise inkâr etmiş olmanız yüzünden"},{"ar":[13,14],"tr":"tadın azabı! (denilir)"}]},
 {"ayet":107,"gruplar":[{"ar":[0,1,2,3],"tr":"Yüzleri ağaranlara gelince,"},{"ar":[4,5,6,7],"tr":"onlar Allah’ın rahmeti içindedirler;"},{"ar":[8,9],"tr":"orada ebedî kalacaklardır"}]},
 {"ayet":108,"gruplar":[{"ar":[0,2],"tr":"İşte bunlar, Allah’ın,"},{"ar":[4,5,3,1],"tr":"sana hak olarak okuduğumuz âyetleridir"},{"ar":[7,8,9,10,11],"tr":"Allah hiçbir kimseye haksızlık etmek istemez"}]},
 {"ayet":109,"gruplar":[{"ar":[2,3,4,5,6,1,0],"tr":"Göklerde ve yerde ne varsa Allah’ındır"},{"ar":[11,10],"tr":"İşler, dönüp dolaşıp"},{"ar":[8,9],"tr":"Allah’a varır"}]},
 {"ayet":110,"gruplar":[{"ar":[0],"tr":"Siz,"},{"ar":[4,3],"tr":"insanların iyiliği için ortaya çıkarılmış"},{"ar":[1,2],"tr":"en hayırlı ümmetsiniz;"},{"ar":[5,6],"tr":"iyiliği emreder,"},{"ar":[7,8,9],"tr":"kötülükten meneder"},{"ar":[10,11],"tr":"ve Allah’a inanırsınız"},{"ar":[13,14,15,16],"tr":"Ehl-i kitap da inansaydı,"},{"ar":[17,18,19],"tr":"elbet bu, kendileri için çok iyi olurdu"},{"ar":[21,22],"tr":"(Gerçi) içlerinde iman edenler var;"},{"ar":[23,24],"tr":"(fakat) çoğu yoldan çıkmışlardır"}]},
 {"ayet":111,"gruplar":[{"ar":[0],"tr":"Onlar (ehl-i kitap) size,"},{"ar":[1,2,3],"tr":"incitmekten başka bir zarar veremezler"},{"ar":[5,6],"tr":"Sizinle savaşa girecek olsalar,"},{"ar":[7,8],"tr":"size arkalarını dönüp kaçarlar"},{"ar":[9,10,11],"tr":"Sonra kendilerine yardım da edilmez"}]},
 {"ayet":112,"gruplar":[{"ar":[3,4,5],"tr":"Onlar (yahudiler) nerede bulunurlarsa bulunsunlar,"},{"ar":[6,7,8,9,10,11,12],"tr":"Allah’ın ahdine ve insanların (müminlerin) himayesine sığınmadıkça"},{"ar":[1,2,0],"tr":"kendilerine zillet (damgası) vurulmuştur;"},{"ar":[13,14,15,16],"tr":"Allah’ın hışmına uğramışlar"},{"ar":[17,18,19],"tr":"ve miskinliğe mahkum edilmişlerdir"},{"ar":[21,22,23,24,25,26],"tr":"Çünkü onlar, Allah’ın âyetlerini inkâr ediyorlar"},{"ar":[27,28,29,30],"tr":"ve haksız yere peygamberleri öldürüyorlardı"},{"ar":[32,33,34,35,36],"tr":"Bu da, onların isyan etmiş ve haddi aşmış bulunmalarındandır"}]},
 {"ayet":113,"gruplar":[{"ar":[1,2],"tr":"Hepsi bir değildir;"},{"ar":[4,5,6,7,8],"tr":"ehl-i kitap içinde istikamet sahibi bir topluluk vardır ki,"},{"ar":[12,13],"tr":"gece saatlerinde"},{"ar":[14,15],"tr":"secdeye kapanarak"},{"ar":[9,10,11],"tr":"Allah’ın âyetlerini okurlar"}]},
 {"ayet":114,"gruplar":[{"ar":[1,2,3,0],"tr":"Onlar, Allah’a ve ahiret gününe inanırlar;"},{"ar":[4,5],"tr":"iyiliği emreder,"},{"ar":[6,7,8],"tr":"kötülükten menederler;"},{"ar":[9,10,11],"tr":"hayırlı işlere koşuşurlar"},{"ar":[12,13,14],"tr":"İşte bunlar iyi insanlardandır"}]},
 {"ayet":115,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Onların yaptıkları hiçbir hayır karşılıksız bırakılmayacaktır"},{"ar":[7,8,9],"tr":"Allah, takvâ sahiplerini çok iyi bilir"}]},
 {"ayet":116,"gruplar":[{"ar":[1,2,0],"tr":"İnkâr edenler var ya,"},{"ar":[5,6,7,8],"tr":"onların malları da evlâtları da"},{"ar":[9,10],"tr":"Allah’a karşı"},{"ar":[3,4,11],"tr":"kendilerine hiçbir fayda sağlamayacaktır"},{"ar":[13,14,15],"tr":"İşte onlar, cehennemliklerdir;"},{"ar":[17,18,19],"tr":"onlar orada ebedî kalacaklardır"}]},
 {"ayet":117,"gruplar":[{"ar":[4,5,6,3],"tr":"Onların, bu dünya hayatında"},{"ar":[1,2,0],"tr":"yapmakta oldukları harcamaların durumu,"},{"ar":[14,15,13],"tr":"kendilerine zulmetmiş olan bir kavmin"},{"ar":[12,11,16],"tr":"ekinlerini vurup da mahveden"},{"ar":[10,8,9],"tr":"kavurucu bir rüzgârın"},{"ar":[7],"tr":"durumu gibidir"},{"ar":[18,19,20],"tr":"Onlara Allah zulmetmedi;"},{"ar":[21,22,23],"tr":"fakat onlar kendilerine zulmediyorlar"}]},
 {"ayet":118,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[6,7,3,4,5],"tr":"Kendi dışınızdakileri sırdaş edinmeyin"},{"ar":[8,9,10],"tr":"Çünkü onlar size fenalık etmekten asla geri durmazlar,"},{"ar":[11,12,13],"tr":"hep sıkıntıya düşmenizi isterler"},{"ar":[14,15,16,17,18],"tr":"Gerçekten, kin ve düşmanlıkları ağızlarından (dökülen sözlerinden) belli olmaktadır"},{"ar":[19,20,21,22],"tr":"Kalplerinde sakladıkları (düşmanlıkları) ise daha büyüktür"},{"ar":[29,30,31],"tr":"Eğer düşünüp anlıyorsanız,"},{"ar":[24,25,26,27],"tr":"âyetlerimizi size açıklamış bulunuyoruz"}]},
 {"ayet":119,"gruplar":[{"ar":[0,1],"tr":"İşte siz öyle kimselersiniz ki,"},{"ar":[3,4],"tr":"onlar sizi sevmedikleri halde"},{"ar":[2],"tr":"siz onları seversiniz"},{"ar":[5,6,7],"tr":"Siz, bütün kitaplara inanırsınız;"},{"ar":[8,9],"tr":"onlar ise, sizinle karşılaştıklarında"},{"ar":[11,10],"tr":"«İnandık» derler;"},{"ar":[12,13],"tr":"kendi başlarına kaldıklarında da,"},{"ar":[17,18],"tr":"size olan kinlerinden dolayı"},{"ar":[14,15,16],"tr":"parmaklarının uçlarını ısırırlar"},{"ar":[20],"tr":"De ki:"},{"ar":[22,21],"tr":"Kininizden (kahrolup) ölün!"},{"ar":[24,25,26,27,28],"tr":"Şüphesiz Allah kalplerin içindekini hakkıyla bilmektedir"}]},
 {"ayet":120,"gruplar":[{"ar":[0,1,2],"tr":"Size bir iyilik dokunsa,"},{"ar":[3],"tr":"bu onları tasalandırır;"},{"ar":[4,5,6],"tr":"başınıza bir musibet gelse,"},{"ar":[7,8],"tr":"buna da sevinirler"},{"ar":[10,11,12],"tr":"Eğer sabreder ve korunursanız,"},{"ar":[13,14,15,16],"tr":"onların hilesi size hiçbir zarar vermez"},{"ar":[18,19,20,21,22],"tr":"Şüphesiz Allah, onların yaptıklarını çepeçevre kuşatmıştır"}]},
 {"ayet":121,"gruplar":[{"ar":[0,1],"tr":"Hani sen, sabah erkenden"},{"ar":[4,5,6,7],"tr":"müminleri savaş mevzilerine yerleştirmek için"},{"ar":[2,3],"tr":"ailenden ayrılmıştın"},{"ar":[9,10,11],"tr":"Allah, hakkıyle işiten ve bilendir"}]},
 {"ayet":122,"gruplar":[{"ar":[0],"tr":"O zaman"},{"ar":[3,2,1,4,5],"tr":"içinizden iki bölük bozulmaya yüz tutmuştu"},{"ar":[6,7],"tr":"Halbuki Allah onların yardımcısı idi"},{"ar":[12,9,10,11],"tr":"Müminler, yalnız Allah’a dayanıp güvensinler"}]},
 {"ayet":123,"gruplar":[{"ar":[0],"tr":"Andolsun,"},{"ar":[4,5],"tr":"sizler güçsüz olduğunuz halde"},{"ar":[2,3,1],"tr":"Allah, Bedir’de de size yardım etmişti"},{"ar":[7,8],"tr":"Öyle ise, Allah’tan sakının"},{"ar":[9,10],"tr":"ki O’na şükretmiş olasınız"}]},
 {"ayet":124,"gruplar":[{"ar":[0,1,2],"tr":"O zaman sen, müminlere şöyle diyordun:"},{"ar":[12,8,9,10,11],"tr":"İndirilen üç bin melekle"},{"ar":[7],"tr":"Rabbinizin"},{"ar":[6],"tr":"sizi takviye etmesi,"},{"ar":[3,4],"tr":"sizin için yeterli değil midir?"}]},
 {"ayet":125,"gruplar":[{"ar":[0],"tr":"Evet,"},{"ar":[2,3,4],"tr":"siz sabır gösterir ve Allah’tan sakınırsanız,"},{"ar":[5,6,7,8],"tr":"onlar (düşmanlarınız) hemen şu anda üzerinize gelseler,"},{"ar":[10],"tr":"Rabbiniz,"},{"ar":[15,11,12,13,14],"tr":"nişanlı beş bin melekle"},{"ar":[9],"tr":"sizi takviye eder"}]},
 {"ayet":126,"gruplar":[{"ar":[2],"tr":"Allah, bunu"},{"ar":[3,4,5],"tr":"size sırf bir müjde olsun"},{"ar":[6,7,8],"tr":"ve kalpleriniz bu sayede rahatlasın diye"},{"ar":[1],"tr":"yaptı"},{"ar":[11],"tr":"Zafer,"},{"ar":[12,10,13,14,15,16,17],"tr":"yalnızca mutlak güç ve hikmet sahibi Allah katındandır"}]},
 {"ayet":127,"gruplar":[{"ar":[2,3,4,1],"tr":"Allah, kâfirlerden bir kısmının"},{"ar":[0],"tr":"kökünü kessin"},{"ar":[5,6],"tr":"veya onları perişan etsin,"},{"ar":[7,8],"tr":"böylece bozulmuş bir halde dönüp gitsinler"}]},
 {"ayet":128,"gruplar":[{"ar":[0,1,2,3,4],"tr":"-ki bu işte senin yapacağın bir şey yoktur-"},{"ar":[5,6,7],"tr":"yahut (müslüman olsunlar da) tevbelerini kabul etsin,"},{"ar":[8,9],"tr":"ya da (ısrar ederlerse) onlara azap etsin diye"},{"ar":[10,11],"tr":"Çünkü onlar zalimdirler"}]},
 {"ayet":129,"gruplar":[{"ar":[3,4,5,6,1,0],"tr":"Göklerde ve yerde ne varsa Allah’ındır"},{"ar":[9,10,8],"tr":"Dilediğini bağışlar,"},{"ar":[11,12,13],"tr":"dilediğine azap eder"},{"ar":[15,16,17],"tr":"Allah, çok bağışlayıcı ve çok merhametlidir"}]},
 {"ayet":130,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[6,7,5,3,4],"tr":"Kat kat arttırılmış olarak faiz yemeyin"},{"ar":[9,10],"tr":"Allah’tan sakının"},{"ar":[11,12],"tr":"ki kurtuluşa eresiniz"}]},
 {"ayet":131,"gruplar":[{"ar":[4,3,2],"tr":"Kâfirler için hazırlanmış bulunan"},{"ar":[1,0],"tr":"ateşten sakının!"}]},
 {"ayet":132,"gruplar":[{"ar":[1,2,0],"tr":"Allah’a ve Resûl’üne itaat edin"},{"ar":[3,4],"tr":"ki rahmete kavuşturulasınız"}]},
 {"ayet":133,"gruplar":[{"ar":[4,5,3],"tr":"Rabbinizin bağışına"},{"ar":[11,10],"tr":"ve takvâ sahipleri için hazırlanmış olup"},{"ar":[7,8,9],"tr":"genişliği gökler ve yer kadar olan"},{"ar":[6,1,2],"tr":"cennete koşun!"}]},
 {"ayet":134,"gruplar":[{"ar":[0],"tr":"O takvâ sahipleri ki,"},{"ar":[3,4,2],"tr":"bollukta da darlıkta da"},{"ar":[1],"tr":"Allah için harcarlar;"},{"ar":[5,6],"tr":"öfkelerini yutarlar"},{"ar":[7,8,9],"tr":"ve insanları affederler"},{"ar":[11,12,13],"tr":"Allah da güzel davranışta bulunanları sever"}]},
 {"ayet":135,"gruplar":[{"ar":[0],"tr":"Yine onlar ki,"},{"ar":[1,2,3],"tr":"bir kötülük yaptıklarında,"},{"ar":[4,5,6],"tr":"ya da kendilerine zulmettiklerinde"},{"ar":[7,8],"tr":"Allah’ı hatırlayıp"},{"ar":[9,10],"tr":"günahlarından dolayı hemen tevbe-istiğfar ederler"},{"ar":[11,12,13,14,15],"tr":"Zaten günahları Allah’tan başka kim bağışlayabilir ki!"},{"ar":[16,17,18,19,20,21,22],"tr":"Bir de onlar, işledikleri kötülüklerde, bile bile ısrar etmezler"}]},
 {"ayet":136,"gruplar":[{"ar":[0,1],"tr":"İşte onların mükâfatı,"},{"ar":[3,4,2],"tr":"Rableri tarafından bağışlanma"},{"ar":[7,8,9,6],"tr":"ve altlarından ırmaklar akan,"},{"ar":[10,11],"tr":"içinde ebedî kalacakları"},{"ar":[5],"tr":"cennetlerdir"},{"ar":[13,14,15],"tr":"Böyle amel edenlerin mükâfatı ne güzeldir!"}]},
 {"ayet":137,"gruplar":[{"ar":[2,3],"tr":"Sizden önce"},{"ar":[4,0,1],"tr":"nice (milletler hakkında) ilâhî kanunlar gelip geçmiştir"},{"ar":[5,6,7],"tr":"Onun için, yeryüzünde gezin dolaşın da"},{"ar":[12,11,9,10],"tr":"(Allah’ın âyetlerini) yalan sayanların âkıbeti ne olmuş,"},{"ar":[8],"tr":"görün!"}]},
 {"ayet":138,"gruplar":[{"ar":[0],"tr":"Bu (Kur’an),"},{"ar":[2,1],"tr":"bütün insanlığa bir açıklamadır;"},{"ar":[5,3,4],"tr":"takvâ sahipleri için de bir hidayet ve bir öğüttür"}]},
 {"ayet":139,"gruplar":[{"ar":[0,1],"tr":"Gevşeklik göstermeyin,"},{"ar":[2,3],"tr":"üzüntüye kapılmayın"},{"ar":[6,7,8],"tr":"Eğer inanmışsanız,"},{"ar":[4,5],"tr":"üstün gelecek olan sizsiniz"}]},
 {"ayet":140,"gruplar":[{"ar":[0,1,2],"tr":"Eğer siz (Uhud’da) bir acıya uğradınızsa,"},{"ar":[3,4,5,6,7],"tr":"(Bedir’de de düşmanınız olan) o kavim de benzer bir acıya uğramıştır"},{"ar":[9,10,11,12,13],"tr":"O günleri biz insanlar arasında döndürür dururuz (zaferi bazen bir topluma bazen öteki topluma nasip ederiz.)"},{"ar":[14,15,16,17],"tr":"Ta ki Allah, iman edenleri ortaya çıkarsın"},{"ar":[18,19,20],"tr":"ve aranızdan şahitler edinsin"},{"ar":[22,23,24,25],"tr":"Allah zalimleri sevmez"}]}
]}
