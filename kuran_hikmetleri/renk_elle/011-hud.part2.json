{"sure":11,"ayetler":[
{"ayet":31,"gruplar":[{"ar":[2],"tr":"Ben size"},{"ar":[0,1,3,4,5],"tr":"«Allah’ın hazineleri benim yanımdadır» demiyorum"},{"ar":[6,7,8],"tr":"gaybı da bilmem"},{"ar":[9,10,11,12],"tr":"«Ben bir meleğim» de demiyorum"},{"ar":[15,16,17],"tr":"Sizin gözlerinizin hor gördüğü kimseler için"},{"ar":[13,14,18,19,20,21],"tr":"«Allah onlara asla bir hayır vermeyecektir» diyemem"},{"ar":[23,24,25,26,27],"tr":"Onların kalplerinde olanı, Allah daha iyi bilir"},{"ar":[29,30,31,32],"tr":"Onları kovduğum takdirde ben gerçekten zalimlerden olurum.»"}]},
{"ayet":32,"gruplar":[{"ar":[0],"tr":"Dediler ki"},{"ar":[1],"tr":"Ey Nuh"},{"ar":[2,3],"tr":"Bizimle mücadele ettin"},{"ar":[4,5],"tr":"ve bize karşı mücadelede çok ileri gittin"},{"ar":[9,10,11,12],"tr":"Eğer doğrulardan isen"},{"ar":[7,8],"tr":"kendisiyle bizi tehdit ettiğini (azabı)"},{"ar":[6],"tr":"bize getir"}]},
{"ayet":33,"gruplar":[{"ar":[0],"tr":"(Nuh) dedi ki"},{"ar":[1,2,3,4,5,6],"tr":"«Onu size ancak dilerse Allah getirir"},{"ar":[7,8,9],"tr":"Ve siz (Allah’ı) âciz bırakacak değilsiniz"}]},
{"ayet":34,"gruplar":[{"ar":[8,9,10,11,12,13],"tr":"Eğer Allah sizi azdırmak istiyorsa"},{"ar":[3,4,5,6,7],"tr":"ben size öğüt vermek istesem de"},{"ar":[0,1,2],"tr":"öğüdüm size fayda vermez"},{"ar":[15,16],"tr":"(Çünkü) O sizin Rabbinizdir"},{"ar":[17,18],"tr":"Ve (nihayet) O’na döndürüleceksiniz.»"}]},
{"ayet":35,"gruplar":[{"ar":[0,2],"tr":"(Resûlüm!) Yoksa, «Bunu uydurdu» mu"},{"ar":[1],"tr":"diyorlar"},{"ar":[4],"tr":"De ki"},{"ar":[5,6],"tr":"«Eğer onu uydurduysam"},{"ar":[7,8],"tr":"günahım bana aittir"},{"ar":[9,10,11,12],"tr":"Fakat ben sizin işlediğiniz günahtan uzağım.»"}]},
{"ayet":36,"gruplar":[{"ar":[0,1,2],"tr":"Nuh’a vahyolundu ki"},{"ar":[6,7,8,9,10,11],"tr":"Kavminden iman etmiş olanlardan başkası"},{"ar":[3,4,5],"tr":"artık (sana) asla inanmayacak"},{"ar":[14,15,16],"tr":"Öyle ise onların işlemekte olduklarından (günahlardan) dolayı"},{"ar":[12,13],"tr":"üzülme"}]},
{"ayet":37,"gruplar":[{"ar":[2],"tr":"Gözlerimizin önünde"},{"ar":[3],"tr":"ve vahyimiz (emrimiz) uyarınca"},{"ar":[0,1],"tr":"gemiyi yap"},{"ar":[4,5,6,7,8],"tr":"ve zulmedenler hakkında bana (bir şey) söyleme"},{"ar":[10,11],"tr":"Onlar mutlaka boğulacaklardır"}]},
{"ayet":38,"gruplar":[{"ar":[0,1],"tr":"Nuh gemiyi yapıyor"},{"ar":[5,6,7],"tr":"kavminden ileri gelenler"},{"ar":[2,3,4],"tr":"ise, yanına her uğradıkça"},{"ar":[8,9],"tr":"onunla alay ediyorlardı"},{"ar":[11],"tr":"Dedi ki"},{"ar":[12,13,14],"tr":"Eğer bizimle alay ediyorsanız"},{"ar":[18,19],"tr":"iyi bilin ki siz nasıl alay ediyorsanız"},{"ar":[15,16,17],"tr":"biz de sizinle alay edeceğiz"}]},
{"ayet":39,"gruplar":[{"ar":[2,3,4,5],"tr":"Kendisini rezil edecek azabın kime geleceğini"},{"ar":[6,7,8,9],"tr":"ve sürekli bir azabın kimin başına ineceğini"},{"ar":[0,1],"tr":"yakında bileceksiniz.»"}]},
{"ayet":40,"gruplar":[{"ar":[0,1,2,3],"tr":"Nihayet emrimiz gelip de"},{"ar":[4,5],"tr":"sular coşup yükselmeye başlayınca"},{"ar":[6],"tr":"Nuh’a dedik ki"},{"ar":[9,10,11,12],"tr":"«(Canlı çeşitlerinin) her birinden birer çift ile"},{"ar":[14,15,16,17,18],"tr":"-(boğulacağına dair) aleyhinde söz geçmiş olanlar dışında-"},{"ar":[13,19,20],"tr":"aileni ve iman edenleri"},{"ar":[7,8],"tr":"gemiye yükle!»"},{"ar":[22,23,24,25,26],"tr":"Zaten onunla beraber pek azı iman etmişti"}]},
{"ayet":41,"gruplar":[{"ar":[1],"tr":"(Nuh) dedi ki"},{"ar":[2,3],"tr":"«Gemiye binin"},{"ar":[6,7],"tr":"Onun yüzüp gitmesi de, durması da"},{"ar":[4,5],"tr":"Allah’ın adıyladır"},{"ar":[9,10,11,12],"tr":"Şüphesiz ki Rabbim çok bağışlayan, pek esirgeyendir.»"}]},
{"ayet":42,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Gemi, dağlar gibi dalgalar arasında onları götürüyordu"},{"ar":[7],"tr":"Nuh"},{"ar":[9,10,11],"tr":"gemiden uzakta bulunan"},{"ar":[8],"tr":"oğluna"},{"ar":[12],"tr":"Yavrucuğum"},{"ar":[13,14],"tr":"(Sen de) bizimle beraber bin"},{"ar":[15,16,17,18],"tr":"kâfirlerle beraber olma"},{"ar":[6],"tr":"diye seslendi"}]},
{"ayet":43,"gruplar":[{"ar":[1,2,3,4,5,6],"tr":"Oğlu: Beni sudan koruyacak bir dağa sığınacağım"},{"ar":[0],"tr":"dedi"},{"ar":[9,10,11,12,13,14,15,16,17],"tr":"(Nuh): «Bugün Allah’ın emrinden (azabından), merhamet sahibi Allah’tan başka koruyacak kimse yoktur»"},{"ar":[8],"tr":"dedi"},{"ar":[19,20,21],"tr":"Aralarına dalga girdi"},{"ar":[22,23,24],"tr":"böylece o da boğulanlardan oldu"}]},
{"ayet":44,"gruplar":[{"ar":[1,2,3],"tr":"(Nihayet) «Ey yer suyunu yut"},{"ar":[0,4,5],"tr":"Ve ey gök (suyunu) tut!» denildi"},{"ar":[6,7],"tr":"Su çekildi"},{"ar":[8,9],"tr":"iş bitirildi"},{"ar":[10,11,12],"tr":"(gemi de) Cûdî (dağının) üzerine yerleşti"},{"ar":[14,15,16,17],"tr":"Ve: «O zalimler topluluğunun canı cehenneme!» denildi"}]},
{"ayet":45,"gruplar":[{"ar":[0,1,2],"tr":"Nuh Rabbine dua edip"},{"ar":[3],"tr":"dedi ki"},{"ar":[4],"tr":"«Ey Rabbim"},{"ar":[5,6,7,8],"tr":"Şüphesiz oğlum da ailemdendir"},{"ar":[9,10,11],"tr":"Senin vâdin ise elbette haktır"},{"ar":[12,13,14],"tr":"Sen hakimler hakimisin.»"}]},
{"ayet":46,"gruplar":[{"ar":[0],"tr":"Allah buyurdu ki"},{"ar":[1],"tr":"Ey Nuh"},{"ar":[2,3,4,5],"tr":"O asla senin ailenden değildir"},{"ar":[7,8,9,10],"tr":"Çünkü onun yaptığı kötü bir iştir"},{"ar":[12,13,14,15,16,17,18],"tr":"O halde hakkında bilgin olmayan bir şeyi benden isteme"},{"ar":[20,21,22,23,24,25],"tr":"Ben sana cahillerden olmamanı tavsiye ederim"}]},
{"ayet":47,"gruplar":[{"ar":[0],"tr":"Nuh dedi ki"},{"ar":[1],"tr":"Ey Rabbim"},{"ar":[2,5,6,7,8,9,10,11],"tr":"Ben senden hakkında bilgim olmayan şeyi istemekten"},{"ar":[3,4],"tr":"sana sığınırım"},{"ar":[13,14,15,16],"tr":"Eğer beni bağışlamaz ve esirgemezsen"},{"ar":[17,18,19],"tr":"ben ziyana uğrayanlardan olurum"}]},
{"ayet":48,"gruplar":[{"ar":[0],"tr":"Denildi ki"},{"ar":[1],"tr":"Ey Nuh"},{"ar":[6,7,8,9,10],"tr":"Sana ve seninle beraber olan ümmetlere"},{"ar":[2,3,4,5],"tr":"bizden selam ve bereketlerle (gemiden) in"},{"ar":[13],"tr":"Kendilerini (dünyada) faydalandıracağımız"},{"ar":[14,15,16,17,18],"tr":"sonra da bizden kendilerine elem verici bir azabın dokunacağı"},{"ar":[12],"tr":"ümmetler de olacaktır"}]},
{"ayet":49,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) İşte bunlar"},{"ar":[4,5],"tr":"sana vahyettiğimiz"},{"ar":[1,2,3],"tr":"gayb haberlerindendir"},{"ar":[13,14,15],"tr":"Bundan önce"},{"ar":[7,8,9,10],"tr":"onları ne sen biliyordun"},{"ar":[11,12],"tr":"ne de kavmin"},{"ar":[17],"tr":"O halde sabret"},{"ar":[19,20,21],"tr":"Çünkü iyi sonuç (sabredip) sakınanlarındır"}]},
{"ayet":50,"gruplar":[{"ar":[0,1],"tr":"Âd kavmine de"},{"ar":[2,3],"tr":"kardeşleri Hûd’u (gönderdik)"},{"ar":[5],"tr":"Dedi ki"},{"ar":[6],"tr":"Ey kavmim"},{"ar":[7,8],"tr":"Allah’a kulluk edin"},{"ar":[9,10,11,12,13],"tr":"Sizin O’ndan başka tanrınız yoktur"},{"ar":[15,16,17,18],"tr":"Siz yalan uyduranlardan başkası değilsiniz"}]},
{"ayet":51,"gruplar":[{"ar":[0],"tr":"Ey kavmim"},{"ar":[1,2,3,4],"tr":"Ben, ona (peygamberliğe) karşılık sizden bir ücret istemiyorum"},{"ar":[6,7,8,9,10,11],"tr":"Benim ücretim, beni yaratandan başkasına ait değildir"},{"ar":[13,14],"tr":"Hâla aklınızı kullanmıyor musunuz"}]},
{"ayet":52,"gruplar":[{"ar":[0],"tr":"Ey kavmim"},{"ar":[1,2],"tr":"Rabbinizden bağış dileyin"},{"ar":[3,4,5],"tr":"sonra da O’na tevbe edin"},{"ar":[6,7,8,9],"tr":"ki, üzerinize göğü (yağmuru) bol bol göndersin"},{"ar":[10,11,12,13],"tr":"ve kuvvetinize kuvvet katsın"},{"ar":[14,15,16],"tr":"Günah işleyerek (Allah’tan) yüz çevirmeyin"}]},
{"ayet":53,"gruplar":[{"ar":[0],"tr":"Dediler ki"},{"ar":[1],"tr":"Ey Hûd"},{"ar":[2,3,4],"tr":"Sen bize açık bir mucize getirmedin"},{"ar":[5,6,7,8,9,10],"tr":"biz de senin sözünle tanrılarımızı bırakacak değiliz"},{"ar":[11,12,13,14],"tr":"ve biz sana iman edecek de değiliz"}]},
{"ayet":54,"gruplar":[{"ar":[0,1,2,3,4,5,6],"tr":"Biz «Tanrılarımızdan biri seni fena çarpmış!» demekten başka bir söz söylemeyiz"},{"ar":[8],"tr":"(Hûd) dedi ki"},{"ar":[9,10,11],"tr":"«Ben Allah’ı şahit tutuyorum"},{"ar":[12],"tr":"siz de şahit olun ki"},{"ar":[13,14,15,16],"tr":"ben sizin ortak koştuklarınızdan uzağım.»"}]},
{"ayet":55,"gruplar":[{"ar":[0,1],"tr":"«O’ndan başka (taptıklarınızın hepsinden uzağım)"},{"ar":[3,4],"tr":"Haydi hepiniz bana tuzak kurun"},{"ar":[5,6,7],"tr":"sonra da bana mühlet vermeyin!»"}]},
{"ayet":56,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"«Ben, benim de Rabbim, sizin de Rabbiniz olan Allah’a dayandım"},{"ar":[7,8,9],"tr":"Çünkü yürüyen hiçbir varlık yoktur ki"},{"ar":[10,11,12,13],"tr":"O, onun perçeminden tutmuş olmasın"},{"ar":[15,16,17,18,19],"tr":"Şüphesiz Rabbim dosdoğru yoldadır.»"}]},
{"ayet":57,"gruplar":[{"ar":[0,1],"tr":"«Eğer yüz çevirirseniz"},{"ar":[2],"tr":"şüphesiz ki"},{"ar":[3,4,5,6,7],"tr":"benimle size gönderileni size bildirdim"},{"ar":[9,10,11,12],"tr":"Rabbim (dilerse) sizden başka bir kavmi yerinize getirir"},{"ar":[13,14,15],"tr":"de O’na hiçbir zarar veremezsiniz"},{"ar":[17,18,19,20,21,22],"tr":"Çünkü benim Rabbim her şeyi gözetendir.»"}]},
{"ayet":58,"gruplar":[{"ar":[0,1,2],"tr":"Emrimiz gelince"},{"ar":[4,5,6,7],"tr":"Hûd’u ve onunla beraber iman edenleri"},{"ar":[8,9],"tr":"tarafımızdan bir rahmetle"},{"ar":[3],"tr":"kurtardık"},{"ar":[10,11,12,13],"tr":"onları ağır bir azaptan kurtuluşa erdirdik"}]},
{"ayet":59,"gruplar":[{"ar":[0,1],"tr":"İşte Âd (kavmi)"},{"ar":[3,4,5],"tr":"Rablerinin âyetlerini inkâr ettiler"},{"ar":[6,7],"tr":"O’nun peygamberlerine âsi oldular"},{"ar":[8,9,10,11,12],"tr":"ve inatçı her zorbanın emrine uydular"}]},
{"ayet":60,"gruplar":[{"ar":[1,2,3],"tr":"Onlar hem bu dünyada"},{"ar":[5,6],"tr":"hem de kıyamet gününde"},{"ar":[0,4],"tr":"lânete tâbi tutuldular"},{"ar":[8,9,10],"tr":"Biliniz ki, Âd (kavmi)"},{"ar":[11,12],"tr":"Rablerini inkâr ettiler"},{"ar":[14],"tr":"(Şunu da) bilin ki"},{"ar":[16,17,18],"tr":"Hûd’un kavmi Âd"},{"ar":[15],"tr":"Allah’ın rahmetinden uzak kılındı"}]}
]}
