{"sure":7,"ayetler":[
 {"ayet":121,"gruplar":[{"ar":[3,2,1,0],"tr":"âlemlerin Rabbine inandık» dediler."}]},
 {"ayet":122,"gruplar":[{"ar":[1,2,0],"tr":"Musa ve Harun’un Rabbi olan"}]},
 {"ayet":123,"gruplar":[{"ar":[0,1],"tr":"Firavun dedi ki:"},{"ar":[6,7,4,5,3,2],"tr":"«Ben size izin vermeden ona iman mı ettiniz?"},{"ar":[10,9],"tr":"Bu, hiç şüphesiz"},{"ar":[13,14],"tr":"şehirde,"},{"ar":[15,16,17],"tr":"halkını oradan çıkarmak için"},{"ar":[12,11],"tr":"kurduğunuz bir tuzaktır."},{"ar":[19,20],"tr":"Ama yakında (başınıza gelecekleri) göreceksiniz!"}]},
 {"ayet":124,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Mutlaka ellerinizi ve ayaklarınızı çaprazlama keseceğim,"},{"ar":[5,6,7],"tr":"sonra da hepinizi asacağım!»"}]},
 {"ayet":125,"gruplar":[{"ar":[0],"tr":"Onlar:"},{"ar":[1,2,3,4],"tr":"Biz zaten Rabbimize döneceğiz."}]},
 {"ayet":126,"gruplar":[{"ar":[0,3,4],"tr":"Sen sadece"},{"ar":[6,7,8,9],"tr":"Rabbimizin âyetleri bize geldiğinde"},{"ar":[5],"tr":"onlara inandığımız için"},{"ar":[1,2],"tr":"bizden intikam alıyorsun."},{"ar":[11],"tr":"Ey Rabbimiz!"},{"ar":[12,13,14],"tr":"Bize bol bol sabır ver,"},{"ar":[15,16],"tr":"müslüman olarak canımızı al, dediler."}]},
 {"ayet":127,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Firavun’un kavminden ileri gelenler dediler ki:"},{"ar":[6,7],"tr":"Musa’yı ve kavmini,"},{"ar":[11,12],"tr":"seni ve tanrılarını bırakıp"},{"ar":[8,9,10],"tr":"yeryüzünde bozgunculuk çıkarsınlar diye mi"},{"ar":[5],"tr":"bırakacaksın?"},{"ar":[14,15,16,17,18],"tr":"(Firavun): «Biz onların oğullarını öldürüp, kadınlarını sağ bırakacağız."},{"ar":[19,20,21],"tr":"Elbette biz onları ezecek üstünlükteyiz» dedi."}]},
 {"ayet":128,"gruplar":[{"ar":[0,1,2],"tr":"Musa kavmine dedi ki:"},{"ar":[3,4],"tr":"«Allah’tan yardım isteyin"},{"ar":[5],"tr":"ve sabredin."},{"ar":[7,8,9],"tr":"Şüphesiz ki yeryüzü Allah’ındır."},{"ar":[10,11,12,13,14],"tr":"Kullarından dilediğini ona vâris kılar."},{"ar":[16,17],"tr":"Sonuç (Allah’tan korkup günahtan) sakınanlarındır.»"}]},
 {"ayet":129,"gruplar":[{"ar":[2,3,4,5],"tr":"Onlar da, sen bize (peygamber olarak) gelmeden önce de"},{"ar":[6,7,8,9],"tr":"geldikten sonra da"},{"ar":[1,0],"tr":"bize işkence edildi, dediler."},{"ar":[11,12,13,14,15,16],"tr":"(Musa), «Umulur ki Rabbiniz düşmanınızı helâk eder"},{"ar":[17,18,19],"tr":"ve onların yerine sizi yer yüzüne hakim kılar da"},{"ar":[20,21,22],"tr":"nasıl hareket edeceğinize bakar» dedi."}]},
 {"ayet":130,"gruplar":[{"ar":[0,2,3],"tr":"Andolsun ki, biz de Firavun’a uyanları"},{"ar":[8,9],"tr":"ders alsınlar diye"},{"ar":[4],"tr":"yıllarca kuraklık"},{"ar":[5,6,7],"tr":"ve mahsül kıtlığı ile"},{"ar":[1],"tr":"cezalandırdık."}]},
 {"ayet":131,"gruplar":[{"ar":[0,1,2],"tr":"Onlara bir iyilik (bolluk) gelince,"},{"ar":[3,4,5],"tr":"«Bu bizim hakkımızdır» derler;"},{"ar":[7,8,9],"tr":"eğer kendilerine bir fenalık gelirse"},{"ar":[10,11,12,13],"tr":"Musa ve onunla beraber olanları uğursuz sayarlardı."},{"ar":[15,16,17,18,19],"tr":"Bilesiniz ki, onlara gelen uğursuzluk Allah katındandır,"},{"ar":[20,21,22,23],"tr":"fakat onların çoğu bunu bilmezler."}]},
 {"ayet":132,"gruplar":[{"ar":[0],"tr":"Ve dediler ki:"},{"ar":[1,2,3,4,5,6,7],"tr":"«Bizi sihirlemek için ne mucize getirirsen getir,"},{"ar":[8,9,10,11],"tr":"biz sana inanacak değiliz.»"}]},
 {"ayet":133,"gruplar":[{"ar":[7,8],"tr":"Biz de ayrı ayrı mucizeler olarak"},{"ar":[1,2,3,4,5,6,0],"tr":"onların üzerine tufan, çekirge, haşere, kurbağalar ve kan gönderdik;"},{"ar":[9],"tr":"yine de büyüklük tasladılar"},{"ar":[10,11,12],"tr":"ve günahkâr bir kavim oldular."}]},
 {"ayet":134,"gruplar":[{"ar":[0,1,2,3],"tr":"Azap üzerlerine çökünce,"},{"ar":[5],"tr":"«Ey Musa!"},{"ar":[9,10,11],"tr":"sana verdiği söz hürmetine,"},{"ar":[6,7,8],"tr":"bizim için Rabbine dua et;"},{"ar":[13,14,15,16],"tr":"eğer bizden azabı kaldırırsan,"},{"ar":[17,18],"tr":"mutlaka sana inanacağız"},{"ar":[19,20,21,22,4],"tr":"ve muhakkak İsrailoğullarını seninle göndereceğiz» dediler."}]},
 {"ayet":135,"gruplar":[{"ar":[4,5,6,7],"tr":"Biz, ulaşacakları bir müddete kadar"},{"ar":[0,1,2,3],"tr":"onlardan azabı kaldırınca"},{"ar":[8,9,10],"tr":"hemen sözlerinden dönüverdiler."}]},
 {"ayet":136,"gruplar":[{"ar":[5,6,7,8,9,10],"tr":"Biz de âyetlerimizi yalanlamaları ve onlardan gafil kalmaları sebebiyle"},{"ar":[0,1],"tr":"kendilerinden intikam aldık"},{"ar":[2,3,4],"tr":"ve onları denizde boğduk."}]},
 {"ayet":137,"gruplar":[{"ar":[1,2,3,4],"tr":"Hor görülüp ezilmekte olan o kavmi (yahudileri) de,"},{"ar":[8,9,10],"tr":"içini bereketle doldurduğumuz yerin"},{"ar":[5,6,7],"tr":"doğu taraflarına ve batı taraflarına"},{"ar":[0],"tr":"mirasçı kıldık."},{"ar":[19,20,13,14,15,16,17,18,12],"tr":"Sabırlarına karşılık Rabbinin İsrailoğullarına verdiği güzel söz yerine geldi."},{"ar":[23,24,25,26,27],"tr":"Firavun ve kavminin yapmakta olduklarını"},{"ar":[28,29,30,22],"tr":"ve yetiştirdikleri bahçeleri helâk ettik."}]},
 {"ayet":138,"gruplar":[{"ar":[0,1,2,3],"tr":"İsrailoğullarını denizden geçirdik,"},{"ar":[4,5,6,7,8,9,10],"tr":"orada kendilerine mahsus birtakım putlara tapan bir kavme rastladılar."},{"ar":[13],"tr":"Bunun üzerine: Ey Musa!"},{"ar":[14,15,16,17,18,19],"tr":"Onların tanrıları olduğu gibi, sen de bizim için bir tanrı yap!"},{"ar":[12],"tr":"dediler."},{"ar":[22,23,24,21],"tr":"Musa: Gerçekten siz cahil bir toplumsunuz, dedi."}]},
 {"ayet":139,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Şüphesiz bunların içinde bulundukları (din) yıkılmıştır,"},{"ar":[6,7,8,9],"tr":"yapmakta oldukları da bâtıldır."}]},
 {"ayet":140,"gruplar":[{"ar":[0],"tr":"Musa dedi ki:"},{"ar":[5,6,7,8],"tr":"Allah sizi âlemlere üstün kılmışken"},{"ar":[1,2,3,4],"tr":"ben size Allah’tan başka bir tanrı mı arayayım?"}]},
 {"ayet":141,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"Hatırlayın ki, size işkencenin en kötüsünü yapan Firavun’un adamlarından sizi kurtardık."},{"ar":[9,10],"tr":"Onlar oğullarınızı öldürüyorlar,"},{"ar":[11,12],"tr":"kadınlarınızı sağ bırakıyorlardı."},{"ar":[14,15,16,17,18,19],"tr":"İşte bunda size Rabbiniz tarafından büyük bir imtihan vardır."}]},
 {"ayet":142,"gruplar":[{"ar":[1,2,3,4],"tr":"(Bana ibadet etmesi için) Musa’ya otuz gece vade verdik"},{"ar":[5,6],"tr":"ve ona on gece daha ilâve ettik;"},{"ar":[7,8,9,10,11],"tr":"böylece Rabbinin tayin ettiği vakit kırk geceyi buldu."},{"ar":[13,14,15,16],"tr":"Musa, kardeşi Harun’a dedi ki:"},{"ar":[17,18,19],"tr":"Kavmimin içinde benim yerime geç,"},{"ar":[20],"tr":"onları ıslah et,"},{"ar":[21,22,23,24],"tr":"bozguncuların yoluna uyma."}]},
 {"ayet":143,"gruplar":[{"ar":[0,1,2,3],"tr":"Musa tayin ettiğimiz vakitte (Tûr’a) gelip de"},{"ar":[4,5],"tr":"Rabbi onunla konuşunca"},{"ar":[7,8],"tr":"«Rabbim! Bana (kendini) göster;"},{"ar":[9,10,6],"tr":"seni göreyim!» dedi."},{"ar":[13,14],"tr":"(Rabbi): «Sen beni asla göremezsin."},{"ar":[15,16,17,18],"tr":"Fakat şu dağa bak,"},{"ar":[19,20,21],"tr":"eğer o yerinde durabilirse"},{"ar":[22,23,12],"tr":"sen de beni göreceksin!» buyurdu."},{"ar":[25,26,27,28],"tr":"Rabbi o dağa tecelli edince"},{"ar":[29,30],"tr":"onu paramparça etti,"},{"ar":[31,32,33],"tr":"Musa da baygın düştü."},{"ar":[35,36],"tr":"Ayılınca"},{"ar":[37],"tr":"dedi ki:"},{"ar":[38],"tr":"Seni noksan sıfatlardan tenzih ederim,"},{"ar":[39,40],"tr":"sana tevbe ettim."},{"ar":[41,42,43],"tr":"Ben inananların ilkiyim."}]},
 {"ayet":144,"gruplar":[{"ar":[0,1],"tr":"(Allah) Ey Musa! dedi,"},{"ar":[2,3,4,5,6,7],"tr":"ben risaletlerimle (sana verdiğim görevlerle) ve sözlerimle seni insanların başına seçtim."},{"ar":[8,9,10],"tr":"Sana verdiğimi al"},{"ar":[11,12,13],"tr":"ve şükredenlerden ol."}]},
 {"ayet":145,"gruplar":[{"ar":[7,8,9,10,4,5,6],"tr":"Nasihat ve her şeyin açıklamasına dair ne varsa hepsini"},{"ar":[1,2,3,0],"tr":"Musa için levhalarda yazdık."},{"ar":[11,12],"tr":"(Ve dedik ki): Bunları kuvvetle tut,"},{"ar":[13,14,15,16],"tr":"kavmine de onun en güzelini almalarını emret."},{"ar":[18,19,20],"tr":"Yakında size, yoldan çıkmışların yurdunu göstereceğim."}]},
 {"ayet":146,"gruplar":[{"ar":[5,6,7,8,3,4,1,2,0],"tr":"Yeryüzünde haksız yere böbürlenenleri âyetlerimden uzaklaştıracağım."},{"ar":[9,10,11,12,13,14,15],"tr":"Onlar bütün mucizeleri görseler de iman etmezler."},{"ar":[16,17,18,19,20,21,22],"tr":"Doğru yolu görseler onu yol edinmezler."},{"ar":[23,24,25,26,27,28],"tr":"Fakat azgınlık yolunu görürlerse, hemen ona saparlar."},{"ar":[30,31,32,33,34,35,36],"tr":"Bu durum, onların âyetlerimizi yalanlamalarından ve onlardan gafil olmalarından ileri gelmektedir."}]},
 {"ayet":147,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Halbuki âyetlerimizi ve ahirete kavuşmayı yalanlayanların"},{"ar":[5,6],"tr":"amelleri boşa çıkmıştır."},{"ar":[8,9,10,11,12,13],"tr":"Onlar, yapmakta oldukları amellerden başka bir şey için mi cezalandırılırlar!"}]},
 {"ayet":148,"gruplar":[{"ar":[1,2,3,4],"tr":"(Tûr’a giden) Musa’nın arkasından kavmi,"},{"ar":[0,5,6,7,8,9,10],"tr":"zinet takımlarından, böğürebilen bir buzağı heykelini (tanrı) edindiler."},{"ar":[12,13,14,15,16,17,18,19],"tr":"Görmediler mi ki o, onlarla ne konuşuyor ne de onlara yol gösteriyor?"},{"ar":[21],"tr":"Onu (tanrı olarak) benimsediler"},{"ar":[22,23],"tr":"ve zalimler oldular."}]},
 {"ayet":149,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"Pişman olup da kendilerinin gerçekten sapmış olduklarını görünce"},{"ar":[8],"tr":"dediler ki:"},{"ar":[9,10,11,12,13,14],"tr":"Eğer Rabbimiz bize acımaz ve bizi bağışlamazsa"},{"ar":[15,16,17],"tr":"mutlaka ziyana uğrayanlardan olacağız!"}]},
 {"ayet":150,"gruplar":[{"ar":[0,1,2,3,4,5,6],"tr":"Musa, kızgın ve üzgün bir halde kavmine dönünce:"},{"ar":[8,9,10,11],"tr":"«Benden sonra arkamdan ne kötü işler yapmışsınız!"},{"ar":[13,14,15,7],"tr":"Rabbinizin emrini (beklemeyip) acele mi ettiniz?» dedi."},{"ar":[17,18],"tr":"Tevrat levhalarını yere attı"},{"ar":[19,20,21,22,23],"tr":"ve kardeşinin (Harun’un) başını tutup kendine doğru çekmeye başladı."},{"ar":[25,26,27],"tr":"(Kardeşi): «Anam oğlu!"},{"ar":[28,29,30],"tr":"Bu kavim beni cidden zayıf gördüler"},{"ar":[31,32],"tr":"ve nerede ise beni öldüreceklerdi."},{"ar":[33,34,35,36],"tr":"Sen de düşmanları bana güldürme"},{"ar":[37,38,39,40,41],"tr":"ve beni bu zalim kavimle beraber tutma!» dedi."}]}
]}
