{"sure": 26, "ayetler": [{"ayet": 71, "gruplar": [{"ar": [1, 2], "tr": "Putlara tapıyoruz"}, {"ar": [3, 4, 5], "tr": "ve onlara tapmaya devam edeceğiz"}, {"ar": [0], "tr": "diye cevap verdiler."}]}, {"ayet": 72, "gruplar": [{"ar": [0], "tr": "İbrahim: Peki, dedi,"}, {"ar": [3, 4], "tr": "yalvardığınızda"}, {"ar": [2], "tr": "onlar sizi işitiyorlar mı?"}]}, {"ayet": 73, "gruplar": [{"ar": [0, 1], "tr": "Yahut size fayda"}, {"ar": [2, 3], "tr": "ya da zarar verebiliyorlar mı?"}]}, {"ayet": 74, "gruplar": [{"ar": [0], "tr": "Şöyle cevap verdiler:"}, {"ar": [1], "tr": "Hayır, ama"}, {"ar": [2, 3, 4, 5], "tr": "biz babalarımızı böyle yapar bulduk."}]}, {"ayet": 75, "gruplar": [{"ar": [0], "tr": "İbrahim dedi ki:"}, {"ar": [1, 2, 3, 4], "tr": "neye taptığınızı (biraz olsun) düşündünüz mü?"}]}, {"ayet": 76, "gruplar": [{"ar": [0, 1, 2], "tr": "ister sizin, ister önceki atalarınızın;"}]}, {"ayet": 77, "gruplar": [{"ar": [0, 1, 2], "tr": "onlar benim düşmanımdır;"}, {"ar": [3, 4, 5], "tr": "ancak âlemlerin Rabbi"}]}, {"ayet": 78, "gruplar": [{"ar": [0, 1], "tr": "Beni yaratan"}, {"ar": [2, 3], "tr": "ve bana doğru yolu gösteren O’dur."}]}, {"ayet": 79, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Beni yediren, içiren O’dur."}]}, {"ayet": 80, "gruplar": [{"ar": [0, 1], "tr": "Hastalandığım zaman"}, {"ar": [2, 3], "tr": "bana şifa veren O’dur."}]}, {"ayet": 81, "gruplar": [{"ar": [0, 1], "tr": "Benim canımı alacak,"}, {"ar": [2, 3], "tr": "sonra beni diriltecek O’dur."}]}, {"ayet": 82, "gruplar": [{"ar": [6, 7], "tr": "hesap günü"}, {"ar": [5], "tr": "hatalarımı"}, {"ar": [2, 3], "tr": "bağışlayacağını"}, {"ar": [1], "tr": "umduğum"}, {"ar": [0], "tr": "O’dur."}]}, {"ayet": 83, "gruplar": [{"ar": [0], "tr": "Rabbim!"}, {"ar": [1, 2, 3], "tr": "Bana hikmet ver"}, {"ar": [4, 5], "tr": "ve beni iyiler arasına kat."}]}, {"ayet": 84, "gruplar": [{"ar": [0, 1], "tr": "Bana,"}, {"ar": [4, 5], "tr": "sonra gelecekler içinde,"}, {"ar": [2, 3], "tr": "iyilikle anılmak nasip eyle!"}]}, {"ayet": 85, "gruplar": [{"ar": [0, 1], "tr": "Beni,"}, {"ar": [3], "tr": "Naîm cennetinin"}, {"ar": [2], "tr": "vârislerinden kıl."}]}, {"ayet": 86, "gruplar": [{"ar": [0, 1], "tr": "Babamı da bağışla"}, {"ar": [2, 3, 4, 5], "tr": "Çünkü o sapıklardandır."}]}, {"ayet": 87, "gruplar": [{"ar": [2, 3], "tr": "dirilecekleri gün,"}, {"ar": [0, 1], "tr": "beni mahcup etme."}]}, {"ayet": 88, "gruplar": [{"ar": [0], "tr": "O gün,"}, {"ar": [1, 2, 3], "tr": "ne mal fayda verir"}, {"ar": [4, 5], "tr": "ne de evlât."}]}, {"ayet": 89, "gruplar": [{"ar": [0], "tr": "Ancak"}, {"ar": [3], "tr": "Allah’a"}, {"ar": [4, 5], "tr": "kalb-i selîm (temiz bir kalp) ile"}, {"ar": [1, 2], "tr": "gelenler"}]}, {"ayet": 90, "gruplar": [{"ar": [1], "tr": "cennet,"}, {"ar": [2], "tr": "takvâ sahiplerine"}, {"ar": [0], "tr": "yaklaştırılır."}]}, {"ayet": 91, "gruplar": [{"ar": [1], "tr": "Cehennem"}, {"ar": [2], "tr": "azgınlara"}, {"ar": [0], "tr": "apaçık gösterilir."}]}, {"ayet": 92, "gruplar": [{"ar": [1], "tr": "Onlara:"}, {"ar": [2, 3, 4, 5], "tr": "Allah’tan gayrı taptıklarınız hani nerede?"}, {"ar": [0], "tr": "denilir."}]}, {"ayet": 93, "gruplar": [{"ar": [0, 1, 2], "tr": "Allah’tan gayrı"}, {"ar": [3, 4], "tr": "Size yardım edebiliyorlar mı"}, {"ar": [5, 6], "tr": "veya kendilerine (olsun) yardımları dokunuyor mu?"}]}, {"ayet": 94, "gruplar": [{"ar": [2], "tr": "onlar,"}, {"ar": [3], "tr": "o azgınlar"}, {"ar": [1, 0], "tr": "oraya tepetaklak (cehenneme) atılırlar."}]}, {"ayet": 95, "gruplar": [{"ar": [0, 1], "tr": "İblis orduları,"}, {"ar": [2], "tr": "toptan"}]}, {"ayet": 96, "gruplar": [{"ar": [2], "tr": "Orada"}, {"ar": [1, 3], "tr": "birbirleriyle çekişerek"}, {"ar": [0], "tr": "şöyle derler:"}]}, {"ayet": 97, "gruplar": [{"ar": [0], "tr": "Vallahi,"}, {"ar": [1, 2], "tr": "biz gerçekten"}, {"ar": [4, 5], "tr": "apaçık bir sapıklık"}, {"ar": [3], "tr": "içindeymişiz."}]}, {"ayet": 98, "gruplar": [{"ar": [0], "tr": "Çünkü"}, {"ar": [1], "tr": "biz sizi"}, {"ar": [2, 3], "tr": "âlemlerin Rabbi ile eşit tutuyorduk."}]}, {"ayet": 99, "gruplar": [{"ar": [2, 3], "tr": "Bizi ancak o günahkârlar"}, {"ar": [0, 1], "tr": "saptırdı."}]}, {"ayet": 100, "gruplar": [{"ar": [0], "tr": "Şimdi artık"}, {"ar": [1], "tr": "bizim"}, {"ar": [2, 3], "tr": "ne şefaatçilerimiz var,"}]}, {"ayet": 101, "gruplar": [{"ar": [0], "tr": "ne de"}, {"ar": [1, 2], "tr": "yakın bir dostumuz."}]}, {"ayet": 102, "gruplar": [{"ar": [0, 1], "tr": "Ah keşke"}, {"ar": [2, 3], "tr": "bizim için (dünyaya) bir dönüş daha olsa da,"}, {"ar": [4, 5, 6], "tr": "müminlerden olsak!"}]}, {"ayet": 103, "gruplar": [{"ar": [0], "tr": "Bunda"}, {"ar": [1, 2], "tr": "elbet"}, {"ar": [3], "tr": "(alınacak) büyük bir ders vardır;"}, {"ar": [5, 6], "tr": "ama"}, {"ar": [7], "tr": "çokları"}, {"ar": [8], "tr": "iman etmezler."}]}, {"ayet": 104, "gruplar": [{"ar": [0], "tr": "Şüphesiz"}, {"ar": [1], "tr": "Rabbin,"}, {"ar": [2], "tr": "işte O,"}, {"ar": [3], "tr": "mutlak galip"}, {"ar": [4], "tr": "ve engin merhamet sahibidir."}]}, {"ayet": 105, "gruplar": [{"ar": [1, 2], "tr": "Nuh kavmi"}, {"ar": [3], "tr": "peygamberleri"}, {"ar": [0], "tr": "yalancılıkla suçladılar."}]}, {"ayet": 106, "gruplar": [{"ar": [3, 4], "tr": "Kardeşleri Nuh"}, {"ar": [2], "tr": "onlara"}, {"ar": [0, 1], "tr": "şöyle demişti:"}, {"ar": [5, 6], "tr": "(Allah’a karşı gelmekten) sakınmaz mısınız?"}]}, {"ayet": 107, "gruplar": [{"ar": [0], "tr": "Bilin ki ben,"}, {"ar": [1], "tr": "size"}, {"ar": [2, 3], "tr": "gönderilmiş güvenilir bir elçiyim."}]}, {"ayet": 108, "gruplar": [{"ar": [0, 1], "tr": "Artık Allah’a karşı gelmekten sakının"}, {"ar": [2], "tr": "ve bana itaat edin."}]}, {"ayet": 109, "gruplar": [{"ar": [0, 1, 2], "tr": "Buna karşı"}, {"ar": [3, 4], "tr": "sizden hiçbir ücret istemiyorum."}, {"ar": [7, 8, 9], "tr": "Benim ecrimi verecek olan, ancak"}, {"ar": [10, 11], "tr": "âlemlerin Rabbidir."}]}, {"ayet": 110, "gruplar": [{"ar": [0, 1], "tr": "Onun için, Allah’tan korkun"}, {"ar": [2], "tr": "ve bana itaat edin."}]}]}