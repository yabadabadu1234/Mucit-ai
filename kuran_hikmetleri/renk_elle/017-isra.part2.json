{"sure": 17, "ayetler": [{"ayet": 41, "gruplar": [{"ar": [5], "tr": "Biz, onların akıllarını başlarına toplamaları için"}, {"ar": [2, 3, 4], "tr": "bu Kur’an’da"}, {"ar": [0, 1], "tr": "(çeşitli ikaz ve ihtarları) türlü şekillerde tekrar ettik."}, {"ar": [6, 7, 8, 9], "tr": "Fakat bu, onlara, daha da kaçıp uzaklaşmaktan başka bir şey sağlamıyor."}]}, {"ayet": 42, "gruplar": [{"ar": [0], "tr": "De ki:"}, {"ar": [1, 2, 3, 4, 5, 6], "tr": "Eğer söyledikleri gibi Allah ile birlikte başka ilâhlar da bulunsaydı,"}, {"ar": [7, 8], "tr": "o takdirde bu ilâhlar,"}, {"ar": [9, 10, 11], "tr": "Arş’ın sahibi olan Allah’a"}, {"ar": [12], "tr": "ulaşmak için çareler arayacaklardı."}]}, {"ayet": 43, "gruplar": [{"ar": [2, 3], "tr": "Allah, onların söyledikleri şeylerden"}, {"ar": [0], "tr": "münezzehtir;"}, {"ar": [1, 4, 5], "tr": "son derece yücedir ve uludur."}]}, {"ayet": 44, "gruplar": [{"ar": [2, 3, 4, 5, 6], "tr": "Yedi gök, yer ve bunlarda bulunan herkes"}, {"ar": [0, 1], "tr": "O’nu tesbih eder."}, {"ar": [8, 9, 10, 11, 12, 13], "tr": "O’nu övgü ile tesbih etmeyen hiçbir şey yoktur."}, {"ar": [14, 15, 16, 17], "tr": "Ne var ki siz, onların tesbihini anlamazsınız."}, {"ar": [19, 20, 21, 22], "tr": "O, halîmdir, bağışlayıcıdır."}]}, {"ayet": 45, "gruplar": [{"ar": [0, 1, 2], "tr": "Biz, Kur’an okuduğun zaman,"}, {"ar": [4, 5, 6, 7, 8, 9], "tr": "seninle ahirete inanmayanların arasına"}, {"ar": [10, 11], "tr": "gizleyici bir örtü"}, {"ar": [3], "tr": "çekeriz."}]}, {"ayet": 46, "gruplar": [{"ar": [4, 5], "tr": "Ayrıca, onu anlamamaları için"}, {"ar": [1, 2, 3], "tr": "kalplerine bir kapalılık"}, {"ar": [6, 7, 8], "tr": "ve kulaklarına bir ağırlık"}, {"ar": [0], "tr": "veririz."}, {"ar": [10, 11, 12, 13, 14, 15], "tr": "Sen, Kur’an’da Rabbinin birliğini yâdettiğinde"}, {"ar": [19], "tr": "onlar, canları sıkılmış bir vaziyette,"}, {"ar": [16, 17, 18], "tr": "gerisin geri dönüp giderler."}]}, {"ayet": 47, "gruplar": [{"ar": [0, 1], "tr": "Biz,"}, {"ar": [5, 6, 7, 2, 3, 4], "tr": "onların seni dinlerken ne maksatla dinlediklerini,"}, {"ar": [8, 9, 10], "tr": "kendi aralarında fısıldaşırlarken de"}, {"ar": [11, 12, 13], "tr": "o zalimlerin:"}, {"ar": [14, 15, 16, 17, 18], "tr": "«Siz, büyülenmiş bir adamdan başkasına uymuyorsunuz!» dediklerini çok iyi biliriz."}]}, {"ayet": 48, "gruplar": [{"ar": [0, 1], "tr": "Baksana;"}, {"ar": [3, 4, 2], "tr": "senin için ne türlü benzetmeler yaptılar!"}, {"ar": [5], "tr": "Bu yüzden, (öyle bir) saptılar ki,"}, {"ar": [6, 7, 8], "tr": "artık (doğru) yolu bulamayacaklardır."}]}, {"ayet": 49, "gruplar": [{"ar": [0], "tr": "Bir de onlar dediler ki:"}, {"ar": [1, 2, 3, 4], "tr": "Sahi biz, bir kemik yığını ve kokuşmuş bir toprak olmuş iken,"}, {"ar": [7, 8, 5, 6], "tr": "yepyeni bir hilkatte diriltileceğiz, öyle mi!"}]}, {"ayet": 50, "gruplar": [{"ar": [1], "tr": "De ki:"}, {"ar": [2, 3], "tr": "İster taş olun,"}, {"ar": [4, 5], "tr": "ister demir,"}]}, {"ayet": 51, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "isterse gözünüzde büyüyen herhangi bir mahlûk!"}, {"ar": [7], "tr": "Diyecekler ki:"}, {"ar": [8, 9], "tr": "«Bizi tekrar (hayata) kim döndürecek?»"}, {"ar": [11], "tr": "De ki:"}, {"ar": [12, 13, 14, 15], "tr": "Sizi ilk kez yaratan."}, {"ar": [17, 18, 19], "tr": "Bunun üzerine onlar sana alaylı bir tarzda başlarını sallayacak"}, {"ar": [20, 21, 22], "tr": "ve «Ne zamanmış o?» diyecekler."}, {"ar": [24], "tr": "De ki:"}, {"ar": [25, 26, 27, 28], "tr": "Yakın olsa gerek!"}]}, {"ayet": 52, "gruplar": [{"ar": [0, 1], "tr": "Allah sizi çağıracağı gün,"}, {"ar": [3, 2], "tr": "kendisine hamdederek çağrısına uyarsınız"}, {"ar": [4, 5, 6, 7, 8], "tr": "ve (dirilmeden önceki halinizde) çok az kaldığınızı sanırsınız."}]}, {"ayet": 53, "gruplar": [{"ar": [0, 1], "tr": "Kullarıma söyle,"}, {"ar": [2, 3, 4, 5], "tr": "sözün en güzelini söylesinler."}, {"ar": [7, 8, 9, 10], "tr": "Sonra şeytan aralarını bozar."}, {"ar": [12, 13, 14, 15, 16, 17], "tr": "Çünkü şeytan, insanın apaçık düşmanıdır."}]}, {"ayet": 54, "gruplar": [{"ar": [0, 1, 2], "tr": "Rabbiniz, sizi en iyi bilendir."}, {"ar": [4, 5, 6], "tr": "Dilerse size merhamet eder;"}, {"ar": [7, 8, 9, 10], "tr": "dilerse sizi cezalandırır."}, {"ar": [12, 13, 14, 15], "tr": "Biz, seni onların üstüne bir vekil olarak göndermedik."}]}, {"ayet": 55, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Rabbin, göklerde ve yerde olan herkesi en iyi bilendir."}, {"ar": [7, 8, 9, 10, 11, 12], "tr": "Gerçekten biz, peygamberlerin kimini kiminden üstün kıldık;"}, {"ar": [14, 15, 16], "tr": "Davud’a da Zebur’u verdik."}]}, {"ayet": 56, "gruplar": [{"ar": [0], "tr": "De ki:"}, {"ar": [1, 2, 3, 4, 5], "tr": "Allah’ı bırakıp da (ilâh olduğunu) ileri sürdüklerinize yalvarın."}, {"ar": [6, 7, 8, 9, 10, 11, 12], "tr": "Ne var ki onlar, sizin sıkıntınızı ne uzaklaştırabilir, ne de değiştirebilirler."}]}, {"ayet": 57, "gruplar": [{"ar": [0, 1, 2], "tr": "Onların yalvardıkları bu varlıklar"}, {"ar": [4, 5], "tr": "Rablerine"}, {"ar": [7, 8], "tr": "-hangisi daha yakın olacak diye-"}, {"ar": [3, 6], "tr": "vesile ararlar;"}, {"ar": [9, 10], "tr": "O’nun rahmetini umarlar"}, {"ar": [11, 12], "tr": "ve azabından korkarlar."}, {"ar": [14, 15, 16, 17, 18], "tr": "Çünkü Rabbinin azabı, sakınılacak bir azaptır."}]}, {"ayet": 58, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Ne kadar ülke varsa hepsini"}, {"ar": [6, 7, 8], "tr": "kıyamet gününden önce"}, {"ar": [9, 10, 11, 12], "tr": "ya helâk edecek veya en çetin bir şekilde azaplandıracağız."}, {"ar": [14, 15, 16, 17, 18], "tr": "Bu, Kitap’ta (levh-i mahfuz’da) yazılıdır."}]}, {"ayet": 59, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Bizi, âyetler (mucizeler) göndermekten alıkoyan tek şey,"}, {"ar": [5, 6, 7, 8, 9], "tr": "öncekilerin bu âyetleri yalanlamış olmasıdır."}, {"ar": [11, 12, 13, 14], "tr": "Nitekim Semûd kavmine, açık bir mucize olmak üzere bir dişi deve vermiştik."}, {"ar": [15, 16], "tr": "Onlar ise, (bu deveyi boğazladılar ve) bu yüzden zalim oldular."}, {"ar": [18, 19, 20, 21, 22], "tr": "Oysa biz âyetleri ancak korkutmak için göndeririz."}]}, {"ayet": 60, "gruplar": [{"ar": [0, 1, 2], "tr": "Hani sana:"}, {"ar": [3, 4, 5, 6], "tr": "Rabbin, insanları çepeçevre kuşatmıştır, demiştik."}, {"ar": [8, 9, 10, 11, 12], "tr": "Sana gösterdiğimiz o görüntüleri"}, {"ar": [16, 17, 18, 19], "tr": "ve Kur’an’da lânetlenen ağacı,"}, {"ar": [13, 14, 15], "tr": "ancak insanları sınamak için meydana getirdik."}, {"ar": [21], "tr": "Biz onları korkuturuz da,"}, {"ar": [22, 23, 24, 25, 26], "tr": "bu onlara, büyük bir azgınlıktan başka bir şey sağlamaz."}]}, {"ayet": 61, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Meleklere: Âdem’e secde edin! demiştik."}, {"ar": [5, 6, 7], "tr": "İblis’in dışında hepsi secde ettiler."}, {"ar": [8], "tr": "İblis:"}, {"ar": [9, 10, 11, 12], "tr": "«Ben, dedi, çamurdan yarattığın bir kimseye secde mi ederim!»"}]}, {"ayet": 62, "gruplar": [{"ar": [0], "tr": "Dedi ki:"}, {"ar": [1, 2, 3, 4, 5], "tr": "«Şu benden üstün kıldığına da bir bak!"}, {"ar": [6, 7, 8, 9, 10], "tr": "Yemin ederim ki, eğer beni kıyamete kadar yaşatırsan,"}, {"ar": [13, 14], "tr": "pek azı dışında,"}, {"ar": [11, 12], "tr": "onun neslini kendime bağlayacağım!»"}]}, {"ayet": 63, "gruplar": [{"ar": [0], "tr": "Allah buyurdu:"}, {"ar": [1], "tr": "Git!"}, {"ar": [2, 3, 4], "tr": "Onlardan kim sana uyarsa,"}, {"ar": [5, 6, 7], "tr": "iyi bilin ki hepinizin cezası cehennemdir."}, {"ar": [8, 9], "tr": "Tam bir ceza!"}]}, {"ayet": 64, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Onlardan gücünün yettiği kimseleri dâvetinle şaşırt;"}, {"ar": [5, 6, 7, 8], "tr": "süvarilerinle, yayalarınla onları yaygaraya boğ;"}, {"ar": [9, 10, 11, 12], "tr": "mallarına, evlâtlarına ortak ol,"}, {"ar": [13], "tr": "kendilerine vaadlerde bulun."}, {"ar": [15, 16, 17, 18, 19], "tr": "Şeytan, insanlara, aldatmadan başka bir şey vâdetmez."}]}, {"ayet": 65, "gruplar": [{"ar": [0, 1], "tr": "Şurası muhakkak ki, benim (ihlâslı) kullarım"}, {"ar": [2, 3, 4, 5], "tr": "üzerinde senin hiçbir ağırlığın olmayacaktır."}, {"ar": [9], "tr": "(Onları) koruyucu olarak"}, {"ar": [7, 8], "tr": "Rabbin yeter."}]}, {"ayet": 66, "gruplar": [{"ar": [0, 1], "tr": "(Kullarım!) Rabbiniz,"}, {"ar": [7, 8, 9], "tr": "lütfuna nâil olmanız için"}, {"ar": [5, 6, 3, 4, 2], "tr": "denizde gemileri sizin için yüzdürendir."}, {"ar": [11, 12, 13, 14], "tr": "Doğrusu O, sizin için çok merhametlidir."}]}, {"ayet": 67, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Denizde başınıza bir musibet geldiğinde,"}, {"ar": [8, 9, 5, 6, 7], "tr": "O’ndan başka bütün yalvardıklarınız kaybolup gider."}, {"ar": [11, 12, 13, 14], "tr": "O sizi kurtarıp karaya çıkardığında,"}, {"ar": [15], "tr": "(yine eski halinize) dönersiniz."}, {"ar": [17, 18, 19], "tr": "İnsanoğlu çok nankördür."}]}, {"ayet": 68, "gruplar": [{"ar": [1, 2, 3, 4, 5], "tr": "O’nun, sizi kara tarafında yerin dibine geçirmeyeceğinden,"}, {"ar": [6, 7, 8, 9], "tr": "yahut başınıza taş yağdırmayacağından"}, {"ar": [0], "tr": "emin misiniz?"}, {"ar": [10, 11, 12, 13, 14], "tr": "Sonra kendinize bir koruyucu da bulamazsınız."}]}, {"ayet": 69, "gruplar": [{"ar": [0], "tr": "Yahut"}, {"ar": [2, 3, 4, 5, 6], "tr": "O’nun, sizi bir kez daha oraya (denize) gönderip"}, {"ar": [7, 8, 9, 10, 11], "tr": "üzerinize bir kasırga yollayarak,"}, {"ar": [13, 14, 12], "tr": "inkâr etmiş olmanız sebebiyle sizi boğmayacağından"}, {"ar": [1], "tr": "emin misiniz?"}, {"ar": [16, 17, 18, 19, 20, 21, 22], "tr": "Sonra, bundan dolayı kendinize (intikamınızı almak için) bizi arayıp soracak bir destekçi de bulamazsınız."}]}, {"ayet": 70, "gruplar": [{"ar": [1, 2, 3, 4], "tr": "Biz, hakikaten insanoğlunu şan ve şeref sahibi kıldık."}, {"ar": [5, 6, 7, 8], "tr": "Onları, (çeşitli nakil vasıtaları ile) karada ve denizde taşıdık;"}, {"ar": [9, 10, 11], "tr": "kendilerine güzel güzel rızıklar verdik;"}, {"ar": [12, 13, 14, 15, 16, 17], "tr": "yine onları, yarattıklarımızın birçoğundan cidden üstün kıldık."}]}, {"ayet": 71, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Her insan topluluğunu önderleri ile birlikte çağıracağımız o günde"}, {"ar": [6, 7, 8, 9], "tr": "kimlerin amel defteri sağından verilirse,"}, {"ar": [10], "tr": "onlar,"}, {"ar": [13, 14, 15], "tr": "en küçük bir haksızlığa uğramamış olarak"}, {"ar": [11, 12], "tr": "amel defterlerini okuyacaklar."}]}, {"ayet": 72, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Bu dünyada kör olan kimse"}, {"ar": [5, 6, 7, 8], "tr": "ahirette de kördür;"}, {"ar": [9, 10], "tr": "üstelik iyice yolunu şaşırmıştır."}]}, {"ayet": 73, "gruplar": [{"ar": [3, 4, 5, 6], "tr": "Müşrikler, sana vahyettiğimizden"}, {"ar": [7, 8, 9], "tr": "başka bir şeyi yalan yere bize isnat etmen için"}, {"ar": [0, 1, 2], "tr": "seni, nerdeyse, sana vahyettiğimizden saptıracaklar"}, {"ar": [11, 12, 13], "tr": "ve ancak o takdirde seni candan dost kabul edeceklerdi."}]}, {"ayet": 74, "gruplar": [{"ar": [0, 1, 2], "tr": "Eğer seni sebatkâr kılmasaydık,"}, {"ar": [3, 4, 5, 6, 7, 8], "tr": "gerçekten, nerdeyse onlara birazcık meyledecektin."}]}, {"ayet": 75, "gruplar": [{"ar": [0, 1], "tr": "O zaman, hiç şüphesiz"}, {"ar": [2, 3, 4, 5], "tr": "sana hayatın ve ölümün sıkıntılarını kat kat tattırırdık;"}, {"ar": [6, 7, 8, 9, 10, 11], "tr": "sonra bize karşı kendin için bir yardımcı da bulamazdın."}]}, {"ayet": 76, "gruplar": [{"ar": [0], "tr": "Yine onlar,"}, {"ar": [5, 6], "tr": "seni yurdundan çıkarmak için"}, {"ar": [1, 2, 3, 4], "tr": "nerdeyse dünyayı başına dar getirecekler."}, {"ar": [8, 9, 10, 11, 12, 13], "tr": "O takdirde, senin ardından kendileri de fazla kalamazlar."}]}, {"ayet": 77, "gruplar": [{"ar": [4, 5, 6, 3, 2, 1], "tr": "Senden önce gönderdiğimiz peygamberler hakkındaki"}, {"ar": [0], "tr": "kanun (da budur)."}, {"ar": [8, 9, 10, 11], "tr": "Bizim kanunumuzda hiçbir değişiklik bulamazsın."}]}, {"ayet": 78, "gruplar": [{"ar": [2, 3, 4, 5, 6], "tr": "Gündüzün güneş dönüp gecenin karanlığı bastırıncaya kadar"}, {"ar": [0, 1], "tr": "(belli vakitlerde) namaz kıl;"}, {"ar": [7, 8], "tr": "bir de sabah namazını."}, {"ar": [10, 11, 12, 13, 14], "tr": "Çünkü sabah namazı şahitlidir."}]}, {"ayet": 79, "gruplar": [{"ar": [0, 1], "tr": "Gecenin bir kısmında"}, {"ar": [2, 3], "tr": "uyanarak,"}, {"ar": [4, 5], "tr": "sana mahsus bir nafile olmak üzere namaz kıl."}, {"ar": [6, 7, 8, 9], "tr": "(Böylece) Rabbinin, seni,"}, {"ar": [10, 11], "tr": "övgüye değer bir makama göndereceği umulur."}]}, {"ayet": 80, "gruplar": [{"ar": [0], "tr": "Ve şöyle niyaz et:"}, {"ar": [1], "tr": "Rabbim!"}, {"ar": [2, 3, 4], "tr": "Gireceğim yere dürüstlükle girmemi sağla;"}, {"ar": [5, 6, 7], "tr": "çıkacağım yerden de dürüstlükle çıkmamı sağla."}, {"ar": [8, 9, 10, 11, 12, 13], "tr": "Bana tarafından, hakkıyla yardım edici bir kuvvet ver."}]}, {"ayet": 81, "gruplar": [{"ar": [0, 1, 2], "tr": "Yine de ki: Hak geldi;"}, {"ar": [3, 4], "tr": "bâtıl yıkılıp gitti."}, {"ar": [6, 7, 8, 9], "tr": "Zaten bâtıl yıkılmaya mahkumdur."}]}, {"ayet": 82, "gruplar": [{"ar": [0, 1, 2], "tr": "Biz, Kur’an’dan öyle bir şey indiriyoruz ki"}, {"ar": [3, 4, 5, 6, 7], "tr": "o, müminler için şifa ve rahmettir;"}, {"ar": [9, 10, 11, 12, 13], "tr": "zalimlerin ise yalnızca ziyanını artırır."}]}, {"ayet": 83, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "İnsana nimet verdiğimiz zaman"}, {"ar": [4, 5, 6], "tr": "(bizden) yüz çevirip yan çizer;"}, {"ar": [8, 9, 10], "tr": "ona bir de zarar ziyan dokunacak olsa"}, {"ar": [11, 12], "tr": "iyice karamsarlığa düşer."}]}, {"ayet": 84, "gruplar": [{"ar": [0], "tr": "De ki:"}, {"ar": [1, 2, 3, 4], "tr": "Herkes, kendi mizaç ve meşrebine göre iş yapar."}, {"ar": [5, 6, 7, 8, 9, 10], "tr": "Bu durumda kimin doğru bir yol tuttuğunu Rabbiniz en iyi bilendir."}]}, {"ayet": 85, "gruplar": [{"ar": [0, 1, 2], "tr": "Sana ruh hakkında soru sorarlar."}, {"ar": [4, 5, 6, 7, 8], "tr": "De ki: Ruh, Rabbimin emrindendir."}, {"ar": [9, 10, 11, 12, 13, 14], "tr": "Size ancak az bir bilgi verilmiştir."}]}]}