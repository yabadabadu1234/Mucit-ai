{"sure": 21, "ayetler": [{"ayet": 1, "gruplar": [{"ar": [1, 2], "tr": "İnsanların hesaba çekilecekleri"}, {"ar": [0], "tr": "(gün) yaklaştı."}, {"ar": [3, 4, 5], "tr": "Hal böyle iken onlar, gaflet içinde"}, {"ar": [6], "tr": "yüz çevirdiler."}]}, {"ayet": 2, "gruplar": [{"ar": [4, 5, 6, 3, 0, 1], "tr": "Rablerinden kendilerine ne zaman yeni bir ihtar gelse,"}, {"ar": [7, 8], "tr": "onlar bunu, hep alaya alarak,"}, {"ar": [9, 10], "tr": "kalpleri oyuna, eğlenceye dalarak dinlemişlerdir."}]}, {"ayet": 3, "gruplar": [{"ar": [0, 1], "tr": "kalpleri oyuna, eğlenceye dalarak"}, {"ar": [5, 6, 3, 4], "tr": "O zalimler şöyle fısıldaştılar:"}, {"ar": [8, 9, 10, 11], "tr": "Bu (Muhammed), sizin gibi bir beşer olmaktan başka nedir ki!"}, {"ar": [13, 14, 15, 16], "tr": "Siz şimdi gözünüz göre göre büyüye mi kapılıyorsunuz?"}]}, {"ayet": 4, "gruplar": [{"ar": [0], "tr": "(Peygamber) dedi ki:"}, {"ar": [1, 2, 3, 4, 5, 6], "tr": "Rabbim, yerde ve gökte (söylenmiş) her sözü bilir."}, {"ar": [8, 9, 10], "tr": "O, hakkıyla işiten ve bilendir."}]}, {"ayet": 5, "gruplar": [{"ar": [0, 1], "tr": "«Hayır, dediler,"}, {"ar": [2, 3], "tr": "(bunlar) saçma sapan rüyalardır;"}, {"ar": [4, 5], "tr": "bilakis onu kendisi uydurmuştur;"}, {"ar": [6, 7, 8], "tr": "belki de o, şairdir."}, {"ar": [9, 10, 11, 12, 13], "tr": "(Eğer öyle değilse) bize hemen, öncekilere gönderilenin benzeri bir âyet getirsin.»"}]}, {"ayet": 6, "gruplar": [{"ar": [2, 3, 4, 5, 0, 1], "tr": "Bunlardan önce helâk ettiğimiz hiçbir belde iman etmemişti;"}, {"ar": [7, 8], "tr": "şimdi bunlar mı iman edecekler?"}]}, {"ayet": 7, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6], "tr": "Biz, senden önce de, kendilerine vahiy verdiğimiz kişilerden başkasını peygamber olarak göndermedik."}, {"ar": [11, 12, 13, 14], "tr": "Eğer bilmiyorsanız"}, {"ar": [8, 9, 10], "tr": "bilenlerden sorunuz."}]}, {"ayet": 8, "gruplar": [{"ar": [0, 1, 2], "tr": "Biz onları (peygamberleri),"}, {"ar": [3, 4, 5], "tr": "yemek yemez birer (cansız) ceset olarak yaratmadık."}, {"ar": [6, 7, 8], "tr": "Onlar (bu dünyada) ebedî de değillerdir."}]}, {"ayet": 9, "gruplar": [{"ar": [0, 1, 2], "tr": "Sonra onlara (verdiğimiz) sözü yerine getirdik;"}, {"ar": [3, 4, 5], "tr": "böylece, hem onları hem de dilediğimiz (başka) kimseleri kurtuluşa erdirdik;"}, {"ar": [6, 7], "tr": "müsrifleri de helâk ettik."}]}, {"ayet": 10, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Andolsun, size"}, {"ar": [4, 5], "tr": "içinde sizin için öğüt bulunan bir kitap indirdik."}, {"ar": [7, 8], "tr": "Hâla akıllanmaz mısınız?"}]}, {"ayet": 11, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Zalim olan nice beldeyi kırıp geçirdik;"}, {"ar": [6, 7, 8, 9], "tr": "arkasından da nice başka topluluklar vücuda getirdik."}]}, {"ayet": 12, "gruplar": [{"ar": [0, 1, 2], "tr": "Azabımızı hissettiklerinde"}, {"ar": [3, 4, 5, 6], "tr": "bir de bakarsın ki oralardan (azap bölgesinden) kaçıyorlar!"}]}, {"ayet": 13, "gruplar": [{"ar": [0, 1], "tr": "«Kaçmayın!"}, {"ar": [2, 3, 4, 5, 6, 7], "tr": "İçinde bulunduğunuz refaha ve yurtlarınıza dönün!"}, {"ar": [8, 9], "tr": "Çünkü size sorular sorulacak!»"}]}, {"ayet": 14, "gruplar": [{"ar": [1, 0], "tr": "«Vay başımıza gelenlere! dediler;"}, {"ar": [2, 3, 4], "tr": "gerçekten biz zalim insanlarmışız.»"}]}, {"ayet": 15, "gruplar": [{"ar": [5, 6, 7], "tr": "Biz kendilerini, kuruyup biçilmiş ekine, sönmüş ateşe çevirinceye kadar"}, {"ar": [0, 1, 2, 3, 4], "tr": "bu feryatları sürüp gider."}]}, {"ayet": 16, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Biz, göğü, yeri ve bunlar arasındakileri,"}, {"ar": [6], "tr": "oyuncular (işi, eğlencesi) olarak yaratmadık."}]}, {"ayet": 17, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Eğer bir eğlence edinmek isteseydik,"}, {"ar": [5, 6, 7], "tr": "onu kendi tarafımızdan edinirdik."}, {"ar": [8, 9, 10], "tr": "(Bu irademizin eseri olurdu. Ama) biz (bunu) yapanlardan değiliz."}]}, {"ayet": 18, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Bilakis biz, hakkı bâtılın tepesine bindiririz"}, {"ar": [5], "tr": "de o, bâtılın işini bitirir."}, {"ar": [6, 7, 8], "tr": "Bir de bakarsınız ki, bâtıl yok olup gitmiştir."}, {"ar": [12, 13, 10, 11], "tr": "(Allah’a) yakıştırdığınız sıfatlardan dolayı yazıklar olsun size!"}]}, {"ayet": 19, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Göklerde ve yerde kimler varsa O’na aittir."}, {"ar": [6, 7], "tr": "O’nun huzurunda bulunanlar,"}, {"ar": [8, 9, 10, 11], "tr": "O’na ibadet hususunda kibirlenmezler"}, {"ar": [12, 13], "tr": "ve yorulmazlar."}]}, {"ayet": 20, "gruplar": [{"ar": [3, 4], "tr": "Onlar, bıkıp usanmaksızın"}, {"ar": [1, 2], "tr": "gece gündüz"}, {"ar": [0], "tr": "(Allah’ı) tesbih ederler."}]}, {"ayet": 21, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Yoksa (o müşrikler), yerden birtakım tanrılar edindiler de,"}, {"ar": [5, 6], "tr": "(ölüleri) onlar mı diriltecekler?"}]}, {"ayet": 22, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Eğer yerde ve gökte Allah’tan başka tanrılar bulunsaydı,"}, {"ar": [6], "tr": "yer ve gök, (bunların nizamı) kesinlikle bozulup gitmişti."}, {"ar": [8, 9, 10, 11], "tr": "Demek ki Arş’ın Rabbi olan Allah,"}, {"ar": [12, 13], "tr": "onların yakıştırdıkları sıfatlardan münezzehtir."}]}, {"ayet": 23, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Allah, yaptığından sorumlu tutulamaz;"}, {"ar": [4, 5], "tr": "onlar ise sorguya çekileceklerdir."}]}, {"ayet": 24, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Yoksa O’ndan başka birtakım tanrılar mı edindiler?"}, {"ar": [6, 7, 8], "tr": "De ki: Haydi delillerinizi getirin!"}, {"ar": [10, 11, 12, 13], "tr": "İşte benimle beraber olanların Kitab’ı"}, {"ar": [14, 15, 16], "tr": "ve benden öncekilerin Kitab’ı."}, {"ar": [18, 19, 20, 21, 22], "tr": "Hayır, onların çoğu hakkı bilmezler;"}, {"ar": [24, 25], "tr": "bu yüzden de yüz çevirirler."}]}, {"ayet": 25, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Senden önce hiçbir resûl göndermedik ki"}, {"ar": [6, 7, 8], "tr": "ona:"}, {"ar": [9, 10, 11, 12, 13, 14], "tr": "«Benden başka İlâh yoktur; şu halde bana kulluk edin» diye vahyetmiş olmayalım."}]}, {"ayet": 26, "gruplar": [{"ar": [0, 2, 1, 3], "tr": "Rahmân (olan Allah, melekleri) evlât edindi, dediler."}, {"ar": [5], "tr": "Hâşâ! O, bundan münezzehtir."}, {"ar": [7, 8, 9], "tr": "Bilakis (melekler), lütuf ve ihsana mazhar olmuş kullardır."}]}, {"ayet": 27, "gruplar": [{"ar": [0, 1, 2], "tr": "O’ndan (emir almazdan) önce konuşmazlar;"}, {"ar": [3, 4, 5], "tr": "onlar, sadece O’nun emri ile hareket ederler."}]}, {"ayet": 28, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Allah, onların önlerindekini de, arkalarındakini de (yaptıklarını da, yapacaklarını da) bilir."}, {"ar": [6, 7, 8, 9, 10], "tr": "Allah rızasına ulaşmış olanlardan başkasına şefaat etmezler."}, {"ar": [11, 12, 13, 14], "tr": "Onlar, Allah korkusundan titrerler!"}]}, {"ayet": 29, "gruplar": [{"ar": [1, 2, 3, 4, 5, 6, 7], "tr": "Onlardan her kim: «Tanrı O değil, benim!» derse,"}, {"ar": [8, 9, 10], "tr": "biz onu cehennemle cezalandırırız."}, {"ar": [12, 13, 14], "tr": "İşte biz, zalimlere böyle ceza veririz!"}]}, {"ayet": 30, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "İnkâr edenler,"}, {"ar": [4, 5, 6, 7, 8], "tr": "göklerle yer bitişik bir halde iken"}, {"ar": [9], "tr": "bizim, onları birbirinden kopardığımızı"}, {"ar": [11, 12, 13, 14, 15, 16], "tr": "ve her canlı şeyi sudan yarattığımızı"}, {"ar": [18, 19], "tr": "görüp düşünmediler mi? Yine de inanmazlar mı?"}]}, {"ayet": 31, "gruplar": [{"ar": [4, 5, 6], "tr": "Onları sarsmasın diye"}, {"ar": [0, 1, 2, 3], "tr": "yeryüzünde bir takım dağlar diktik."}, {"ar": [7, 8, 9, 10], "tr": "Orada geniş geniş yollar açtık;"}, {"ar": [11, 12], "tr": "ta ki maksatlarına ulaşsınlar."}]}, {"ayet": 32, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Biz, gökyüzünü korunmuş bir tavan gibi yaptık."}, {"ar": [5, 6, 7, 8], "tr": "Onlar ise, gökyüzünün âyetlerinden yüz çevirirler."}]}, {"ayet": 33, "gruplar": [{"ar": [0, 1], "tr": "O,"}, {"ar": [3, 4, 5, 6], "tr": "geceyi, gündüzü, güneşi, ayı..."}, {"ar": [2], "tr": "yaratandır."}, {"ar": [8, 9, 10, 11], "tr": "Her biri bir yörüngede yüzmektedirler."}]}, {"ayet": 34, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Biz, senden önce de hiçbir beşere ebedîlik vermedik."}, {"ar": [7, 8], "tr": "Şimdi sen ölürsen,"}, {"ar": [9, 10], "tr": "sanki onlar ebedî mi kalacaklar?"}]}, {"ayet": 35, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Her canlı, ölümü tadar."}, {"ar": [5, 6, 7, 8], "tr": "Bir deneme olarak sizi hayırla da, şerle de imtihan ederiz."}, {"ar": [10, 11], "tr": "Ve siz, ancak bize döndürüleceksiniz."}]}, {"ayet": 36, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "(Resûlüm!) Kâfirler seni gördükleri zaman:"}, {"ar": [8, 9, 10, 11], "tr": "«Sizin ilâhlarınızı diline dolayan bu mu?» diyerek"}, {"ar": [4, 5, 6, 7], "tr": "seni hep alaya alırlar."}, {"ar": [12, 13, 14, 15, 16], "tr": "Halbuki onlar, çok esirgeyici Allah’ın Kitabını inkâr edenlerin ta kendileridir."}]}, {"ayet": 37, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "İnsan, aceleci (bir tabiatta) yaratılmıştır."}, {"ar": [5, 6], "tr": "Size âyetlerimi göstereceğim;"}, {"ar": [7, 8], "tr": "benden acele istemeyin."}]}, {"ayet": 38, "gruplar": [{"ar": [4, 5, 6], "tr": "«Eğer, diyorlar, doğru iseniz,"}, {"ar": [0], "tr": "ne zaman"}, {"ar": [2, 3], "tr": "(gerçekleşecek) bu tehdit?»"}]}, {"ayet": 39, "gruplar": [{"ar": [2, 3], "tr": "İnkâr edenler,"}, {"ar": [7, 8, 9, 10, 11, 12], "tr": "yüzlerinden ve sırtlarından (saran) ateşi"}, {"ar": [5, 6, 13, 14, 15, 4], "tr": "savamayacakları, kendilerine yardım dahi edilmeyeceği zamanı"}, {"ar": [0, 1], "tr": "bir bilselerdi!"}]}, {"ayet": 40, "gruplar": [{"ar": [0, 1, 2], "tr": "Bilâkis kendilerine o (kıyamet) öyle âni gelir ki,"}, {"ar": [3], "tr": "onları şaşırtır."}, {"ar": [4, 5, 6], "tr": "Artık, ne reddedebilirler onu,"}, {"ar": [7, 8, 9], "tr": "ne de kendilerine mühlet verilir."}]}, {"ayet": 41, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Andolsun, senden önceki peygamberlerle de alay edildi;"}, {"ar": [5, 6, 7, 8], "tr": "ama onları alaya alanları,"}, {"ar": [9, 10, 11, 12], "tr": "o alay konusu ettikleri şey kuşatıverdi."}]}, {"ayet": 42, "gruplar": [{"ar": [0], "tr": "De ki:"}, {"ar": [5, 6, 1, 2, 3, 4], "tr": "Allah’a karşı sizi gece gündüz kim koruyacak?"}, {"ar": [8, 9, 10, 11, 12, 13], "tr": "Buna rağmen onlar Rablerini anmaktan yüz çevirirler."}]}, {"ayet": 43, "gruplar": [{"ar": [0, 1], "tr": "Yoksa kendilerini"}, {"ar": [3, 4, 5], "tr": "bize karşı savunacak"}, {"ar": [2], "tr": "birtakım ilâhları mı var?"}, {"ar": [7, 8, 9, 10], "tr": "(O ilâh dedikleri şeyler) kendilerine bile yardım edecek güçte değildirler."}, {"ar": [11, 12, 13, 14], "tr": "Onlar bizden de alâka ve destek görmezler."}]}, {"ayet": 44, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Evet, onları da, atalarını da barındırdık."}, {"ar": [4, 5, 6, 7], "tr": "Nihayet ömür kendilerine (hiç bitmeyecek gibi) uzun geldi."}, {"ar": [9, 10, 11, 12, 13, 14, 15, 16], "tr": "Oysa onlar, bizim gelip (kâfirlere ait) araziyi çevresinden eksilteceğimizi görmezler mi?"}, {"ar": [18, 19], "tr": "Şu halde, üstün gelen onlar mı?"}]}, {"ayet": 45, "gruplar": [{"ar": [0], "tr": "De ki:"}, {"ar": [1, 2, 3], "tr": "Ben, sadece, vahiy ile sizi ikaz ediyorum."}, {"ar": [5, 6, 7, 8, 9, 10, 11], "tr": "Fakat, sağır olanlar, ikaz edildikleri zaman bu çağrıyı duymazlar."}]}, {"ayet": 46, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5], "tr": "Andolsun, onlara Rabbinin azabından ufak bir esinti dokunsa,"}, {"ar": [6, 7], "tr": "hiç şüphesiz, «Vah bize!"}, {"ar": [8, 9, 10], "tr": "Hakikaten biz zalim kimselermişiz!» derler."}]}, {"ayet": 47, "gruplar": [{"ar": [0, 1, 2, 3, 4], "tr": "Biz, kıyamet günü için adalet terazileri kurarız."}, {"ar": [5, 6, 7, 8], "tr": "Artık kimseye, hiçbir şekilde haksızlık edilmez."}, {"ar": [10, 11, 12, 13, 14, 15], "tr": "(Yapılan iş,) bir hardal tanesi kadar dahi olsa,"}, {"ar": [16, 17], "tr": "onu (adalet terazisine) getiririz."}, {"ar": [19, 20, 21], "tr": "Hesap gören olarak biz (herkese) yeteriz."}]}, {"ayet": 48, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "Andolsun biz, Musa ve Harun’a,"}, {"ar": [7, 5, 6], "tr": "takvâ sahipleri için bir ışık, bir öğüt"}, {"ar": [4], "tr": "ve Furkan’ı verdik."}]}, {"ayet": 49, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "(O takvâ sahipleri ki) onlar, görmedikleri halde Rablerine candan saygı gösterirler."}, {"ar": [4, 5, 6, 7], "tr": "Yine onlar, kıyametten korkan kimselerdir."}]}, {"ayet": 50, "gruplar": [{"ar": [0], "tr": "İşte bu (Kur’an) da,"}, {"ar": [3], "tr": "bizim indirdiğimiz"}, {"ar": [2, 1], "tr": "hayırlı ve faydalı bir öğüttür."}, {"ar": [5, 6, 7], "tr": "Şimdi onu inkâr mı ediyorsunuz?"}]}, {"ayet": 51, "gruplar": [{"ar": [1, 2, 3, 4], "tr": "Andolsun biz İbrahim’e daha önce rüşdünü vermiştik."}, {"ar": [7, 8, 9], "tr": "Biz onu iyi tanırdık."}]}, {"ayet": 52, "gruplar": [{"ar": [0, 1, 2, 3], "tr": "O, babasına ve kavmine:"}, {"ar": [4, 5, 6, 7, 8, 9, 10], "tr": "Şu karşısına geçip tapmakta olduğunuz heykeller de ne oluyor? demişti."}]}, {"ayet": 53, "gruplar": [{"ar": [0], "tr": "Dediler ki:"}, {"ar": [1, 2, 3, 4], "tr": "Biz, babalarımızı bunlara tapar kimseler bulduk."}]}, {"ayet": 54, "gruplar": [{"ar": [0, 1, 2, 3, 4, 5, 6, 7], "tr": "Doğrusu, siz de, babalarınız da açık bir sapıklık içindesiniz, dedi."}]}, {"ayet": 55, "gruplar": [{"ar": [0], "tr": "Dediler ki:"}, {"ar": [1, 2], "tr": "Bize gerçeği mi getirdin,"}, {"ar": [3, 4, 5, 6], "tr": "yoksa sen oyunbazlardan biri misin?"}]}, {"ayet": 56, "gruplar": [{"ar": [0, 1], "tr": "Hayır, dedi,"}, {"ar": [2, 3, 4, 5], "tr": "sizin Rabbiniz,"}, {"ar": [6, 7], "tr": "yarattığı göklerin ve yerin de Rabbidir"}, {"ar": [8, 9, 10, 11, 12], "tr": "ve ben buna şahitlik edenlerdenim."}]}]}