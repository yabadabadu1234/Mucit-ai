{"sure":8,"ayetler":[
{"ayet":26,"gruplar":[{"ar":[0,1],"tr":"Hatırlayın ki, bir zaman"},{"ar":[2,3,4,5,6],"tr":"siz yeryüzünde âciz tanınan az (bir toplum) idiniz"},{"ar":[7,8,9,10],"tr":"insanların sizi kapıp götürmesinden korkuyordunuz"},{"ar":[17,18],"tr":"da şükredesiniz diye"},{"ar":[11],"tr":"Allah size yer yurt verdi"},{"ar":[12,13],"tr":"yardımıyla sizi destekledi"},{"ar":[14,15,16],"tr":"ve size temizinden rızıklar verdi"}]},
{"ayet":27,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4,5,6],"tr":"Allah’a ve Peygamber’e hainlik etmeyin"},{"ar":[9,10],"tr":"(sonra) bile bile"},{"ar":[7,8],"tr":"kendi emanetlerinize hainlik etmiş olursunuz"}]},
{"ayet":28,"gruplar":[{"ar":[0,1],"tr":"Biliniz ki"},{"ar":[2,3],"tr":"mallarınız ve çocuklarınız"},{"ar":[4],"tr":"birer imtihan sebebidir"},{"ar":[5,6,7,8,9],"tr":"ve büyük mükâfat Allah’ın katındadır"}]},
{"ayet":29,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4,5],"tr":"Eğer Allah’tan korkarsanız"},{"ar":[6,7,8],"tr":"O, size iyi ile kötüyü ayırdedecek bir anlayış verir"},{"ar":[9,10,11],"tr":"suçlarınızı örter"},{"ar":[12,13],"tr":"ve sizi bağışlar"},{"ar":[15,16,17,18],"tr":"Çünkü Allah büyük lütuf sahibidir"}]},
{"ayet":30,"gruplar":[{"ar":[0,3,4],"tr":"Hatırla ki, kâfirler"},{"ar":[5],"tr":"seni tutup bağlamaları"},{"ar":[6,7],"tr":"veya öldürmeleri"},{"ar":[8,9],"tr":"yahut seni (yurdundan) çıkarmaları için"},{"ar":[1,2],"tr":"sana tuzak kuruyorlardı"},{"ar":[11],"tr":"Onlar (sana) tuzak kurarlarken"},{"ar":[12,13],"tr":"Allah da (onlara) tuzak kuruyordu"},{"ar":[15,16,17],"tr":"Çünkü Allah tuzak kuranların en iyisidir"}]},
{"ayet":31,"gruplar":[{"ar":[0,1,2,3],"tr":"Onlara âyetlerimiz okunduğu zaman"},{"ar":[4],"tr":"dediler ki"},{"ar":[5,6],"tr":"«(Evet) işittik"},{"ar":[7,8,9,10,11],"tr":"istesek biz de bunun benzerini elbette söyleyebiliriz"},{"ar":[13,14,15,16,17],"tr":"Bu öncekilerin masallarından başka bir şey değildir.»"}]},
{"ayet":32,"gruplar":[{"ar":[0],"tr":"Hani (o kâfirler) bir zaman da"},{"ar":[2],"tr":"Ey Allah’ım"},{"ar":[3,4,5,6,7,8,9],"tr":"Eğer bu Kitap senin katından gelmiş bir gerçekse"},{"ar":[10,11,12,13,14],"tr":"üzerimize gökten taş yağdır"},{"ar":[15,16,17,18],"tr":"yahut bize elem verici bir azap getir"},{"ar":[1],"tr":"demişlerdi"}]},
{"ayet":33,"gruplar":[{"ar":[4,5],"tr":"Halbuki sen onların içinde iken"},{"ar":[0,1,2,3],"tr":"Allah, onlara azap edecek değildir"},{"ar":[11,12],"tr":"Ve onlar mağfiret dilerlerken de"},{"ar":[7,8,9,10],"tr":"Allah onlara azap edici değildir"}]},
{"ayet":34,"gruplar":[{"ar":[5,8,9,10,11,12],"tr":"Onlar Mescid-i Haram’ın mütevellîleri olmadıkları halde"},{"ar":[6,7],"tr":"(müminleri) oradan geri çevirirlerken"},{"ar":[0,1,2,3,4],"tr":"Allah onlara ne diye azap etmeyecek"},{"ar":[14,15,16,17],"tr":"Oranın mütevellîleri takvâ sahiplerinden başkaları değildir"},{"ar":[18,19,20,21],"tr":"Fakat onların çoğu bunu bilmez"}]},
{"ayet":35,"gruplar":[{"ar":[2,3,4],"tr":"Onların Beytullah yanındaki duaları da"},{"ar":[0,1,5,6,7],"tr":"ıslık çalmak ve el çırpmaktan başka bir şey değildir"},{"ar":[11,12,13],"tr":"(Ey kâfirler!) İnkâr etmekte olduğunuz şeylerden ötürü"},{"ar":[9,10],"tr":"şimdi azabı tadın"}]},
{"ayet":36,"gruplar":[{"ar":[0,1,2],"tr":"Şüphesiz ki inkâr edenler"},{"ar":[4],"tr":"mallarını"},{"ar":[5,6,7,8],"tr":"(insanları) Allah yolundan alıkoymak için"},{"ar":[3],"tr":"harcıyorlar"},{"ar":[10],"tr":"Daha da harcayacaklar"},{"ar":[11,12,13,14],"tr":"Ama sonunda bu, onlara yürek acısı olacak"},{"ar":[15,16],"tr":"ve en sonunda mağlûp olacaklardır"},{"ar":[18,19],"tr":"Kâfirlikte ısrar edenler ise"},{"ar":[20,21,22],"tr":"cehenneme toplanacaklardır"}]},
{"ayet":37,"gruplar":[{"ar":[0,1,2,3,4],"tr":"(Bu toplama) Allah’ın murdarı temizden ayıklaması (mümini kâfirden ayırması)"},{"ar":[5,6,7,8,9],"tr":"ve bütün murdarların bir kısmını diğer bir kısmının üstüne koyup"},{"ar":[10,11],"tr":"hepsini yığarak"},{"ar":[12,13,14],"tr":"cehenneme atması içindir"},{"ar":[16,17,18],"tr":"İşte onlar ziyana uğrayanların kendileridir"}]},
{"ayet":38,"gruplar":[{"ar":[1,2],"tr":"İnkâr edenlere"},{"ar":[3,4],"tr":"(sana düşmanlıktan) vazgeçerlerse"},{"ar":[5,6,7,8,9],"tr":"geçmiş günahlarının bağışlanacağını"},{"ar":[0],"tr":"söyle"},{"ar":[10,11],"tr":"Yok geri dönerlerse"},{"ar":[12,13,14,15],"tr":"kendilerinden öncekilerin hali gözlerinin önündedir"}]},
{"ayet":39,"gruplar":[{"ar":[2,3,4],"tr":"Fitne ortadan kalkıncaya"},{"ar":[1,5,6,7,8],"tr":"ve din tamamen Allah’ın oluncaya kadar"},{"ar":[0],"tr":"onlarla savaşın"},{"ar":[10,11],"tr":"(İnkâra) son verirlerse"},{"ar":[12,13],"tr":"şüphesiz ki Allah"},{"ar":[14,15,16],"tr":"onların yaptıklarını çok iyi görür"}]},
{"ayet":40,"gruplar":[{"ar":[0,1],"tr":"Eğer (imandan) yüz çevirirlerse"},{"ar":[2,3],"tr":"bilin ki"},{"ar":[4,5],"tr":"Allah sizin sahibinizdir"},{"ar":[7,8],"tr":"O ne güzel sahip"},{"ar":[9,10],"tr":"ve ne güzel yardımcıdır"}]},
{"ayet":41,"gruplar":[{"ar":[16,17],"tr":"Eğer"},{"ar":[19],"tr":"Allah’a"},{"ar":[24,25],"tr":"hak ile bâtılın ayrıldığı gün"},{"ar":[26,27,28],"tr":"iki ordunun birbiri ile karşılaştığı gün"},{"ar":[20,21,22,23],"tr":"(Bedir savaşında) kulumuza indirdiğimize"},{"ar":[18],"tr":"inanmışsanız"},{"ar":[1],"tr":"bilin ki"},{"ar":[2,3,4,5],"tr":"ganimet olarak aldığınız herhangi bir şeyin"},{"ar":[6,7,8],"tr":"beşte biri Allah’a"},{"ar":[9],"tr":"Resûlüne"},{"ar":[10,11],"tr":"onun akrabalarına"},{"ar":[12],"tr":"yetimlere"},{"ar":[13],"tr":"yoksullara"},{"ar":[14,15],"tr":"ve yolcuya aittir"},{"ar":[30,31,32,33,34],"tr":"Allah her şeye hakkıyla kadirdir"}]},
{"ayet":42,"gruplar":[{"ar":[0,1],"tr":"Hatırlayın ki, (Bedir savaşında) siz"},{"ar":[2,3],"tr":"vâdinin yakın kenarında (Medine tarafında) idiniz"},{"ar":[4,5,6],"tr":"onlar da uzak kenarında (Mekke tarafında) idiler"},{"ar":[7,8,9],"tr":"Kervan da sizden daha aşağıda (deniz sahilinde) idi"},{"ar":[11,12],"tr":"Eğer (savaş için) sözleşmiş olsaydınız"},{"ar":[13,14,15],"tr":"sözleştiğiniz vakit hususunda ihtilâfa düşerdiniz"},{"ar":[17,18,19,20,21,22],"tr":"Fakat Allah, gerekli olan emri yerine getirmesi"},{"ar":[23,24,25,26,27],"tr":"helâk olanın açık bir delille (gözüyle gördükten sonra) helâk olması"},{"ar":[28,29,30,31,32],"tr":"yaşayanın da açık bir delille yaşaması için (böyle yaptı)"},{"ar":[34,35,36,37],"tr":"Çünkü Allah hakkıyla işitendir, bilendir"}]},
{"ayet":43,"gruplar":[{"ar":[0,2,3,4],"tr":"Hatırla ki, Allah, uykunda"},{"ar":[1,5],"tr":"sana onları az gösterdi"},{"ar":[7,8,9],"tr":"Eğer onları sana çok gösterseydi"},{"ar":[10],"tr":"elbette çekinecek"},{"ar":[11,12,13],"tr":"ve bu iş hakkında münakaşaya girişecektiniz"},{"ar":[14,15,16],"tr":"Fakat Allah (sizi bundan) kurtardı"},{"ar":[18],"tr":"Şüphesiz O"},{"ar":[19,20,21],"tr":"kalplerin özünü bilir"}]},
{"ayet":44,"gruplar":[{"ar":[10,11,12,13,14],"tr":"Allah, olacak bir işi yerine getirmek için"},{"ar":[2,3],"tr":"(savaş alanında) karşılaştığınız zaman"},{"ar":[0,1,4,5,6],"tr":"onları sizin gözlerinizde az gösteriyor"},{"ar":[7,8,9],"tr":"sizi de onların gözlerinde azaltıyordu"},{"ar":[16,17,18,19],"tr":"Bütün işler Allah’a döner"}]},
{"ayet":45,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler"},{"ar":[3,4,5],"tr":"Herhangi bir topluluk ile karşılaştığınız zaman"},{"ar":[6],"tr":"sebat edin"},{"ar":[7,8,9],"tr":"ve Allah’ı çok anın"},{"ar":[10,11],"tr":"ki başarıya erişesiniz"}]},
{"ayet":46,"gruplar":[{"ar":[0,1,2],"tr":"Allah ve Resûlüne itaat edin"},{"ar":[3,4],"tr":"birbirinizle çekişmeyin"},{"ar":[5],"tr":"sonra korkuya kapılırsınız"},{"ar":[6,7],"tr":"da kuvvetiniz gider"},{"ar":[9],"tr":"Bir de sabredin"},{"ar":[11,12,13,14],"tr":"Çünkü Allah sabredenlerle beraberdir"}]},
{"ayet":47,"gruplar":[{"ar":[6],"tr":"Çalım satmak"},{"ar":[7,8],"tr":"insanlara gösteriş yapmak"},{"ar":[9,10,11,12],"tr":"ve (insanları) Allah yolundan alıkoymak için"},{"ar":[2,3,4,5],"tr":"yurtlarından çıkanlar (kâfirler) gibi"},{"ar":[0,1],"tr":"olmayın"},{"ar":[14,15,16,17],"tr":"Allah onların yaptıklarını çepeçevre kuşatmıştır"}]},
{"ayet":48,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Hani şeytan onlara yaptıklarını güzel gösterdi"},{"ar":[6,7,8,9,10,11],"tr":"de: Bugün insanlardan size galip gelecek kimse yoktur"},{"ar":[12,13,14],"tr":"şüphesiz ben de sizin yardımcınızım"},{"ar":[5],"tr":"dedi"},{"ar":[16,17,18],"tr":"Fakat iki ordu birbirini görünce"},{"ar":[19,20,21],"tr":"ardına döndü"},{"ar":[22,23,24,25],"tr":"ve: Ben sizden uzağım"},{"ar":[26,27,28,29,30],"tr":"ben sizin göremediklerinizi (melekleri) görüyorum"},{"ar":[31,32,33],"tr":"ben Allah’tan korkuyorum"},{"ar":[35,36,37],"tr":"Allah’ın azabı şiddetlidir, dedi"}]},
{"ayet":49,"gruplar":[{"ar":[0],"tr":"O zaman"},{"ar":[2,3,4,5,6],"tr":"münafıklarla kalplerinde hastalık bulunanlar"},{"ar":[7,8,9],"tr":"(sizin için), «Bunları, dinleri aldatmış»"},{"ar":[1],"tr":"diyorlardı"},{"ar":[11,12,13,14],"tr":"Halbuki kim Allah’a dayanırsa"},{"ar":[15,16,17,18],"tr":"bilsin ki Allah mutlak galiptir, hikmet sahibidir. (Kendisine güveneni üstün ve galip kılacak O’dur. Yoksa orduların sayı ve techizat üstünlüğü değildir)"}]},
{"ayet":50,"gruplar":[{"ar":[7],"tr":"Melekler"},{"ar":[8,9,10],"tr":"yüzlerine ve arkalarına vurarak"},{"ar":[11,12,13],"tr":"ve «Tadın yakıcı cehennem azabını» (diyerek)"},{"ar":[2,3,4,5],"tr":"o kâfirlerin canlarını alırken"},{"ar":[0,1],"tr":"onları bir görseydin"}]}
]}
