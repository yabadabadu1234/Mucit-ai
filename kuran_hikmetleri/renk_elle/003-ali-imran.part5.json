{"sure":3,"ayetler":[
 {"ayet":141,"gruplar":[{"ar":[0,1],"tr":"Bir de (böylece) Allah,"},{"ar":[2,3],"tr":"iman edenleri günahlardan temize çıkarmak,"},{"ar":[5,4],"tr":"kâfirleri de helâk etmek ister."}]},
 {"ayet":142,"gruplar":[{"ar":[0],"tr":"Yoksa"},{"ar":[7,5,6,8,9,10],"tr":"Allah içinizden cihad edenleri belli etmeden,"},{"ar":[11,12],"tr":"sabredenleri ortaya çıkarmadan"},{"ar":[4,3,1,2],"tr":"cennete gireceğinizi mi sandınız?"}]},
 {"ayet":143,"gruplar":[{"ar":[0,1,10],"tr":"Andolsun ki siz,"},{"ar":[3,4,5,6,7,2],"tr":"ölümle yüzyüze gelmezden önce onu temenni ederdiniz."},{"ar":[8,9,11],"tr":"İşte şimdi onu karşınızda gördünüz."}]},
 {"ayet":144,"gruplar":[{"ar":[0,1,2,3],"tr":"Muhammed, ancak bir peygamberdir."},{"ar":[4,5,6,7,8],"tr":"Ondan önce de peygamberler gelip geçmiştir."},{"ar":[10,11,12,13],"tr":"Şimdi o ölür ya da öldürülürse,"},{"ar":[14,15,16],"tr":"gerisin geriye (eski dininize) mi döneceksiniz?"},{"ar":[18,19,20,21],"tr":"Kim (böyle) geri dönerse,"},{"ar":[24,22,23,25],"tr":"Allah’a hiçbir şekilde zarar vermiş olmayacaktır."},{"ar":[28,29,27],"tr":"Allah, şükredenleri mükâfatlandıracaktır."}]},
 {"ayet":145,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"Hiçbir kimse yok ki, ölümü Allah’ın iznine bağlı olmasın."},{"ar":[8,9],"tr":"(Ölüm), belli bir süreye göre yazılmıştır."},{"ar":[11,12,13,14],"tr":"Her kim, dünya nimetini isterse,"},{"ar":[15,16],"tr":"kendisine ondan veririz;"},{"ar":[17,18,19,20],"tr":"kim de ahiret sevabını isterse,"},{"ar":[21,22],"tr":"ona da bundan veririz."},{"ar":[24,25],"tr":"Biz şükredenleri mükâfatlandıracağız."}]},
 {"ayet":146,"gruplar":[{"ar":[0,1,2],"tr":"Nice peygamberler vardı ki,"},{"ar":[4,5,6,3],"tr":"beraberinde birçok Allah erleri bulunduğu halde savaştılar da,"},{"ar":[7,8,9,10,11,12,13,14,15],"tr":"bunlar, Allah yolunda başlarına gelenlerden dolayı gevşeklik ve zaaf göstermediler,"},{"ar":[16,17],"tr":"boyun eğmediler."},{"ar":[19,20,21],"tr":"Allah sabredenleri sever."}]},
 {"ayet":147,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"Onların sözleri, sadece şöyle demekten ibaretti:"},{"ar":[6],"tr":"Ey Rabbimiz!"},{"ar":[9,10,7,8,11,12],"tr":"Günahlarımızı ve işimizdeki taşkınlığımızı bağışla;"},{"ar":[13,14],"tr":"ayaklarımızı (yolunda) sabit kıl;"},{"ar":[17,18,16,15],"tr":"kâfirler topluluğuna karşı bizi muzaffer kıl!"}]},
 {"ayet":148,"gruplar":[{"ar":[0,1],"tr":"Allah da onlara"},{"ar":[2,3],"tr":"dünya nimetini"},{"ar":[4,5,6],"tr":"ve (daha da önemlisi,) ahiret sevabının güzelliğini verdi."},{"ar":[8,9,10],"tr":"Allah, iyi davrananları sever."}]},
 {"ayet":149,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[3,4,5,6],"tr":"Eğer kâfirlere uyarsanız,"},{"ar":[7,8,9],"tr":"gerisin geriye (eski dininize) döndürürler de,"},{"ar":[10,11],"tr":"hüsrana uğrayanların durumuna düşersiniz."}]},
 {"ayet":150,"gruplar":[{"ar":[0],"tr":"Oysa"},{"ar":[2],"tr":"sizin mevlânız"},{"ar":[1],"tr":"Allah’tır"},{"ar":[4,5,6],"tr":"ve O, yardımcıların en hayırlısıdır."}]},
 {"ayet":151,"gruplar":[{"ar":[6,7,8,9,10,11,12,13],"tr":"Allah’ın, hakkında hiçbir delil indirmediği şeyleri O’na ortak koşmaları sebebiyle,"},{"ar":[3,4,1,2],"tr":"kâfirlerin kalplerine"},{"ar":[0,5],"tr":"yakında korku salacağız."},{"ar":[15,16],"tr":"Gidecekleri yer de cehennemdir."},{"ar":[18,19,20],"tr":"Zalimlerin varacağı yer ne kötüdür!"}]},
 {"ayet":152,"gruplar":[{"ar":[5,6,4],"tr":"Siz Allah’ın izni ile düşmanlarınızı öldürürken,"},{"ar":[0,2,1,3],"tr":"Allah, size olan vâdini yerine getirmiştir."},{"ar":[8,9],"tr":"Nihayet, öyle bir an geldi ki,"},{"ar":[16,17,18,19,20],"tr":"Allah arzuladığınızı (galibiyeti) size gösterdikten sonra"},{"ar":[10],"tr":"zaafa düştünüz;"},{"ar":[13,12,11],"tr":"(Peygamberin verdiği) emir konusunda tartışmaya kalkıştınız"},{"ar":[14],"tr":"ve âsi oldunuz."},{"ar":[22,23,24,25],"tr":"Dünyayı isteyeniniz de vardı,"},{"ar":[26,27,28,29],"tr":"ahireti isteyeniniz de vardı."},{"ar":[31],"tr":"Sonra Allah,"},{"ar":[34,32,33],"tr":"denemek için sizi onlardan (onları mağlup etmekten) alıkoydu."},{"ar":[36,37,38],"tr":"Ve andolsun sizi bağışladı."},{"ar":[40,41,42,43,44],"tr":"Zaten Allah, müminlere karşı çok lütufkârdır."}]},
 {"ayet":153,"gruplar":[{"ar":[1],"tr":"O zaman"},{"ar":[7,8,10,9],"tr":"Peygamber arkanızdan sizi çağırdığı halde"},{"ar":[2],"tr":"siz, durmadan (savaş alanından) uzaklaşıyor,"},{"ar":[3,4,5,6],"tr":"hiç kimseye dönüp bakmıyordunuz."},{"ar":[11,12,13],"tr":"(Allah) size keder üstüne keder verdi"},{"ar":[14,16,17,18],"tr":"ki, bundan dolayı gerek elinizden gidene,"},{"ar":[19,20,21],"tr":"gerekse başınıza gelenlere"},{"ar":[15],"tr":"üzülmeyesiniz."},{"ar":[23,24,25,26],"tr":"Allah yaptıklarınızdan haberdardır."}]},
 {"ayet":154,"gruplar":[{"ar":[0,3,4,5],"tr":"Sonra o kederin arkasından"},{"ar":[1,2,6],"tr":"Allah size bir güven indirdi"},{"ar":[7],"tr":"ki, (bu güvenin yol açtığı) uyuklama hali"},{"ar":[9,10,8],"tr":"bir kısmınızı kaplıyordu."},{"ar":[15,14,13,12],"tr":"Kendi canlarının kaygısına düşmüş bir gurup da,"},{"ar":[17,18,19,20,21,16],"tr":"Allah’a karşı haksız yere cahiliye devrindekine benzer düşüncelere kapılıyorlar,"},{"ar":[23,24,25,26,27,28,29],"tr":"Bu işten bize ne!» diyorlardı."},{"ar":[31],"tr":"De ki:"},{"ar":[32,33,34,35],"tr":"İş (zafer, yardım, herşeyin karar ve buyruğu) tamamen Allah’a aittir."},{"ar":[43,40,41,42,38,39,37],"tr":"Onlar, sana açıklayamadıklarını içlerinde gizliyorlar."},{"ar":[46,47,48,49,50,51,54,52,53,45],"tr":"Bu işten bize bir şey olsaydı, burada öldürülmezdik» diyorlar."},{"ar":[56],"tr":"Şöyle de:"},{"ar":[57,58,59,60],"tr":"Evlerinizde kalmış olsaydınız bile,"},{"ar":[65,63,64,62],"tr":"öldürülmesi takdir edilmiş olanlar,"},{"ar":[61,66,67],"tr":"öldürülüp düşecekleri yerlere kendiliklerinden çıkıp giderlerdi."},{"ar":[70,71,72,73,69],"tr":"Allah, içinizdekileri yoklamak"},{"ar":[74,75,76,77],"tr":"ve kalplerinizdekileri temizlemek için (böyle yaptı)."},{"ar":[79,80,81,82],"tr":"Allah içinizde ne varsa hepsini bilir."}]},
 {"ayet":155,"gruplar":[{"ar":[0,6,5,4],"tr":"(Uhud’da) iki ordu karşılaştığı gün,"},{"ar":[1,2,3],"tr":"sizi bırakıp gidenleri,"},{"ar":[7,10,11,12],"tr":"sırf işledikleri bazı hatalar yüzünden"},{"ar":[9,8],"tr":"şeytan (yerlerinden) kaydırmıştı."},{"ar":[14,15,16,17],"tr":"Yine de Allah onları affetti."},{"ar":[19,20,21,22],"tr":"Çünkü Allah, çok bağışlayıcıdır, halîmdir."}]},
 {"ayet":156,"gruplar":[{"ar":[0,1,2],"tr":"Ey iman edenler!"},{"ar":[5,6],"tr":"Sizler, inkâr edenler"},{"ar":[7,9,10,11,12,13,14,15,8],"tr":"ve yeryüzünde sefere çıkan veya savaşan kardeşleri hakkında:"},{"ar":[16,17,18],"tr":"Eğer bizim yanımızda kalsalardı"},{"ar":[19,20,21,22],"tr":"ölmezler, öldürülmezlerdi"},{"ar":[3,4],"tr":"diyenler gibi olmayın."},{"ar":[24,25],"tr":"Allah bu kanaatı"},{"ar":[27,28],"tr":"onların kalplerine"},{"ar":[26,23],"tr":"(kaybettikleri yakınları için onulmaz) bir hasret (yarası) olarak koydu."},{"ar":[30,31,32],"tr":"Canı veren de alan da Allah’tır."},{"ar":[34,35,36,37],"tr":"Allah, yaptıklarınızı hakkıyla görür."}]},
 {"ayet":157,"gruplar":[{"ar":[0,2,3,4,1,5,6],"tr":"Eğer Allah yolunda öldürülür ya da ölürseniz,"},{"ar":[7,8,9],"tr":"şunu bilin ki, Allah’ın mağfireti"},{"ar":[10],"tr":"ve rahmeti"},{"ar":[12,13],"tr":"onların topladıkları bütün şeylerden"},{"ar":[11],"tr":"daha hayırlıdır."}]},
 {"ayet":158,"gruplar":[{"ar":[0,1,2,3],"tr":"Andolsun, ölseniz de öldürülseniz de"},{"ar":[4,5,6],"tr":"Allah’ın huzurunda toplanacaksınız."}]},
 {"ayet":159,"gruplar":[{"ar":[0],"tr":"O vakit"},{"ar":[2,3,1],"tr":"Allah’tan bir rahmet ile"},{"ar":[5,4],"tr":"onlara yumuşak davrandın!"},{"ar":[7,8,9,10,11],"tr":"Şayet sen kaba, katı yürekli olsaydın,"},{"ar":[12,13,14],"tr":"hiç şüphesiz, etrafından dağılıp giderlerdi."},{"ar":[16,17],"tr":"Şu halde onları affet;"},{"ar":[18,19],"tr":"bağışlanmaları için dua et;"},{"ar":[20,21,22],"tr":"iş hakkında onlara danış."},{"ar":[24,25],"tr":"Kararını verdiğin zaman da"},{"ar":[26,27,28],"tr":"artık Allah’a dayanıp güven."},{"ar":[30,31,32,33],"tr":"Çünkü Allah, kendisine dayanıp güvenenleri sever."}]},
 {"ayet":160,"gruplar":[{"ar":[0,2,1],"tr":"Allah size yardım ederse,"},{"ar":[3,4,5],"tr":"artık size üstün gelecek hiç kimse yoktur."},{"ar":[7,8],"tr":"Eğer sizi bırakıverirse,"},{"ar":[9,10,11,12,13,14],"tr":"ondan sonra size kim yardım eder?"},{"ar":[16,17,18,19],"tr":"Müminler ancak Allah’a güvenip dayanmalıdırlar."}]},
 {"ayet":161,"gruplar":[{"ar":[0,1,2,3,4],"tr":"Bir peygambere, emanete hıyanet yaraşmaz."},{"ar":[6,7],"tr":"Kim emanete (devlet malına) hıyanet ederse,"},{"ar":[11,12],"tr":"kıyamet günü,"},{"ar":[8,9,10],"tr":"hainlik ettiği şeyin günahı boynuna asılı olarak gelir."},{"ar":[14,16,17],"tr":"Sonra herkese"},{"ar":[20,21,22],"tr":"-asla haksızlığa uğratılmaksızın-"},{"ar":[18,19,15],"tr":"kazandığı tastamam verilir."}]},
 {"ayet":162,"gruplar":[{"ar":[0,1,2,3],"tr":"Allah’ın hoşnutluğunu gözetenle"},{"ar":[4,5,6,7,8],"tr":"Allah’ın hışmına uğrayan bir olur mu hiç?"},{"ar":[9,10],"tr":"Berikisinin yeri cehennemdir."},{"ar":[12,13],"tr":"Cehennem ise ne kötü bir varış noktasıdır."}]},
 {"ayet":163,"gruplar":[{"ar":[0,1,2,3],"tr":"Onlar Allah katında derece derecedirler."},{"ar":[5,6,7,8],"tr":"Allah onların yaptıklarını görmektedir."}]},
 {"ayet":164,"gruplar":[{"ar":[0],"tr":"Andolsun ki"},{"ar":[7,9,10],"tr":"içlerinden,"},{"ar":[11,12,13],"tr":"kendilerine Allah’ın âyetlerini okuyan,"},{"ar":[14],"tr":"(kötülüklerden ve inkârdan) kendilerini temizleyen,"},{"ar":[15,16,17],"tr":"kendilerine Kitap ve hikmeti öğreten"},{"ar":[5,6,8],"tr":"bir Peygamber göndermekle"},{"ar":[1,2,3,4],"tr":"Allah, müminlere büyük bir lütufta bulunmuştur."},{"ar":[18,20,21,19,22,23,24],"tr":"Halbuki daha önce onlar apaçık bir sapıklık içinde idiler."}]},
 {"ayet":165,"gruplar":[{"ar":[3,4,5],"tr":"(Bedir’de) iki katını (düşmanınızın) başına getirdiğiniz"},{"ar":[2],"tr":"bir musibet,"},{"ar":[0,1],"tr":"(Uhud’da) kendi başınıza geldiği için mi"},{"ar":[8,7,6],"tr":"Bu nasıl oluyor!» dediniz?"},{"ar":[10],"tr":"De ki:"},{"ar":[11,12,13,14],"tr":"O, kendi kusurunuzdandır."},{"ar":[16,17,18,19,20,21],"tr":"Şüphesiz Allah’ın her şeye gücü yeter."}]},
 {"ayet":166,"gruplar":[{"ar":[2,3,4],"tr":"İki birliğin karşılaştığı gün"},{"ar":[0,1],"tr":"sizin başınıza gelenler,"},{"ar":[5,6],"tr":"ancak Allah’ın dilemesiyle olmuştur ki,"},{"ar":[7,8],"tr":"bu da, müminleri ayırdetmesi"}]},
 {"ayet":167,"gruplar":[{"ar":[0,1,2],"tr":"ve münafıkları ortaya çıkarması için idi."},{"ar":[5,6,8,9,10,7,11,12,4],"tr":"Bunlara: «Gelin, Allah yolunda çarpışın; ya da savunma yapın» denildiği zaman,"},{"ar":[15,16,17,18,14],"tr":"Harbetmeyi bilseydik, elbette sizin peşinizden gelirdik» dediler."},{"ar":[20,22,25,24,21,23],"tr":"Onlar o gün, imandan çok, kâfirliğe yakın idiler."},{"ar":[27,28,29,30,31,32],"tr":"Ağızlarıyla, kalplerinde olmayanı söylüyorlardı."},{"ar":[34,35,36,37],"tr":"Halbuki Allah, onların içlerinde gizlediklerini daha iyi bilir."}]},
 {"ayet":168,"gruplar":[{"ar":[3],"tr":"(Evlerinde) oturup da"},{"ar":[2],"tr":"kardeşleri hakkında:"},{"ar":[4,5,6,7,1,0],"tr":"Bize uysalardı öldürülmezlerdi» diyenlere,"},{"ar":[14,15,16],"tr":"Eğer doğru sözlü insanlar iseniz,"},{"ar":[10,12,13,11],"tr":"canlarınızı ölümden kurtarın bakalım!"},{"ar":[9],"tr":"de."}]},
 {"ayet":169,"gruplar":[{"ar":[4,5,6,2,3,0,1,7],"tr":"Allah yolunda öldürülenleri sakın ölü sanmayın."},{"ar":[9,10],"tr":"Bilakis onlar diridirler;"},{"ar":[11,12,13],"tr":"Rableri yanında rızıklara mazhar olmaktadırlar."}]},
 {"ayet":170,"gruplar":[{"ar":[3,4,5,2,1,0],"tr":"Allah’ın, lütuf ve kereminden kendilerine verdikleri ile sevinçli bir halde"},{"ar":[12,11,9,8,10,7],"tr":"Arkalarından gelecek ve henüz kendilerine katılmamış olan şehit kardeşlerine de"},{"ar":[13,14,15,16,17,18],"tr":"hiçbir keder ve korku bulunmadığı"},{"ar":[6],"tr":"müjdesinin sevincini duymaktadırlar."}]},
 {"ayet":171,"gruplar":[{"ar":[4,3,2,5],"tr":"Onlar, Allah’tan gelen nimet ve keremin;"},{"ar":[6,7,8,9,10,11],"tr":"Allah’ın, müminlerin ecrini zayi etmeyeceği"},{"ar":[1],"tr":"müjdesinin sevinci içindedirler."}]},
 {"ayet":172,"gruplar":[{"ar":[4,5,6,7,8],"tr":"Yara aldıktan sonra yine"},{"ar":[2,3,1,0],"tr":"Allah’ın ve Peygamber’in çağrısına uyanlar"},{"ar":[12,11,13,10],"tr":"(özellikle) bunların içlerinden iyilik yapanlar ve takvâ sahibi olanlar için"},{"ar":[14,15],"tr":"pek büyük bir mükâfat vardır."}]},
 {"ayet":173,"gruplar":[{"ar":[0,3,2],"tr":"Bir kısım insanlar, müminlere:"},{"ar":[4,5,6,7,8],"tr":"Düşmanlarınız olan insanlar, size karşı asker topladılar;"},{"ar":[9,1],"tr":"aman sakının onlardan!» dediklerinde"},{"ar":[10,11],"tr":"bu, onların imanlarını bir kat daha arttırdı"},{"ar":[12,13,14],"tr":"ve «Allah bize yeter."},{"ar":[15,16],"tr":"O ne güzel vekîldir!» dediler."}]},
 {"ayet":174,"gruplar":[{"ar":[5,6,7],"tr":"Bunun üzerine, kendilerine hiçbir fenalık dokunmadan,"},{"ar":[2,3,1,4,0],"tr":"Allah’ın nimet ve keremiyle geri geldiler."},{"ar":[8,9,10],"tr":"Böylece Allah’ın rızasına uymuş oldular."},{"ar":[12,13,14,15],"tr":"Allah büyük kerem sahibidir."}]},
 {"ayet":175,"gruplar":[{"ar":[1,2,0],"tr":"İşte o şeytan, ancak"},{"ar":[4,3],"tr":"kendi dostlarını korkutur."},{"ar":[8,9,10],"tr":"Şu halde, eğer iman etmiş kimseler iseniz"},{"ar":[5,6],"tr":"onlardan korkmayın,"},{"ar":[7],"tr":"benden korkun."}]}
]}
