{"sure":3,"ayetler":[
 {"ayet":1,"gruplar":[{"ar":[0],"tr":"Elif. Lâm. Mîm."}]},
 {"ayet":2,"gruplar":[{"ar":[5,6],"tr":"Hayy ve kayyûm olan"},{"ar":[0],"tr":"Allah’tan"},{"ar":[1,2,3,4],"tr":"başka ilâh yoktur"}]},
 {"ayet":3,"gruplar":[{"ar":[1],"tr":"(Resûlüm!) O, sana"},{"ar":[2,3],"tr":"Kitab’ı hak"},{"ar":[4,5,6,7],"tr":"ve önceki kitapları tasdik edici olarak"},{"ar":[0],"tr":"tedricen indirmiş;"},{"ar":[8,9,10],"tr":"Tevrat ile İncil’i indirmişti"}]},
 {"ayet":4,"gruplar":[{"ar":[0,1],"tr":"daha önce de,"},{"ar":[2,3],"tr":"insanlara doğru yolu göstermek üzere"},{"ar":[5,4],"tr":"Furkan’ı da indirdi"},{"ar":[8,9,10,11],"tr":"Bilinmeli ki, Allah’ın âyetlerini inkâr edenler"},{"ar":[12,13,14],"tr":"için şiddetli bir azap vardır"},{"ar":[16,17,18,19],"tr":"Allah, suçlunun hakkından gelen mutlak güç sahibidir"}]},
 {"ayet":5,"gruplar":[{"ar":[0],"tr":"Şüphesiz ki"},{"ar":[8,9,10,6,7],"tr":"ne yerde ne de gökte"},{"ar":[5],"tr":"hiçbir şey"},{"ar":[1,2,3,4],"tr":"Allah’a gizli kalmaz"}]},
 {"ayet":6,"gruplar":[{"ar":[3,4],"tr":"Rahimlerde"},{"ar":[2,5,6],"tr":"sizi dilediği gibi şekillendiren"},{"ar":[0,1],"tr":"O’dur"},{"ar":[8,9,10,11],"tr":"O’ndan başka ilâh yoktur"},{"ar":[12,13],"tr":"O mutlak güç ve hikmet sahibidir"}]},
 {"ayet":7,"gruplar":[{"ar":[3,4],"tr":"Sana Kitab’ı"},{"ar":[2,0,1],"tr":"indiren O’dur"},{"ar":[5,6,7],"tr":"Onun (Kur’an’ın) bazı âyetleri muhkemdir ki,"},{"ar":[8,9,10],"tr":"bunlar Kitab’ın esasıdır"},{"ar":[11,12],"tr":"Diğerleri de müteşâbihtir"},{"ar":[15,16,17,18],"tr":"Kalplerinde eğrilik olanlar,"},{"ar":[23,24,25,26],"tr":"fitne çıkarmak ve onu tevil etmek için"},{"ar":[19,20,21,22],"tr":"ondaki müteşâbih âyetlerin peşine düşerler"},{"ar":[28,29,30,31,32],"tr":"Halbuki Onun tevilini ancak Allah bilir"},{"ar":[34,35,36],"tr":"İlimde yüksek pâyeye erişenler ise:"},{"ar":[38,39],"tr":"Ona inandık;"},{"ar":[40,41,42,43],"tr":"hepsi Rabbimiz tarafındandır,"},{"ar":[37],"tr":"derler"},{"ar":[45,46,47,48,49],"tr":"(Bu inceliği) ancak aklıselim sahipleri düşünüp anlar"}]},
 {"ayet":8,"gruplar":[{"ar":[0],"tr":"(Onlar şöyle yakarırlar:) Rabbimiz!"},{"ar":[6,4,5],"tr":"Bizi doğru yola ilettikten sonra"},{"ar":[3,1,2],"tr":"kalplerimizi eğriltme"},{"ar":[7,8,9,10,11],"tr":"Bize tarafından rahmet bağışla"},{"ar":[13,14,15],"tr":"Lütfu en bol olan sensin"}]},
 {"ayet":9,"gruplar":[{"ar":[0],"tr":"Rabbimiz!"},{"ar":[4,5,6,7],"tr":"Gelmesinde şüphe edilmeyen bir günde,"},{"ar":[3,1,2],"tr":"insanları mutlaka toplayacak olan sensin"},{"ar":[9,10,11,12,13],"tr":"Allah asla sözünden dönmez"}]},
 {"ayet":10,"gruplar":[{"ar":[0],"tr":"Bilinmelidir ki"},{"ar":[1,2],"tr":"inkâr edenlerin"},{"ar":[3,6,7,8],"tr":"ne malları ne de evlâtları"},{"ar":[9,10],"tr":"Allah huzurunda"},{"ar":[4,5,11],"tr":"kendilerine bir fayda sağlayacaktır"},{"ar":[13,14,15,16],"tr":"İşte onlar cehennemin yakıtıdır"}]},
 {"ayet":11,"gruplar":[{"ar":[0,1,2,3,4,5],"tr":"(Onların yolu) Firavun hanedanının ve onlardan öncekilerin tuttuğu yola benzer"},{"ar":[7,8],"tr":"Onlar bizim âyetlerimizi yalanladılar,"},{"ar":[9,10,11],"tr":"Allah da kendilerini günahları yüzünden yakalayıverdi"},{"ar":[13,14,15],"tr":"Allah’ın cezası çok şiddetlidir"}]},
 {"ayet":12,"gruplar":[{"ar":[1,2,0],"tr":"(Resûlüm!) İnkâr edenlere de ki:"},{"ar":[3],"tr":"Yakında mağlup olacaksınız"},{"ar":[4,5,6],"tr":"ve cehenneme sürüleceksiniz"},{"ar":[8,9],"tr":"Orası kalınacak ne kötü bir yerdir!"}]},
 {"ayet":13,"gruplar":[{"ar":[4,5,6],"tr":"(Bedir’de) karşı karşıya gelen şu iki gurubun halinde"},{"ar":[0,1,2,3],"tr":"sizin için büyük bir ibret vardır"},{"ar":[8,9,10,11,12],"tr":"Biri Allah yolunda çarpışan bir gurup,"},{"ar":[13,14,15,16,17,18],"tr":"diğeri ise bunları apaçık kendilerinin iki misli gören kâfir bir gurup"},{"ar":[20,21,22,23,24],"tr":"Allah dilediğini yardımı ile destekler"},{"ar":[26,27,28,29,30,31],"tr":"Elbette bunda basiret sahipleri için büyük bir ibret vardır"}]},
 {"ayet":14,"gruplar":[{"ar":[3],"tr":"Nefsanî arzulara,"},{"ar":[4,5],"tr":"(özellikle) kadınlara,"},{"ar":[6],"tr":"oğullara,"},{"ar":[7,8,9,10,11],"tr":"yığın yığın biriktirilmiş altın ve gümüşe,"},{"ar":[12,13],"tr":"salma atlara,"},{"ar":[14],"tr":"sağmal hayvanlara"},{"ar":[15],"tr":"ve ekinlere"},{"ar":[2],"tr":"karşı düşkünlük"},{"ar":[1,0],"tr":"insanlara çekici kılındı"},{"ar":[17,18,19,20],"tr":"Bunlar, dünya hayatının geçici menfaatleridir"},{"ar":[22,23,24,25],"tr":"Halbuki varılacak güzel yer, Allah’ın katındadır"}]},
 {"ayet":15,"gruplar":[{"ar":[1],"tr":"(Resûlüm!) De ki:"},{"ar":[2,3,4,5],"tr":"Size bunlardan daha iyisini bildireyim mi?"},{"ar":[7,8],"tr":"Takvâ sahipleri için"},{"ar":[9,10],"tr":"Rableri yanında,"},{"ar":[14,15,12,13],"tr":"içinden ırmaklar akan,"},{"ar":[16,17],"tr":"ebediyyen kalacakları"},{"ar":[11],"tr":"cennetler,"},{"ar":[19,18],"tr":"tertemiz eşler"},{"ar":[20,21,22],"tr":"ve (hepsinin üstünde) Allah’ın hoşnutluğu vardır"},{"ar":[24,25,26],"tr":"Allah kullarını çok iyi görür"}]},
 {"ayet":16,"gruplar":[{"ar":[0],"tr":"(Bu nimetler)"},{"ar":[2],"tr":"«Ey Rabbimiz!"},{"ar":[3,4],"tr":"İman ettik;"},{"ar":[5,6,7],"tr":"bizim günahlarımızı bağışla,"},{"ar":[8,9,10],"tr":"bizi ateş azabından koru!»"},{"ar":[1],"tr":"diyen;"}]},
 {"ayet":17,"gruplar":[{"ar":[0],"tr":"Sabreden,"},{"ar":[1],"tr":"dürüst olan,"},{"ar":[2],"tr":"huzurda boyun büken,"},{"ar":[3],"tr":"hayra harcayan"},{"ar":[5,4],"tr":"ve seher vaktinde Allah’tan bağış dileyenler (içindir)"}]},
 {"ayet":18,"gruplar":[{"ar":[1,10,11],"tr":"Allah, adaleti ayakta tutarak (delilleriyle)"},{"ar":[0,2],"tr":"şu hususu açıklamıştır ki,"},{"ar":[3,4,5,6],"tr":"kendisinden başka ilâh yoktur"},{"ar":[7,8,9],"tr":"Melekler ve ilim sahipleri de (bunu ikrar etmişlerdir. Evet)"},{"ar":[17,18],"tr":"mutlak güç ve hikmet sahibi"},{"ar":[13,14,15,16],"tr":"Allah’tan başka ilâh yoktur"}]},
 {"ayet":19,"gruplar":[{"ar":[2,3],"tr":"Allah nezdinde"},{"ar":[1,4,0],"tr":"hak din İslâm’dır"},{"ar":[8,9,10],"tr":"Kitap verilenler,"},{"ar":[12,13,14,15,16],"tr":"kendilerine ilim geldikten sonradır ki,"},{"ar":[17,18,7],"tr":"aralarındaki kıskançlık yüzünden ayrılığa düştüler"},{"ar":[20,21,22,23],"tr":"Allah’ın âyetlerini inkâr edenler"},{"ar":[24,25,26,27],"tr":"bilmelidirler ki Allah’ın hesabı çok çabuktur"}]},
 {"ayet":20,"gruplar":[{"ar":[0,1],"tr":"Eğer seninle tartışmaya girerlerse"},{"ar":[2],"tr":"de ki:"},{"ar":[6,7],"tr":"«Bana uyanlarla birlikte"},{"ar":[3,4,5],"tr":"ben kendimi Allah’a teslim ettim.»"},{"ar":[10,11,12,13],"tr":"Ehl-i kitaba ve ümmîlere de:"},{"ar":[14],"tr":"«Siz de Allah’a teslim oldunuz mu?»"},{"ar":[9],"tr":"de"},{"ar":[16,17],"tr":"Eğer teslim oldularsa"},{"ar":[18,19],"tr":"doğru yolu buldular demektir"},{"ar":[21,22],"tr":"Yok eğer yüz çevirdilerse"},{"ar":[23,24,25],"tr":"sana düşen, yalnızca duyurmaktır"},{"ar":[27,28,29],"tr":"Allah kullarını çok iyi görmektedir"}]},
 {"ayet":21,"gruplar":[{"ar":[3,4,1,2],"tr":"Allah’ın âyetlerini inkâr edenler,"},{"ar":[7,8,6,5],"tr":"haksız yere peygamberlerin canlarına kıyanlar"},{"ar":[9,10,11,12,13,14],"tr":"ve adaleti emreden insanları öldürenler (yok mu),"},{"ar":[15,16,17],"tr":"onlara acı bir azabı müjdele!"}]},
 {"ayet":22,"gruplar":[{"ar":[0,1],"tr":"İşte bunlar"},{"ar":[4,5,6],"tr":"dünyada da ahirette de"},{"ar":[3,2],"tr":"çabaları boşa giden kimselerdir"},{"ar":[7,8,9,10],"tr":"Onların hiçbir yardımcısı da yoktur"}]},
 {"ayet":23,"gruplar":[{"ar":[3,4,5,6,7],"tr":"(Resûlüm!) Kendilerine Kitap’tan bir pay verilenleri (yahudileri)"},{"ar":[0,1,2],"tr":"görmez misin ki,"},{"ar":[12,13],"tr":"aralarında hükmetmesi için"},{"ar":[9,10,11,8],"tr":"Allah’ın Kitab’ına çağırılıyorlar da,"},{"ar":[14],"tr":"sonra"},{"ar":[16,17],"tr":"içlerinden bir gurup"},{"ar":[15,18,19],"tr":"cayarak geri dönüyor"}]},
 {"ayet":24,"gruplar":[{"ar":[0,1],"tr":"Onların bu tutumları:"},{"ar":[3,4,5],"tr":"Bize ateş,"},{"ar":[6,7,8],"tr":"sadece sayılı günlerde dokunacaktır,"},{"ar":[2],"tr":"demelerinin bir sonucudur"},{"ar":[13,14,15],"tr":"Onların vaktiyle uydurdukları şeyler de"},{"ar":[11,12],"tr":"dinleri hakkında"},{"ar":[10],"tr":"kendilerini yanıltmıştır"}]},
 {"ayet":25,"gruplar":[{"ar":[1],"tr":"Fakat,"},{"ar":[3,4,5,6],"tr":"onları gelmesinde şüphe edilmeyen bir gün için"},{"ar":[2],"tr":"topladığımız"},{"ar":[12,13,14,8,9,10,11,7],"tr":"ve hiçbir haksızlığa uğramaksızın herkese kazandığı şeyler tastamam ödendiği zaman"},{"ar":[0],"tr":"halleri nice olur?"}]},
 {"ayet":26,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) De ki:"},{"ar":[1,2,3],"tr":"Mülkün gerçek sahibi olan Allah’ım!"},{"ar":[4,5,6,7],"tr":"Sen mülkü dilediğine verirsin"},{"ar":[8,9,10,11],"tr":"ve mülkü dilediğinden geri alırsın"},{"ar":[12,13,14],"tr":"Dilediğini yüceltir,"},{"ar":[15,16,17],"tr":"dilediğini de alçaltırsın"},{"ar":[19,20],"tr":"Her türlü iyilik senin elindedir"},{"ar":[22,23,24,25,26],"tr":"Gerçekten sen her şeye kadirsin"}]},
 {"ayet":27,"gruplar":[{"ar":[0,1,2,3],"tr":"Geceyi gündüze katar,"},{"ar":[4,5,6,7],"tr":"gündüzü de geceye katarsın"},{"ar":[9,10,11,12],"tr":"Ölüden diriyi çıkarır,"},{"ar":[13,14,15,16],"tr":"diriden de ölüyü çıkarırsın"},{"ar":[18,19,20,21,22],"tr":"Dilediğine de sayısız rızık verirsin"}]},
 {"ayet":28,"gruplar":[{"ar":[0,1,2,3,4,5,6,7],"tr":"Müminler, müminleri bırakıp da kâfirleri dost edinmesin"},{"ar":[9,10,11],"tr":"Kim bunu yaparsa,"},{"ar":[12,13,14,15,16],"tr":"artık onun Allah nezdinde hiçbir değeri yoktur"},{"ar":[17,18,19,20,21],"tr":"Ancak kâfirlerden gelebilecek bir tehlikeden sakınmanız başkadır"},{"ar":[23,24,25],"tr":"Allah, kendisine karşı (gelmekten) sizi sakındırıyor"},{"ar":[27,28,29],"tr":"Dönüş yalnız Allah’adır"}]},
 {"ayet":29,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2,3,4,5,6,7],"tr":"İçinizdekileri gizleseniz de açığa vursanız da"},{"ar":[8,9],"tr":"Allah onu bilir"},{"ar":[11,12,13,14,15,16,17],"tr":"Göklerde ve yerde olanları da bilir"},{"ar":[19,20,21,22,23],"tr":"Allah her şeye kadirdir"}]},
 {"ayet":30,"gruplar":[{"ar":[2,3],"tr":"Herkesin,"},{"ar":[4,5,6,7],"tr":"iyilik olarak yaptıklarını da"},{"ar":[9,10,11,12],"tr":"kötülük olarak yaptıklarını da"},{"ar":[8,1],"tr":"karşısında hazır bulduğu"},{"ar":[0],"tr":"günde"},{"ar":[13,14,15],"tr":"(insan) isteyecek ki"},{"ar":[16,17,18,19],"tr":"kötülükleri ile kendisi arasında uzun bir mesafe bulunsun"},{"ar":[21,22,23],"tr":"Allah, kendisine karşı (gelmekten) sizi sakındırıyor"},{"ar":[25,26,27],"tr":"Allah kullarına çok şefkatlidir"}]},
 {"ayet":31,"gruplar":[{"ar":[0],"tr":"(Resûlüm!) De ki:"},{"ar":[1,2,3,4],"tr":"Eğer Allah’ı seviyorsanız"},{"ar":[5],"tr":"bana uyunuz"},{"ar":[6,7],"tr":"ki Allah da sizi sevsin"},{"ar":[8,9,10],"tr":"ve günahlarınızı bağışlasın"},{"ar":[12,13,14],"tr":"Allah son derece bağışlayıcı ve esirgeyicidir"}]},
 {"ayet":32,"gruplar":[{"ar":[0],"tr":"De ki:"},{"ar":[1,2,3],"tr":"Allah’a ve Resûlü’ne itaat edin"},{"ar":[5,6],"tr":"Eğer yüz çevirirlerse"},{"ar":[7,8,9,10,11],"tr":"bilsinler ki Allah kâfirleri sevmez"}]},
 {"ayet":33,"gruplar":[{"ar":[2],"tr":"Allah"},{"ar":[4],"tr":"Âdem’i,"},{"ar":[5],"tr":"Nuh’u,"},{"ar":[6,7],"tr":"İbrahim ailesi"},{"ar":[8,9],"tr":"ile İmrân ailesini"},{"ar":[3],"tr":"seçip"},{"ar":[10,11],"tr":"âlemlere üstün kıldı"}]},
 {"ayet":34,"gruplar":[{"ar":[0,1,2,3],"tr":"birbirinden gelme bir nesil olarak"},{"ar":[5,6,7],"tr":"Allah işiten ve bilendir"}]},
 {"ayet":35,"gruplar":[{"ar":[3,2,1,0],"tr":"İmrân’ın karısı şöyle demişti:"},{"ar":[4],"tr":"«Rabbim!"},{"ar":[9,10,8],"tr":"Karnımdakini"},{"ar":[11],"tr":"azatlı bir kul olarak"},{"ar":[5,6,7],"tr":"sırf sana adadım"},{"ar":[12,13],"tr":"Adağımı kabul buyur"},{"ar":[15,16,17,18],"tr":"Şüphesiz (niyazımı) hakkıyla işiten ve (niyetimi) bilen sensin"}]}
