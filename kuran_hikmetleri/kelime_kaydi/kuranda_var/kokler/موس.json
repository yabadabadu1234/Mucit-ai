  "ontoloji_tr": [
    {
      "tanim": "Demirden yahut ona benzer şeylerden yapılmış, ağzı keskin bir âlet; boğazlamak yahut kesmek için kullanılır.",
      "misal": "Et ustura ile kesilir."
    },
    {
      "tanim": "Bir şeyin bulunduğu yerde ileri geri, mahallî olarak hareket etmesi hâli",
      "misal": "Altımızdaki yerin sarsıldığını hissettik; sonra bunun hafif bir deprem olduğunu anladık."
    },
    {
      "tanim": "Kelbgiller ailesinden, etoburlar takımından bir memeli; sarıya çalan gri renkli yırtıcı bir hayvan; Avrupa, Asya ve Afrika ormanlarında yaşar; hile ve kurnazlıkla bilinir, avla geçinir.",
      "misal": "Gâlib, kurdun uluduğunu işitti de koyunlarına korktu."
    }
  ],
