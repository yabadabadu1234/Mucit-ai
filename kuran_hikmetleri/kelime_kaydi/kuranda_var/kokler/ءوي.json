  "ontoloji_tr": [
    {
      "tanim": "Bir mihnete maruz kalındığında veya bir mevkide tehlike hissedildiğinde kendisini emniyete almak için bir şeyden maddî ve manevî kuvvet istimdad etmek.",
      "misal": "Ebû Cemal, tahripçilerin mahsulünü tahrip etmesini önlemek için polise sığındı (_); zira geçen ay mahsulünün bir kısmı tahrip edilmişti."
    },
    {
      "tanim": "Tek bir ailenin yaşama mekânı (mesken/yuva).",
      "misal": "Ahmed, kendisi ve bütün ailesi içine taşınıp oturmak için yeni bir mesken/yuva (_) inşasını tamamladı."
    },
    {
      "tanim": "Tehlike vukuunda insanların korunmak için sığındıkları yer (melce/sığınak).",
      "misal": "Top mermileri ve füzeler işitildiğinde sakinler korunmak için sığınağa (_) giderler."
    },
    {
      "tanim": "İnsanın içinde yaşadığı ve hayatını sürdürdüğü mekân (barınak/mesken).",
      "misal": "Barınak/mesken (_), kerim bir hayat elde etmek için temini vacip olan en mühim hayat esaslarından sayılır."
    },
    {
      "tanim": "İnsanların oturması ve yaşaması için tahsis edilmiş bir arazi sahası üzerinde yapılmış, hayatın mukavvimatını ihtiva eden mekân.",
      "misal": "Muhammed güzel ve geniş bir meskende (_) yaşamaktadır."
    },
    {
      "tanim": "Bir şahsa daimî veya muvakkat olarak bir mekânda kalması için müsaade etmek.",
      "misal": "Ebû Heysem, ırkçı ayrım duvarının inşasına karşı beldeyle dayanışma için geldiklerinde yabancı mütezaminleri evinde misafir edip barındırdı (_)."
    },
    {
      "tanim": "İster bir müddet isterse daimî olsun, ikamet edip yaşadığı bir mekânı mevki edindi.",
      "misal": "Muhammed, işine yakın kırsal bir mıntıkada yerleşip barındı (_)."
    },
    {
      "tanim": "Mahdut bir zaman müddeti için meskende misafirler kabul etmek.",
      "misal": "Ebû Cevad ailesi, diğer evlerinde bazı Suriyeli mültecileri barındırma/misafir etme (_) işini yaptı."
    },
    {
      "tanim": "İhtiyaç ve musibet vaktinde müstacel yardım ve avn talep etti.",
      "misal": "Askerler kaleye sığındılar (_)."
    },
    {
      "tanim": "Birkaç meziyetin veya şeyin bir mekânda, şahısta yahut şeyde toplanması fiili.",
      "misal": "Yemek listesi sıhhî taamları ihtiva etti (_)."
    },
    {
      "tanim": "Muhtaçları yahut bir meydan okumadan veya tehlikeden kaçan şahısları barındırmaya tahsis edilmiş müessese/tesis.",
      "misal": "Devletin her muhtaç için temin edeceği bir barınak (me'vâ) bulunması elzemdir."
    },
    {
      "tanim": "Canlı varlıkları ihtiva eden, onların rahat, himaye ve itminan için içinde ikamet ettikleri veya oraya sığındıkları ve hüviyetini bu varlıkların nev'i ile hallerinden alan yer.",
      "misal": "Her canlının içinde yaşadığı bir meskeni vardır."
    },
    {
      "tanim": "Hayvanın mükerrer surette içinde oturduğu veya oraya sığındığı barınağı/yuvası.",
      "misal": ""
    }
  ],
