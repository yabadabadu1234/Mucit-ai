  "ontoloji_tr": [
    {
      "tanim": "Bir mekânı terk edip uzağa gitme fiili.",
      "misal": "Ahmed kahvaltısını bitirdi ve mektebe gitti."
    },
    {
      "tanim": "Şahsın bir mekândan başka bir mekâna intikal etmesi.",
      "misal": "Hânî, ırkçı ayırım duvarının arkasında kalan arazisine ulaşmak için uzun bir mesafeyi katetmeye muvaffak oldu."
    },
    {
      "tanim": "Bir mekâna ulaşmak maksadıyla veya mecazen bir şeyi aramak yahut bir hedefi gerçekleştirmek için iki ayağı bir mekândan diğerine nakletme fiili.",
      "misal": "Nebîl hedefini gerçekleştirmeye doğru adım attı."
    },
    {
      "tanim": "Kopmaksızın uzayabilen yumuşak madde.",
      "misal": "Mâlik çiçek vazosunu tamir etmek için elastik bir madde satın aldı."
    },
    {
      "tanim": "Birbirine yakın adımlarla yavaşça yürüdü ve ilerledi.",
      "misal": "Çocuk bugün ilk adımlarını attı."
    },
    {
      "tanim": "Şahsın muayyen adımlar yürümesi fiili.",
      "misal": ""
    },
    {
      "tanim": "Yürüyüşü esnasında onu geçip arkasında bıraktı.",
      "misal": "Yarışmacı, yarışın bitmesine dakikalar kala arkadaşını geçti."
    }
  ],
