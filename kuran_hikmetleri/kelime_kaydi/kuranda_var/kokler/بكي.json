  "ontoloji_tr": [
    {
      "tanim": "Bir şahsı kötü bir surette zikretti ve ister onda hakikaten mevcut olsun ister kendisine iftira etsin ondaki ayıplardan bahsetti.",
      "misal": "Zeyd, kendisine ihanet etmesinden dolayı Amr'ı _ (ayıpladı/yerdi)."
    },
    {
      "tanim": "Ona sert bir lehçe ile hitap etti ve kötü bir fiilinden dolayı onu levm etti.",
      "misal": "Üstat, arkadaşını dövmesi sebebiyle talebeyi _ (azarladı/tekdir etti)."
    },
    {
      "tanim": "Eziyet vermek için değil, sevgi ve davranışın tadil edilmesi talebiyle tekdir veya nasihat ederek nazla hitap etti.",
      "misal": "Zeyd yaptığı işten dolayı Amr'ı _ (azarladı/ayıpladı)."
    },
    {
      "tanim": "Başkalarını kötülükle ve zatlarına dokunan lafızlarla hoşlanmadıkları sıfatlarla zikretti.",
      "misal": "Adam hasmını _ (yerdi/tahkir etti) ve ona ihanet etti."
    },
    {
      "tanim": "Bir işi irtikap etmesine ceza olarak bir şahıs üzerinde bir takım sert icraatlar tatbik etti.",
      "misal": "Muallim, riyaziyat vazifesini yapmaması sebebiyle Ahmed'i _ (cezalandırdı/tekdir etti)."
    }
  ],
