  "ontoloji_tr": [
    {
      "tanim": "Bir şeyi aklî olarak ihata etme ve onun hakkında marifete sahip olma halinin vasfı.",
      "misal": "Bu dünyada yaşayan herkesin orada olup bitenlerin idrakinde/bilgisinde olması gerekir."
    },
    {
      "tanim": "Arazi bol mahsul ve kâr sahibi idi.",
      "misal": "Arazi zeytin mahsulüyle bol verim verdi."
    },
    {
      "tanim": "İşleri süratle idrak etme ve gözlemlenmesi güç olan şeyleri zekâyla mülahaza etme kudretine sahip bir şahsın mücerret hususiyeti.",
      "misal": "İş adamları dünyasına girmeye karar verdiğinde bu sahada dirayet ve ferasetin bulunmalıdır."
    },
    {
      "tanim": "Kalbindekini aksettirmeyecek şekilde bir şahsa sözle hoş görünme ameliyesi (müdârâ).",
      "misal": "Sözünde onu idare ederek müdârâda bulundu."
    },
    {
      "tanim": "Şey kendi etrafında hareket ederek dairevî bir şekil çizdi.",
      "misal": "Hâlid talih çarkını yüksek bir süratle döndürdü."
    },
    {
      "tanim": "NULL",
      "misal": "Askerler devriyeli/münavebeli bir şekilde murakabe yaptılar."
    },
    {
      "tanim": "Zihnin istinbat etmeye ve işleri anlamaya olan istidadının iyiliği.",
      "misal": "Kitabın fikirlerini idrak etmeye/kavramaya muvaffak oldu."
    }
  ],
