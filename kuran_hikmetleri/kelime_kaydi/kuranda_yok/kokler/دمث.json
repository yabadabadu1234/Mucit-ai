  "mekayis": [
    {
      "baslik": "دَمَثَ",
      "metin": "(دَمَثَ) الدَّالُ وَالْمِيمُ وَالثَّاءُ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى لِينٍ وَسُهُولَةٍ. فَالدَّمَثُ: اللِّينُ; يُقَالُ دَمِثَ الْمَكَانُ يَدْمَثُ دَمَثًا; وَهُوَ دَمْثٌ وَدَمِثٌ. وَيَكُونُ ذَا رَمْلٍ، وَمِنْ ذَلِكَ الْحَدِيثِ: «أَنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَآلِهِ وَسَلَّمَ مَالَ إِلَى دَمَثٍ، وَقَالَ: إِذَا بَالَ أَحَدُكُمْ فَلْيَرْتَدْ لِبَوْلِهِ» &quot;. وَالدَّمَاثَةُ: سُهُولَةُ الْخُلُقِ. وَيُقَالُ دَمِّثْ لِي الْحَدِيثَ، أَيْ سَهِّلْهُ وَوَطِّئْهُ."
    }
  ],
  "zemahseri": {
    "hakikat": "دمث المكان فهو دمث ودميث. ومال إلى دمثٍ من الأرض فبال. ودمّث الشيء بيده: مرسه حتى يلين. ودمّث لخبزتك: وطيء مكانها. ونزلنا بأرض ميثاء دمثاء.",
    "mecaz": "رجل دمث الأخلاق: وطيئها. وفي خلقه دمث ودماثة. وقال:\nلنا جانب منه دميث وجانب ... إذا رامه الأعداء ممتنع صعب\nوفي مثل: \" دمّث لنفسك قبل النوم مضطجعاً \" أي استعد للأمر قبل وقوعه. ويقال: دمث لي ذلك الحديث حتى أطعن في حوصه أي اذكر لي أوله حتى أعرف وجهه فأعلم كيف آخذ فيه.",
    "mecaz_var": true
  },
