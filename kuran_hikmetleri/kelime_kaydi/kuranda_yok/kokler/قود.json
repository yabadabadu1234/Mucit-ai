  "prototip": {
    "karsilastirma_prototipi": "Zemahşerî hakîkat kolu",
    "yayilim": [
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "إن فلاناً سلس القياد: يتابعك على هواك، وأعطيته مقادتي: انقدت له، وطريق منقاد: مستقيم، وانقاد الطريق إلى البلد. قال ذو",
        "prototipe_benzerlik": 0.838,
        "halka": "yakın"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "الرمّة يصف ماء:",
        "prototipe_benzerlik": 0.233,
        "halka": "uzak"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "تنزّل عن زيزاءة القفّ وارتقى ... عن الرمل وانقادت إليه الموارد",
        "prototipe_benzerlik": 0.294,
        "halka": "uzak"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "واقتاد النبت الثور: وجد ريحه فهجم عليه. وللسحاب قائد وهو السحاب يتقدمه. قال ابن مقبل:",
        "prototipe_benzerlik": 0.417,
        "halka": "orta"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "لها قائد دهم الرّباب وخلفه ... روايا يبجسّن الغمام الكنهورا",
        "prototipe_benzerlik": 0.821,
        "halka": "yakın"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "وأقاد السحاب: صار له قائد، وسحاب مقيد، وقادته الريح فاستقاد لها. قال الأخطل:",
        "prototipe_benzerlik": 0.418,
        "halka": "orta"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "باتت يمانية الرياح تقوده ... حتى استقاد لها بغير حبال",
        "prototipe_benzerlik": 0.29,
        "halka": "uzak"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "وأصبحت يقاد بي البعير أي شخت وهرمت. وتقاود المكان: استوى. قال:",
        "prototipe_benzerlik": 0.862,
        "halka": "yakın"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "ألا ليت شعري هل أرى من مكانه ... ذرى عقدات الأبرق المتقاود",
        "prototipe_benzerlik": 0.264,
        "halka": "uzak"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "وقلّة قوداء: طويلة.",
        "prototipe_benzerlik": 0.267,
        "halka": "uzak"
      }
    ],
    "ortalama_benzerlik": 0.47
  }
