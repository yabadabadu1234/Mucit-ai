  "vikisozluk_etimolojiler": [
    {
      "metin": "From و ر ء (w r ʔ) or و ر ي (w r y). Lane's Dictionary, page 2933, \"ورأ\" meaning to push back behind something, to obscure or cover over; ultimately from \"ورى\", page 3052, meaning to make a fire, to set a blaze in front of you, behind its cover, to allude, to pretend or being ambiguous, to state something symbolically or to see another meaning besides the apparent.",
      "kognatlar": [
        ["و ر ء", "Appendix:Arabic roots/و ر ء"],
        ["و ر ي", "Appendix:Arabic roots/و ر ي"]
      ]
    },
    {
      "metin": "See the etymology of the corresponding lemma form.",
      "kognatlar": []
    },
    {
      "metin": "Eventually from Hebrew תּוֹרָה.",
      "kognatlar": [
        ["תּוֹרָה", "תורה#Hebrew"]
      ]
    },
    {
      "metin": "Borrowed from Persian لور (lôr).",
      "kognatlar": [
        ["لور", "لور#Persian"]
      ]
    }
  ],
