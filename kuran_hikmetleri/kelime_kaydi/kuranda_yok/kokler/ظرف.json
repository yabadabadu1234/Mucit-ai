  "mekayis": [
    {
      "baslik": "ظَرَفَ",
      "metin": "(ظَرَفَ) الظَّاءُ وَالرَّاءُ وَالْفَاءُ كَلِمَةٌ كَأَنَّهَا صَحِيحَةٌ. يَقُولُونَ: هَذَا وِعَاءُ الشَّيْءِ وَظَرْفُهُ، ثُمَّ يُسَمُّونَ الْبَرَاعَةَ ظَرْفًا، وَذَكَاءَ الْقَلْبِ كَذَلِكَ. وَمَعْنَى ذَلِكَ أَنَّهُ\nوِعَاءٌ لِذَلِكَ. وَهُوَ ظَرِيفٌ. وَقَدْ أَظْرَفَ الرَّجُلُ. إِذَا وَلَدَ بَنِينَ ظُرَفَاءَ. وَمَا أَحْسَبُ شَيْئًا مِنْ ذَلِكَ مِنْ كَلَامِ الْعَرَبِ."
    }
  ],
  "zemahseri": {
    "hakikat": "فيه ظرف وظرافة: كيس وذكاء، وقد ظرف فهو ظريف، وهم ظراف، ونساء ظراف وظرائف، وفتية ظروف، وعن عمر رضي الله عنه: إذا كان اللص ظيفاً لم يقطع أي كيساً يدرأ الحدّ باحتجاجه وأنا أستظرفه، وهو يتظرف ويتظارف. وقد أظرفت يا فلان أي جئت بأولاد ظراف. ويا مظرفان، كقولك: يا ملكعان. وعنده ظرف وظروف من الطعام والشراب. وبئس الظرف: الجوف. ورأيت فلاناً بظرفه: بعينه وهو تمثيل من قولك: أخذت المتاع بظرفه.",
    "mecaz_var": false
  },
