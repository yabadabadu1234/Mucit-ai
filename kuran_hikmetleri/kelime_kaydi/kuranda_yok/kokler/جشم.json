  "mekayis": [
    {
      "baslik": "جَشَمَ",
      "metin": "(جَشَمَ) الْجِيمُ وَالشِّينُ وَالْمِيمُ أَصْلٌ وَاحِدٌ، وَهُوَ مَجْمُوعُ الْجِسْمِ. يُقَالُ أَلْقَى فُلَانٌ عَلَى فُلَانٍ جُشَمَهُ، إِذَا أَلْقَى عَلَيْهِ ثِقْلَهُ. وَيُقَالُ جُشَمُ الْبَعِيرِ صَدْرُهُ، وَبِهِ سُمِّيَ الرَّجُلُ &quot; جُشَمَ &quot;. فَأَمَّا قَوْلُهُمْ تَجَشَّمْتُ الْأَمْرَ، فَمَعْنَاهُ تَحَمَّلْتُ بِجُشَمِي حَتَّى فَعَلْتُهُ. وَجَشَّمْتُ فُلَانًا كَذَا، أَيْ كَلَّفْتُهُ أَنْ يَحْمِلَ عَلَيْهِ جُشَمَهُ. قَالَ:\nفَأُقْسِمُ مَا جَشَّمْتُهُ مِنْ مُلِمَّةٍ ... تَؤُودُ كِرَامَ النَّاسِ إِلَّا تَجَشَّمَا"
    }
  ],
  "zemahseri": {
    "hakikat": "جشمت الأمر، وتجشمته: تكلفته على مشقة. وألقى عليه جشمه أي كلفته وثقله، وروي بضم الجيم. وقال العجاج:\nيدق إبزيم الحزام جشمه\nأراد جوفه المنتفخ، سماه جشماً لثقله. وجشمتك ما أتعبك. وقال المرقش:\nألم تر أن المرء يجذم كفه ... ويجشم من أجل الصديق المجاشما",
    "mecaz_var": false
  },
