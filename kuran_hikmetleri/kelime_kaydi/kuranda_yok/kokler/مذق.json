  "mekayis": [
    {
      "baslik": "مَذَقَ",
      "metin": "(مَذَقَ) الْمِيمُ وَالذَّالُ وَالْقَافُ أَصْلٌ يَدُلُّ عَلَى خَلْطِ شَيْءٍ لَا عَلَى جِهَةِ النَّصَاحَةِ.\nمِنْ ذَلِكَ مَذَقَ اللَّبَنَ بِالْمَاءِ، وَإِنَّمَا يُرَادُ بِذَلِكَ تَكْثِيرُهُ. وَاشْتُقَّ مِنْهُ الْمَذَّاقُ: الَّذِي يَمْذُقُ الْوُدَّ بِمَلَلٍ يَكُونُ فِيهِ. وَالْمَذْقُ: اللَّبَنُ الْمَمْزُوجُ أَيْضًا، وَكَذَا الْمَذِيقُ."
    }
  ],
  "zemahseri": {
    "hakikat": "مذق اللبن بالماء يمذقه، ومذق الشراب: مزجه فأكثر ماءه، ولبن مذيق. وسقاني مذقاً ومذقة. قال أعرابي:\nإذا ما أصبنا كل يوم مذيقة ... وخمس تميرات صغار خوانز\nفنحن ملوك الأرض خصباً ونعمةً ... ونحن أسود الغيل عند الهزاهز",
    "mecaz": "فلان يمذق الودّ، وودّه ممذوق، وهو ممذوق الود، وماذقه في الوداد مذاقاً، وهو مماذق في ودّه ومذّاق. وفلان مذّاق: كذاب. قال:\nما وجز معروفك بالرماق ... ولا مؤاخاتك بالمذاق\nما معجّل معروفك بالقليل، أوجز العطيّة: عجّلها.",
    "mecaz_var": true
  },
