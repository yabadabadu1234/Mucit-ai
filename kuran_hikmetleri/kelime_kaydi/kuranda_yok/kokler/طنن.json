  "mekayis": [
    {
      "baslik": "طَنَّ",
      "metin": "(طَنَّ) الطَّاءُ وَالنُّونُ أَصْلٌ يَدُلُّ عَلَى صَوْتٍ. يُقَالُ: طَنَّ الذُّبَابُ طَنِينًا. وَيَقُولُونَ: ضَرَبَ يَدَهُ فَأَطَنَّهَا، كَأَنَّهُ يُرَادُ بِهِ صَوْتُ الْقَطْعِ.\nوَمِمَّا لَيْسَ عِنْدِي عَرَبِيًّا قَوْلُهُمْ لِلْحُزْمَةِ مِنَ الْحَطَبِ وَغَيْرِهِ: طُنٌّ. وَيَقُولُونَ: طَنَّ، إِذَا مَاتَ، وَلَيْسَ بِشَيْءٍ.\n(طَهَ) الطَّاءُ وَالْهَاءُ كَلِمَةٌ وَاحِدَةٌ. يُقَالُ لِلْفَرَسِ السَّرِيعِ: طَهْطَاهٌ.\n(طَأَ) الطَّاءُ وَالْهَمْزَةُ، وَهُوَ يَدُلُّ عَلَى هَبْطِ شَيْءٍ. مِنْ ذَلِكَ قَوْلُهُمْ: طَأْطَأَ رَأْسَهُ. وَهُوَ مَأْخُوذٌ مِنَ الطَّأْطَاءِ، وَهُوَ مُنْهَبَطٌ مِنَ الْأَرْضِ. وَهُوَ فِي قَوْلِ الْكُمَيْتِ."
    }
  ],
  "cebel": {
    "fasil": "الطاء والنون",
    "baslik": "طنن - طنطن",
    "mihveri": "تكتلٌ باكتناز باطن أو أثناءٍ بما هو غَيْرُ صُلْب أو مُصْمت (1)",
    "sesler": "الطاء تعبر عن ضغط تجمع وتمدد والنون تعبر عن امتداد في الباطن، والفصل منهما يعبر عن امتداد لطيف في باطن جرم متجمع كما في الطنّ البدن، وطُنّ القصب. وفي (طين) تزيد الياء التعبير عن الامتداد، ويعبر التركيب عن تجمع أي تماسك الشيء =",
    "tam_metin": "\"الطُنُّ -بالضم: بَدَن الإنسان وغيره، والحُزْمَة من القصب والحطب. والعِدْل من القطن \".\n° المعنى المحوري\nتكتلٌ باكتناز باطن أو أثناءٍ بما هو غَيْرُ صُلْب أو مُصْمت (1)\n__________\n(1) (صوتيًّا): الطاء تعبر عن ضغط تجمع وتمدد والنون تعبر عن امتداد في الباطن، والفصل منهما يعبر عن امتداد لطيف في باطن جرم متجمع كما في الطنّ البدن، وطُنّ القصب. وفي (طين) تزيد الياء التعبير عن الامتداد، ويعبر التركيب عن تجمع أي تماسك الشيء =\n(3/1357)\nكالبدن وحُزمة القَصَب (غير مصمت) والقُطْن رخو الأثناء. ومنه \"الطنطنة والطنين: صوت نحو الذباب والجبل \" (يملأ الرأس رغم لطفه أي عدم حدته).",
    "fasil_ozeti": "° معنى الفصل المعجمي (طن) : هو اللزوم أو التلازم كتلة كتلازم القصب والحطب في الحزمة، وككتلة البدن -في (طنن)، وكتلازب الطين -في (طين)، وكلزوم الشخص وطنه أي منزله أي الإقامة فيه والعَوْد إليه بعد السعي -في (وطن)."
  },
  "zemahseri": {
    "hakikat": "طن الذباب والبعوض والطست، وطنت أذنه طنيناً، وطنطنت طنطنة، وأطننت الطست.",
    "mecaz": "ضربه فأطن ذراعه، وطنت ذراعه إذا ندرت لأنها تطن عند ذلك، وطنت من العود شظية، وطنت بكرات لي في البرية إذا هامت، وطن ذكرك في البلاد، ولفلان ذكر طنان، وقال قصيدة طنانة، وصوت صوتاً طن له القاع. وفلان لا يقوم بطن نفسه: لمن لا يكفي خويصته. والطن: العلاوة وهي البرواز بين الجوالقين. قال:\nمعترضاً مثل اعتراض الطن\nويقال للحزمة من القصب: الطن أيضاً.",
    "mecaz_var": true
  },
