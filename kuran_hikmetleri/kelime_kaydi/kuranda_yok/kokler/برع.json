  "mekayis": [
    {
      "baslik": "بَرَعَ",
      "metin": "(بَرَعَ) الْبَاءُ وَالرَّاءُ وَالْعَيْنُ أَصْلَانِ: أَحَدُهُمَا التَّطَوُّعُ بِالشَّيْءِ مِنْ غَيْرِ وُجُوبٍ. وَالْآخَرُ التَّبْرِيزُ وَالْفَضْلُ. قَالَ الْخَلِيلُ: تَقُولُ بَرَعَ يَبْرَعُ بُرُوعًا وَبَرَاعَةً، وَهُوَ يَتَبَرَّعُ مِنْ قِبَلِ نَفْسِهِ بِالْعَطَاءِ. وَقَالَتِ الْخَنْسَاءُ:\nجَلَدٌ جَمِيلٌ أَصِيلٌ بَارِعٌ وَرِعٌ ... مَأْوَى الْأَرَامِلِ وَالْأَيْتَامِ وَالْجَارِ\nقَالَ: وَالْبَارِعُ: الْأَصِيلُ الْجَيِّدُ الرَّأْيِ. وَتَقُولُ: وُهِبَتْ لِلْإِنْسَانِ نَتْيَاءُ تَبَرُّعًا: إِذَا لَمْ يَطْلُبْ."
    }
  ],
  "zemahseri": {
    "hakikat": "برع الجبل وفرعه: علاه. وكل مشرف بارع، وفارع. وبرع أصحابه في علمه. وما رأيت أبرع منه ولا أبدع منه، وكانت رابعة امرأة بارعة. وقال:\nمحت الأقارب والأكفاء بارعة ... من المكارم لا تمتاحها القلب\nوفعل ذلك تبرعاً من غير طلب إليه، كأنه يتكلف البراعة فيه والكرم.",
    "mecaz_var": false
  },
