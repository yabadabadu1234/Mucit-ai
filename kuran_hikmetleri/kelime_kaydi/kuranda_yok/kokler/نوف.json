  "mekayis": [
    {
      "baslik": "نَوَفَ",
      "metin": "(نَوَفَ) النُّونُ وَالْوَاوُ وَالْفَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى عُلُوٍّ وَارْتِفَاعٍ. وَنَافَ يَنُوفُ: طَالَ وَارْتَفَعَ. وَالنَّوْفُ: السَّنَامُ، وَجَمْعُهُ أَنْوَافٌ. وَمُمْكِنٌ أَنْ يَكُونَ قَوْلَهُمْ: مِائَةٌ وَنَيِّفٌ مِنْ هَذَا، وَقَدْ ذَكَرْنَاهُ فِي نَيَفَ لِلَفْظِهِ."
    }
  ],
  "zemahseri": {
    "hakikat": "جبل منيف، وقد أناف إذا ارتفع. وأناف عليه: أشرف. وأنافوا على مائة ونيّفوا. وأنافت هذه الدراهم على ألف ونيّفت، وهي ألف ونيّف. وهذا الحبل نيّف على هذا. قال ابن الرّقاع:\nولدت برابيةٍ رأسها ... على كلّ رابية نيّف\nوجبل عالي المناف أي المرتقى، ومنه: عبد منافٍ. وجمل وناقة نيافٌ.",
    "mecaz": "له عزّ منيف. وامرأ منيفة: تامّةٌ.",
    "mecaz_var": true
  },
