  "mekayis": [
    {
      "baslik": "جَوَيَ",
      "metin": "(جَوَيَ) الْجِيمُ وَالْوَاوُ وَالْيَاءُ أَصْلٌ يَدُلُّ عَلَى كَرَاهَةِ الشَّيْءِ. يُقَالُ اجْتَوَيْتُ الْبِلَادَ، إِذَا كَرِهْتَهَا وَإِنْ كُنْتَ فِي نَعْمَةٍ، وَجَوِيتُ. قَالَ:\nبَشِمْتُ بِنِيِّهَا وَجَوِيتُ عَنْهَا ... وَعِنْدِي لَوْ أَرَدْتُ لَهَا دَوَاءُ\nوَمِنْ هَذَا الْجَوَى، وَهُوَ دَاءُ الْقَلْبِ. فَأَمَّا الْجِوَاءُ فَهِيَ الْأَرْضُ الْوَاسِعَةُ، وَهِيَ شَاذَّةٌ عَنِ الْأَصْلِ الَّذِي ذَكَرْنَاهُ."
    }
  ],
  "zemahseri": {
    "hakikat": "جويت عن كذا، وأصابني جوّي وهو داء في الجوف لا يستمرأ منه الطعام، واجتويت الطعام واستجويته. واجتوينا أرضكم: لم يوافقنا غذارها. وفي الحديث: \" دخل العرنيون المدينة فاجتووها \" ونزلنا في جواء بني فلان وهي فجوة في محلتهم وسط البيوت، وقيل هو جمع الجو وهو الهجل. وأقمت في جو اليمامة أي في وسطها.",
    "mecaz": "اجتوى القوم إذا أبغضهم. قال:\nلقد جعلت أكبادنا تجثويكم ... كمتا تجتوي سوق العضاه الكرازنا\nوماء جوي: منتن، ومياه جوىً لأنه وصف بالمصدر. قال:\nثم كان المزاج ماء سماء ... لا جوًى آجنٌ ولا مطروق",
    "mecaz_var": true
  },
