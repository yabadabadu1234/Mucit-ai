  "mekayis": [
    {
      "baslik": "رَنَمَ",
      "metin": "(رَنَمَ) الرَّاءُ وَالنُّونُ وَالْمِيمُ أُصَيْلٌ صَحِيحٌ فِي الْأَصْوَاتِ. يُقَالُ تَرَنَّمَ، إِذَا رَجَّعَ صَوْتَهُ. وَتَرَنَّمَ الطَّائِرُ فِي هَدِيرِهِ. وَتَرَنَّمَتِ الْقَوْسُ، شُبِّهَ صَوْتُهَا عِنْدَ الْإِنْبَاضِ عَنْهَا بِالتَّرَنُّمِ. قَالَ الشَّمَّاخُ:\nإِذَا أَنْبَضَ الرَّامُونَ عَنْهَا تَرَنَّمَتْ ... تَرَنُّمَ ثَكْلَى أَوْجَعَتْهَا الْجَنَائِزُ\n[بَابُ الرَّاءِ وَالْهَاءِ وَمَا يَثْلُثُهُمَا]"
    }
  ],
  "zemahseri": {
    "hakikat": "ترنم المغني ورنّم ورنم رنماً: رجع صوته، وسمعت له رنيماً ورنمة حسنة وترنماً وترنيماً. وترنم الطائر في هديره. وفي صوت المكاء ترنيم.",
    "mecaz": "ترنمت القوس. قال الشماخ:\nإذا أنبض الرامون عنها ترنمت ... ترنّم ثكلى أوجعتها الجنائز\nوعود رنم. قال علقمة:\nقد أشهد الشرب فيهم مزهر رنيم ... والقوم تصرعهم صهباء خرطوم\nوتقول: نقرته بعنمه، فأنطقته برنمه.",
    "mecaz_var": true
  },
