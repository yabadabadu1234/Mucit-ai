  "mekayis": [
    {
      "baslik": "رَصَنَ",
      "metin": "(رَصَنَ) الرَّاءُ وَالصَّادُ وَالنُّونُ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى ثَبَاتٍ وَكَمَالٍ وَإِحْكَامٍ. تَقُولُ: شَيْءٌ رَصِينٌ، أَيْ شَدِيدٌ ثَابِتٌ. وَقَدْ رَصُنَ رَصَانَةً، وَأَرْصَنْتُهُ أَنَا. وَحَكَى نَاسٌ: فُلَانٌ رَصِينٌ بِحَاجَتِكَ، أَيْ حَفِيٌّ. وَيُقَالُ رَصَنْتُ الشَّيْءَ: أَكْمَلْتُهُ. وَقَالَ أَبُو زَيْدٍ: رَصَنْتُ الشَّيْءَ مَعْرِفَةً. وَالرَّصِينَانِ فِي رُكْبَةِ الْفُرْسِ: أَطْرَافُ الْقَصَبِ الْمُرَكَّبِ فِي رَضَْفَةِ الْفَرَسِ.\nوَمِمَّا شَذَّ عَنِ الْبَابِ قَوْلُهُمْ: هُوَ رَصِينُ الْجَوْفِ، أَيْ مُوجَعُ الْجَوْفِ. قَالَ:\nتَقُولُ إِنِّي رَصِينُ الْجَوْفِ فَاسْقُونِي\nوَيَقُولُونَ: رَصَنَهُ بِلِسَانِهِ رَصْنًا، أَيْ شَتَمَهُ. وَفِيهِ نَظَرٌ."
    }
  ],
  "zemahseri": {
    "hakikat": "رصن البناء وغيره رصانة فهو رصين، ورصن فهو مرصون، وأرصن فهو مرصن. وتقول: هذه درع رصينة حصينة.",
    "mecaz": "له رأي رصين، وكلام متين رصين. وهو رصين الرأي. وسمعتهم يقولون: رصّن لي\nهذا الخبر بمعنى حققه. وإذا عملت عملاً فأرصنه وأتقنه.",
    "mecaz_var": true
  },
