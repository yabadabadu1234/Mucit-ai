  "mekayis": [
    {
      "baslik": "دَغَلَ",
      "metin": "(دَغَلَ) الدَّالُ وَالْغَيْنُ وَاللَّامُ أَصْلٌ يَدُلُّ عَلَى الْتِبَاسٍ وَالْتِوَاءٍ مِنْ شَيْئَيْنِ يَتَدَاخَلَانِ. مِنْ ذَلِكَ الدَّغَلُ، وَهُوَ الشَّجَرُ الْمُلْتَفُّ. وَمِنْهُ الدَّغَلُ فِي الشَّيْءِ، وَهُوَ الْفَسَادُ. وَيَقُولُونَ: أَدْغَلَ فِي الْأَمْرِ، إِذَا أَدْخَلَ فِيهِ مَا يُخَالِفُهُ."
    }
  ],
  "zemahseri": {
    "hakikat": "دخل في الدّغل: وهو نحو الغيل والشجر الملتف الذي يتوارى فيه للختل والغيلة. قال الكميت يصف حاله:\nلا عين نارك عن سار مغمضة ... ولا محلتك الطيطاء والدغل\nالمكان الذي طوطيء أي خفض. وقال:\nإنّا إذا ما أعيت القوم الحبل ... تنسلّ في ظلمة ليل ودغل\nومنه قولهم: اندسوا في مداغل وهي بطون الأودية إذا كثر شجرها والتف. ودغلت الأرض دغلاً: صارت ذات دغل. ودغل القانص: دخل في مكان خفيّ لختل الصيد.",
    "mecaz": "اتخذوا الباطل دغلاً، ومنه دغل فلان، وفيه دغل أي فساد وريبة. وهو دغل نغل، وإذا دخل مدخل مريب قيل: دغل فيه، تشبيهاً بالقانص الذي يدغل لختل القنص. وأدغل في الأمر: أدخل فيه ما يفسده. وعاد فلان لدغاوله وهي غوائله.",
    "mecaz_var": true
  },
