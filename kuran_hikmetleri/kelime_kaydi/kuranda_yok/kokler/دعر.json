  "mekayis": [
    {
      "baslik": "دَعَرَ",
      "metin": "(دَعَرَ) الدَّالُ وَالْعَيْنُ وَالرَّاءُ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى كَرَاهَةٍ وَأَذًى، وَأَصْلُهُ الدُّخَانُ; يُقَالُ عُودٌ دَعِرٌ، إِذَا كَانَ كَثِيرَ الدُّخَانِ. قَالَ ابْنُ مُقْبِلٍ:\nبَاتَتْ حَوَاطِبُ لَيْلَى يَلْتَمِسْنَ لَهَا ... جَزْلَ الْجِذَى غَيْرَ خَوَّارٍ وَلَا دَعِرِ\nوَمِنْ ذَلِكَ اشْتِقَاقُ الدَّعَارَةِ فِي الْخُلُقِ. وَالدَّعَرُ: الْفَسَادُ. وَالزَّنْدُ الْأَدْعَرُ: الَّذِي قُدِحَ بِهِ مِرَارًا فَاحْتَرَقَ طَرَفُهُ فَصَارَ لَا يُورِي. وَدَاعِرٌ: فَحْلٌ تُنْسَبُ إِلَيْهِ الدَّاعِرِيَّةُ."
    }
  ],
  "zemahseri": {
    "hakikat": "رجل داعر: خبيث فاجر، وفيه دعارة. وتقول: فلان داعر، في كل فتنة ناعر؛ وعود دعر: كثير الدخان. قال:\nأقبلن من بطن قلاب بسحر ... يحملن فحماً جيّداً غير دعر\nأسود صلاّلاً كأعيان البقر",
    "mecaz_var": false
  },
