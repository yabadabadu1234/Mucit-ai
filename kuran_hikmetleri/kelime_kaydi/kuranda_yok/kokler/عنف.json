  "mekayis": [
    {
      "baslik": "عَنُفَ",
      "metin": "(عَنُفَ) الْعَيْنُ وَالنُّونُ وَالْفَاءُ أَصْلٌ صَحِيحٌ يَدُلُّ عَلَى خِلَافِ الرِّفْقِ. قَالَ الْخَلِيلُ: الْعُنْفُ: ضِدُّ الرِّفْقِ. تَقُولُ عَنُفَ يَعْنُفُ عُنْفًا فَهُوَ عَنِيفٌ، إِذَا لَمْ يَرْفُقُ فِي أَمْرِهِ. وَأَعْنَفْتُهُ أَنَا. وَيُقَالُ: اعْتَنَفْتَ الشَّيْءَ، إِذَا كَرِهْتَهُ وَوَجَدْتَ لَهُ عُنْفًا عَلَيْكَ وَمَشَقَّةً. وَمِنَ الْبَابِ: التَّعْنِيفُ، وَهُوَ التَّشْدِيدُ فِي اللَّوْمِ. فَأَمَّا الْعُنْفُوَانُ فَأَوَّلُ الشَّيْءِ، يُقَالُ عُنْفُوَانُ الشَّبَابِ، وَهُوَ أَوَّلُهُ، فَهَذَا لَيْسَ مِنَ الْأَوَّلِ، إِنَّمَا هَذَا مِنْ بَابِ الْإِبْدَالِ، وَهُوَ أَنَّ الْعَيْنَ مُبْدَلَةٌ مِنْ هَمْزَةٍ، وَالْأَصْلُ الْأَنْفُ; وَأَنْفُ كُلِّ شَيْءٍ: أَوَّلُهُ. قَالَ:\nمَاذَا تَقُولُ بِنْتَهَا تَلَمَّسُ ... وَقَدْ دَعَاهَا الْعُنْفُوَانُ الْمُخْلِسُ\nوَقَالَ آخَرُ:\nتَلُومُ امْرَأً فِي عُنْفُوَانِ شَبَابِهِ ... وَتَتْرُكُ أَشْيَاعَ الضَّلَالِ تَحَيَّنُ"
    }
  ],
  "zemahseri": {
    "hakikat": "ساق عنيف، وقد عنف به وعليه وعنّفه: لامه وعيّره. ومنه قول سيبويه: لم أعنّفه. وقال طفيل:\nفأصبحت قد عنفت بالجهل أهله ... وعرّيَ أفراس الصبا ورواحله\nوكان ذلك في عنفوان شبابه وأنفوانه. واعتنف الشيء وائتنفه بمعنًى. وتقول: هو في عنفوان أمره، وعنفوان عمره. وتقول: لعنت لحية المنافق، وعنفقته شر العنافق. وقال ذو الرمة:\nتظل ذرى نخل امريء القيس نسوةً ... قباحاً وأشياخاً لئام العنافق",
    "mecaz_var": false
  },
