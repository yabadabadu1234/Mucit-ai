  "mekayis": [
    {
      "baslik": "رَنَّ",
      "metin": "(رَنَّ) الرَّاءُ وَالنُّونُ أَصْلٌ وَاحِدٌ يَدُلُّ عَلَى صَوْتٍ. فَالْإِرْنَانُ: الصَّوْتُ وَالرَّنَّةُ وَالرَّنِينُ: صَيْحَةُ ذِي الْحُزْنِ. وَيُقَالُ أَرَنَّتِ الْقَوْسُ عِنْدَ إِنْبَاضِ الرَّامِي عَنْهَا. قَالَ:\nتُرِنُّ إِرْنَانًا إِذَا مَا أَنْضَبَا\nأَيْ أَنْبَضَ. وَالْمِرْنَانُ: الْقَوْسُ; لِأَنَّ لَهَا رَنِينًا. وَيُقَالُ إِنَّ الرَّنَنَ دُوَيْبَّةٌ تَكُونُ فِي الْمَاءِ تَصِيحُ أَيَّامَ الصَّيْفِ. قَالَ:\nوَلَا الْيَمَامُ وَلَمْ يَصْدَحْ لَهُ الرَّنَنُ\nفَهَذَا مُعْظَمُ الْبَابِ، وَهُوَ قِيَاسٌ مُطَّرِدٌ. وَحُكِيَتْ كَلِمَةٌ مَا أَدْرِي مَا هِيَ، وَهِيَ شَاذَّةٌ إِنْ صَحَّتْ، وَلَمْ أَسْمَعْهَا سَمَاعًا. قَالُوا: كَانَ يُقَالُ لِجُمَادَى الْأُولَى رُنَّى، بِوَزْنِ حُبْلَى. وَهَذَا مِمَّا لَا يَنْبَغِي أَنْ يُعَوَّلَ عَلَيْهِ."
    }
  ],
  "cebel": {
    "fasil": "الراء والنون",
    "baslik": "رنن",
    "mihveri": "صوت حادّ أو مؤثر يصدر عن حيّ أو غيره (1) كتلك الأصوات المختلفة من مصادرها (رنين المرأة هو صراخها عند المصيبة) وفي سامعها.",
    "tam_metin": "\"الرَنَّة - بالفتح: الصيحة الحزينة. والرَنَّة والرَنين والإرْنان: الصيحة الشديدة والصوت الحزين عند الغناء أو البكاء. أطيارٌ مُرِنّة. وأرنّت القوس في إنباضها، والمرأة في نَوْحها، والحمامةُ في سَجْعها، والحمارُ في نهيقه، والسحابةُ في رَعْدها، والماءُ في خريره \".\n° المعنى المحوري\nصوت حادّ أو مؤثر يصدر عن حيّ أو غيره (1) كتلك الأصوات المختلفة من مصادرها (رنين المرأة هو صراخها عند المصيبة) وفي سامعها.",
    "fasil_ozeti": "° معنى الفصل المعجمي (رن): مادة تغطي على الحس وتمنع النفاذ - كالصوت الشديد - في (رنن)، فإنه يمنع الأذن أي يحجبها عن سماع غيره، وكالصدأ الذي يعلو السيف والمرآة - في (رين) فيحجب جوهرهما ويعوق عملهما."
  },
  "zemahseri": {
    "hakikat": "سمعت له رنة ورنيناً: صبحة حزينة، وقد رنّ وأرنّ.",
    "mecaz": "أرنت القوس والسحابة، وقوس وسحابة مرنان. وعود ذو رنة.\nر ن\nورنا إليه ورنا له رنواً: أدام إليه النظر وظل رانياً إليه. وكأس رنوناة: دائمة. قال ابن أحمر:\nمدت عليه الملك أطنابه ... كأس رنوناة وطرف طمز\nومن المجاز: حدّثني فرنوت إلى حديثه. ورنوت عنه: تغافلت. وأسأل الله أن يرنيكم إلى الطاعة أي يصيّركم تسكنون إليها لا إلى غيرها. وله شرف يراني الكواكب، سمعته من العرب.",
    "mecaz_var": true
  },
