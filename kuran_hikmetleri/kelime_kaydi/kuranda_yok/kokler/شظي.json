  "mekayis": [
    {
      "baslik": "شَظِيَ",
      "metin": "(شَظِيَ) الشِّينُ وَالظَّاءُ وَالْحَرْفُ الْمُعْتَلُّ أَصْلٌ يَدُلُّ عَلَى تَصَدُّعِ الشَّيْءِ مِنْ مَوَاضِعَ كَثِيرَةٍ، حَتَّى يَصِيرَ صُدُوعًا مُتَفَرِّقَةً، مِنْ ذَلِكَ الشَّظِيَّةُ مِنَ الشَّيْءِ: الْفِلْقَةُ. يُقَالُ تَشَظَّتِ الْعَصَا، إِذَا كَانَتْ فِلَقًا. قَالَتْ فَرْوَةُ بِنْتُ [أَبَانَ بْنِ] عَبْدِ الْمَدَانِ:\nيَا مَنْ أَحَسَّ بُنَيَّيَّ اللَّذَيْنِ هُمَا ... كَالدُّرَّتَيْنِ تَشَظَّى عَنْهُمَا الصَّدَفُ\n[بَابُ الشِّينِ وَالْعَيْنِ وَمَا يَثْلُثُهُمَا]"
    }
  ],
  "zemahseri": {
    "hakikat": "فرس سليم الشظى وهو عظيم لازق بالوظيف، وشظى الفرس: دوى شظاه. وطارت شظية من عود أو قصبة أو عظم: شقة، وتشظى العود: تشقق، وشظيته. قال أبو النجم:\nسمر تشظى جندل الإكام\nوفي الحديث \" لما أراد الله أن يخلق لإبليس نسلاً وزوجة ألقى عليه الغضب فطارت منه شظية من نار فخلق منها امرأته \".",
    "mecaz": "تشظى القوم: تفرقوا. وقال الطرماح:\nتتشظى عنه الضراء فما ... تثبت أغماره ولا صيده أي الكلاب عن الثور. وشظيتهم. قال:\nوردهم عن لعلع وبارق ... ضرب يشظيهم عن الخنادق\nوتشظى الصدف عن اللؤلؤ. قالت:\nيا من أحسّ بنيّ اللذين هما ... كالدرّتين تشظّى عنهما الصدف",
    "mecaz_var": true
  },
