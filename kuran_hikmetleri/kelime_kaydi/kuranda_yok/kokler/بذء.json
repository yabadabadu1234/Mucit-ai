  "mekayis": [
    {
      "baslik": "بَذَأَ",
      "metin": "(بَذَأَ) الْبَاءُ وَالذَّالُ وَالْهَمْزَةُ أَصْلٌ وَاحِدٌ، وَهُوَ خُرُوجُ الشَّيْءِ عَنْ طَرِيقَةِ الْإِحْمَادِ، تَقُولُ: هُوَ بَذِيءُ اللِّسَانِ، وَقَدْ بَذَأْتُ عَلَى فُلَانٍ أَبْذَأُ بُذَاءً. وَيُقَالُ: بَذَأْتُ الْمَكَانَ أَبْذَؤُهُ: إِذَا أَتَيْتَهُ فَلَمْ تُحْمِدْهُ."
    }
  ],
  "zemahseri": {
    "hakikat": "فلان بذيء اللسان، وقد بذؤ علي وبذأ بذاءة وبذاء. وبذىء فلان: عيب وازدرى. وسألته عن رجل فبذأه. وقد أبذأت يا رجل أي جئت بالبذاء، كما تقول أفحشت وأقدعت. وباذأني فلان فبذأني. وبينهم مباذأة: مفاحشة. قال ابن مقبل:\nهل كنت إلا مجناً تتقون به ... قد لاح في عرض من باذاكم علبي",
    "mecaz": "بذأت عيني فلاناً: ازدرته ولم تقبله. ووصفت لي أرض بني فلان فأبصرتها فما بذأتها عيني.",
    "mecaz_var": true
  },
