  "mekayis": [
    {
      "baslik": "سَمَِتَ",
      "metin": "(سَمَِتَ) السِّينُ وَالْمِيمُ وَالتَّاءُ أَصْلٌ يَدُلُّ عَلَى نَهْجٍ وَقَصْدٍ وَطَرِيقَةٍ. يُقَالُ سَمَتَ، إِذَا أَخَذَ النَّهْجَ. وَكَانَ بَعْضُهُمْ يَقُولُ: السَّمْتُ: السَّيْرُ بِالظَّنِّ وَالْحَدْسِ. وَهُوَ قَوْلُ الْقَائِلِ:\nلَيْسَ بِهَا رُبْعٌ لِسَمْتِ السَّامِتِ\nوَيُقَالُ إِنَّ فُلَانًا لَحَسَنُ السَّمْتِ، إِذَا كَانَ مُسْتَقِيمَ الطَّرِيقَةِ مُتَحَرِّيًا لِفِعْلِ الْخَيْرِ. وَالْفِعْلُ مِنْهُ سَمَتَ. وَيُقَالُ سَمَتَ سَمْتَهُ، إِذَا قَصَدَ قَصْدَهُ."
    }
  ],
  "zemahseri": {
    "hakikat": "خذ في هذا السمت وهو النحو والطريق، وما أحسن سمته، وقد سمت نحوه يسمت سمتاً.\nقال:\nخواضع بالركبان خوضاً عيونها ... وهن إلى البيت العتيق سوامت\nوسامته مسامتة. وتسمته: تعمده وقصد نحوه. وسمت على الشيء: ذكر اسم الله تعالى عليه. وسمت العاطس.",
    "mecaz_var": false
  },
