  "mekayis": [
    {
      "baslik": "غَشَّ",
      "metin": "(غَشَّ) الْغَيْنُ وَالشِّينُ أُصُولٌ تَدُلُّ عَلَى ضَعْفٍ فِي الشَّيْءِ وَاسْتِعْجَالٍ فِيهِ. مِنْ ذَلِكَ الْغِشُّ. وَيَقُولُونَ: الْغِشُّ: أَلَّا تَمْحَضَ النَّصِيحَةُ. وَشُرْبٌ غِشَاشٌ: قَلِيلٌ. وَمَا نَامَ إِلَّا غِشَاشًا، أَيْ قَلِيلًا، وَلَقِيتُهُ غِشَاشًا، وَذَلِكَ عِنْدَ مُغَيْرِبَانِ الشَّمْسِ."
    }
  ],
  "cebel": {
    "fasil": "الغين والشين",
    "baslik": "غشش",
    "mihveri": "شَوْب الصافي الرقيق بما ينتشر فيه ويجعله كثيفًا بحيث يُغَطّي ما تحته (1): كما تشوب الظُلْمة الضوءَ، والطينُ ونحوه الماءَ الكَدِر.",
    "tam_metin": "\"الغِشَاش - ككتاب: أولُ الظلمة، وآخرُها. والغشش -محركة: المَشْرَب الكِدر \".\n° المعنى المحوري\nشَوْب الصافي الرقيق بما ينتشر فيه ويجعله كثيفًا بحيث يُغَطّي ما تحته (1): كما تشوب الظُلْمة الضوءَ، والطينُ ونحوه الماءَ الكَدِر.",
    "fasil_ozeti": "° معنى الفصل المعجمي (غش) : هو عدم صفاء الشيء أي شَوْبه أو خلطه بما يجعله كثيفًا يغطي ما تحته: كالغِشاش أول الظلمة وآخرها حيث تخالط كثافة الظلمة شفافيةَ النور -في (غشش)، وكغاشية السَرْج والغِشاء: الغطاء فإنه طبقة تكثُفُ على الشيء فتخفيه أو تكاد: في (غشو/ غشى)."
  },
  "zemahseri": {
    "hakikat": "ما نصحت أحداً إلا استغشني واغتشني.\nقال:\nألا ربّ من تغتشه لك ناصح ... ومؤتمن بالغيب غير أمين\nوقال أبو النجم:\nفظل من عرفان نؤيٍ ناحل ... من الأسى يغتشّ نصح القائل\nورجل غاش من قوم غششة وغشّاشة، وتقول: ما هم إلا قوم غشّاشه، أيديهم بالخيانة رشّاشه. وطعام فلان مغشوش، أعلاه يابس وأسفله مرشوش. وما لقيته إلا غشاشاً وعلى غشاش، وكنت على حدّ غشاش وهو العجلة. وجاؤا مغاشّين للصبح: مبادرين له. قال:\nيكون نزول القوم فيها كلا ولا ... غشاشاً ولا يدنون رحلاً إلى رحل",
    "mecaz_var": false
  },
