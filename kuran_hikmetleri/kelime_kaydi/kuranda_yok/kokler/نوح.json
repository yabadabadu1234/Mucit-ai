  "vikisozluk_etimolojiler": [
    {
      "metin": "From Classical Syriac ܢܝܚܬܐ (nəyāḥtā, “quiet; rest”) in the sense of a feast of the Eucharist as a memorial service for the dead. The specific sense of lamentation is influenced by Arabic ناح (nāḥ), which is related to Classical Syriac ܐܢܚ from ܐ ܢ ܚ , meaning to wail or lament.",
      "kognatlar": [
