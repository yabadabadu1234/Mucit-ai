  "mekayis": [
    {
      "baslik": "غَنَّ",
      "metin": "(غَنَّ) الْغَيْنُ وَالنُّونُ أُصَيْلٌ صَحِيحٌ، وَهُوَ يَدُلُّ عَلَى صَوْتٍ كَأَنَّهُ غَيْرُ مَفْهُومٍ، إِمَّا لِاخْتِلَاطِهِ، وَإِمَّا لِعِلَّةٍ تُصَاحِبُهُ. مِنْ ذَلِكَ قَوْلُهُمْ: قَرْيَةٌ غَنَّاءُ، يُرَادُ بِذَلِكَ تَجَمُّعُ أَصْوَاتِهِمْ وَاخْتِلَاطُ جَلَبَتِهِمْ. وَوَادٍ أَغَنُّ: مُلْتَفُّ النَّبَاتِ، فَتَرَى الرِّيحَ تَجْرِي فِيهِ وَلَهَا غُنَّةٌ ; وَيَكُونُ ذَلِكَ مِنْ كَثْرَةِ ذُبَابِهِ. وَمِنْهُ الْغُنَّةُ فِي الرَّجُلِ الْأَغَنِّ، وَهُوَ خُرُوجُ كَلَامِهِ كَأَنَّهُ بِأَنْفِهِ."
    }
  ],
  "cebel": {
    "fasil": "الغين والنون",
    "baslik": "غنن",
    "mihveri": "امتلاء الظرف أو المكان أي ازدحامه بلطيف يظهر وجوده (1): كالروضة والقرية والوادي والقِربة بما فيهن.",
    "tam_metin": "\"رَوْضة وأرض غَنَّاء: الْتَجَّ عُشْبُها واعْتَم/ تَمرُّ الريح فيها غَيْرَ صافية\n(3/1610)\nالصوت من كثافة عشبها والتفافه. وقَرية غنّاء: كثيرة الأهل والبنيان والعشب. وغَنّ الوادي وأَغَنّ: كثُر شَجَره. وأغَنّ السقاءُ: امتلأ ماء \".\n° المعنى المحوري\nامتلاء الظرف أو المكان أي ازدحامه بلطيف يظهر وجوده (1): كالروضة والقرية والوادي والقِربة بما فيهن.",
    "fasil_ozeti": "° معنى الفصل المعجمي (غن) : هو وجود لطيف في الحوزة: كما في الروضة الغنّاء سواء من الشجر والعشب، ومن النسيم العليل والمختلط بصوت حفيف الريح في الشجر -في (غنن)، وكوفرة المحتاج إليه من مال ومتاع، وما تتميز به حنجرة المغني من صوت رخيم -في (غنى)، وكالغُنْم والغَنَم في الحوزة مع ما ذكرنا من سعة جدواها مع يسر مئونتها -في (غنم). * * *"
  },
  "zemahseri": {
    "hakikat": "الظبي أغنّ: لأن في ترنينه غنّة وهي ترخيم في صوته من نحو الخياشيم بعون من نفس الأنف، والنون أشدّ الحروف غنّة.",
    "mecaz": "وادٍ أغنّ، وروضة غنّاء: لطنين الذّبّان أو لحفيف الريح في خلاله. وغشب مغنذ خجلٌ، وقد أغنّ. قال:\nوما قاع تغنّ به الخزامىبه الجثجاث يندى والعرار وقرية غنّاء: كثيرة الأهل. وتقول: عنّت لنا روضة غنّاء، للذبان فيها غناء.",
    "mecaz_var": true
  },
