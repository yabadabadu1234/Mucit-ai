  "mekayis": [
    {
      "baslik": "شَذَّ",
      "metin": "(شَذَّ) الشِّينُ وَالذَّالُ يَدُلُّ عَلَى الِانْفِرَادِ وَالْمُفَارَقَةِ. شَذَّ الشَّيْءُ يَشِذُّ شُذُوذًا. وَشُذَّاذُ النَّاسِ: الَّذِينَ يَكُونُونَ فِي الْقَوْمِ وَلَيْسُوا مِنْ قَبَائِلِهِمْ وَلَا مَنَازِلِهِمْ. وَشُذَّانُ الْحَصَى: الْمُتَفَرِّقُ مِنْهُ. قَالَ امْرُؤُ الْقَيْسِ:\nتُطَايِرُ شُذَّانَ الْحَصَى بِمَنَاسِمٍ ... صِلَابِ الْعُجَى مَلْثُومُهَا غَيْرُ أَمْعَرَا"
    }
  ],
  "zemahseri": {
    "hakikat": "شذ عن الجماعة شذوذاَ: انفرد عنهم. وهو من شذاذ القوم: من الذين هم فيهم وليسوا منهم. وجاءني شذان الناس: متفرقوهم.",
    "mecaz": "هو شاذ عن القياس. وهذا مما شذ عن الأصول. وكلمة شاذة. وأصابه شذان الحصى: ما تفرق منه.",
    "mecaz_var": true
  },
