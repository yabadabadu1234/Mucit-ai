      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "نفسها وأوّلها. قال ذو الرمة:",
        "prototipe_benzerlik": 0.666,
        "halka": "yakın"
      },
      {
        "kaynak": "Zemahşerî mecaz kolu",
        "metin": "بجرعاء دهناوية التّرب طيّب ... بها نسم الأرواح من كل منسم",
