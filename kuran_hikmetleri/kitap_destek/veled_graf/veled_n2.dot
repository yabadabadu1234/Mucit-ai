n1 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.4583 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kökün çekirdeği bir şeyin kendi varlığından<BR ALIGN="LEFT"/>başka bir varlık çıkarmasıdır: doğurmak.<BR ALIGN="LEFT"/></FONT>> pos="173.50,1314.00!"];
n2 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8194 height=0.7778 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kamus bunu tek cümleyle çerçeveler: veled,<BR ALIGN="LEFT"/>«insânın ve sâir hayvânın bi-nefsihî ve bi-<BR ALIGN="LEFT"/>hakîkatihî zâdesi»dir; yani doğuşla gelen, kendi<BR ALIGN="LEFT"/>özünden çıkan yavru.<BR ALIGN="LEFT"/></FONT>> pos="173.50,1252.00!"];
n3 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5000 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Aynı lügat bir sınır da çizer: tebennî ve<BR ALIGN="LEFT"/>ittihâz yoluyla, yani evlât edinilerek gelene<BR ALIGN="LEFT"/>veled denmez.<BR ALIGN="LEFT"/></FONT>> pos="173.50,1186.00!"];
n4 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.2917 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Bu tek sınır, kökün bütün mantığını açar.<BR ALIGN="LEFT"/></FONT>> pos="173.50,1130.00!"];
n5 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.4028 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Veled bir köken ilişkisidir (özden çıkış), bir<BR ALIGN="LEFT"/>sahiplenme ilişkisi değildir.<BR ALIGN="LEFT"/></FONT>> pos="173.50,1078.00!"];
n6 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.3750 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Mantık zinciri: çıkış → çıkan → çıkışın yeri,<BR ALIGN="LEFT"/>zamanı, vasıtası.<BR ALIGN="LEFT"/></FONT>> pos="197.50,928.00!"];
n7 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.7222 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kök bir fiil olan doğurmaktan başlar ve her<BR ALIGN="LEFT"/>halka, aynı olayın başka bir yüzünü adlandırır:<BR ALIGN="LEFT"/></FONT>> pos="197.50,876.00!"];
n8 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.6667 height=0.9444 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğuran: vâlid (baba, doğuran taraf), vâlide<BR ALIGN="LEFT"/>(anne). İkisi birlikte vâlidân olur; Kamus bunu<BR ALIGN="LEFT"/>«tağlîb» diye anar: erkek lafız kadını da<BR ALIGN="LEFT"/>kapsar, tıpkı «iki ay»ın güneşi de kapsaması<BR ALIGN="LEFT"/>gibi. Kur&#x27;ân&#x27;daki vâlideyn (2:83) bu kalıptır.<BR ALIGN="LEFT"/></FONT>> pos="197.50,784.00!"];
n9 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8333 height=0.7778 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğan: veled (ilk geçişi 2:116), mevlûd (doğan,<BR ALIGN="LEFT"/>2:233). Veled tek ve çoğul için aynıdır; çoğulu<BR ALIGN="LEFT"/>evlâd, vildet, ildet (vâv hemzeye dönmüş) ve<BR ALIGN="LEFT"/>vuld.<BR ALIGN="LEFT"/></FONT>> pos="197.50,706.00!"];
n10 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.3750 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğumun hâli: vilâd, vilâdet, ilâdet, lidet:<BR ALIGN="LEFT"/>doğurma fiilinin masdarları.<BR ALIGN="LEFT"/></FONT>> pos="197.50,644.00!"];
n11 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.4861 height=1.1111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğumun yeri ve zamanı: mevlid. Kamus ve Vankulu<BR ALIGN="LEFT"/>bunu «doğulan yer» diye verir; Osmanlıca lügat<BR ALIGN="LEFT"/>bunu «doğum zamanı» ve «Peygamberimizin doğumunu<BR ALIGN="LEFT"/>anlatan eser» olarak ekler. Yani bir kelime, yer<BR ALIGN="LEFT"/>isminden zaman ismine, oradan bir edebî türe<BR ALIGN="LEFT"/>kaymıştır.<BR ALIGN="LEFT"/></FONT>> pos="197.50,570.00!"];
n12 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5972 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğurganlık: velûd (çok doğuran dişi; çoğulu<BR ALIGN="LEFT"/>vuld): kökün sıfata dönmüş hâli. Kur&#x27;ân&#x27;daki<BR ALIGN="LEFT"/>«doğurmazlar» (71:27) bu damardan gelir.<BR ALIGN="LEFT"/></FONT>> pos="197.50,492.00!"];
n13 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8472 height=1.1111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Yeni doğmuş, genç: velîd (26:18 «seni içimizde<BR ALIGN="LEFT"/>çocukken yetiştirmedik mi?»), çoğulu vildân.<BR ALIGN="LEFT"/>Kur&#x27;ân&#x27;da cennet çocukları «vildân muhalledûn»<BR ALIGN="LEFT"/>(56:17, ölümsüz gençler) ve kıyamet günü saçı<BR ALIGN="LEFT"/>ağartan dehşet «vildâne şîbâ» (73:17) bu<BR ALIGN="LEFT"/>çocukluk anlamını taşır.<BR ALIGN="LEFT"/></FONT>> pos="197.50,414.00!"];
n14 [shape=box style="filled,rounded" fixedsize=true fillcolor="#fbeeb8:#ecd68a" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5278 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Yaşıt: lide (vilde&#x27;nin aslı): aynı zamanda<BR ALIGN="LEFT"/>doğanlar, yani yaşıtlar. Doğumu ortak olan,<BR ALIGN="LEFT"/>zaman bakımından kardeştir.<BR ALIGN="LEFT"/></FONT>> pos="197.50,336.00!"];
n15 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.1250 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Mecaz kolu: doğmak = ortaya çıkmak.<BR ALIGN="LEFT"/></FONT>> pos="197.50,234.00!"];
n16 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8333 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kök, canlı olmayan şeye de geçer: tevellüd «bir<BR ALIGN="LEFT"/>şeyden başka bir şey meydana gelmek»tir<BR ALIGN="LEFT"/>(Osmanlıcada «doğma», «doğum tarihi»).<BR ALIGN="LEFT"/></FONT>> pos="197.50,178.00!"];
n17 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.7917 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Mantık ve kelâm dilinde tevlîd, bir fiilin başka<BR ALIGN="LEFT"/>bir fiili kendiliğinden doğurması demektir (okun<BR ALIGN="LEFT"/>fırlaması gibi).<BR ALIGN="LEFT"/></FONT>> pos="197.50,118.00!"];
n18 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.6528 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Dilcilikte müvelled, Arapça olmayıp sonradan<BR ALIGN="LEFT"/>Arapçaya girmiş ve yerleşmiş kelimedir;<BR ALIGN="LEFT"/>kelimenin de bir «doğuşu» vardır.<BR ALIGN="LEFT"/></FONT>> pos="197.50,58.00!"];
n19 [shape=plain style="" label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#7a7360"><TR><TD BGCOLOR="#d9cfae" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a"><B>Şekil</B></FONT></TD><TD BGCOLOR="#d9cfae" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a"><B>Vezin</B></FONT></TD><TD BGCOLOR="#d9cfae" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a"><B>Mana</B></FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَلَدَ – يَلِدُ</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَعَلَ</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">doğurmak</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَلَد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَعَل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">oğul, çocuk (tek ve çoğul)</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">أَوْلَاد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">أَفْعَال</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">çocuklar</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَالِد / وَالِدَة</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَاعِل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">baba / anne</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَالِدَان</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">tağlîb</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">ana-baba</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مَوْلُود</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مَفْعُول</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">doğan, yeni doğmuş</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَلِيد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَعِيل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">yeni doğmuş çocuk, genç</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وِلْدَان</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فِعْلَان</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">gençler, çocuklar</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَلُود</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَعُول</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">çok doğuran</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وِلَادَة</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فِعَالَة</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">doğurma, doğum</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مَوْلِد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مَفْعِل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">doğum yeri, vakti; mevlit</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">لِدَة</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فِعَة</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">yaşıt</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">تَوَلُّد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">تَفَعُّل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">kendiliğinden meydana gelme</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">وَلَّدَ / تَوْلِيد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">فَعَّلَ</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">doğurtmak, üretmek; ebelik</FONT></TD></TR><TR><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مُوَلَّد</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">مُفَعَّل</FONT></TD><TD BGCOLOR="#f7f3e8" ALIGN="LEFT"><FONT FACE="DejaVu Sans" POINT-SIZE="10" COLOR="#1b232a">sonradan türemiş (kelime, melez)</FONT></TD></TR></TABLE>> pos="556.50,1180.00!"];
n20 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.0000 height=1.2778 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Doğrudan doğum: «ve&#x27;ssalâmu aleyye yevme<BR ALIGN="LEFT"/>vülidtü» (19:33, Îsâ&#x27;nın doğduğu gün esenlik);<BR ALIGN="LEFT"/>«e-elidü ve ene acûzün» (11:72, ben yaşlıyken mi<BR ALIGN="LEFT"/>doğuracağım?); «innemâ ümmehâtühüm illâ&#x27;llâî<BR ALIGN="LEFT"/>veledenehüm» (58:2, anneleri ancak onları<BR ALIGN="LEFT"/>doğuranlardır: zıhâr hükmünün mantığı, annelik<BR ALIGN="LEFT"/>doğumdur, ad vermek değil).<BR ALIGN="LEFT"/></FONT>> pos="567.00,868.00!"];
n21 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.2917 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kamus&#x27;un ayrımı Kur&#x27;ân&#x27;a nasıl bağlanır?<BR ALIGN="LEFT"/></FONT>> pos="897.00,918.00!"];
n22 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.0556 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">«lem yelid ve lem yûled» (112:3) ve<BR ALIGN="LEFT"/>«ittehazallâhü veledâ» (2:116) yan yana okunursa<BR ALIGN="LEFT"/>fark ortaya çıkar.<BR ALIGN="LEFT"/></FONT>> pos="897.00,862.00!"];
n23 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.7083 height=0.9444 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kur&#x27;ân iddiayı iki katmanda reddeder: Allah&#x27;a<BR ALIGN="LEFT"/>hakikî veled olmaz, çünkü veled bi-nefsihî ve<BR ALIGN="LEFT"/>bi-hakîkatihî doğuşla gelir ve doğuş, özden bir<BR ALIGN="LEFT"/>parça çıkarmayı gerektirir (bu, bölünebilen bir<BR ALIGN="LEFT"/>varlığı varsayar).<BR ALIGN="LEFT"/></FONT>> pos="897.00,790.00!"];
n24 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.4861 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">İttihâz (evlât edinme) ise ihtiyaçtan doğar,<BR ALIGN="LEFT"/>yani sahip olmayanın eksikliğini giderir.<BR ALIGN="LEFT"/></FONT>> pos="897.00,722.00!"];
n25 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=2.1250 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">İki yol da O&#x27;na yakışmaz.<BR ALIGN="LEFT"/></FONT>> pos="897.00,670.00!"];
n26 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.3333 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Bu yüzden ayet aynı kökten iki ayrı fiili<BR ALIGN="LEFT"/>(yelid/yûled, ittehaze) birlikte ret konusu<BR ALIGN="LEFT"/>yapar.<BR ALIGN="LEFT"/></FONT>> pos="897.00,614.00!"];
n27 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.4167 height=1.1111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Ana-baba hakkı: «ve bi&#x27;l-vâlideyni ihsânâ»<BR ALIGN="LEFT"/>(2:83, ve 31:14 «ve ve-ssaynâ&#x27;l-insâne bi-<BR ALIGN="LEFT"/>vâlideyhi»); «lâ yeczî vâlidün an veledihî»<BR ALIGN="LEFT"/>(31:33, hiçbir ana-baba çocuğunun yerine<BR ALIGN="LEFT"/>ödeyemez: kıyamette doğuş bağı bile işe<BR ALIGN="LEFT"/>yaramaz).<BR ALIGN="LEFT"/></FONT>> pos="1235.50,874.00!"];
n28 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.2361 height=0.9444 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Evlât imtihandır: «innemâ emvâlüküm ve evlâdüküm<BR ALIGN="LEFT"/>fitne» (8:28, 64:15); «inne min ezvâcikum ve<BR ALIGN="LEFT"/>evlâdikum adüvven lekum» (64:14); «ve şârikhüm<BR ALIGN="LEFT"/>fi&#x27;l-emvâli ve&#x27;l-evlâd» (17:64, şeytanın<BR ALIGN="LEFT"/>ortaklığı).<BR ALIGN="LEFT"/></FONT>> pos="1235.50,738.00!"];
n29 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5000 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Burada kök, sevginin bile imtihan olduğunu<BR ALIGN="LEFT"/>gösterir.<BR ALIGN="LEFT"/></FONT>> pos="1235.50,670.00!"];
n30 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8889 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Çocukluk ve gençlik: «elem nürebbike fînâ<BR ALIGN="LEFT"/>velîdâ» (26:18); «vildânün muhalledûn» (56:17);<BR ALIGN="LEFT"/>«yevmen yecalü&#x27;l-vildâne şîbâ» (73:17).<BR ALIGN="LEFT"/></FONT>> pos="567.00,738.00!"];
n31 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8611 height=1.2778 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Veled (çocuk, özellikle oğul; «veled-i zinâ»<BR ALIGN="LEFT"/>gibi hukuk tabirlerinde) ve evlâd (soy,<BR ALIGN="LEFT"/>çocuklar): Türkçede «evlât» olarak yerleşmiş,<BR ALIGN="LEFT"/>«evlatlık» ise Arapça kökün sınırını aşmıştır;<BR ALIGN="LEFT"/>Kamus&#x27;un «tebennî ile gelene veled denmez»<BR ALIGN="LEFT"/>kaydına rağmen Türkçe bu iki kavramı yan yana<BR ALIGN="LEFT"/>tutar.<BR ALIGN="LEFT"/></FONT>> pos="1597.50,1286.00!"];
n32 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.7083 height=0.7778 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Vâlid, vâlide: Osmanlı sarayında Vâlide Sultan<BR ALIGN="LEFT"/>hükümdarın annesidir; vâlide alayı ise tahta<BR ALIGN="LEFT"/>çıkan padişahın annesinin saraya nakli için<BR ALIGN="LEFT"/>yapılan törendir.<BR ALIGN="LEFT"/></FONT>> pos="1925.00,1282.00!"];
n33 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.2639 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kök burada bir devlet makamı olmuştur.<BR ALIGN="LEFT"/></FONT>> pos="1925.00,1220.00!"];
n34 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.0417 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Velâdet ve tevellüd: «Doğum» ve «doğma»; nüfus<BR ALIGN="LEFT"/>kayıtlarındaki tevellüt tarihi ve mevlûd<BR ALIGN="LEFT"/>kelimeleri bu iki halkadan türer.<BR ALIGN="LEFT"/></FONT>> pos="1597.50,1156.00!"];
n35 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.9444 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Mevlid → mevlit: Arapçada «doğum yeri/zamanı»<BR ALIGN="LEFT"/>olan kelime, Osmanlıcada Peygamberimizin<BR ALIGN="LEFT"/>doğumunu anlatan manzum esere ad olmuştur.<BR ALIGN="LEFT"/></FONT>> pos="1925.00,1118.00!"];
n36 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5417 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Bu, bir zaman isminin edebî bir türe kaydığı<BR ALIGN="LEFT"/>nadir bir örnektir.<BR ALIGN="LEFT"/></FONT>> pos="1925.00,1062.00!"];
n37 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.8472 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">ب ن ي (ibn/bint): İbn kelimesi nesep ve yapıdan<BR ALIGN="LEFT"/>gelir ve evlatlığı da kapsayabilir; Kur&#x27;ân&#x27;da<BR ALIGN="LEFT"/>ebnâ&#x27; (33:4) evlatlıkları da içine alır.<BR ALIGN="LEFT"/></FONT>> pos="1597.00,908.00!"];
n38 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5417 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Veled ise yalnız doğuşla gelen için kullanılır.<BR ALIGN="LEFT"/></FONT>> pos="1597.00,852.00!"];
n39 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=4.0278 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Kamus&#x27;un ayrımı budur: aynı baba için ibn hem öz<BR ALIGN="LEFT"/>hem evlat edinilmiş olabilir, veled yalnız öz.<BR ALIGN="LEFT"/></FONT>> pos="1597.00,800.00!"];
n40 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.7778 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">ذ ر ر (zürriyet): Zürriyet tohumun yayılmasıdır,<BR ALIGN="LEFT"/>döllenip yeryüzüne saçılan nesil; veled ise tek<BR ALIGN="LEFT"/>bir doğuşun neticesidir.<BR ALIGN="LEFT"/></FONT>> pos="1918.00,908.00!"];
n41 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=2.6806 height=0.5000 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Biri çokluğa, öbürü bireye bakar.<BR ALIGN="LEFT"/></FONT>> pos="1918.00,852.00!"];
n42 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5139 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">ن س ل (nesil): Nesl aşağı akıp devam eden<BR ALIGN="LEFT"/>zinciri anlatır (ekin ve hayvanda da<BR ALIGN="LEFT"/>kullanılır); veled zincirin tek halkasıdır.<BR ALIGN="LEFT"/></FONT>> pos="1918.00,750.00!"];
n43 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.6250 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">ص ب و / غ ل م (sabî, gulâm): Bunlar çocuğun<BR ALIGN="LEFT"/>yaşına ve gelişimine (süt çağı, delikanlılık)<BR ALIGN="LEFT"/>bakar; veled ise doğuşa.<BR ALIGN="LEFT"/></FONT>> pos="1597.00,698.00!"];
n44 [shape=box style="filled,rounded" fixedsize=true fillcolor="#f7f3e8:#e4dcc6" gradientangle=270 color="#0b1218" penwidth=1.2 width=3.5278 height=0.6111 margin="0.10,0.06" fontname="DejaVu Sans" label=<<FONT FACE="DejaVu Sans" POINT-SIZE="11" COLOR="#1b232a">Aynı çocuk hem veled hem sabî hem gulâm<BR ALIGN="LEFT"/>olabilir, çünkü her kelime başka bir soruya<BR ALIGN="LEFT"/>cevap verir.<BR ALIGN="LEFT"/></FONT>> pos="1597.00,638.00!"];
