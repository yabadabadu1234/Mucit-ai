b17 [shape=box style="rounded,filled" fixedsize=true fillcolor="#456f89:#4f7d99" gradientangle=270 color="#a9c4d4" penwidth=1.2 width=4.3750 height=1.2500 pos="1597.50,1167.00!" labelloc=t label=<<FONT FACE="DejaVu Sans" POINT-SIZE="13" COLOR="#ffffff"><B>Velâdet ve tevellüd</B></FONT>>];
