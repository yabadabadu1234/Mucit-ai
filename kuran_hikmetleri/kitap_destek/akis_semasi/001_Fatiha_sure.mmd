%% Fâtiha (1) -- SÛRENİN KENDİ LAFZIYLA ŞEMA. TEKLİF, mühürsüz (F 3-I 337). Düğüm = âyetin kendi parçası; kutu içinde kutu = kategori; ✓ ve ✗ = dallanma.
flowchart TB
  classDef ayet fill:#fffdf2,stroke:#8a6d1d,color:#111,stroke-width:1.5px
  classDef kabul fill:#e8f6ea,stroke:#2e7d32,color:#111,stroke-width:1.5px
  classDef red fill:#fde7e7,stroke:#c62828,color:#111,stroke-width:1.5px

  subgraph M1["① المُعَرَّف · tarif edilen zât"]
    B1["<big>ٱلْحَمْدُ لِلَّهِ</big><br/><small>hamd Allah'ındır</small>"]:::ayet
    B3["<big>ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ</big><br/><small>Rahmân, Rahîm</small>"]:::ayet
    subgraph RB["رَبِّ ٱلْعَـٰلَمِينَ · âlemlerin Rabbi"]
      B4["<big>مَـٰلِكِ يَوْمِ ٱلدِّينِ</big><br/><small>dîn gününün sahibi</small>"]:::ayet
    end
    B1 --> B3
    B1 --> RB
  end

  subgraph M2["② الْمُصَدِّقُونَ · kitabı hak kabul edenler"]
    N1["<big>إِيَّاكَ نَعْبُدُ</big><br/><small>yalnız Sana kulluk ederiz</small>"]:::kabul
    subgraph NS["وَإِيَّاكَ نَسْتَعِينُ · yalnız Senden yardım dileriz"]
      N3["<big>ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ</big><br/><small>bizi doğru yola ilet</small>"]:::kabul
    end
    N4["<big>صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ</big><br/><small>nimet verdiklerinin yolu</small>"]:::kabul
    N1 --> NS
  end

  subgraph M3["③ الْمُعَانِدُونَ · kitaba düşman olanlar"]
    E1["<big>غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ</big><br/><small>gazaba uğrayanların değil</small>"]:::red
    E2["<big>وَلَا ٱلضَّآلِّينَ</big><br/><small>sapıtanların da değil</small>"]:::red
    E1 --> E2
  end

  B1 ==>|"لِلَّهِ ← كَ"| N1
  N3 ==>|"✓"| N4
  N3 ==>|"✗"| E1

  style M1 fill:#fffaf0,stroke:#8a6d1d
  style M2 fill:#f3fbf4,stroke:#2e7d32
  style M3 fill:#fff5f5,stroke:#c62828
  style RB fill:#fff3d6,stroke:#8a6d1d
  style NS fill:#dff3e2,stroke:#2e7d32
  linkStyle 4 stroke:#8a6d1d,stroke-width:3px
  linkStyle 5 stroke:#2e7d32,stroke-width:4px
  linkStyle 6 stroke:#c62828,stroke-width:4px
