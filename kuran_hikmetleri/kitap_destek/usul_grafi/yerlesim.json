{"W": 1991.0088, "H": 1432.99968, "boxes": [["kok", 0, 0, 1991.0088, 1432.99968, "Kelimenin Tam Künyesi", 0], ["bolum", 12, 816.00064, 617.0, 1374.99968, "1 · KÖK (bünye)", 1], ["blok", 24, 1134.00064, 205.9968, 1334.99968, "Kök sayısı", 2], ["blok", 24, 828.00064, 205.9968, 1118.00064, "Harf değişmesi", 2], ["blok", 221.9968, 1044.99968, 394.0, 1334.99968, "Kök yapısı", 2], ["blok", 410.0, 1040.0, 605.0, 1334.99968, "Kök kimliği", 2], ["bolum", 12, 308.00064, 617.0, 800.00064, "2 · VAZ‘ (ilk konuluş): 5 eksen, 16 çeşit", 1], ["blok", 24, 569.00096, 195.0024, 760.00064, "Kim koydu? (3)", 2], ["blok", 24, 419.00095999999996, 195.0024, 553.00096, "Kaç defa konuldu? (2)", 2], ["blok", 211.0024, 626.00064, 403.0, 760.00064, "Nasıl konuldu? (2)", 2], ["blok", 211.0024, 320.00064, 403.0, 610.00064, "Mana sayısı (5)", 2], ["blok", 419.0, 512.00128, 588.0008, 760.00064, "Kapsamı (4)", 2], ["bolum", 633.0, 825.9999999999999, 985.0024, 1374.99968, "3 · MANA SEYRİ (kökten manaya)", 1], ["blok", 645.0, 1040.0, 808.0032, 1334.99968, "Akış", 2], ["blok", 645.0, 837.9999999999999, 808.0032, 1023.9999999999999, "Hakikat türü", 2], ["blok", 824.0032, 888.9996799999999, 973.0024, 1334.99968, "Mana nasıl kayar?", 2], ["bolum", 633.0, 109.99999999999989, 985.0024, 809.9999999999999, "4 · İŞTİKAK (türeyiş hatları)", 1], ["blok", 645.0, 517.0009599999998, 806.0016, 769.9999999999999, "İştikak kaidesi", 2], ["blok", 822.0016, 531.9999999999999, 949.0048, 769.9999999999999, "Fiil kolları", 2], ["blok", 822.0016, 121.99999999999989, 949.0048, 515.9999999999999, "İsim kolları", 2], ["bolum", 1001.0024, 830.9996799999999, 1580.0032, 1374.99968, "5 · DELİL AĞI", 1], ["blok", 1013.0024, 1144.0, 1166.0048, 1334.99968, "Çeşidi", 2], ["blok", 1013.0024, 994.0, 1166.0048, 1128.0, "İstidlâl yönü", 2], ["blok", 1182.0048, 1096.99968, 1369.0056, 1334.99968, "Katiyet derecesi", 2], ["blok", 1182.0048, 842.9996799999999, 1369.0056, 1080.99968, "Nakil sıhhati", 2], ["blok", 1385.0056, 1040.0, 1568.0031999999999, 1334.99968, "Yolu", 2], ["bolum", 1001.0024, 519.9999999999999, 1580.0032, 814.9996799999999, "6 · BAĞLAM (siyâk)", 1], ["blok", 1013.0024, 531.9999999999999, 1182.0031999999999, 774.9996799999999, "Lafzî bağlam", 2], ["blok", 1198.0031999999999, 536.9996799999999, 1367.004, 774.9996799999999, "Hâlî bağlam", 2], ["blok", 1383.004, 536.9996799999999, 1545.0064, 774.9996799999999, "Tarih bağlamı", 2], ["bolum", 1001.0024, 11.999999999999886, 1580.0032, 503.9999999999999, "7 · SES (sıfatü’l-hurûf)", 1], ["blok", 1013.0024, 173.9999999999999, 1197.0008, 463.9999999999999, "Harfin tabiatı", 2], ["blok", 1013.0024, 23.999999999999886, 1197.0008, 157.9999999999999, "Delil mertebesi", 2], ["bolum", 1596.0032, 1018.00064, 1979.0088, 1374.99968, "8 · KAYNAK VE KARŞILAŞTIRMA", 1], ["blok", 1608.0032, 1030.00064, 1779.0056000000002, 1334.99968, "Karşılaştırma", 2], ["blok", 1795.0056000000002, 1092.0, 1967.0088, 1334.99968, "İhtilâfı çözme", 2]], "nodes": [{"id": 1, "text": "Tek kök — lafız tek asıl harf dizisine bağlı", "kind": "cumle", "x": 114.9984, "y": 1280.49984, "w": 105.9984, "h": 40.99968}, {"id": 2, "text": "Çok kök — lafız iki köke çekilebilir; ihtilâf doğar", "kind": "cumle", "x": 114.9984, "y": 1223.50016, "w": 139.9968, "h": 40.99968}, {"id": 3, "text": "Kök yoktur — câmid isim, türemez (ör. zamir)", "kind": "cumle", "x": 114.9984, "y": 1166.5004800000002, "w": 149.9976, "h": 40.99968}, {"id": 4, "text": "Selâsî — üç asıl harf", "kind": "cumle", "x": 307.9984, "y": 1282.99968, "w": 75.00240000000001, "h": 36.0}, {"id": 5, "text": "Rubâ‘î — dört asıl harf", "kind": "cumle", "x": 307.9984, "y": 1230.99968, "w": 85.0032, "h": 36.0}, {"id": 6, "text": "Humâsî — beş asıl harf, nâdir", "kind": "cumle", "x": 307.9984, "y": 1178.99968, "w": 117.0, "h": 36.0}, {"id": 7, "text": "Mücerred — ziyâdesiz, çıplak kök", "kind": "cumle", "x": 307.9984, "y": 1126.99968, "w": 127.0008, "h": 36.0}, {"id": 8, "text": "Mezîd-fîh — ziyâde harfle genişlemiş", "kind": "cumle", "x": 307.9984, "y": 1074.99968, "w": 148.0032, "h": 36.0}, {"id": 9, "text": "Arabî asıl — Arapçanın öz kökü", "kind": "cumle", "x": 507.5, "y": 1282.99968, "w": 114.9984, "h": 36.0}, {"id": 10, "text": "Mu‘arreb — yabancıdan alınıp Arapçalaşmış", "kind": "cumle", "x": 507.5, "y": 1228.49984, "w": 111.00240000000001, "h": 40.99968}, {"id": 11, "text": "Dehîl — yabancı, Arapçaya uymamış", "kind": "cumle", "x": 507.5, "y": 1174.0, "w": 171.0, "h": 36.0}, {"id": 12, "text": "Müvelled — sonradan türemiş", "kind": "cumle", "x": 507.5, "y": 1122.0, "w": 111.00240000000001, "h": 36.0}, {"id": 13, "text": "Sâmî ortak — kardeş dillerle ortak kök", "kind": "cumle", "x": 507.5, "y": 1070.0, "w": 147.0024, "h": 36.0}, {"id": 14, "text": "İ‘lâl — illetli harf değişir", "kind": "cumle", "x": 114.9984, "y": 1066.00064, "w": 106.9992, "h": 36.0}, {"id": 15, "text": "İbdâl — bir harf başka harfe döner", "kind": "cumle", "x": 114.9984, "y": 1014.00064, "w": 157.9968, "h": 36.0}, {"id": 16, "text": "İdğâm — iki harf kaynaşır", "kind": "cumle", "x": 114.9984, "y": 962.00064, "w": 102.00240000000001, "h": 36.0}, {"id": 17, "text": "Hazf — harf düşer", "kind": "cumle", "x": 114.9984, "y": 910.00064, "w": 70.99992, "h": 36.0}, {"id": 18, "text": "Kalb-i mekânî — harfin yeri değişir", "kind": "cumle", "x": 114.9984, "y": 858.00064, "w": 111.00240000000001, "h": 36.0}, {"id": 19, "text": "Tevkîfî — Allah öğretti", "kind": "cumle", "x": 109.5012, "y": 708.00064, "w": 82.0008, "h": 36.0}, {"id": 20, "text": "Istılâhî — insanlar anlaştı", "kind": "cumle", "x": 109.5012, "y": 656.00064, "w": 99.0, "h": 36.0}, {"id": 21, "text": "Zâtî münâsebet — lafızla mana arasında doğal bağ görüşü", "kind": "cumle", "x": 109.5012, "y": 601.5008, "w": 131.9976, "h": 40.99968}, {"id": 22, "text": "Ta‘yînî — açıkça tayin edildi", "kind": "cumle", "x": 307.0012, "y": 708.00064, "w": 113.99759999999999, "h": 36.0}, {"id": 23, "text": "Te‘ayyünî — kullanımla yerleşti", "kind": "cumle", "x": 307.0012, "y": 656.00064, "w": 114.9984, "h": 36.0}, {"id": 24, "text": "Âmm–âmm — genel lafız, genel mana", "kind": "cumle", "x": 503.5004, "y": 708.00064, "w": 142.9992, "h": 36.0}, {"id": 25, "text": "Âmm–hâss — genel tasavvur, özel müsemmâ (harf, zamir)", "kind": "cumle", "x": 503.5004, "y": 653.5008, "w": 145.0008, "h": 40.99968}, {"id": 26, "text": "Hâss–hâss — tek lafız, tek şey (özel isim)", "kind": "cumle", "x": 503.5004, "y": 596.50112, "w": 137.0016, "h": 40.99968}, {"id": 27, "text": "Hâss–âmm — imkânsız sayılır", "kind": "cumle", "x": 503.5004, "y": 542.00128, "w": 99.0, "h": 36.0}, {"id": 28, "text": "Müfred — tek mana", "kind": "cumle", "x": 307.0012, "y": 558.00064, "w": 66.00024, "h": 36.0}, {"id": 29, "text": "Müşterek — aynı lafız, farklı manalar", "kind": "cumle", "x": 307.0012, "y": 506.00064, "w": 147.0024, "h": 36.0}, {"id": 30, "text": "Mütevâtı — aynı mana, çok fert", "kind": "cumle", "x": 307.0012, "y": 454.00064, "w": 121.9968, "h": 36.0}, {"id": 31, "text": "Müşekkik — mana derece derece değişir", "kind": "cumle", "x": 307.0012, "y": 402.00064, "w": 167.9976, "h": 36.0}, {"id": 32, "text": "Ezdâd — aynı lafız, zıt iki mana", "kind": "cumle", "x": 307.0012, "y": 350.00064, "w": 135.0, "h": 36.0}, {"id": 33, "text": "Vaz‘-ı şahsî — her lafız ayrı konuldu", "kind": "cumle", "x": 109.5012, "y": 501.00095999999996, "w": 130.0032, "h": 36.0}, {"id": 34, "text": "Vaz‘-ı nev‘î — mecaz türüne genel izin", "kind": "cumle", "x": 109.5012, "y": 449.00095999999996, "w": 147.0024, "h": 36.0}, {"id": 35, "text": "Kök — harf iskeleti", "kind": "cumle", "x": 726.5016, "y": 1282.99968, "w": 78.9984, "h": 36.0}, {"id": 36, "text": "Vaz‘-ı evvel — ilk konulan asıl mana", "kind": "cumle", "x": 726.5016, "y": 1230.99968, "w": 130.0032, "h": 36.0}, {"id": 37, "text": "İştikak — köklerden dallanma", "kind": "cumle", "x": 726.5016, "y": 1178.99968, "w": 121.9968, "h": 36.0}, {"id": 38, "text": "Kayma — mana genişler, daralır, nakledilir", "kind": "cumle", "x": 726.5016, "y": 1124.49984, "w": 139.0032, "h": 40.99968}, {"id": 39, "text": "Bugünkü mana — kullanımdaki hâl", "kind": "cumle", "x": 726.5016, "y": 1070.0, "w": 104.99759999999999, "h": 36.0}, {"id": 40, "text": "Tevessü‘ — mana genişler", "kind": "cumle", "x": 898.5028, "y": 1282.99968, "w": 93.00240000000001, "h": 36.0}, {"id": 41, "text": "Tazyîk — mana daralır", "kind": "cumle", "x": 898.5028, "y": 1230.99968, "w": 84.00240000000001, "h": 36.0}, {"id": 42, "text": "Tahsîs — genelden özele", "kind": "cumle", "x": 898.5028, "y": 1178.99968, "w": 97.9992, "h": 36.0}, {"id": 43, "text": "Ta‘mîm — özelden genele", "kind": "cumle", "x": 898.5028, "y": 1126.99968, "w": 97.9992, "h": 36.0}, {"id": 44, "text": "Mecâz — ilgiyle başka mana", "kind": "cumle", "x": 898.5028, "y": 1074.99968, "w": 117.0, "h": 36.0}, {"id": 45, "text": "İstiâre — benzetme ilgisi", "kind": "cumle", "x": 898.5028, "y": 1022.9996799999999, "w": 97.9992, "h": 36.0}, {"id": 46, "text": "Mürsel — benzetme dışı ilgi", "kind": "cumle", "x": 898.5028, "y": 970.9996799999999, "w": 111.00240000000001, "h": 36.0}, {"id": 47, "text": "Kinâye — lâzım mananın kastı", "kind": "cumle", "x": 898.5028, "y": 918.9996799999999, "w": 124.9992, "h": 36.0}, {"id": 48, "text": "Lügavî — dilin ilk konuluşu", "kind": "cumle", "x": 726.5016, "y": 971.9999999999999, "w": 104.99759999999999, "h": 36.0}, {"id": 49, "text": "Örfî — halkın kullanımı", "kind": "cumle", "x": 726.5016, "y": 919.9999999999999, "w": 99.0, "h": 36.0}, {"id": 50, "text": "Şer‘î — dinin ıstılâhı", "kind": "cumle", "x": 726.5016, "y": 867.9999999999999, "w": 81.0, "h": 36.0}, {"id": 51, "text": "Sagîr — harf ve sıra aynı, sarf türevi", "kind": "cumle", "x": 725.5008, "y": 715.5001599999999, "w": 132.9984, "h": 40.99968}, {"id": 52, "text": "Kebîr — harfler yer değiştirir, ortak öz kalır", "kind": "cumle", "x": 725.5008, "y": 658.5004799999999, "w": 129.0024, "h": 40.99968}, {"id": 53, "text": "Ekber — mahreci yakın harfler geçişir", "kind": "cumle", "x": 725.5008, "y": 601.5007999999999, "w": 131.9976, "h": 40.99968}, {"id": 54, "text": "Nahit — iki kelimeden kısaltma", "kind": "cumle", "x": 725.5008, "y": 547.0009599999998, "w": 137.0016, "h": 36.0}, {"id": 55, "text": "Mâzî — geçmiş", "kind": "cumle", "x": 885.5032000000001, "y": 717.9999999999999, "w": 54.0, "h": 36.0}, {"id": 56, "text": "Muzâri‘ — şimdiki, gelecek", "kind": "cumle", "x": 885.5032000000001, "y": 665.9999999999999, "w": 102.00240000000001, "h": 36.0}, {"id": 57, "text": "Emir — istek", "kind": "cumle", "x": 885.5032000000001, "y": 613.9999999999999, "w": 54.0, "h": 36.0}, {"id": 58, "text": "Bâb — fiilin vezin ailesi", "kind": "cumle", "x": 885.5032000000001, "y": 561.9999999999999, "w": 102.00240000000001, "h": 36.0}, {"id": 59, "text": "Masdar — işin kendisi", "kind": "cumle", "x": 885.5032000000001, "y": 463.9999999999999, "w": 75.00240000000001, "h": 36.0}, {"id": 60, "text": "Fâil — işi yapan", "kind": "cumle", "x": 885.5032000000001, "y": 411.9999999999999, "w": 64.00008, "h": 36.0}, {"id": 61, "text": "Mef‘ûl — işi gören", "kind": "cumle", "x": 885.5032000000001, "y": 359.9999999999999, "w": 61.99992, "h": 36.0}, {"id": 62, "text": "Sıfat — vasıf bildirir", "kind": "cumle", "x": 885.5032000000001, "y": 307.9999999999999, "w": 78.9984, "h": 36.0}, {"id": 63, "text": "Mübâlağa — çokluk, şiddet", "kind": "cumle", "x": 885.5032000000001, "y": 255.9999999999999, "w": 90.0, "h": 36.0}, {"id": 64, "text": "Zaman–mekân — işin vakti, yeri", "kind": "cumle", "x": 885.5032000000001, "y": 203.9999999999999, "w": 103.0032, "h": 36.0}, {"id": 65, "text": "Âlet — işin vasıtası", "kind": "cumle", "x": 885.5032000000001, "y": 151.9999999999999, "w": 79.9992, "h": 36.0}, {"id": 66, "text": "Nakilî — haberle: âyet, hadis, şiir, lügat", "kind": "cumle", "x": 1089.5036, "y": 1280.49984, "w": 129.0024, "h": 40.99968}, {"id": 67, "text": "Aklî — mantıkla, zorunlu", "kind": "cumle", "x": 1089.5036, "y": 1226.0, "w": 110.0016, "h": 36.0}, {"id": 68, "text": "Hissî — duyu ve müşâhede", "kind": "cumle", "x": 1089.5036, "y": 1174.0, "w": 120.00240000000001, "h": 36.0}, {"id": 69, "text": "Kat‘î — kesin, burhan", "kind": "cumle", "x": 1275.5051999999998, "y": 1282.99968, "w": 88.9992, "h": 36.0}, {"id": 70, "text": "Zannî — güçlü ihtimal", "kind": "cumle", "x": 1275.5051999999998, "y": 1230.99968, "w": 85.0032, "h": 36.0}, {"id": 71, "text": "Şekk — iki ihtimal denk", "kind": "cumle", "x": 1275.5051999999998, "y": 1178.99968, "w": 97.9992, "h": 36.0}, {"id": 72, "text": "Vehim — zayıf ihtimal", "kind": "cumle", "x": 1275.5051999999998, "y": 1126.99968, "w": 82.0008, "h": 36.0}, {"id": 73, "text": "Müstakîm — doğrudan manaya götürür", "kind": "cumle", "x": 1476.5044, "y": 1282.99968, "w": 158.9976, "h": 36.0}, {"id": 74, "text": "Gayr-i müstakîm — ara öncül ister", "kind": "cumle", "x": 1476.5044, "y": 1230.99968, "w": 115.9992, "h": 36.0}, {"id": 75, "text": "İstikrâî — tek tek tarayıp genele varır", "kind": "cumle", "x": 1476.5044, "y": 1176.49984, "w": 136.0008, "h": 40.99968}, {"id": 76, "text": "İktisâbî — nazarla kazanılır", "kind": "cumle", "x": 1476.5044, "y": 1122.0, "w": 104.99759999999999, "h": 36.0}, {"id": 77, "text": "Bedîhî — nazarsız, apaçık", "kind": "cumle", "x": 1476.5044, "y": 1070.0, "w": 103.0032, "h": 36.0}, {"id": 78, "text": "İnnî — eserden müessire", "kind": "cumle", "x": 1089.5036, "y": 1076.0, "w": 112.9968, "h": 36.0}, {"id": 79, "text": "Limmî — sebepten sonuca", "kind": "cumle", "x": 1089.5036, "y": 1024.0, "w": 108.0, "h": 36.0}, {"id": 80, "text": "Mütevâtir — yalan üzerine toplanılamaz", "kind": "cumle", "x": 1275.5051999999998, "y": 1028.99968, "w": 163.0008, "h": 36.0}, {"id": 81, "text": "Meşhur — yaygın", "kind": "cumle", "x": 1275.5051999999998, "y": 976.9996799999999, "w": 59.99976, "h": 36.0}, {"id": 82, "text": "Âhâd — tek tük", "kind": "cumle", "x": 1275.5051999999998, "y": 924.9996799999999, "w": 54.0, "h": 36.0}, {"id": 83, "text": "Şâz — genele aykırı", "kind": "cumle", "x": 1275.5051999999998, "y": 872.9996799999999, "w": 85.0032, "h": 36.0}, {"id": 84, "text": "Sibâk — kelimeden önceki söz", "kind": "cumle", "x": 1097.5028, "y": 722.9996799999999, "w": 131.9976, "h": 36.0}, {"id": 85, "text": "Lihâk — kelimeden sonraki söz", "kind": "cumle", "x": 1097.5028, "y": 670.9996799999999, "w": 137.0016, "h": 36.0}, {"id": 86, "text": "Takdîm–te’hîr — sıra bozulmasının mana vurgusu", "kind": "cumle", "x": 1097.5028, "y": 616.49984, "w": 145.0008, "h": 40.99968}, {"id": 87, "text": "Karîne — manayı seçtiren ipucu", "kind": "cumle", "x": 1097.5028, "y": 561.9999999999999, "w": 136.0008, "h": 36.0}, {"id": 88, "text": "Makam — sözün söylendiği durum", "kind": "cumle", "x": 1282.5035999999998, "y": 722.9996799999999, "w": 145.0008, "h": 36.0}, {"id": 89, "text": "Mukteza-yı hâl — duruma uygun söz", "kind": "cumle", "x": 1282.5035999999998, "y": 670.9996799999999, "w": 117.0, "h": 36.0}, {"id": 90, "text": "Sebeb-i nüzûl — âyetin iniş sebebi", "kind": "cumle", "x": 1282.5035999999998, "y": 618.9996799999999, "w": 111.00240000000001, "h": 36.0}, {"id": 91, "text": "Konuşan, muhatap — kim kime söylüyor", "kind": "cumle", "x": 1282.5035999999998, "y": 566.9996799999999, "w": 129.0024, "h": 36.0}, {"id": 92, "text": "Câhiliye — Kur’ân öncesi kullanım", "kind": "cumle", "x": 1464.0051999999998, "y": 722.9996799999999, "w": 138.0024, "h": 36.0}, {"id": 93, "text": "Kur’ân — vahyin kullanımı", "kind": "cumle", "x": 1464.0051999999998, "y": 670.9996799999999, "w": 103.9968, "h": 36.0}, {"id": 94, "text": "Hadis, fıkıh — sonraki ıstılâhlar", "kind": "cumle", "x": 1464.0051999999998, "y": 618.9996799999999, "w": 104.99759999999999, "h": 36.0}, {"id": 95, "text": "Osmanlıca — Türkçedeki yeri", "kind": "cumle", "x": 1464.0051999999998, "y": 566.9996799999999, "w": 96.9984, "h": 36.0}, {"id": 96, "text": "Mahreç — harfin çıkış yeri", "kind": "cumle", "x": 1105.0016, "y": 411.9999999999999, "w": 99.0, "h": 36.0}, {"id": 97, "text": "Şiddet–rehâvet — sert, yumuşak", "kind": "cumle", "x": 1105.0016, "y": 359.9999999999999, "w": 108.0, "h": 36.0}, {"id": 98, "text": "Cehr–hems — gür, fısıltılı", "kind": "cumle", "x": 1105.0016, "y": 307.9999999999999, "w": 81.0, "h": 36.0}, {"id": 99, "text": "İtbâk — damağa yapışan harf", "kind": "cumle", "x": 1105.0016, "y": 255.9999999999999, "w": 130.9968, "h": 36.0}, {"id": 100, "text": "Tekrâr — muzâaf: tekrarlayan mana", "kind": "cumle", "x": 1105.0016, "y": 203.9999999999999, "w": 159.9984, "h": 36.0}, {"id": 101, "text": "Ses–mana uyumu — karîne, zannî", "kind": "cumle", "x": 1105.0016, "y": 105.99999999999989, "w": 121.0032, "h": 36.0}, {"id": 102, "text": "Burhan değil — tek başına hüküm kurmaz", "kind": "cumle", "x": 1105.0016, "y": 53.999999999999886, "w": 156.0024, "h": 36.0}, {"id": 103, "text": "Lügatler arası — kim ne dedi, ihtilâf nerede", "kind": "cumle", "x": 1693.5044, "y": 1280.49984, "w": 117.0, "h": 40.99968}, {"id": 104, "text": "Sâmî diller — İbrânî, Süryânî, Akkadca ile kök", "kind": "cumle", "x": 1693.5044, "y": 1223.50016, "w": 147.0024, "h": 40.99968}, {"id": 105, "text": "Lehçe (lügât) — kabile farkı", "kind": "cumle", "x": 1693.5044, "y": 1169.00032, "w": 95.99759999999999, "h": 36.0}, {"id": 106, "text": "Kıraat — okuyuş farkı manayı değiştirir mi", "kind": "cumle", "x": 1693.5044, "y": 1114.5004800000002, "w": 126.0, "h": 40.99968}, {"id": 107, "text": "Türkçeye geçiş — ses ve mana kayması", "kind": "cumle", "x": 1693.5044, "y": 1060.0006400000002, "w": 135.0, "h": 36.0}, {"id": 108, "text": "Sıhhat — hangisi sağlam", "kind": "cumle", "x": 1881.0072000000002, "y": 1282.99968, "w": 96.9984, "h": 36.0}, {"id": 109, "text": "Kıdem — hangisi eski", "kind": "cumle", "x": 1881.0072000000002, "y": 1230.99968, "w": 78.9984, "h": 36.0}, {"id": 110, "text": "İttifak — hangisinde çoğunluk var", "kind": "cumle", "x": 1881.0072000000002, "y": 1178.99968, "w": 148.0032, "h": 36.0}, {"id": 111, "text": "Tercih — kalan ihtimalden en güçlüsü", "kind": "cumle", "x": 1881.0072000000002, "y": 1124.49984, "w": 122.99759999999999, "h": 40.99968}], "zincir": [[35, 36, 37, 38, 39]], "rows": {}}